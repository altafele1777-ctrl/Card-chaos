// زيادة نقاط حياة لاعب معيّن
function arGainLP(who,amt){ if(who==='p')G.playerLP+=amt; else G.enemyLP+=amt; if(typeof updateLP==='function')updateLP(); }
// تدمير كل وحوش فصيلة معيّنة على ساحة معيّنة (المكشوفة) — تُرجع العدد
function arDestroyByRace(who,race){
  let f=who==='p'?G.pField:G.eField; let n=0;
  for(let i=4;i>=0;i--){let sl=f.m[i]; if(sl&&!sl.faceDown){let c=cardById(sl.id); if(c&&c.race===race){destroyMonster(who,i);n++;}}}
  return n;
}
// تدمير كل تعويذات/أفخاخ ساحة معيّنة — تُرجع العدد
function arDestroyAllST(who){
  let f=who==='p'?G.pField:G.eField; let n=0;
  for(let i=4;i>=0;i--){if(f.s[i]){destroySpell(who,i);n++;}}
  return n;
}

// ===== مؤثرات التعويذات البصرية حسب نوع التأثير =====
function classifySpell(card){
  let d=(card.desc||'')+' '+(card.name||'');
  let s=card.slug||'';
  // فئات حسب الكلمات المفتاحية في الوصف
  if(/دمّر|دمر|تدمير|تُدمّر|إبادة|اقتلاع|raigeki|dark-hole|أبيد/.test(d)||/dark-hole|raigeki/.test(s)) return 'destroy';
  if(/اسحب|سحب|اسحبي|pot-of-greed|graceful-charity|\+2|بطاقتين|بطاقات إضافية/.test(d)) return 'draw';
  if(/يزداد|تزداد|\+\d00|يكتسب|زيادة|أقوى|تقوية|هجوم.*\+|قوّة/.test(d)) return 'boost';
  if(/ينقص|تنقص|يخسر|إضعاف|-\d00|تخصم.*هجوم|أضعف/.test(d)) return 'weaken';
  if(/استدع|أحيي|إحياء|صحّ|بعث|monster-reborn|عُد|أعِد للملعب/.test(d)) return 'summon';
  if(/سيطر|تحكم|محولة القلوب|change-of-heart|brain-control|اخطف|استحوذ/.test(d)) return 'control';
  if(/ضرر|نقطة أساسية|نقاط حياة|يتلقى|burn/.test(d)) return 'burn';
  if(/فخ|سحر|أبطل|يُلغى|تعطيل|de-spell|typhoon|أزل|دمّر.*سحر/.test(d)) return 'disrupt';
  if(/درع|حماية|دفاع|حصّن|يحمي|shield|protect/.test(d)) return 'shield';
  return 'generic';
}
function spellFx(category,card){
  try{
    const conf={
      destroy:{icon:'💥',color:'#ff4422',glow:'rgba(255,68,34,.9)',label:'تدمير'},
      draw:{icon:'🃏',color:'#4aaaff',glow:'rgba(74,170,255,.9)',label:'سحب'},
      boost:{icon:'⬆️',color:'#ffcc33',glow:'rgba(255,204,51,.95)',label:'تقوية'},
      weaken:{icon:'⬇️',color:'#aa66cc',glow:'rgba(170,102,204,.9)',label:'إضعاف'},
      summon:{icon:'✨',color:'#66ddaa',glow:'rgba(102,221,170,.9)',label:'استدعاء'},
      control:{icon:'💘',color:'#ff66aa',glow:'rgba(255,102,170,.9)',label:'سيطرة'},
      burn:{icon:'🔥',color:'#ff7722',glow:'rgba(255,119,34,.9)',label:'ضرر'},
      disrupt:{icon:'🌀',color:'#33ccdd',glow:'rgba(51,204,221,.9)',label:'تعطيل'},
      shield:{icon:'🛡',color:'#88bbff',glow:'rgba(136,187,255,.9)',label:'حماية'},
      generic:{icon:'✨',color:'#c9a84c',glow:'rgba(201,168,76,.9)',label:'تعويذة'},
    };
    let c=conf[category]||conf.generic;
    let ov=document.createElement('div');
    ov.className='spell-fx spell-fx-'+category;
    ov.style.setProperty('--fx-color',c.color);
    ov.style.setProperty('--fx-glow',c.glow);
    ov.innerHTML='<div class="spell-fx-ring"></div><div class="spell-fx-icon">'+c.icon+'</div><div class="spell-fx-label">'+c.label+'</div>';
    document.body.appendChild(ov);
    setTimeout(()=>{ if(ov.parentElement)ov.parentElement.removeChild(ov); },1500);
  }catch(e){}
}
function activateSpell(card,who,sIdx){
  sfx('spell');showMsg("✨ "+card.name+"!",1700);
  // مؤثر بصري حسب نوع التعويذة
  spellFx(classifySpell(card),card);
  // Spell Absorption: controller gains 500 LP whenever any spell resolves
  if(G.spellAbsorption){
    if(G.spellAbsorption==='p')G.playerLP+=500; else G.enemyLP+=500;
  }
  let myF=who==='p'?G.pField:G.eField, oppF=who==='p'?G.eField:G.pField;
  let s=card.slug;
  setTimeout(()=>{
    // ===== محرّك التعويذات العربية: يُجرَّب أولاً =====
    if(AR_SPELLS[s]){
      let keep=false;
      try{ keep = AR_SPELLS[s](who,card,myF,oppF)==='STAY'; }catch(e){}
      if(!keep){
        graveSpell(who,card);
        if(sIdx!=null&&myF.s[sIdx])myF.s[sIdx]=null;
      } else {
        // تعويذة دائمة: تبقى على الملعب مكشوفة
        if(sIdx!=null&&myF.s[sIdx]){myF.s[sIdx].faceDown=false;}
      }
      renderAll();
      return;
    }
    if(s==='dark-hole'){clearMonstersToGrave('p');clearMonstersToGrave('e');graveSpell(who,card);showMsg("Dark Hole! دُمّر الكل!",1800);}
    else if(s==='raigeki'){clearMonstersToGrave(who==='p'?'e':'p');graveSpell(who,card);showMsg("Raigeki! دُمّرت مونسترات العدو!",1800);}
    else if(s==='pot-of-greed'){drawFrom(who);drawFrom(who);graveSpell(who,card);showMsg("Pot of Greed! +2",1500);}
    else if(s==='card-of-sanctity'){
      // نسخة الأنمي: كل لاعب يسحب حتى يصبح بيده 6 بطاقات
      ['p','e'].forEach(w=>{
        let h=w==='p'?G.playerHand:G.enemyHand;
        let dk=w==='p'?G.playerDeck:G.enemyDeck;
        while(h.length<6 && dk.length){drawFrom(w);}
      });
      graveSpell(who,card);showMsg("Card of Sanctity! سحب الطرفان حتى 6 بطاقات",2000);
    }
    else if(s==='mystical-space-typhoon'||s==='de-spell'||s==='dust-tornado'){let oppW=who==='p'?'e':'p';for(let i=0;i<5;i++){if(oppF.s[i]){destroySpell(oppW,i);graveSpell(who,card);showMsg("دُمّرت تعويذة/فخ العدو!",1500);break;}}}
    else if(s==='monster-reborn'){
      // Revive strongest monster from either graveyard
      let allGrave=[...G.pGrave.map(id=>({id,from:'p'})),...G.eGrave.map(id=>({id,from:'e'}))].filter(x=>cardById(x.id).type==='monster');
