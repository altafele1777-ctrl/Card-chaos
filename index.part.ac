  { id:355, slug:"ar3-055", name:"أخو هاربي", type:"monster", race:"winged", gameDeck:true, attribute:"wind", level:4, atk:1800, def:600, desc:"نظراً لمخالبه الثاقبة وسرعة طيرانه يعد سيد السماء." },
