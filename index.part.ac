  { id:1276, slug:"ar9-077", name:"التحكم المغناطيسي", type:"trap", gameDeck:true, desc:"عندما تلعب هذه الورقة، خصمك لا يمكنه تغيير وضعيات الوحوش في دوره المقبل." },
  { id:1277, slug:"ar9-078", name:"إبطال الهجوم", type:"trap", gameDeck:true, desc:"عندما يقوم خصمك بهجمة، كل هجمات وحوشه يتم إبطالها و ينهي دور هجوم خصمك." },
  { id:1278, slug:"ar9-079", name:"ورقة الشغب", type:"trap", gameDeck:true, desc:"صحي بوحش ظلام هجوم 1000 نقطة على الأقل من ملعبك. كل الوحوش هجوم 1500 نقطة أو أكثر من وحوش خصمك التي في يده أو التي يسحبها خلال 3 أدواره القادمة تدمر." },
  { id:1279, slug:"ar9-080", name:"التمساح ذو سيف التنين", type:"monster", race:"dragon", gameDeck:true, attribute:"wind", level:5, atk:1700, def:1500, desc:"وحش دمج: \"سيف التمساح\" + \"صغير التنين\". الهجوم مباشرة على النقاط الأساسية إذا كانت وحوش أرض، ماء أو نار." , fusionMon:true},
  { id:1280, slug:"ar9-081", name:"الترس السحري", type:"trap", gameDeck:true, desc:"بمكنك تفعيل هذه الورقة عندما يعلن خصمك هجوما، اختر وحشا من وحوشك بالملعب في وضعية الهجوم يكون هدف للهجوم." },
  { id:1281, slug:"ar9-082", name:"استنساخ القبعة", type:"monster", race:"spellcaster", gameDeck:true, attribute:"light", level:1, atk:0, def:0, desc:"عندما يستدعى هذه الورقة بمكنها أخذ نقاط هجوم و دفاع وحش من وحوش خصمك المكشوف أنت تختاره." },
  { id:1282, slug:"ar9-083", name:"صاروخ المحارب", type:"monster", race:"machine", gameDeck:true, attribute:"light", level:4, atk:1500, def:1300, desc:"لا يعمل تأثيره إلا في مرحلة هجومك، جميع الأضرار ترجع إلى 0، و إذا هجم خصمك بنقطة 500 نقطة هجومية." },
  { id:1283, slug:"ar9-084", name:"سيف التمساح", type:"monster", race:"reptile", gameDeck:true, attribute:"earth", level:4, atk:1500, def:1200, desc:"هذا التمساح بحرك السيف بسرعة تفوق سرعة الصوت." },
  { id:1284, slug:"ar9-085", name:"محارب المعارك", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:3, atk:700, def:1000, desc:"محارب يقاتل ببده المجردتين." },
  { id:1285, slug:"ar9-086", name:"الكني المسلسل", type:"trap", gameDeck:true, desc:"بمكنك تغيير وضعية وحش من الهجوم إلى وضعية الدفاع. في المقابل بمكنك زيادة نقاط هجوم أحد وحوشك بالملعب بـ500 نقطة." },
  { id:1286, slug:"ar9-087", name:"النمر المحارب", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:4, atk:2000, def:1600, desc:"لا بمكنك الهجوم به إلا بعد التضحية بوحش من وحوش ملعبك." },
  { id:1287, slug:"ar9-088", gameDeck:true, name:"حكيم الدمج", type:"spell", desc:"خذ ورقة \"الانصهار\" من مجموعتك ثم أضفها لأوراق يدك." },
  { id:1288, slug:"ar9-089", name:"تمساح التكنولوجيا البقية", type:"monster", race:"reptile", gameDeck:true, attribute:"wind", level:6, atk:2500, def:1600, desc:"محنج النسر بمكن إعادته للحياة عن طريق وسائل التكنولوجيا الحديثة." },
  { id:1289, slug:"ar9-090", name:"المنشدة المائية", type:"trap", gameDeck:true, desc:"إذا كان بالملعب وحوش لها نفس الاسم، تزداد نقاط هجومهم و دفاعهم بـ500 نقطة." },
  { id:1290, slug:"ar9-091", name:"ماكر العيون السوداء", type:"monster", race:"spellcaster", gameDeck:true, attribute:"dark", level:4, atk:0, def:1400, desc:"قلب: ساحر. طالما هذه الورقة في الملعب أحد وحوش خصمك المختار لا يمكنه الهجوم." },
  { id:1291, slug:"ar9-092", name:"ملكة الحشرات", type:"monster", race:"insect", gameDeck:true, attribute:"earth", level:7, atk:2200, def:2400, desc:"تضحي بوحشين من ملعبك كي تجمح فجوة بريد 200 نقطة لكل وحش حشرة بالملعب. إذا دمر وحشا \"نحلة\" وحش حشرة جديدة هجوم 100 و دفاع 200 مقلوب للملعب." },
  { id:1292, slug:"ar9-093", name:"ستار السحر الأسود", type:"spell", gameDeck:true, desc:"عند تفعيلها لا بمكنك استدعاء أي وحش. بمكنك استدعاء \"ساحر الظلام\" استدعاء خاص لكن بعد التخلي عن نصف نقاط حياتك." },
  { id:1293, slug:"ar9-094", name:"الوحش الخرافي الطائر", type:"monster", race:"winged", gameDeck:true, attribute:"dark", level:6, atk:2100, def:1800, desc:"وحش دمج: \"بيرفوميت\" + \"غارلن: ملك وحوش الأسطورة\". إذا دمر استدعاء \"بيرفوميت\" أو \"غارلن\" من مقبرتك." , fusionMon:true},
  { id:1294, slug:"ar9-095", name:"وحش جيلفر", type:"monster", race:"beast", gameDeck:true, attribute:"dark", level:7, atk:2200, def:2500, desc:"يفعل هذه الخاصية عندما تكون هذه الورقة بالمعبر. يزيد للوحش المختار في الملعب 500 نقطة هجوم." },
  { id:1295, slug:"ar9-096", name:"أجنحة غريفون", type:"trap", gameDeck:true, desc:"عندما يفعل خصمك \"ريشة هاريب\"، كل أوراق سحر و فخ خصمك تدمر مكان أوراقك." },
  { id:1296, slug:"ar9-097", name:"الجندي الحركي", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:3, atk:1350, def:1800, desc:"قلب: خلال المعركة ضد الوحوش من نوع محارب تضاف لهجومه و دفاعه 2000 نقطة عند احتساب الأضرار." },
  { id:1297, slug:"ar9-098", name:"سكيلانج", type:"monster", race:"warrior", gameDeck:true, attribute:"light", level:2, atk:900, def:400, desc:"قلب: بمكنك سحب ورقة من مجموعتك." },
  { id:1298, slug:"ar9-099", name:"انفجار المجال", type:"trap", gameDeck:true, desc:"إذا كان مقلوبا و قوحم، بلعبي بوجين خصمك و عند دور استعداده يفعل الوحش، و يخصم من نقاط حصمك بقدر قدرة هجوم الوحش المقابل." },
  { id:1299, slug:"ar9-100", name:"مباركة الملك", type:"spell", gameDeck:true, desc:"لا تستطيع استخدام هذه الورقة إلا عندما تهاجم نقاط حياة معارضك مباشرة، بمكنك زيادة نقاط حياتك بمبلغ يساوي الضرر الذي سببه لخصمك." },
  { id:1300, slug:"ar10-001", name:"اليد المدمرة", type:"trap", gameDeck:true, desc:"كل الوحوش من المستوى الثالث أو أقل يدمرون بنهاية الدور الذي استدعوا فيه إما استدعاءً عاديا عن طريق القلب." },
  { id:1301, slug:"ar10-002", name:"شبكة الجاذبية", type:"trap", gameDeck:true, desc:"كل وحوش المستوى الرابع أو أكثر لا بمكنها الهجوم." },
  { id:1302, slug:"ar10-003", name:"المطحنة السحرية", type:"trap", gameDeck:true, desc:"لكل ورقة سحرية ترميها، يتلقى خصمك ضررا قدره 500 نقطة أساسية." },
  { id:1303, slug:"ar10-004", name:"ظلّ الأعين", type:"trap", gameDeck:true, desc:"إذا وضع خصمك وحشا في وضعية دفاع مقلوب، اقلبه في وضعية هجوم مكشوف. إذا كان له تأثير لا تفعله." },
  { id:1304, slug:"ar10-005", name:"الصياد الأسطوري", type:"monster", race:"warrior", gameDeck:true, attribute:"water", level:4, atk:1850, def:1600, desc:"طالما ورقة \"الملعب المائي\" مفعلة لا بتأثر بأوراق السحر. جميع وحوش خصمك لا يمكنهم استهدافه في هجوم." },
  { id:1305, slug:"ar10-006", name:"صياد السيوف", type:"monster", race:"rock", gameDeck:true, attribute:"earth", level:7, atk:2450, def:1700, desc:"الوحش المُدمّر بهذه الورقة، صحب ورقة بحجر له في بنهاية مرحلة الهجوم مع 300 نقطة كريادة في هجومه." },
  { id:1306, slug:"ar10-007", name:"الحشرة الثاقبة", type:"monster", race:"insect", gameDeck:true, attribute:"earth", level:2, atk:1100, def:200, desc:"قلب: عندما بلتقى ضررا لنقاط حياة حصلت، بمكنك سحب ورقة من بعين الأسفل، و بعد الخلط ضعها في أعلى مجموعتك." },
  { id:1307, slug:"ar10-008", name:"وحش أغوار البحر", type:"monster", race:"warrior", gameDeck:true, attribute:"water", level:4, atk:1600, def:1800, desc:"طالما ورقة \"أومي\" بالملعب لا يتأثر بأي ورقة سحر." },
  { id:1308, slug:"ar10-009", name:"الحذاء اللاحم", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:2, atk:500, def:300, desc:"قلب: عبر وحشا خصمك أحد مكشوف إلى وضعية الدفاع اللاحم، يبقى هذه الورقة مكشوفة." },
  { id:1309, slug:"ar10-010", name:"سبايكبوط", type:"monster", race:"spellcaster", gameDeck:true, attribute:"earth", level:5, atk:1800, def:1700, desc:"هذا الجندي الآلي هو من صنع ساحر بهاجم بكرس حدادبس مشدودين إلى دراعيه بسلسلين." },
  { id:1310, slug:"ar10-011", name:"دعوة للنوم الظلامي", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:1500, def:1800, desc:"عند استدعائه أو كسبه، اخبر وحشا من وحوش خصمك. طالما هذه الورقة بالملعب وحش خصمك لا بمكنه الهجوم." },
  { id:1311, slug:"ar10-012", name:"المعبود ألف عين", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:1, atk:0, def:0, desc:"هذا الكيان الشرير يسيطر على قلوب الرجال، بأعينه الألف قادر على رؤيته و بمدد تأثيره السلبي على أمر الأفراد." },
  { id:1312, slug:"ar10-013", name:"الممنوع ذو الألف عين", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:1, atk:0, def:0, desc:"المسخ \"المعبود ألف عين\". باخذ هجوم و دفاع أي وحش و وحوش خصمك، عندما يطبق فخ ظهور و دموع الوحش الملك بقدرة و الأضرار بنقطة مضلل عمله." },
  { id:1313, slug:"ar10-014", name:"حيروشين كواكاتا", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:4, atk:1700, def:1000, desc:"رغم صغر هذا الوحش له قوة فكين رهيبة قادرة على نفث المعادن." },
  { id:1314, slug:"ar10-015", name:"الفارس هايابوزا", type:"monster", race:"warrior", gameDeck:true, attribute:"wind", level:3, atk:1000, def:700, desc:"بمكنه أن يهجم مرتين خلال نفس مرحلة الهجوم." },
  { id:1315, slug:"ar10-016", name:"الخنفساء المدمرة", type:"monster", race:"insect", gameDeck:true, attribute:"wind", level:2, atk:400, def:900, desc:"قلب: اقلب ورقة مقلوبة في الدفاع من أوراق حصملك و إن كان وحش تأثر دمره و إلا أرجعه لوضعيته." },
  { id:1316, slug:"ar10-017", name:"دعسوقة الأربع نجوم", type:"monster", race:"warrior", gameDeck:true, attribute:"wind", level:4, atk:800, def:1200, desc:"قلب: دمر جميع وحوش خصمك من المستوى الرابع." },
  { id:1317, slug:"ar10-018", name:"كرادبيس", type:"monster", race:"beast", gameDeck:true, attribute:"light", level:4, atk:1200, def:800, desc:"قلب: قناص لديه ردة فعل سريعة جدا و لديه كبسولة طاقة قادرة على إطلاق هجوم قوى." },
  { id:1318, slug:"ar10-019", name:"ساحر القمر الأحمر", type:"monster", race:"spellcaster", gameDeck:true, attribute:"dark", level:3, atk:700, def:1000, desc:"أي وحش يدمر بمكنك استدعاؤه لصالحك بعد نهاية مرحلة الهجوم." },
  { id:1319, slug:"ar10-020", name:"وحش السيف المجنون", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:4, atk:1400, def:1200, desc:"عندما يهجم على وحش حالة دفاع أقل من هجومه يمر هجومه في نقاط حياة الخصم." },
  { id:1320, slug:"ar10-021", name:"قبطان الجمجمة", type:"monster", race:"zombie", gameDeck:true, attribute:"water", level:4, atk:1600, def:900, desc:"سفينة قراصنة تخرج من الضباب لإغراق كل السفن المتواجدة بمنطقتها." },
  { id:1321, slug:"ar10-022", name:"الكل يرى النمر الأبيض", type:"monster", race:"beast", gameDeck:true, attribute:"wind", level:4, atk:1300, def:500, desc:"هذا المخلوق لديه سيادة الغابة لكنه يخشى بعض النواحي الأخرى." },
  { id:1322, slug:"ar10-023", name:"قوة هجوم العفاريت", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:2300, def:0, desc:"عندما يهاجم بهذه الورقة في وضعية الدفاع، لا بمكن يغير وضعيتها إلا بنهاية دورك التالي." },
  { id:1323, slug:"ar10-024", name:"السلحفات الجزيرة", type:"monster", race:"warrior", gameDeck:true, attribute:"water", level:4, atk:1100, def:2000, desc:"سلحفات ضخمة الكبير بخلط بينها و بين جزيرة." },
  { id:1324, slug:"ar10-025", name:"الجناح الحائك", type:"monster", race:"winged", gameDeck:true, attribute:"light", level:7, atk:2750, def:2400, desc:"ملاك ذو أجنحة سته، برجو السلام." },
  { id:1325, slug:"ar10-026", name:"جندي العلوم", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:3, atk:800, def:800, desc:"جنود مجهزين من الدولة بأحدث الأجهزة المعاصرة لمحاربة المخلوقات المجهولة." },
  { id:1326, slug:"ar10-027", name:"الأرواح المنسية", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:2, atk:900, def:200, desc:"روح شريرة أنشئت من الأرواح الشريرة التي خسرت في المعارك، تكبر أرواح أعدائها." },
  { id:1327, slug:"ar10-028", name:"دوكوروبيا", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:3, atk:1000, def:400, desc:"سلاح يتبع هدفه ليدمره أينما حل." },
  { id:1328, slug:"ar10-029", name:"شيطان الميغاسايبر", type:"monster", race:"fiend", gameDeck:true, attribute:"light", level:6, atk:2200, def:1200, desc:"إذا أردت لحصمك وحشان أو أكثر في ملعبه يمكنك استدعاؤه استدعاء خاصا من يدك للملعب." },
  { id:1329, slug:"ar10-030", name:"غيرفريد - الفارس الحديدي", type:"monster", race:"machine", gameDeck:true, attribute:"earth", level:4, atk:1800, def:1600, desc:"إذا جهزت هذا الوحش بورقة تجهيز تندمر الورقة." },
  { id:1330, slug:"ar10-031", name:"حاجز الحشرات", type:"trap", gameDeck:true, desc:"وحوش حصلك التي في ملعبه من نوع الحشرات لا تستطيع مهاجمة طالما هذه البطاقة في الملعب." },
  { id:1331, slug:"ar10-032", name:"وحش حكاية الحرب", type:"monster", race:"fiend", gameDeck:true, attribute:"dark", level:6, atk:2400, def:2150, desc:"فقط سيد السيف من نوع شيطان و وحوش نوع شيطان يمكنه الصعود في وجه هذا الوحش." },
  { id:1332, slug:"ar10-033", name:"الأمر الأمبريالي", type:"trap", gameDeck:true, desc:"طالما هذه الورقة بالملعب تلغي جميع تأثيرات أوراق السحر، ادفع 700 نقطة عن كل دور و إلا تدمر الورقة." },
  { id:1333, slug:"ar10-034", name:"فالكبريون المحارب المغناطيسي", type:"monster", race:"thunder", gameDeck:true, attribute:"earth", level:8, atk:3500, def:3850, desc:"يستدعى بعد التضحية بـ\"ألفا\" و \"بيتا\" و \"غاما\" من الملعب أو يدك. إذا كانا بالمعبر صحي بهذا الوحش لتجميعهم للملعب." },
  { id:1334, slug:"ar10-035", name:"الثعبان المشؤوم", type:"monster", race:"reptile", gameDeck:true, attribute:"water", level:2, atk:300, def:250, desc:"عندما يدمر هذا الوحش يعود إلى يدك في الدور المقبل." },
  { id:1335, slug:"ar10-036", name:"ريشة هاربي", type:"spell", gameDeck:true, desc:"دمر كل أوراق الفخ و السحر في ملعب خصمك." },
  { id:1336, slug:"ar10-037", name:"سباف أرض النجوم", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:2, atk:500, def:1200, desc:"هذا الجندي المحارب مجهز بسيف له قوى عاصفة." },
  { id:1337, slug:"ar10-038", name:"البطريق الجندي", type:"monster", race:"warrior", gameDeck:true, attribute:"water", level:2, atk:750, def:500, desc:"قلب: ارجع ورقتان من وحوش الملعب إلى يد صاحبهما." },
  { id:1338, slug:"ar10-039", name:"الدرع و السيف", type:"spell", gameDeck:true, desc:"بدل نقاط الهجوم و نقاط الدفاع لجميع الوحوش في الملعب، أي نقصان أو زيادة في النقاط تطبق على الضرر الحديث للوحوش المستهدفة بعد تفعيل هذه الورقة مباشرة." },
  { id:1339, slug:"ar10-040", name:"الأكباش الفضائية", type:"spell", gameDeck:true, desc:"ضع أربعة \"كبش فضائي\" في وضعية دفاع مكشوفين (أرضي، مستوى 1، هجوم 0، دفاع 0) لا بمكن التضحية بها." },
  { id:1340, slug:"ar10-041", name:"الدودة الشريرة", type:"monster", race:"insect", gameDeck:true, attribute:"earth", level:3, atk:1400, def:700, desc:"هذه الورقة مكشوفة بالملعب ترجع لبدك في الدور المقبل." },
  { id:1341, slug:"ar10-042", gameDeck:true, name:"نور المعارك", type:"monster", race:"warrior", attribute:"earth", level:4, atk:1700, def:1000, desc:"وحش بقوة مهولة بدمر أعداءه بضربة واحدة سريعة." },
  { id:1342, slug:"ar10-043", name:"القاضي", type:"monster", race:"warrior", gameDeck:true, attribute:"light", level:6, atk:2200, def:1500, desc:"هذا المحارب صاحب العضمي بقاتل حتى آخر رمق في حياته و لا يسلم نفسه أبدا." },
  { id:1343, slug:"ar10-044", name:"المحارب المنتقم", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:6, atk:2000, def:1600, desc:"وحش بتكون من أرواح المنتقمين الذين سقطوا في ساحة الحرب." },
  { id:1344, slug:"ar10-045", name:"جني المصباح الغامض", type:"monster", race:"fiend", gameDeck:true, attribute:"dark", level:4, atk:1800, def:1000, desc:"جني المصباح بخدم سيده الذي بدعمه." },
  { id:1345, slug:"ar10-046", name:"سيّد التنانين", type:"monster", race:"dragon", gameDeck:true, attribute:"dark", level:4, atk:1200, def:1100, desc:"جميع الوحوش من نوع شي تنانين تستدعها بالأوراق السحرية أو الفخاخ لو احتاج لو أمر آخر مادام هذا الوحش مكشوف في الملعب." },
  { id:1346, slug:"ar10-047", name:"مزمار نداء التنين", type:"spell", gameDeck:true, desc:"إذا كنت تملك \"سيّد التنانين\" في ملعبك مكشوفا قم باستدعاء تنين على الأكثر من بدك استدعاء خاصا." },
  { id:1347, slug:"ar10-048", name:"محرك الدمى الغامض", type:"monster", race:"machine", gameDeck:true, attribute:"dark", level:4, atk:1000, def:1500, desc:"ما دامت هذه الورقة في الملعب مكشوفة تزداد لك 500 نقطة عن كل استدعاء عادي توحش ما في الملعب." },
  { id:1348, slug:"ar10-049", name:"تحرير الروح", type:"spell", gameDeck:true, desc:"اخبر 5 أوراق من أوراق مقبرتك أو من أوراق مقبرة حصملك أو معا أو أخرجهم من اللعب." },
  { id:1349, slug:"ar10-050", name:"الرأفة الظريفة", type:"spell", gameDeck:true, desc:"اسحب ثلاث أوراق من مجموعتك و في المقابل ارم ورقتين من بدك إلى المقبرة." },
  { id:1350, slug:"ar10-051", name:"الجنية الغامضة", type:"monster", race:"fiend", gameDeck:true, attribute:"light", level:4, atk:800, def:2000, desc:"جنية خطيرة بنقصها الهجوم و لكن لديها دفاع خارق مدعم بقوة خارقة." },
  { id:1351, slug:"ar10-052", name:"العفريت المتوحش", type:"monster", race:"fiend", gameDeck:true, attribute:"dark", level:4, atk:1300, def:1400, desc:"شيطان صغير يربص في الظلام، بفعل فريسته تم بعض عليها." },
  { id:1352, slug:"ar10-053", name:"النسر المجنح حامي الحصن #1", type:"monster", race:"winged", gameDeck:true, attribute:"wind", level:4, atk:1400, def:1200, desc:"نس نجده في العادة بحرس قلاع الجبال، و معروف بهجومه وقت الانقضاض على الجنية الصعبة." },
  { id:1353, slug:"ar10-054", name:"عملاق القرنين", type:"monster", race:"fiend", gameDeck:true, attribute:"dark", level:6, atk:2500, def:1200, desc:"شيطان بقوة الظلام بربك أعداءه، هذا الوحش بطاحي بقوته الهائلة بس الوحوش الشيطانية." },
  { id:1354, slug:"ar10-055", name:"القندس المحارب", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:4, atk:1200, def:1500, desc:"هذا المخلوق بعوض فضى قامه بدفاع ممبزر جدا أثناء المعارك." },
  { id:1355, slug:"ar10-056", name:"ساحر الظلام", type:"monster", race:"spellcaster", gameDeck:true, attribute:"dark", level:7, atk:2500, def:2100, desc:"ساحر كبير فيما يخص الهجوم و الدفاع." },
  { id:1356, slug:"ar10-057", name:"كابا الفارس العنيف", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:7, atk:2300, def:2100, desc:"فارس ذو حصان بسبق الرياح، دوره في الحرب لا يستهان به." },
  { id:1357, slug:"ar10-058", name:"لعنة التنين", type:"monster", race:"dragon", gameDeck:true, attribute:"dark", level:5, atk:2000, def:1500, desc:"تنين شرير يستغل قوى الظلام لتنفيذ هجمة قوية." },
  { id:1358, slug:"ar10-059", name:"الحارس السلتي", type:"monster", race:"fiend", gameDeck:true, attribute:"earth", level:4, atk:1400, def:1200, desc:"هذا الجني تعلمه الجد للتحكم بالسيف بمكنه من التغلب على خصومه." },
  { id:1359, slug:"ar10-060", name:"مقبرة الماموت", type:"monster", race:"dinosaur", gameDeck:true, attribute:"earth", level:3, atk:1200, def:800, desc:"ماموت بحمي مقبرة أجداده و هو بدون رحمة تجاه كل من ببس القبور." },
  { id:1360, slug:"ar10-061", name:"القرش الأبيض", type:"monster", race:"fish", gameDeck:true, attribute:"water", level:4, atk:1600, def:800, desc:"قرش أبيض بملك أسنانا حادة جدا." },
  { id:1361, slug:"ar10-062", name:"الذئب الفضي", type:"monster", race:"beast", gameDeck:true, attribute:"earth", level:3, atk:1200, def:800, desc:"ذئب بلوح رائع لكنه سرس و عنيف في المعارك." },
  { id:1362, slug:"ar10-063", name:"الجدي العملاق الصخري", type:"monster", race:"rock", gameDeck:true, attribute:"earth", level:3, atk:1300, def:2000, desc:"ضربه من ها. جدي عملاق من الصخر المخلوق قادر على إنشاء زلزال في الأرض." },
  { id:1363, slug:"ar10-064", name:"التنين الزومبي", type:"monster", race:"dragon", gameDeck:true, attribute:"dark", level:3, atk:1600, def:0, desc:"تنين أعيد للحياة بفضل السحر. له زفير جارف." },
  { id:1364, slug:"ar10-065", name:"دوما ملاك الهدوء", type:"monster", race:"fairy", gameDeck:true, attribute:"dark", level:4, atk:1600, def:1400, desc:"هذه الملكة تتربع على عرش نهاية الوجود." },
  { id:1365, slug:"ar10-066", name:"أنساتسو", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:4, atk:1700, def:1200, desc:"محارب فتال و خفيف متخصص في الاغتيالات." },
  { id:1366, slug:"ar10-067", name:"الشبح الروحي", type:"monster", race:"zombie", gameDeck:true, attribute:"dark", level:4, atk:1400, def:1300, desc:"يظهر وسط دخان أسود، هذا المخلوق برأس قوة الظلام." },
  { id:1367, slug:"ar10-068", name:"المخلب", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:3, atk:1000, def:800, desc:"أيدي تطول و مخالب حادة مثل السكين و هو خصم قوي." },
  { id:1368, slug:"ar10-069", name:"البهلوان الغامض", type:"monster", race:"beast", gameDeck:true, attribute:"dark", level:4, atk:1500, def:1000, desc:"لا شيء بمكنه الوقوف في وجه الهجمة المجنونة لهذا المخلوق." },
  { id:1369, slug:"ar10-070", name:"سيف الدمار الأسود", type:"spell", gameDeck:true, desc:"الوحش الظلامي المجهز بهذه الورقة تزداد نقاط هجومه بـ400 نقطة و نقاط دفاعه بـ200 نقطة." },
  { id:1370, slug:"ar10-071", name:"كتاب الفنون الخفية", type:"spell", gameDeck:true, desc:"الوحش من نوع ساحر المجهز بهذه الورقة تزداد نقاط هجومه و دفاعه بـ300." },
  { id:1371, slug:"ar10-072", name:"النقب الأسود", type:"spell", gameDeck:true, desc:"دمر جميع الوحوش التي بالملعب بما فيها وحوشك." },
  { id:1372, slug:"ar10-073", name:"ديان كيتو الأستاذ المعالج", type:"spell", gameDeck:true, desc:"تزيد نقاط حياتك الأساسية 1000." },
  { id:1373, slug:"ar10-074", name:"العفريت القديم", type:"monster", race:"fiend", gameDeck:true, attribute:"light", level:4, atk:1450, def:1200, desc:"يقال أن هذا الفزم عاش أيام سعيدة، و يستخدم سلاح روحي ضد أعداله." },
  { id:1374, slug:"ar10-075", name:"الشبح السحري", type:"monster", race:"zombie", gameDeck:true, attribute:"dark", level:4, atk:1300, def:1400, desc:"هذا المخلوق برمي قدرا من السحر قبل أن بهاجم." },
  { id:1375, slug:"ar10-076", name:"الشق", type:"spell", gameDeck:true, desc:"دمر وحشا من أضعف الوحوش من ناحية الهجوم في ملعب خصمك." },
  { id:1376, slug:"ar10-077", name:"فخ الحفرة", type:"trap", gameDeck:true, desc:"إذا استدعى حصملك وحشا في وضعية الهجوم يتم تدميره بنفعيل هذه الورقة إذا كانت نقاط هجومه 1000 أو أكثر." },
  { id:1377, slug:"ar10-078", name:"هجمة الوحشين", type:"trap", gameDeck:true, desc:"اختر و دمر وحشين من ملعبك و وحشا من ملعب خصمك." },
  { id:1378, slug:"ar10-079", name:"مدمر الفخاخ", type:"spell", gameDeck:true, desc:"دمر ورقة سحر في ملعب حصمك و إن كانت مقلوبة تكشفها فإن كانت سحر تدمر و إن لم تكن كذلك ترجع لوضعيتها السابقة و معولها لا يفعل." },
  { id:1379, slug:"ar10-080", name:"ولادة الوحوش", type:"spell", gameDeck:true, desc:"اخبر وحشا من مقبرتك أو من مقبرة حصملك و صحه بالملعب في وضعية الهجوم أو الدفاع مكشوف." },
  { id:1380, slug:"ar10-081", name:"المدد", type:"trap", gameDeck:true, desc:"عندما تجهز وحشا بهذه الورقة تزداد نقاط هجومه بـ500 نقطة." },
  { id:1381, slug:"ar10-082", name:"محولة القلوب", type:"spell", gameDeck:true, desc:"اختر وحشا من وحوش حصمك مهما كانت وضعيته في الملعب و تحكم به حتى نهاية دورك." },
  { id:1382, slug:"ar10-083", name:"الصوفي الساحر", type:"monster", race:"spellcaster", gameDeck:true, attribute:"light", level:4, atk:1500, def:1200, desc:"قلب: اقلب كل الوحوش المقلوبة تم أرجعها لوضعيتها و لا يفعل أي تأثير." },
  { id:1383, slug:"ar10-084", name:"حائط الوهم", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:1000, def:1850, desc:"الوحش الذي بهاجمه ترجع إلى يد صاحبه، الأضرار الناتجة عن الهجوم تحسب بالطريقة العادية." },
  { id:1384, slug:"ar10-085", name:"نيو السياف الساحر", type:"monster", race:"spellcaster", gameDeck:true, attribute:"light", level:4, atk:1700, def:1000, desc:"رجال في اليمن و ساحر وفضلا عن هذا فهو خبير فنون القتال و بجيد استعمال السيف." },
  { id:1385, slug:"ar10-086", name:"بارون السيف الشيطاني", type:"monster", race:"fiend", gameDeck:true, attribute:"dark", level:4, atk:1550, def:800, desc:"أرستقراطي بتحكم بسيف ذو روح شيطانية تهاجم الضعفاء." },
  { id:1386, slug:"ar10-087", name:"أكل الكنوز", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:1600, def:1000, desc:"وحش متخفى في هيئة صندوق للكنوز دائم السبط بمواجهته للمعامر الطائش." },
  { id:1387, slug:"ar10-088", name:"الساحر المسجون", type:"monster", race:"spellcaster", gameDeck:true, attribute:"dark", level:4, atk:1450, def:1200, desc:"ساحر قديم بدم للظلام، و هو رئيس جمعية إبادة الحياة." },
  { id:1388, slug:"ar10-089", name:"الوصية الأخيرة", type:"trap", gameDeck:true, desc:"خلال هذا الدور، عندما برمي وحش من ملعبك للمقبرة، بمكنك أن تقوم باستدعاء وحش ذو هجوم 1500 نقطة أو أقل من مجموعتك." },
  { id:1389, slug:"ar10-090", name:"وابوكو", type:"trap", gameDeck:true, desc:"عند تفعيل هذه الورقة فإن كل ضرر ناتج عن هجمة من هجمات حصملك تصبح 0." },
  { id:1390, slug:"ar10-091", name:"تبادل الأرواح", type:"spell", gameDeck:true, desc:"صحي بوحش من وحوش حصملك بدلا من وحوشك. لا بمكنك الهجوم في هذا الدور." },
  { id:1391, slug:"ar10-092", name:"مدمرة الأوراق", type:"trap", gameDeck:true, desc:"بوجب على كلا اللاعبين رمي أوراق أيدهم في المقبرة و سحب نفس عدد أوراقهم التي رموها." },
  { id:1392, slug:"ar10-093", name:"سيد الفخاخ", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:1700, def:1200, desc:"قلب: دمر ورقة فخ بالملعب، اقلبها إن كانت مقلوبة، إذا كانت فخ دمرها و إن لم تكن ترجع لوضعيتها." },
  { id:1393, slug:"ar10-094", name:"الوعاء صائد التنانين", type:"trap", gameDeck:true, desc:"التنانين الموجودة بالملعب يتم إرجاعها إلى حالة الدفاع ما دامت هذه الورقة مفعلة." },
  { id:1394, slug:"ar10-095", name:"يامي", type:"spell", gameDeck:true, desc:"تزيد نقاط هجوم و دفاع كل الوحوش بالملعب من نوع شيطان و ساحر بـ200 نقطة و تنقص 200 نقطة من الوحوش من نوع جني." },
  { id:1395, slug:"ar10-096", name:"الحشرة اللاحمة", type:"monster", race:"insect", gameDeck:true, attribute:"earth", level:2, atk:450, def:600, desc:"قلب: دمر وحشا من وحوش حصمك بالملعب كهما كانت قوته و وضعيته." },
  { id:1396, slug:"ar10-097", name:"فخ الإنعكاس", type:"trap", gameDeck:true, desc:"كل الزيادات أو النقصان الملحقة بهجوم أو دفاع الوحوش يتم عكسها خلال الدور الذي تفعل فيه هذه الورقة." },
  { id:1397, slug:"ar10-098", name:"دمار الفخ", type:"spell", gameDeck:true, desc:"دمر ورقة فخ مكشوفة في الملعب." },
  { id:1398, slug:"ar10-099", name:"سور القصر", type:"trap", gameDeck:true, desc:"أصف لوحش نختاره 500 نقطة في الهجوم في الدور الذي تكون فيه هذه الورقة مفعلة." },
  { id:1399, slug:"ar10-100", name:"القربان الأسمى", type:"trap", gameDeck:true, desc:"بمكنك استدعاء وحش استدعاء عاديا أو وضع وحش وحش إضافي بعد دفع 500 نقطة أساسية لكل وحش." },
  { id:1400, slug:"ar11-001", name:"الجرذ العملاق", type:"monster", race:"zombie", gameDeck:true, attribute:"earth", level:4, atk:1400, def:1450, desc:"إذا ذهب للمقبرة أو هجوم اسدع وحشا أرضي عنده 1500 هجوم أو أقل من مجموعتك و ضعه في حالة هجوم." },
  { id:1401, slug:"ar11-002", name:"سنجو ذو الألف يد", type:"monster", race:"warrior", gameDeck:true, attribute:"light", level:4, atk:1400, def:1000, desc:"بعد استدعائه في الملعب، بمكنك أن تسحب وحش طقوسي من مجموعتك إلى أوراق يدك." },
  { id:1402, slug:"ar11-003", name:"سلحفاة الصحن الطائر", type:"monster", race:"reptile", gameDeck:true, attribute:"fire", level:4, atk:1400, def:1200, desc:"عندما يذهب للمقبرة اسدع وحشا ناري هجومه أقل أو يساوي 1500 من مجموعتك في الملعب في حالة هجوم." },
  { id:1403, slug:"ar11-004", name:"المهاجم البرقي", type:"monster", race:"thunder", gameDeck:true, attribute:"dark", level:4, atk:2000, def:2000, desc:"كلما كان في الملعب مكشوف يمص له 400 نقطة عن كل ورقة بملكها صاحبها." },
  { id:1404, slug:"ar11-005", name:"الحمار الوحشي الظلامي", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:1800, def:400, desc:"إذا كان هذا الوحش في مرحلة استبدال الوحيد تحت بتحكم بجدول لوصمعه الدفاع و لا بمكن يغير وضعيته في هذا الدور." },
  { id:1405, slug:"ar11-006", name:"الجرثومة العملاقة", type:"monster", race:"zombie", gameDeck:true, attribute:"dark", level:2, atk:1000, def:100, desc:"عندما يلقى في المقبرة بنبع هجوم بمكنك جلب اثناء من أعداله للملعب في هجوم مع ضرر 500 نقطة لخصملك." },
  { id:1406, slug:"ar11-007", name:"نيمبلي مومونجا", type:"monster", race:"zombie", gameDeck:true, attribute:"light", level:2, atk:1000, def:100, desc:"عندما يرمى إلى القبرة بعد الهجوم بربك 1000 نقطة و بمكنك من وضع وحشان صنه في وضعية الدفاع مقلوبين في الملعب." },
  { id:1407, slug:"ar11-008", name:"أليف الظلام", type:"monster", race:"zombie", gameDeck:true, attribute:"dark", level:2, atk:500, def:500, desc:"قلب: عندما يذهب للمقبرة بتلبى أنت و حصملك وحشا من المقبرة تختاره في دفاع مقلوب أو في هجوم مكشوف." },
  { id:1408, slug:"ar11-009", name:"الملاك الساطع", type:"monster", race:"fairy", gameDeck:true, attribute:"light", level:4, atk:1400, def:800, desc:"إذا ذهب للمقبرة بعد هجوم بمكنك جلب وحش ضوئي المعبود 1500 أو أقل من مجموعتك في الملعب." },
  { id:1409, slug:"ar11-010", name:"الخنزير الجندي", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:4, atk:2000, def:500, desc:"لا بمكن استدعاؤه إلا لحصملك وحشا في هجوم في الملعب بنقص هجوم و حصلك بـ1000 نقطة." },
  { id:1410, slug:"ar11-011", name:"الدب الأزرق", type:"monster", race:"beast", gameDeck:true, attribute:"earth", level:4, atk:1400, def:1000, desc:"عندما يذهب للمقبرة بعد هجوم بمكنك سحب وحش من نوع مائي بهجوم 1500 أو أقل من مجموعتك إلى الملعب في هجوم." },
  { id:1411, slug:"ar11-012", name:"كاماكيري الطائر #1", type:"monster", race:"winged", gameDeck:true, attribute:"wind", level:4, atk:1400, def:900, desc:"إذا ذهب للمقبرة بعد هجوم اسدع وحشا هوائي عنده 1500 هجوم أو أقل من مجموعتك في حالة هجوم." },
  { id:1412, slug:"ar11-013", name:"حرس الطقوس", type:"monster", race:"warrior", gameDeck:true, attribute:"light", level:3, atk:0, def:1850, desc:"طالما هذه الورقة مكشوفة بوجب عليك أن خصملك كشف يديكها." },
  { id:1413, slug:"ar11-014", name:"الطائر السريع", type:"monster", race:"winged", gameDeck:true, attribute:"wind", level:4, atk:1400, def:1000, desc:"عندما يرنل للملعب بمكنك سحب ورقة طقس سحرية من مجموعة بدك." },
  { id:1414, slug:"ar11-015", name:"الطماطم الغامضة", type:"monster", race:"zombie", gameDeck:true, attribute:"dark", level:4, atk:1400, def:1100, desc:"إذا أرسل من الملعب للمقبرة بعد هجوم اخبر وحشا ظلامه هجومه 1500 أو أقل من مجموعتك و صنه في وضعية هجوم." },
  { id:1415, slug:"ar11-016", name:"كوطوداما", type:"monster", race:"warrior", gameDeck:true, attribute:"light", level:3, atk:0, def:1600, desc:"طالما هذه الورقة مكشوفة بالملعب، الوحوش ذات نفس الاسم لا بمكنها أن تجتمع قيما بينها في الملعب." },
  { id:1416, slug:"ar11-017", name:"قوة كايا", type:"spell", gameDeck:true, desc:"يزيد من نقاط هجوم كل الوحوش بالملعب و التي من نوع أرض بـ500 و بنقص الدفاع بـ400 نقطة." },
  { id:1417, slug:"ar11-018", name:"أوميروكا", type:"spell", gameDeck:true, desc:"تزيد نقاط هجوم الوحوش من نوع ماء بـ500 نقطة و تنقص 400 نقطة في الدفاع." },
  { id:1418, slug:"ar11-019", name:"الدمج المدمر", type:"spell", gameDeck:true, desc:"تزيد نقاط هجوم كل الوحوش من نوع نار بـ500 نقطة و بنقصهم 400 نقطة في الدفاع." },
  { id:1419, slug:"ar11-020", name:"تيار الهواء المرتفع", type:"spell", gameDeck:true, desc:"تزيد هذه الورقة نقاط الهجوم لجميع الوحوش في الملعب من نوع الرياح بـ500 نقطة و في المقابل بنقص نقاط الدفاع بـ400 نقطة." },
  { id:1420, slug:"ar11-021", name:"البريق الساطع", type:"spell", gameDeck:true, desc:"يزيد لكل الوحوش من نوع ضباء 500 نقطة في الهجوم و بنقص 300 نقطة في الدفاع." },
  { id:1421, slug:"ar11-022", name:"بؤرة البلازما الغامضة", type:"spell", gameDeck:true, desc:"تزيد نقاط هجوم كل الوحوش من نوع ظلام بـ500 نقطة و تنقص 400 نقطة من دفاعهم." },
  { id:1422, slug:"ar11-023", name:"حامل السلام", type:"spell", gameDeck:true, desc:"ادفع 100 نقطة في كل دور من أدوارك و إلا تدمر هذه الورقة. كل الوحوش التي هجومها 1500 أو أكثر لا بمكنها الهجوم." },
  { id:1423, slug:"ar11-024", name:"التنين الثعبان الليلي", type:"monster", race:"dragon", gameDeck:true, attribute:"dark", level:7, atk:2350, def:2400, desc:"تنين خلق بروح فارس شرير." },
  { id:1424, slug:"ar11-025", name:"عاصفة إيطاكا", type:"trap", gameDeck:true, desc:"غير وضعية كل أوراق الوحوش المكشوفة في الملعب." },
  { id:1425, slug:"ar11-026", name:"الرائحة المضادة للسحر", type:"trap", gameDeck:true, desc:"طالما هذه الورقة بالملعب، أوراق السحر يتم وضعها في الملعب و لا بمكن تفعيلها قبل دور الخصم التالي." },
  { id:1426, slug:"ar11-027", name:"ألف سكين", type:"spell", gameDeck:true, desc:"تفعل لا إذا كان \"فارس الظلام\" في الملعب و مكشوف، عندما تفعل هذه الورقة بستطيع أن تدمر وحشا من وحوش حصملك في الملعب." },
  { id:1427, slug:"ar11-028", name:"حلقة الدمار", type:"trap", gameDeck:true, desc:"دمر وحشا مكشوفا و بنضرر كلا اللاعبين بضرر قدره مجموع نقاط هجوم الوحش المختار." },
  { id:1428, slug:"ar11-029", name:"حينزو", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:6, atk:2400, def:1500, desc:"طالما بكون في الملعب بطل معقول أي ورقه من نوع فخ." },
  { id:1429, slug:"ar11-030", name:"الغول كروطو الحديدي #2", type:"monster", race:"machine", gameDeck:true, attribute:"earth", level:6, atk:1900, def:2200, desc:"هذه الدمية الحديدية الميكانيكية لديها قوة هائلة جدا." },
  { id:1430, slug:"ar11-031", name:"حيدو ذو الرؤوس الثلاثة", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:1200, def:1400, desc:"هذا الوحش لديه ثلاث رؤوس وقوي جدا في المعارك." },
  { id:1431, slug:"ar11-032", name:"طفيلية باراسيت", type:"monster", race:"beast", gameDeck:true, attribute:"earth", level:2, atk:500, def:300, desc:"قلب: ضمها مع ورق حصملك و اخلطها. لما سحبها يصبح وحشا مكشوفا للعبة بقدرة 1000 نقطة و تصبح كل وحوشه من نوع حشرة." },
  { id:1432, slug:"ar11-033", name:"السبعة التامة", type:"spell", gameDeck:true, desc:"تجهر فقط وحش من نوع الآلة و تزيد إما نقاط الهجوم أو الدفاع بـ700 نقطة، لا تستطيع تغيير اختيارك طالما هذه الورقة في الملعب." },
  { id:1433, slug:"ar11-034", name:"سيف قوة الضوء", type:"trap", gameDeck:true, desc:"اخبر عشوائيا ورقة من يد حصمك، اجمع بها و ضعها خارج الملعب. خلال مرحلة حصملك الرابعة ترجع الورقة لبده." },
  { id:1434, slug:"ar11-035", name:"التدمير المتسلسل", type:"trap", gameDeck:true, desc:"عندما يستدعى وحش بهجوم 2000 نقطة أو أقل استدعاء عاديا، فلب أو خاص، فعليا تدمر كل الأوراق التي لها نفس اسم الوحش المستدعى في يده أو أوراقه." },
  { id:1435, slug:"ar11-036", name:"الختم الزمني", type:"trap", gameDeck:true, desc:"اجعل خصمك يفقد دور السحب المقبل." },
  { id:1436, slug:"ar11-037", name:"مدنس القبور", type:"trap", gameDeck:true, desc:"اخبر ورقة سحرية من مقبرة حصمك، حتى نهاية الدور، بمكنك استعمال الورقة و كأنك صاحبها. إذا قعلها بتلقى ضرر 2000 نقطة." },
  { id:1437, slug:"ar11-038", name:"هدية الجنية الغامضة", type:"trap", gameDeck:true, desc:"تزداد نقاط حياتك بـ300 نقطة لكل وحش موجود بالملعب." },
  { id:1438, slug:"ar11-039", name:"عين الحقيقة", type:"trap", gameDeck:true, desc:"طالما هذه الورقة مفعلة في الملعب على حصمك أن يكشف أوراق يده. تزيد نقاطه بـ1000 نقطة لكل دور إذا كان بملك ورقة سحرية في يده." },
  { id:1439, slug:"ar11-040", name:"الزوبعة الرملية", type:"trap", gameDeck:true, desc:"دمر ورقة سحر أو فخ من ملعب حصمك. بمكنك بعدها وضع ورقة سحر أو فخ في الملعب." },
  { id:1440, slug:"ar11-041", name:"نداء الممسوس", type:"trap", gameDeck:true, desc:"اخبر وحشا من مقبرتك و ضعه في الملعب في وضعية الهجوم مكشوف. إذا دمر أحدها بدمر الآخر." },
  { id:1441, slug:"ar11-042", name:"كتاب القوانين", type:"trap", gameDeck:true, desc:"تنازل عن دورك." },
  { id:1442, slug:"ar11-043", name:"الإهتزاز الأرضي", type:"trap", gameDeck:true, desc:"اختر نوعان من أوصاف الوحوش. حصملك بختار واحدا منهما. تدمر كل الوحوش المكشوفة بالملعب من نفس الوصف المختار." },
  { id:1443, slug:"ar11-044", name:"الرمح المسحور", type:"trap", gameDeck:true, desc:"عندما بهجم وحش من وحوش حصملك، أضف إلى نقاط حياتك الأساسية نقاط تساوي نقاط هجوم وحش حصملك." },
  { id:1444, slug:"ar11-045", name:"جدار المرآة", type:"trap", gameDeck:true, desc:"أنقص النصف من نقاط هجوم كل وحوش حصملك المهاجمة، ادفع 2000 نقطة خلال كل دور، إذا لم تدفع تدمر هذه الورقة." },
  { id:1445, slug:"ar11-046", name:"هبة الريح", type:"trap", gameDeck:true, desc:"بمكنك استعمال هذه الورقة عندما تدمر ورقة أو أوراق سحرية بأنبر ورقة. دمر ورقة سحر أو فخ في الملعب." },
  { id:1446, slug:"ar11-047", name:"الثلج القاهر", type:"trap", gameDeck:true, desc:"عندما تدمر ورقة أو أوراق فخ من أوراقك بالملعب بأنبر ورقة من أوراق حصملك. دمر ورقة فخ أو سحر بالملعب." },
  { id:1447, slug:"ar11-048", name:"الدرع الزجاجي", type:"trap", gameDeck:true, desc:"قتلها عندما تكون أحد الوحوش مجهز بأوراق تجهير، تلغي تأثيراتها كلها في دور تسعيلها." },
  { id:1448, slug:"ar11-049", name:"دمار العالم", type:"trap", gameDeck:true, desc:"الغ تفعيل ورقة ملعب سحرية خلال الدور الذي فعلت فيه." },
  { id:1449, slug:"ar11-050", name:"المجس الغامض", type:"trap", gameDeck:true, desc:"قعلها عندما تكون في الملعب ورقة أو أوراق فخ ذو تأثير مستمر و و أبطل مفعولها خلال الدور الذي فعل فيه هذه الورقة." },
  { id:1450, slug:"ar11-051", name:"منبع المعادن", type:"trap", gameDeck:true, desc:"عندما تكون ورقة سحر مستمر مفعلة، قعل هذه الورقة و أبطل مفعول أوراق الفخ المستمر خلال الدور الذي فعل فيه هذه الورقة." },
  { id:1451, slug:"ar11-052", name:"الطبيب الملائكي", type:"trap", gameDeck:true, desc:"قعلها عندما تنصرر نقاطك الأساسية، أضف 1000 نقطة لنقاط حياتك. بعدها أصف 500 نقطة عن كل ورقة \"الطبيب الملائكي\" في مقبرتك." },
  { id:1452, slug:"ar11-053", name:"التملّك", type:"trap", gameDeck:true, desc:"قعلها عندما بسحب حصملك ورقة في غير دور السحب، بعدها اسحب ورقتان من أوراق مجموعتك كلما سحب حصملك ورقه في غير دور السحب." },
  { id:1453, slug:"ar11-054", name:"المصادرة الإجبارية", type:"trap", gameDeck:true, desc:"قعلها عندما يستعى عن ورقه، بعدها كل مرة يستعى فيها عن ورقه، يكون حصملك مجبر هو أيضا أن برمى نفس عدد الأوراق التي رميت أنت من بدك." },
  { id:1454, slug:"ar11-055", name:"الجراحة الوراثية", type:"trap", gameDeck:true, desc:"اخبر نوعا من الوحوش. طالما هذه الورقة بالملعب، كل الوحوش المكشوفة تصبح من النوع الذي اخترته." },
  { id:1455, slug:"ar11-056", name:"قوانين القبيلة", type:"trap", gameDeck:true, desc:"اخبر نوع من الوحوش. الوحوش من هذا النوع لا بمكنها الهجوم. صحى بوحش من ملعك كل دور أو إلا دمرت هذه الورقة." },
  { id:1456, slug:"ar11-057", name:"جندي الإحتياط", type:"trap", gameDeck:true, desc:"بمكنك تفعيلها إذا كان لديك 5 وحوش بالمقبرة أو أكثر. بمكنك أخذ 3 وحوش عادية بهجوم 1500 نقطة أو أقل من القبرة و ضمهم لبدك." },
  { id:1457, slug:"ar11-058", name:"الفتنة الكبيرة", type:"trap", gameDeck:true, desc:"تفعل هذه الورقة عندما تقوم باستدعاء وحش من المقبرة، الوحش يبقى في وضعية الدفاع مقلوبة في حالة دفاع." },
  { id:1458, slug:"ar11-059", name:"وقف إطلاق النار", type:"trap", gameDeck:true, desc:"اقلب كل الوحوش المقلوبة. التأثيرات لا تفعل، بنصرر حصمك بـ500 نقطة لكل وحش ذو تأثير في الملعب." },
  { id:1459, slug:"ar11-060", name:"ضياء التدخل", type:"trap", gameDeck:true, desc:"أوراق الوحوش لا بمكن وضعها مقلوبة. الوحوش المستدعات في وضعية الدفاع مقلوبة توضع مكشوفة." },
  { id:1460, slug:"ar11-061", name:"احترام اللعب", type:"trap", gameDeck:true, desc:"في كل دور من أدوار الخصمين بوجب عليهما كشف أوراق أيديهما." },
  { id:1461, slug:"ar11-062", name:"القبعات السحرية", type:"trap", gameDeck:true, desc:"تفعل عند هجوم حصمك. اخبر ورقتان من ورقك بمسا و وحشين و حصلك بالملعب فقط الأوراق و ضعهم في الملعب مقلوب، الأوراق المختارة من تعبر كوحوش دفاع 0 و هجوم 0." },
  { id:1462, slug:"ar11-063", name:"سيد الإبادة", type:"spell", gameDeck:true, desc:"دمر ورقة وحش في الملعب مقلوب و أخرجها من اللعبة، إذا كان للوحش تأثير بدرج كل أوراق مجموعتك الخصمين المماثلة لهذا الوحش." },
  { id:1463, slug:"ar11-064", name:"سيد الإبادة", type:"spell", gameDeck:true, desc:"دمر ورقة سحر أو فخ مقلوبة و أخرجها من اللعبة، إذا كانت ورقة فخ، كل اللاعبين بنخلى عن كل الأوراق المماثلة لورقة الفخ التي دمرت." },
  { id:1464, slug:"ar11-065", name:"القبر الفارغ", type:"spell", gameDeck:true, desc:"أنت و حصمك اسدعنا وحسا واحد من المقبرة إلى الملعب مقلوب في وضعية الدفاع." },
  { id:1465, slug:"ar11-066", name:"الدفن المعجل", type:"spell", gameDeck:true, desc:"ادفع 800 نقطة. اخبر وحشا من المقبرة و استدعه في الملعب في وضعية الهجوم مكشوف. إذا دمرت هذه الورقة بدمر الوحش أيضا." },
  { id:1466, slug:"ar11-067", name:"التفتيش", type:"spell", gameDeck:true, desc:"خلال دور حصمك بمكنك رؤية ورقة واحدة من أوراق حصمك مع دفع 500 نقطة." },
  { id:1467, slug:"ar11-068", name:"الحظر", type:"spell", gameDeck:true, desc:"اخبر اسم ورقه. طالما هذه الورقة بالملعب الورقة المختارة لا بمكن لحصمك لعنها، الأوراق الموجودة بالملعب قبلا لا تتأثر." },
  { id:1468, slug:"ar11-069", name:"الوعاء الفخاري #2", type:"monster", race:"zombie", gameDeck:true, attribute:"earth", level:3, atk:800, def:700, desc:"قلب: أرمي و وحوش الملعب للمجموعات، باخذ كل واحد نفس عدد الوحوش الذي كان بنده، توضع الأوراق المسحوبة أعلى 3 أو أقل توضع بالمقبرة مقلوبة، الأخرى ترمى للمقبرة." },
  { id:1469, slug:"ar11-070", name:"بطل النيران", type:"monster", race:"warrior", gameDeck:true, attribute:"fire", level:5, atk:1900, def:1300, desc:"هذا المحارب بنصدى لكل الهجمات نرسه النارى." },
  { id:1470, slug:"ar11-071", name:"تنين النار ذو الرأسين", type:"monster", race:"dragon", gameDeck:true, attribute:"fire", level:6, atk:2200, def:1700, desc:"تحت تأثير الإنفجار الكبير، إندمج تنينان لبشكلا تنينا واحدا." , fusionMon:true},
  { id:1471, slug:"ar11-072", name:"جندي اللهب الأسود #1", type:"monster", race:"pyro", gameDeck:true, attribute:"fire", level:6, atk:1700, def:1150, desc:"من القوة الخاصة متخصص في المتحرات." },
  { id:1472, slug:"ar11-073", name:"سيد البراكين", type:"monster", race:"beast", gameDeck:true, attribute:"fire", level:6, atk:2100, def:1300, desc:"هذا المخلوق و رغم هذاءه العادبة إلا أنه بمنع سراج منقلب." },
  { id:1473, slug:"ar11-074", name:"جندي اللهب الأسود #2", type:"monster", race:"pyro", gameDeck:true, attribute:"fire", level:6, atk:1700, def:1100, desc:"هذا المحارب بلغى قوة لبس لها حد من قلب البركان." },
  { id:1474, slug:"ar11-075", name:"طفيلية العقل", type:"monster", race:"beast", gameDeck:true, attribute:"earth", level:1, atk:300, def:800, desc:"قلب: إذا هوجم و هو مقلوب لا بدمر، بتحول إلى ورقة سحرية بنده كل دور بمر بصمد نقاط هجوم الوحش المجهز بها." },
  { id:1475, slug:"ar11-076", name:"الصقر الخارق", type:"monster", race:"winged", gameDeck:true, attribute:"wind", level:4, atk:1400, def:1200, desc:"صقر لديه سرعة توازي سرعة الصوت." },
  { id:1476, slug:"ar11-077", name:"كيماكيري الطائر #2", type:"monster", race:"winged", gameDeck:true, attribute:"wind", level:4, atk:1500, def:800, desc:"هذا المخلوق بغتات أساسا على الحشرات." },
  { id:1477, slug:"ar11-078", name:"أخو هاربي", type:"monster", race:"winged", gameDeck:true, attribute:"wind", level:4, atk:1800, def:600, desc:"نظرا لمنبه الناقبتان و سرعة طبرانه بعد سيد السماء." },
  { id:1478, slug:"ar11-079", name:"السيف الصاروخي", type:"monster", race:"machine", gameDeck:true, attribute:"light", level:7, atk:2600, def:2300, desc:"بزداد هجوم هذا الوحش بـ500 نقطة عن كل وحش من نوع نس بلعبه حصملك و بمقبرته." },
  { id:1479, slug:"ar11-080", name:"مينيزور", type:"spell", gameDeck:true, desc:"قعلها عندما بدهب وحشك من الملعب للمقبرة. دمر وحشا من وحوش حصمك." },
  { id:1480, slug:"ar11-081", name:"الشيطان العميل", type:"trap", gameDeck:true, desc:"قعلها عندما تصبح نقاط حصمك الأساسية 3000 أو أقل. بصاب حصمك بضرر 500 نقطة عند كل دور من أدواره." },
  { id:1481, slug:"ar11-082", name:"المُقامرة", type:"trap", gameDeck:true, desc:"قعلها عندما بكون في بد حصمك 6 أوراق أو أكثر و في بدك أوراق أقل. حد عملك الأخير و اسحب أوراق حتى يصبح في بدك 5 أوراق، إذا خسرت بنخلى عن دورك القادم." },
  { id:1482, slug:"ar11-083", name:"تلقى ثم أهجم", type:"trap", gameDeck:true, desc:"قعلها عندما تلقى ضرر في نقاط حياتك، اخصم 700 نقطة أساسية من نقاط حصملك. ثم احصم 300 نقطة لكل ورقة فخ بنده الاسم موجودة في المقبرة." },
  { id:1483, slug:"ar11-084", name:"أمنيات رائعة", type:"trap", gameDeck:true, desc:"تزيد نقاطك الأساسية بمقدار 500 نقطة كلما دور من أدوارك." },
  { id:1484, slug:"ar11-085", name:"دعوة الهيكل", type:"trap", gameDeck:true, desc:"عن كل ورقه تذهب للمقبرة، بلقى صاحبها ضرر قدره 300 نقطة من نقاطه الأساسية." },
  { id:1485, slug:"ar11-086", name:"جرذ الهامستر", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:3, atk:900, def:600, desc:"عندما بدمر بستطيع إعادة الوحش نفسه مقلوب بشرط أن تكون لديك في مجموعتك." },
  { id:1486, slug:"ar11-087", name:"وطواط الظلام", type:"monster", race:"warrior", gameDeck:true, attribute:"wind", level:3, atk:1000, def:1000, desc:"هذه الوطاويط لها قدرة حسنة مفرطة في اكتشاف مواقع أعدائها." },
  { id:1487, slug:"ar11-088", name:"الدبابة أوني ت-34", type:"monster", race:"machine", gameDeck:true, attribute:"earth", level:4, atk:1400, def:1700, desc:"اخترعها شيطان لتتبع الأعداء و تدمرهم." },
  { id:1488, slug:"ar11-089", name:"السائق المحترف", type:"monster", race:"machine", gameDeck:true, attribute:"earth", level:4, atk:1600, def:1500, desc:"مركبة مدرعة لجميع الأراضي مسلحة بمدفع كبير." },
  { id:1489, slug:"ar11-090", name:"الأرض المحروقة", type:"spell", gameDeck:true, desc:"تدمر كل أوراق الملعب بالملعب، كما تنقص صاحبها 500 نقطة في كل دور من أدواره." },
  { id:1490, slug:"ar11-091", name:"موجة الجليد", type:"spell", gameDeck:true, desc:"هذه الورقة تفعل فقط في مرحلة الدور الأول حتى دورك في السحب. أنت و حصملك لا بمكنكما الهجوم، تفعل أو استعمال تأثير ورقة فخ أو سحر." },
  { id:1491, slug:"ar11-092", name:"تأثير النيزك الجني", type:"spell", gameDeck:true, desc:"إذا هجم وحشا و هو مجهز بهذه الورقة على وحس حصمك في وضعية الدفاع، نقاط دفاع هذا الوحش وحصملك بخصم الفرق من نقاط حياته الأساسية كناتج للهجوم." },
  { id:1492, slug:"ar11-093", name:"الإنتقال الأقصى", type:"spell", gameDeck:true, desc:"بضاعف هجوم كل وحس من نوع آله موجود بالملعب. عند نهاية الدور، كل الوحوش الطائرين بهذه الورقة بدمرون." },
  { id:1493, slug:"ar11-094", name:"مطر الرحمة", type:"spell", gameDeck:true, desc:"تزيد لكلا اللاعبين 1000 نقطة أساسيه." },
  { id:1494, slug:"ar11-095", name:"شفاء الوحش", type:"spell", gameDeck:true, desc:"أطف وحشا مقلبصك إلى أوراقك تم أطف أوراق بدك إلى أوراقها و اخلط ثم اسحب نفس عدد أوراقك التي كانت بدك، إذا نجح العملية اذا كنت تملك ورقة من أوراق حصمك." },
  { id:1495, slug:"ar11-096", name:"التبديل", type:"spell", gameDeck:true, desc:"عندما بحدد حصمك وحسا من عندك كهدف لورقة سحر أو فخ أو كهدف لهجوم بمكنك أن تغير الانتباه إلى وحش آخر." },
  { id:1496, slug:"ar11-097", name:"تقليد الحشرات", type:"spell", gameDeck:true, desc:"صحى بوحش من ملعك. اخبر من مجموعتك وحش ذو مستوى أعلى بدرجة واحدة من وحش التضحية، و استدعه على الملعب." },
  { id:1497, slug:"ar11-098", name:"النقب البَعدي", type:"spell", gameDeck:true, desc:"اخرج وحشا من اللعب حتى دورك القادم." },
  { id:1498, slug:"ar11-099", name:"الإنهيار", type:"spell", gameDeck:true, desc:"اختر مكانين من أمكنة وحوش حصملك للملعب و دمرهما. لا بمكن لحصمك استعمالها ما دامت هذه الورقة مفعلة في الملعب." },
  { id:1499, slug:"ar11-100", name:"التبديل السحري", type:"trap", gameDeck:true, desc:"لا تفعل هذه الورقة إلا عندما بلغى حصمك ورقة سحرية بمعكنك أن برمي ورقة سحرية من بدك لبطل مفعولها و لا تدمر ورقته." },
  { id:1500, slug:"ar12-001", name:"الطائر الأزرق المجنح", type:"monster", race:"winged", gameDeck:true, attribute:"wind", level:4, atk:1600, def:1200, desc:"هذا الطائر المحاط بلهب أزرق و شعر على شكل لاج بهر الناصرين." },
  { id:1501, slug:"ar12-002", name:"الفارس العضمي", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:7, atk:2650, def:2250, desc:"وحش دمج: \"الحكمة الملونة\" + \"العقل القديم\"." , fusionMon:true},
  { id:1502, slug:"ar12-003", name:"غارلن: ملك وحوش الأساطير", type:"monster", race:"winged", gameDeck:true, attribute:"earth", level:4, atk:1500, def:1200, desc:"هذا الوحش بنقل بسرعته بحت بها للنسر أنه مجرد وهم." },
  { id:1503, slug:"ar12-004", name:"الفيل المزين", type:"monster", race:"beast", gameDeck:true, attribute:"earth", level:6, atk:2400, def:2000, desc:"هذا الوحش حد نقيل بحبت قدماه بحدث رجه في الأرض." },
  { id:1504, slug:"ar12-005", name:"التنين المدفعي", type:"monster", race:"dragon", gameDeck:true, attribute:"dark", level:7, atk:2600, def:2200, desc:"ارم ثلاث نقديات بعد اختبار أحد الزمر. إذا كان النوع على الأقل رمزين من اختبارك بدمر الوحش المستهدف." },
  { id:1505, slug:"ar12-006", name:"الحكم المهيب", type:"trap", gameDeck:true, desc:"عندما بفعل حصملك ورقة سحر، فخ أو يستدعى وحشا، ادفع نصف نقاط حياتك الأساسية من أجل إبطال حركة حصملك و تدمير ورقته." },
  { id:1506, slug:"ar12-007", name:"منشوش السحر", type:"trap", gameDeck:true, desc:"ارمي ورقة من يدك و أبطل تفعيل ورقة سحر و دمرها." },
  { id:1507, slug:"ar12-008", name:"أدوات قاطع الطريق", type:"trap", gameDeck:true, desc:"ادفع 1000 نقطة أساسية من أجل إبطال مفعول ورقة فخ و تدميرها." },
  { id:1508, slug:"ar12-009", name:"بوق الجنة", type:"trap", gameDeck:true, desc:"ضحي بوحش من ملعبك من أجل إبطال استدعاء وحش خصملك و تدميره." },
  { id:1509, slug:"ar12-010", name:"سيف الأغوار", type:"spell", gameDeck:true, desc:"الوحش المجهز بهذه الورقة تزداد هجومه و دفاعه بـ500 نقطة. عندما ترمى إلى المقبرة أرجعها إلى أعلى مجموعتك." },
  { id:1510, slug:"ar12-011", name:"صد الهجوم", type:"spell", gameDeck:true, desc:"اختر وحشا واحدا من وحوش حصملك المكشوفة في الملعب و حوله إلى حالة الدفاع." },
  { id:1511, slug:"ar12-012", name:"الفتاة الحزينة", type:"monster", race:"zombie", gameDeck:true, attribute:"light", level:2, atk:0, def:100, desc:"قلب: عندما تذهب هذه الورقة إلى المقبرة بعطل هجوم بتوقف هذه المرحلة حالا." },
  { id:1512, slug:"ar12-013", name:"الشيطان روبن", type:"trap", gameDeck:true, desc:"كلما الحق أحد و حوسك أضرار هجوم لحصمك، اخبر ورقة من أوراق بده و ارمها للمقبرة." },
  { id:1513, slug:"ar12-014", name:"عدوى المكروبات", type:"spell", gameDeck:true, desc:"تجهر فقط الوحوش الآلية، تنقص 300 نقطة من هجوم الوحش في كل دور من أدوار صاحب الورقة السحرية." },
  { id:1514, slug:"ar12-015", name:"جرعة الشلّل", type:"spell", gameDeck:true, desc:"لا تجهز سوى الوحوش الآلية. الوحش المجهز بها لا بمكنه الهجوم." },
  { id:1515, slug:"ar12-016", name:"قوة المرآة", type:"trap", gameDeck:true, desc:"عندما بهجم حصمك فعلها لدمر كل وحوش حصمك التي في وضعية الهجوم مكشوفة." },
  { id:1516, slug:"ar12-017", name:"الخاتم المغناطيسي", type:"spell", gameDeck:true, desc:"هذه الورقة تجهز وحشين من وحوشك في الملعب، تنقص حالة الهجوم و الدفاع بـ500 بالإضافة إلى أن وحوش وحشي حصمك لا تستطيع الهجوم إلا على هذا الوحش." },
  { id:1517, slug:"ar12-018", name:"تشارك الألم", type:"spell", gameDeck:true, desc:"ضحي بوحش من الملعب. خصمك يختار وحش من ملعبه و يضحي به." },
  { id:1518, slug:"ar12-019", name:"المشروب المقوّي", type:"spell", gameDeck:true, desc:"الوحش المحدد بهذه الورقة تزيد نقاط هجومه و دفاعه بـ700 نقطة، تنقص نقاط هجومه بـ200 في كل مرحلة من مراحل الاستعداد." },
  { id:1519, slug:"ar12-020", name:"الإعصار المدمّر", type:"spell", gameDeck:true, desc:"دمر كل أوراق السحر و الفخ بالملعب." },
  { id:1520, slug:"ar12-021", name:"تنين الألفية", type:"monster", race:"dragon", gameDeck:true, attribute:"light", level:7, atk:2400, def:2000, desc:"وحش دمج: \"ساحر الزمن\" + \"صغر التنين\"." , fusionMon:true},
  { id:1521, slug:"ar12-022", name:"التنين التون أزرق العينين", type:"monster", race:"dragon", gameDeck:true, attribute:"light", level:9, atk:3000, def:2500, desc:"يستدعى إذا كان \"عالم التون\" مفعل. لا بمكنك الهجوم في دور استدعائه. ادفع 500 نقطة عند كل فخمته، بمكنك مهاجمة الخصم النقاط الأساسية مباشرة إذا لم يكن لديه وحش بنون." },
  { id:1522, slug:"ar12-023", name:"البطريق الفارس", type:"monster", race:"warrior", gameDeck:true, attribute:"water", level:3, atk:900, def:800, desc:"إذا ذهب مباشرة من مجموعتك إلى المقبرة فبمكنك ارجاع كل أوراق فخك بالمقبرة لمجموعتك و معهم هذا الوحش." },
  { id:1523, slug:"ar12-024", name:"فأس الياس", type:"spell", gameDeck:true, desc:"الوحش المجهز بهذه الورقة تزيد نقاطه الهجومية بـ1000. بعدما تدمر هذه الورقة و قد كانت موجودة في الملعب صحي بوحش من ملعك و أرجعها إلى أعلى مجموعتك." },
  { id:1524, slug:"ar12-025", name:"القلادة السوداء", type:"spell", gameDeck:true, desc:"الوحش المجهز بها تزيد نقاط هجومه بـ500 نقطة، عندما ترمى من الملعب للمقبرة، بنصرر حصمك بـ500 نقطة من نقاطه الأساسية." },
  { id:1525, slug:"ar12-026", name:"فرن الضياء", type:"spell", gameDeck:true, desc:"الوحش المجهز بها تزيد دفاعه 800 نقطة، إذا أرسلت من الملعب للمقبرة، ادفع 500 نقطة من بطاقتك الأساسية و ارجعها لأعلى أوراق مجموعتك." },
  { id:1526, slug:"ar12-027", name:"صاحبة الأنف الشريرة", type:"spell", gameDeck:true, desc:"الوحش المجهز بها يزداد نقاط هجومه بـ700 نقطة، عندما ترمى من الملعب للمقبرة، بمكنك ارجاعها للأعلى مجموعتك بدفع 500 نقطة أساسية." },
  { id:1527, slug:"ar12-028", name:"الحلقة الأسرة", type:"trap", gameDeck:true, desc:"فعلها على وحش بصبحه حصمك بالملعب مكشوف. هذا الوحش لا بمكنه الهجوم و لا تغير وضعيته، إذا دمر الوحش بدمر، و إذا ضحى بالوحش لا تدمر." },
  { id:1528, slug:"ar12-029", name:"السمكة المعدنية", type:"monster", race:"fish", gameDeck:true, attribute:"water", level:6, atk:1600, def:1900, desc:"سمكة معدنية مجهزة بشفرات حادة قاتلة." },
  { id:1529, slug:"ar12-030", name:"الكوبرا الكهربائية", type:"monster", race:"zombie", gameDeck:true, attribute:"light", level:3, atk:800, def:900, desc:"عندما ترمى هذه الورقة مباشرة من بدك إلى المقبرة بمكنك سحب ورقتين من مجموعتك." },
  { id:1530, slug:"ar12-031", name:"ملكة الطيور", type:"monster", race:"warrior", gameDeck:true, attribute:"wind", level:5, atk:1200, def:2000, desc:"هذا الوحش بهاجم أعدائه بمنقاره الضخم." },
  { id:1531, slug:"ar12-032", name:"الأميبا", type:"monster", race:"beast", gameDeck:true, attribute:"water", level:1, atk:300, def:350, desc:"قلب: عندما بتحول من ملعك إلى ملعب حصمك يخسر من نقاط حياته 2000 نقطة." },
  { id:1532, slug:"ar12-033", name:"الطاووس", type:"monster", race:"winged", gameDeck:true, attribute:"wind", level:4, atk:1700, def:1500, desc:"هذا الطاووس الخطير و العملاق بستعمل ريشه كالبال." },
  { id:1533, slug:"ar12-034", name:"ماها-فايلو", type:"monster", race:"beast", gameDeck:true, attribute:"light", level:4, atk:1550, def:1400, desc:"يزداد هجوم هذا الوحش 500 نقطة عن كل ورقة تجهزه." },
  { id:1534, slug:"ar12-035", name:"حارس غرفة العرش", type:"monster", race:"machine", gameDeck:true, attribute:"light", level:4, atk:1650, def:1600, desc:"هذا الآلي مسلح بصواريخ للتتبع صنع لحماية غرفة العرش." },
  { id:1535, slug:"ar12-036", name:"مطلاق البراكين", type:"monster", race:"warrior", gameDeck:true, attribute:"fire", level:4, atk:1600, def:1500, desc:"حتى في المياه بيقى هذا الجبار متوهجا." },
  { id:1536, slug:"ar12-037", name:"مينار", type:"monster", race:"zombie", gameDeck:true, attribute:"dark", level:3, atk:850, def:750, desc:"عندما ترمى من الملعب للمقبرة بمكنك تجهير ورقة في حصملك بنقص حمه 1000 نقطة من حياته الأساسية." },
  { id:1537, slug:"ar12-038", name:"غربغل", type:"monster", race:"beast", gameDeck:true, attribute:"earth", level:1, atk:350, def:300, desc:"عندما تكون هذه البطاقة معلوبة في حالة هجوم و تسبب ضرر إذا أصبح حصملك حابئل 3000 نقطة." },
  { id:1538, slug:"ar12-039", name:"ثيون #2", type:"monster", race:"pyro", gameDeck:true, attribute:"fire", level:4, atk:1700, def:1900, desc:"هذا النسر الأحمر بقذف من قمة كرات من لهب ثم بتحول إلى بحر من النار." },
  { id:1539, slug:"ar12-040", name:"قديم الغابة العميقة", type:"monster", race:"plant", gameDeck:true, attribute:"earth", level:6, atk:1800, def:1900, desc:"هذا المخلوق بأحد صورة الماعز لكنه في الحقيقة سحر الغابه." },
  { id:1540, slug:"ar12-041", name:"ساحرة الظلام", type:"monster", race:"spellcaster", gameDeck:true, attribute:"light", level:4, atk:1800, def:1700, desc:"هذا المخلوق الخرافي الذي بعش في الأعوار بصرع أعدائه برمحه." },
  { id:1541, slug:"ar12-042", name:"نشرة الطقس", type:"monster", race:"warrior", gameDeck:true, attribute:"water", level:2, atk:950, def:1500, desc:"قلب: دمر \"سيوق الصوت الكامية\" و بستسلم من مرحلة الهجوم خلال هذا الدور و المعبل إذا تم تفعيل هذا التأثير في دور الخصم." },
  { id:1542, slug:"ar12-043", name:"الحلزون الميكانيكي", type:"monster", race:"machine", gameDeck:true, attribute:"earth", level:3, atk:800, def:1000, desc:"بالرغم من أنه ميكانيكي، لا يزال هذا الحلزون بطيء." },
  { id:1543, slug:"ar12-044", name:"السلحفات العملاقة أكلة النيران", type:"monster", race:"warrior", gameDeck:true, attribute:"water", level:5, atk:1400, def:1800, desc:"هذه السلحفات التي داخل قوقعة تتغذى على النار." },
  { id:1544, slug:"ar12-045", name:"الحيوان السائل", type:"monster", race:"aqua", gameDeck:true, attribute:"water", level:3, atk:950, def:800, desc:"هذا الشيء الحي تقريبا سائل و بعش عادة في وسط مائي." },
  { id:1545, slug:"ar12-046", name:"هيرو ظل الكشاف", type:"monster", race:"zombie", gameDeck:true, attribute:"dark", level:1, atk:650, def:500, desc:"قلب: اسحب 3 أوراق و ارمي للمقبرة كل الأوراق السحرية الموجودة بينهم." },
  { id:1546, slug:"ar12-047", name:"حبوحين رافع المد", type:"monster", race:"fish", gameDeck:true, attribute:"water", level:4, atk:1650, def:1300, desc:"هذا الإنسان-الحوت محارب دكي حدا معروف بهجمانه التي لا بمكن تجنبها." },
  { id:1547, slug:"ar12-048", name:"سارقة العرش", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:1350, def:1700, desc:"قلب: اخبر وحشا من وحوش حصملك و استدله بهذا الوحش لا تعمل هذا التأثير أثناء مرحلة الهجوم." },
  { id:1548, slug:"ar12-049", name:"كرو ويتنايل", type:"monster", race:"aqua", gameDeck:true, attribute:"dark", level:4, atk:1650, def:1600, desc:"بهاجم من السماء بذيله الذي بشبه السوط." },
  { id:1549, slug:"ar12-050", name:"ماكنة النقود", type:"monster", race:"machine", gameDeck:true, attribute:"earth", level:7, atk:2000, def:2300, desc:"بقال أن قدرات هذه الآلة تتغير حسب النائج." },
  { id:1550, slug:"ar12-051", name:"المنسحب", type:"monster", race:"spellcaster", gameDeck:true, attribute:"dark", level:2, atk:0, def:0, desc:"باخذ هجوم/طقوسي/ساحر، اخذ هجوم و دفاع و نس و وحوس حصمك بالملعب. هذا التأثير بستمر طالما فعلت إذا هاجمه وحش و علبه، بدمر الوحش المهاجم." },
  { id:1551, slug:"ar12-052", name:"فتاة القوس الحمراء", type:"monster", race:"fairy", gameDeck:true, attribute:"water", level:4, atk:1400, def:1500, desc:"هذه الحورية البحرية الرامية تختبئ في صدفة وتجتمي إلى أن تجد الفرصة لمهاجمته." },
  { id:1552, slug:"ar12-053", name:"خادم حفار القبور", type:"spell", gameDeck:true, desc:"كلما هجم خصمك بوحش إلا و ترمى ورقة من أعلى أوراق مجموعته للمقبرة." },
  { id:1553, slug:"ar12-054", name:"لعنة الشيطان", type:"spell", gameDeck:true, desc:"اقلب وضعيات كل الوحوش بالملعب. هذه الوضعيات لا بمكن تغييرها في دور تفعيل هذه الورقة عادما بأنبر ورقة سحر، فخ أو وحش." },
  { id:1554, slug:"ar12-055", name:"ترقية الشيطان", type:"spell", gameDeck:true, desc:"اسحب ورقة من مجموعتك. نقاط حياة خصمك تزداد بـ1000 نقطة." },
  { id:1555, slug:"ar12-056", name:"رسم المرور", type:"spell", gameDeck:true, desc:"طالما هذه الورقة مفعلة في الملعب أنت و حصملك لا بمكنكما الهجوم إلا بعد دفع 500 نقطة لكل هجمة من هجمات وحش و حصمك من الوحوش." },
  { id:1556, slug:"ar12-057", name:"المصير النهائي", type:"spell", gameDeck:true, desc:"تخلص من 5 أوراق بدك و دمر جميع الأوراق التي بالملعب." },
  { id:1557, slug:"ar12-058", name:"السرقة الخاطفة", type:"spell", gameDeck:true, desc:"تحكم في وحش من وحوش حصملك المكشوفة بالملعب. بنقى حصملك 1000 نقطة كل دور." },
  { id:1558, slug:"ar12-059", name:"جوقة الملاذ", type:"spell", gameDeck:true, desc:"تزيد هذه الورقة نقاط الدفاع لجميع الوحوش في الملعب بحالة الدفاع بـ500 نقطة." },
  { id:1559, slug:"ar12-060", name:"المصادرة", type:"spell", gameDeck:true, desc:"ادفع 1000 نقطة لترى أوراق بد حصمك. و اختر واحدة و أرسلها للمقبرة." },
  { id:1560, slug:"ar12-061", name:"الثاني المنسكع", type:"spell", gameDeck:true, desc:"ادفع 1000 نقطة. و اخبر عشوائيا ورقة من بد حصملك و ارمها للمقبرة. و بدوره حصملك علبه أن بختار ورقة من بده و برميها للمقبرة." },
  { id:1561, slug:"ar12-062", name:"نهج الظلام", type:"spell", gameDeck:true, desc:"ارم ورقتين من بدك،تم اخبر وحسا واحدا في الملعب و اقلبه معكوسا، ولكن لا بتغير موقع معركته." },
  { id:1562, slug:"ar12-063", name:"مرآة الجنيات", type:"trap", gameDeck:true, desc:"اعكس تأثير ورقة خصمك السحرية و اختر وحشا كهدف جديد لهذه الورقة." },
  { id:1563, slug:"ar12-064", name:"الخياط المتردد", type:"spell", gameDeck:true, desc:"اختر ورقة تجهيز و حوّلها إلى ورقة أخرى." },
  { id:1564, slug:"ar12-065", name:"الإندفاع المتهور", type:"spell", gameDeck:true, desc:"تزيد هذه الورقة نقاط الهجوم لأي وحش في الملعب بـ700 نقطة لدور واحد." },
  { id:1565, slug:"ar12-066", name:"الحارس الموثوق منه", type:"spell", gameDeck:true, desc:"يزيد من نقط دفاع وحش خلال الدور الذي تفعل فيه فقط." },
  { id:1566, slug:"ar12-067", name:"الحارس العنيد", type:"spell", gameDeck:true, desc:"القِ نظرة على أوراق بد خصمك و اختر ورقة و أرجعها إلى مجموعة أوراقه." },
  { id:1567, slug:"ar12-068", name:"القوة المتسلسلة", type:"spell", gameDeck:true, desc:"لكل ورقة توضع بالملعب. كلاكما بدفع 500 نقطة طالما هذه الورقه بالملعب مكشوفه." },
  { id:1568, slug:"ar12-069", name:"باطن الاعصار القضائي", type:"spell", gameDeck:true, desc:"دمر ورقة سحر أو فخ موجودة في الملعب." },
  { id:1569, slug:"ar12-070", name:"الزوبعة العملاقة", type:"spell", gameDeck:true, desc:"هذه الورقة تعيد جميع أوراق الفخ و السحر التي بالملعب بما فيها أوراق الخصم إلى بد صاحبها." },
  { id:1570, slug:"ar12-071", name:"الإختيار المؤلم", type:"spell", gameDeck:true, desc:"اخبر خمس أوراق من مجموعتك و اكشفهم لحصمك بختار منهم ورقة واحدة تضاف إلى بدك أما الباقي فبذهب إلى المقبرة." },
  { id:1571, slug:"ar12-072", name:"أنياب الثعبان", type:"trap", gameDeck:true, desc:"أنقص نقاط دفاع وحش تختاره بمقدار 500 نقطة في الدور الذي تفعل فيه هذه الورقة." },
  { id:1572, slug:"ar12-073", name:"طقس الوهم الأسود", type:"spell", gameDeck:true, desc:"هذه الورقة بتستعمل لاستدعاء \"المنبو\" استدعاء طقوس عليك أيضا التضحية بطقوس مستوياتها تساوي 1 أو أكثر." },
  { id:1573, slug:"ar12-074", name:"أوكتوبيرسر", type:"monster", race:"fish", gameDeck:true, attribute:"water", level:4, atk:1600, def:1400, desc:"هذا المخلوق الغريب له رأس سمكي و أرجل أخطبوطية و بهاجم أعداله بالرماح." },
  { id:1574, slug:"ar12-075", name:"نفسية كابا", type:"monster", race:"warrior", gameDeck:true, attribute:"water", level:2, atk:400, def:1000, desc:"وحش برماني مع كنبر من الطاقات التي بحميه من هجمات الأعداء." },
  { id:1575, slug:"ar12-076", name:"قرن وحيد القرن", type:"spell", gameDeck:true, desc:"الوحش المجهز بهذه الورقة تزداد نقاط هجومه بـ700 نقطة. و عندما ترسل للمقبرة، نعود إلى أعلى أوراقك." },
  { id:1576, slug:"ar12-077", name:"جدار المتاهة", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:5, atk:0, def:3000, desc:"هذا الجدار هو متاهة بدون مخرج محرج بالنسبة للأعداء." },
  { id:1577, slug:"ar12-078", name:"ظل الحائط", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:7, atk:1600, def:3000, desc:"لا يستدعى إلا من مجموعتك، و بعد التضحية في الملعب بـ\"حائط المتاهة\" مجهز بـ\"المتاهة السحرية\"." },
  { id:1578, slug:"ar12-079", name:"الذبلان الطويلان النوّام #2", type:"monster", race:"warrior", gameDeck:true, attribute:"water", level:2, atk:850, def:700, desc:"هذا الحيوان البرماني بستعمل ذبله كالسوط." },
  { id:1579, slug:"ar12-080", name:"غول الكهف الصخري", type:"monster", race:"rock", gameDeck:true, attribute:"earth", level:4, atk:1600, def:1500, desc:"مخلوق ضخم مكون من الصخور." },
  { id:1580, slug:"ar12-081", name:"المتاهة السحرية", type:"spell", gameDeck:true, desc:"جهز بها \"حائط المتاهة\". إذا صحبت بـ\"حائط المتاهة\" بمكنك استدعاء \"ظل الحائط\" من مجموعتك." },
  { id:1581, slug:"ar12-082", name:"الراحة الأبدية", type:"spell", gameDeck:true, desc:"دمر كل الوحوش المجهزة بأوراق التجهيز." },
  { id:1582, slug:"ar12-083", name:"التحول الأقصى", type:"spell", gameDeck:true, desc:"إذا كانت نقاطه الأساسية أقل من نقاط حصمك، الوحش المجهر الأصلي للوحش المجهز نقده الورقة بساعها. و إذا كانت نقاطه أكبر من نقاط حصمك، الهجوم بنقص بالنصف." },
  { id:1583, slug:"ar12-084", name:"الرقصة الإفتتاحية", type:"spell", gameDeck:true, desc:"تفعل لاستدعاء ورقة الطقوس \"انجازات السيف\". عليك التضحية بوحوش لها مستوى 6 أو أكثر من الملعب أو من بدك." },
  { id:1584, slug:"ar12-085", name:"وصفة الهمبرغر", type:"spell", gameDeck:true, ritualFor:"ar12-090", desc:"تفعل لاستدعاء وحش الطقوس \"البورغر الجائع\". عليك التضحية بالوحوش ذات المستوى 6 أو أكثر من ملعك أو من بدك." },
  { id:1585, slug:"ar12-086", name:"منزل الشريط اللاصق", type:"trap", gameDeck:true, desc:"إذا قام حصمك باستدعاء عادي أو عن قلب لوحش دفاعه 500 نقطة أو أقل. بدمر هذا الوحش." },
  { id:1586, slug:"ar12-087", name:"الفخ المفترس", type:"trap", gameDeck:true, desc:"إذا استدعى حصمك استدعاء عاديا أو عن قلب لوحش هجومه 500 أو أقل، بدمر هذا الوحش." },
  { id:1587, slug:"ar12-088", name:"قسم السلحفاة", type:"spell", gameDeck:true, ritualFor:"ar12-091", desc:"تفعل لاستدعاء وحش الطقوس \"السلطعون-السلحفاة\". عليك التضحية بوحوش ذات مستوى 8 أو أكثر من الملعب أو بدك." },
  { id:1588, slug:"ar12-089", name:"انجازات السيف", type:"monster", race:"spellcaster", gameDeck:true, attribute:"light", level:6, atk:1950, def:1850, desc:"يستدعى بالورقة السحرية \"الرقصة الإفتتاحية\". عليك التضحية بوحوش مستواها 6 أو أكثر من الملعب أو من بدك." },
  { id:1589, slug:"ar12-090", name:"البورغر الجائع", type:"monster", race:"spellcaster", gameDeck:true, attribute:"earth", level:6, atk:2000, def:1850, ritual:true, ritualSpellName:"وصفة الهمبرغر", desc:"يستدعى بالورقة السحرية \"وصفة الهمبرغر\". عليك التضحية بوحوش مستواها 6 أو أكثر من الملعب أو من بدك." },
  { id:1590, slug:"ar12-091", name:"السلطعون-السلحفاة", type:"monster", race:"reptile", gameDeck:true, attribute:"water", level:8, atk:2550, def:2500, ritual:true, ritualSpellName:"قسم السلحفاة", desc:"يستدعى فقط بورقة الطقوس السحرية \"قسم السلحفاة\". يجب عليك التضحية بوحوش ذات مستواها 8 أو أكثر من بدك أو من الملعب." },
  { id:1591, slug:"ar12-092", name:"ريو-ران", type:"monster", race:"winged", gameDeck:true, attribute:"fire", level:6, atk:2200, def:2600, desc:"هذا النسر الصغير الشرس بختبئ في بيضة مما بوهم بعدم خطورته." },
  { id:1592, slug:"ar12-093", name:"مانكا ريو-ران", type:"monster", race:"warrior", gameDeck:true, attribute:"fire", level:6, atk:2200, def:2600, desc:"يستدعى إذا كان \"عالم التون\" مفعل. لا بمكنك الهجوم في دور استدعائه. ادفع 500 نقطة عند كل فخمته. بمكنك مهاجمة حصمك مباشرة إذا لم يكن لديه وحش بنون." },
  { id:1593, slug:"ar12-094", name:"عروسة بحر التون", type:"monster", race:"warrior", gameDeck:true, attribute:"water", level:4, atk:1400, def:1500, desc:"يستدعى إذا كان ورقة \"عالم التون\" مفعلة. لا بمكنك الهجوم في دور استدعائه. ادفع 500 نقطة لكن بهذه بمكنك مهاجمة النقاط الأساسية مباشرة إذا لم يكن لحصمك وحش بنون بالملعب." },
  { id:1594, slug:"ar12-095", name:"عملاق القرنين تون", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:6, atk:2500, def:1200, desc:"يستدعى بوجود \"عالم الرسوم المتحركة\" في الملعب. لا يهجم في دور استدعائه. ادفع 500 نقطة لكل فخمته. أصبح مباشرة على نقاط الخصم إذا لم يكن لحصمك وحش بنون بملعبه." },
  { id:1595, slug:"ar12-096", name:"الوحش المدمر", type:"monster", race:"warrior", gameDeck:true, attribute:"fire", level:2, atk:200, def:1000, desc:"عند قلبه صحي بـ كلاء فترة لمستعداد و دمر كل وحوشك كي بخصص نفسه طاقة و وحوشك من نقاط حصمك مباشرة. باستثناء هذا الوحش." },
  { id:1596, slug:"ar12-097", name:"هيوزانريو", type:"monster", race:"dragon", gameDeck:true, attribute:"light", level:7, atk:2100, def:2800, desc:"تنين اللالماس الذي بيرق بألف بريق." },
  { id:1597, slug:"ar12-098", name:"عالم الرسوم المتحركة", type:"spell", gameDeck:true, desc:"ادفع 1000 نقطة من نقاطك الأساسية لتفعل هذه الورقة." },
  { id:1598, slug:"ar12-099", name:"الجرة السيبيرية", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:3, atk:900, def:900, desc:"قلب: دمر وحوش الملعب، قبتها الناتجة و أوراق من محموعتهم و مجموعتي و تستدعى كل وحوش المستوى 4 على الأقل." },
  { id:1599, slug:"ar12-100", name:"مطارد الظوء", type:"monster", race:"zombie", gameDeck:true, attribute:"light", level:3, atk:100, def:2000, desc:"ماداميت مكشوفة بالملعب كل ورقه تذهب للمقبرة تخرج من اللعب." },
