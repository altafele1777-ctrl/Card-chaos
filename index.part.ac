  { id:1121, slug:"ar8-021", name:"نيموريكو", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:3, atk:800, def:700, desc:"مخلوق رضع بسيطر على روح النوم ويلقي بأعدائه في نوم أبدي." },
