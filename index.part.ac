function showResultFace(state){
  let opp=(typeof G!=='undefined'&&G.opponent)||G_oppKey||'yugi';
  let face=document.getElementById('result-face');
  let img=document.getElementById('result-face-img');
  let quote=document.getElementById('result-quote');
  if(!face||!img||!quote)return;
  let key=resolveFaceKey(opp,state);
  if(!key){face.style.display='none';return;}
  img.src=OPP_FACES[key];
  let pool=(OPP_COMMENTS[opp]&&OPP_COMMENTS[opp][state])||[''];
  quote.textContent=pool[Math.floor(Math.random()*pool.length)];
  let ov=document.getElementById('result-ov');
  if(state==='win'){
    ov.style.setProperty('--rf-color','#ffd54a');
    ov.style.setProperty('--rf-glow','rgba(255,180,40,.7)');
    ov.style.setProperty('--rf-bg','rgba(70,55,8,.95)');
  } else {
    ov.style.setProperty('--rf-color','#8a8a99');
    ov.style.setProperty('--rf-glow','rgba(120,120,150,.6)');
    ov.style.setProperty('--rf-bg','rgba(30,30,40,.95)');
  }
}

// ===================== UI HELPERS =====================
let msgT;function showMsg(txt,dur=1500){let el=document.getElementById('dmsg');el.textContent=txt;el.classList.add('show');clearTimeout(msgT);msgT=setTimeout(()=>el.classList.remove('show'),dur);}
function oppName(){return (typeof G!=='undefined'&&G.opponent&&OPPONENTS[G.opponent])?OPPONENTS[G.opponent].name.split(' ')[0]:'يوغي';}
function showTurnBanner(who){let b=document.getElementById('turn-banner');if(!b)return;b.className='turn-banner '+(who==='player'?'you':'foe');b.textContent=who==='player'?'⭐ دورك!':'🔮 دور '+oppName();void b.offsetWidth;b.classList.add('show');setTimeout(()=>b.classList.remove('show'),1700);}
function updateTurnGlow(){let p=document.getElementById('plp-row'),e=document.getElementById('elp-row');if(p)p.classList.toggle('active-turn',G.turn==='player');if(e)e.classList.toggle('active-turn',G.turn==='enemy');}
// ضرر المعركة المركزي — يحترم Waboku (يمنع كل ضرر المعركة هذا الدور)
function dealBattleDmg(who,amount){
  if(G.wabokuActive){return;} // Waboku يمنع كل ضرر المعركة
  if(who==='p'){G.playerLP-=amount;} else {G.enemyLP-=amount;}
  showDmg(amount, who==='p');
  // محرّك تأثيرات الوحوش عند إلحاق ضرر قتالي: صاحب الضرر هو الطرف المعاكس للمتلقّي
  if(typeof AR_MON_DAMAGE!=='undefined'){
    let dealer=who==='p'?'e':'p';
    let df=dealer==='p'?G.pField:G.eField;
    df.m.forEach(x=>{ if(x&&!x.faceDown&&AR_MON_DAMAGE[cardById(x.id).slug]){ try{ AR_MON_DAMAGE[cardById(x.id).slug](dealer,amount); }catch(e){} } });
  }
  // [جديد] ضربة قاضية مركزية: تعمل أيضاً عند القتال على الوحوش
  if((who==='p'&&G.playerLP<=0)||(who==='e'&&G.enemyLP<=0)){
    setTimeout(koSequence,120);
  }
}
function showDmg(n,isP){
  vibrate(isP?[40,30,60]:[30]);
  let body=document.body;body.classList.add('shake');setTimeout(()=>body.classList.remove('shake'),350);
  let el=document.createElement('div');el.className='dmg-num';el.textContent='-'+n;
  el.style.color=isP?'#ff3300':'#ffcc00';
  // [جديد] الأرقام الكبيرة أوضح وأكبر
  let big=n>=2000;
  if(big){el.style.fontSize='38px';el.classList.add('dmg-big');}
  else if(n>=1000){el.style.fontSize='32px';}
  el.style.left=(isP?window.innerWidth*.25:window.innerWidth*.75)+'px';
  el.style.top=(isP?window.innerHeight*.7:window.innerHeight*.3)+'px';
  document.body.appendChild(el);setTimeout(()=>el.remove(),1500);
  if(big)camShake(true);
}

function showDetail(card,handIdx=-1){
  let ov=document.getElementById('det-ov');
  document.getElementById('det-name').textContent=card.name;
  let lvl=card.type==='monster'?('مونستر / '+(card.attribute||'')+' / مستوى '+card.level+(card.level>=5?' (تضحية)':'')):card.type==='spell'?'تعويذة سحرية':'فخ';
  document.getElementById('det-type').textContent=lvl;
  document.getElementById('det-img').innerHTML='<img src="'+cardImg(card)+'" alt="'+card.name+'">';
  document.getElementById('det-stats').innerHTML=card.type==='monster'?('<div class="sbox atk">ATK '+card.atk+'</div><div class="sbox def">DEF '+card.def+'</div>'):'';
  document.getElementById('det-desc').textContent=card.desc;
  let acts=document.getElementById('det-acts');acts.innerHTML='';
  if(handIdx>=0&&G.turn==='player'&&(G.phase==='main1'||G.phase==='main2')){let b=document.createElement('button');b.className='det-btn';b.textContent=card.type==='monster'?'⚔ استدعاء':'✨ لعب';b.onclick=()=>{closeDet();selCard(handIdx);showMsg('اضغط على منطقة فارغة',1800);};acts.appendChild(b);}
  let cb=document.createElement('button');cb.className='det-btn cls';cb.textContent='✕ إغلاق';cb.onclick=closeDet;acts.appendChild(cb);
  ov.classList.add('vis');
}
function closeDet(e){if(!e||e.target===document.getElementById('det-ov'))document.getElementById('det-ov').classList.remove('vis');}

// ===================== CARD ZOOM (double-tap) =====================
// Arabic explanations for cards with active mechanical effects
const EFFECT_NOTES={
  'dark-magician-girl':'⚡ يكسب +300 هجوم عن كل "Dark Magician" في أي مقبرة.',
  'buster-blader':'⚡ يكسب +500 هجوم عن كل تنين يسيطر عليه الخصم.',
  'archfiend-of-gilfer':'⚡ عند إرساله للمقبرة: ينقص هجوم مونستر للخصم بمقدار 500.',
  'witch-of-the-black-forest':'⚡ عند إرساله للمقبرة: تضيف ليدك مونستراً بدفاع ≤1500 من سطحك.',
  'magician-of-faith':'⚡ عند القلب لأعلى: استرجع تعويذة من مقبرتك إلى يدك.',
  'kuriboh':'⚡ تخلّص منه من يدك لإلغاء ضرر المعركة بالكامل.',
  'kings-knight':'⚡ إذا كان "Queen\'s Knight" بالساحة عند استدعائه: استدعِ "Jack\'s Knight" خاصةً.',
  'book-of-secret-arts':'⚡ تجهيز لساحر: +300 هجوم/دفاع.',
  'magic-formula':'⚡ تجهيز لـ Dark Magician: +700 هجوم.',
};
function showZoom(card){
  if(!card)return;
  document.getElementById('zoom-card').innerHTML='<img src="'+cardImg(card)+'" alt="'+card.name+'">';
  document.getElementById('zoom-name').textContent=card.name;
  document.getElementById('zoom-type').textContent=card.type==='monster'?('مونستر / '+(card.attribute||'')+' / مستوى '+card.level+(card.level>=5?' (تضحية)':'')):card.type==='spell'?'تعويذة سحرية':'فخ';
  document.getElementById('zoom-stats').innerHTML=card.type==='monster'?('<div class="sbox atk">ATK '+card.atk+'</div><div class="sbox def">DEF '+card.def+'</div>'):'';
  let note=EFFECT_NOTES[card.slug];
  document.getElementById('zoom-desc').innerHTML=(card.desc||'')+(note?('<br><span style="color:#7dff7d;font-weight:700">'+note+'</span>'):'');
  document.getElementById('zoom-ov').classList.add('vis');
}
function closeZoom(e){if(!e||e.target===document.getElementById('zoom-ov'))document.getElementById('zoom-ov').classList.remove('vis');}

// ===================== GRAVEYARD =====================
function showGrave(who){
  let g=who==='p'?G.pGrave:G.eGrave;
  document.getElementById('grave-title').textContent=(who==='p'?'مقبرتك':'مقبرة يوغي')+' ('+g.length+')';
  let grid=document.getElementById('grave-grid');grid.innerHTML='';
  if(!g.length){grid.innerHTML='<div class="grave-empty">المقبرة فارغة</div>';}
  else{
    // Show most recent first
    [...g].reverse().forEach(id=>{
      let card=cardById(id);let div=document.createElement('div');div.className='grid-card';
      div.innerHTML='<img src="'+cardImg(card)+'" alt="'+card.name+'">';
      div.onclick=()=>showZoom(card);
      grid.appendChild(div);
    });
  }
  document.getElementById('grave-ov').classList.add('vis');
}


let deckTab='mine';
function showDeckBuilder(){deckTab='mine';showScreen('deck-screen');setDeckTab('mine');}

function setDeckTab(tab){
  deckTab=tab;
  document.getElementById('tab-mine').classList.toggle('active',tab==='mine');
  document.getElementById('tab-all').classList.toggle('active',tab==='all');
  // شريط أزرار +الكل/−الكل يظهر فقط في تبويب مجموعتي
  let bar=document.querySelector('#deck-screen .db-bar');
  if(bar)bar.style.display=tab==='mine'?'':'none';
  if(tab==='mine')renderDeckBuilder();
  else renderAllCards();
  sfx('flip');
}

function dbCardEl(card,inDeck){
  let wrap=document.createElement('div');wrap.className='dbcard';
  let gc=document.createElement('div');gc.className='grid-card';
  gc.innerHTML='<img src="'+cardImg(card)+'" alt="'+card.name+'">';
  gc.onclick=()=>showZoom(card);
  wrap.appendChild(gc);
  let btn=document.createElement('button');
  if(inDeck){btn.className='mv-btn remove';btn.textContent='✕ إخراج';btn.onclick=()=>moveCard(card.id,true);}
  else{btn.className='mv-btn add';btn.textContent='+ إضافة';btn.onclick=()=>moveCard(card.id,false);}
  wrap.appendChild(btn);
  return wrap;
}

// بطاقة في تبويب "كل الأوراق" — عرض فقط، لا يمكن أخذها للمجموعة
function allCardEl(card){
  let wrap=document.createElement('div');wrap.className='dbcard locked';
  let gc=document.createElement('div');gc.className='grid-card';
  gc.innerHTML='<img src="'+cardImg(card)+'" alt="'+card.name+'">';
  gc.onclick=()=>showZoom(card);
  wrap.appendChild(gc);
  let tag=document.createElement('div');tag.className='lock-tag';tag.textContent='🔒 خاصة باللعبة';
  wrap.appendChild(tag);
  return wrap;
}

// تبويب "كل الأوراق": يعرض جميع بطاقات اللعبة كاملةً (للعرض فقط)
function renderAllCards(){
  let el=document.getElementById('deck-content');el.innerHTML='';
  let note=document.createElement('div');note.className='db-locked-note';
  note.innerHTML='📚 هنا كل أوراق اللعبة كاملةً — هذه البطاقات خاصة باللعبة وللعرض فقط، لا يمكن إضافتها إلى مجموعتك.';
  el.appendChild(note);
  // ترتيب: وحوش ثم تعويذات ثم أفخاخ
  let groups=[
    ['⚔ الوحوش','monster'],
    ['✨ التعويذات','spell'],
    ['🪤 الأفخاخ','trap'],
  ];
  let total=CARDS.length;
  document.getElementById('db-count').textContent='إجمالي أوراق اللعبة: '+total;
  groups.forEach(([title,t])=>{
    let cards=CARDS.filter(c=>c.type===t);
    if(!cards.length)return;
    let head=document.createElement('div');head.className='db-grouptitle all';
    head.textContent=title+' ('+cards.length+')';el.appendChild(head);
    let grid=document.createElement('div');grid.className='card-grid';
    cards.forEach(c=>grid.appendChild(allCardEl(c)));
    el.appendChild(grid);
  });
}

function renderDeckBuilder(){
  let el=document.getElementById('deck-content');el.innerHTML='';
  let ex=loadExcluded();
  let owned=loadOwned();
  // بطاقات كايبا لا تظهر في مجموعة اللاعب نهائياً
  let pool=CARDS.filter(c=>!c.kaiba&&!c.joeyDeck&&!c.gameDeck);
  // أضف البطاقات المربوحة (المملوكة) إلى المخزون المتاح، حتى لو كانت gameDeck
  let poolIds=new Set(pool.map(c=>c.id));
  owned.forEach(id=>{ if(!poolIds.has(id)){ let c=cardById(id); if(c&&!c.kaiba&&!c.joeyDeck&&!c.noDeck){ pool.push(c); poolIds.add(id); } } });
  let inCards=pool.filter(c=>!ex.includes(c.id));
  let outCards=pool.filter(c=>ex.includes(c.id));
  // ترتيب: الوحوش أولاً (الأقوى→الأضعف حسب المستوى ثم الهجوم)، ثم السحر، ثم الفخ
  function deckSort(a,b){
    let order={monster:0,spell:1,trap:2};
    let oa=order[a.type]!==undefined?order[a.type]:3, ob=order[b.type]!==undefined?order[b.type]:3;
    if(oa!==ob) return oa-ob;
    if(a.type==='monster'){
      if((b.level||0)!==(a.level||0)) return (b.level||0)-(a.level||0);
      return (b.atk||0)-(a.atk||0);
    }
    return 0;
  }
  inCards.sort(deckSort);
  outCards.sort(deckSort);
  // counter
  let ownableTotal=CARDS.filter(c=>!c.kaiba&&!c.joeyDeck).length;
  let ownedUnique=0; try{ let uniq={}; loadOwned().forEach(id=>{uniq[id]=1;}); ownedUnique=Object.keys(uniq).length; }catch(e){}
  document.getElementById('db-count').innerHTML='داخل المجموعة: '+inCards.length+' / '+pool.length+'<br><span style="font-size:11px;color:#ffd97a">🏆 جمعت '+ownedUnique+' من '+ownableTotal+' ورقة</span>';

  function addGroup(parent,titleHtml,cls,cards,inDeck){
    let t=document.createElement('div');t.className='db-grouptitle '+cls;t.innerHTML=titleHtml;parent.appendChild(t);
    if(!cards.length){let e=document.createElement('div');e.className='db-empty';e.textContent='— لا توجد بطاقات —';parent.appendChild(e);return;}
    let grid=document.createElement('div');grid.className='card-grid';
    cards.forEach(c=>grid.appendChild(dbCardEl(c,inDeck)));
    parent.appendChild(grid);
  }

  // IN DECK section
  let inSec=document.createElement('div');inSec.className='dbsec-in';
  addGroup(inSec,'✅ داخل المجموعة ('+inCards.length+')','in',inCards,true);
  el.appendChild(inSec);
  // OUT section
  let outSec=document.createElement('div');outSec.className='dbsec-out';
  addGroup(outSec,'🚫 خارج المجموعة ('+outCards.length+')','out',outCards,false);
  el.appendChild(outSec);
}

function moveCard(id,removing){
  let ex=loadExcluded();
  if(removing){
    // don't allow removing last card overall
    if(CARDS.length-ex.length<=1){showMsg('لازم تترك بطاقة واحدة على الأقل!',1800);return;}
    if(!ex.includes(id))ex.push(id);
  } else {
    ex=ex.filter(x=>x!==id);
  }
  saveExcluded(ex);
  sfx('flip');
  renderDeckBuilder();
}

function dbAddAll(){saveExcluded([]);sfx('flip');renderDeckBuilder();showMsg('تمت إضافة كل البطاقات ✅',1500);}
function dbRemoveAll(){
  // keep at least 1 of each type so deck is playable
  let keep=[];
  ['monster','spell','trap'].forEach(t=>{let c=CARDS.find(x=>x.type===t&&!x.ritual&&!x.ritualFor);if(c)keep.push(c.id);});
  let ex=CARDS.map(c=>c.id).filter(id=>!keep.includes(id));
  saveExcluded(ex);sfx('flip');renderDeckBuilder();showMsg('تم إبقاء الحد الأدنى فقط',1800);
}

function showHelp(){document.getElementById('help-ov').classList.add('vis');}

window.addEventListener('load',()=>{renderMenuStats();
  // توليد جزيئات ذهبية متطايرة في القائمة
  (function(){let box=document.getElementById('menu-embers');if(!box)return;
    for(let i=0;i<18;i++){let e=document.createElement('i');
      e.style.left=(Math.random()*100)+'%';
      let d=6+Math.random()*7;
      e.style.animationDuration=d+'s';
      e.style.animationDelay=(-Math.random()*d)+'s';
      let s=2+Math.random()*2.5;
      e.style.width=e.style.height=s+'px';
      box.appendChild(e);}
  })();
  // شاشة التحميل: شريط تقدّم، ولا تختفي إلا بعد جاهزية الصفحة فعلاً (مهم للملف الكبير على الموبايل)
  (function(){
    let bar=document.getElementById('loading-bar'), pct=document.getElementById('loading-pct'), txt=document.getElementById('loading-text');
    let ov=document.getElementById('loading-ov');
    let p=0, ready=false;
    let tick=setInterval(()=>{
      let cap=ready?100:90;
      let speed=ready?8:(p<60?2.5:0.8);
      p=Math.min(cap,p+speed);
      if(bar)bar.style.width=p+'%';
      if(pct)pct.textContent=Math.floor(p)+'%';
      if(txt&&p>50&&!ready)txt.textContent='تحميل البطاقات...';
      if(p>=100){
        clearInterval(tick);
        if(txt)txt.textContent='جاهز!';
        setTimeout(()=>{ if(ov){ov.style.opacity='0';setTimeout(()=>ov.style.display='none',500);} },250);
      }
    },60);
    let markReady=()=>{ ready=true; };
    if(document.readyState==='complete') setTimeout(markReady,400);
    else window.addEventListener('load',()=>setTimeout(markReady,400));
    setTimeout(markReady,12000); // أمان
  })();
  // صوت نقر لطيف على كل أزرار القائمة
  document.querySelectorAll('.menu-btn,.back-btn,.db-tab,.diff-btn').forEach(b=>{
    b.addEventListener('click',()=>{ if(SETTINGS.sfxOn){initAudio();sfx('click');} });
  });
});
let lastTap=0;document.addEventListener('touchend',e=>{let n=Date.now();if(n-lastTap<300)e.preventDefault();lastTap=n;},{passive:false});

</script>
