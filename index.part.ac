  { id:1054, slug:"ar7-054", name:"أشليد ذو أربعة وجوه", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:1500, def:1200, desc:"هذا الوحش لديه أربعة أقنعة مخلفة لأربع هجمات مخلفة." },
  { id:1055, slug:"ar7-055", name:"نيفيا الغريب", type:"monster", race:"beast", gameDeck:true, attribute:"dark", level:4, atk:2000, def:0, desc:"يستدعى بطريقة الغلب، وإلا يدمر إذا استدعى استدعاء عادية، نقص نقاط هجومه بـ200 نقطة لكل وحش في ملعب خصمك." },
  { id:1056, slug:"ar7-056", name:"المختار", type:"spell", gameDeck:true, desc:"اختر ورقتين ليستا وحوش ووحش، بختار خصمك واحدة، إن كانت وحش بستدعى وترسل الباقي للمقبرة، وإن لم تكن تذهب الثلاث للمقبرة." },
  { id:1057, slug:"ar7-057", name:"قناع الضعف", type:"trap", gameDeck:true, desc:"بنقص 700 نقطة من نقاط وحش خصمك المهاجم حتى نهاية الدور." },
  { id:1058, slug:"ar7-058", name:"لعنة الوحش المقنع", type:"spell", gameDeck:true, ritualFor:"ar7-044", desc:"تستخدم للإستدعاء الطقوسي لـ الوحش المُقنّع، وجب أن تقدم كنصحية الوحوش ذات المستوى 8 أو أكثر من الملعب أو بدك." },
  { id:1059, slug:"ar7-059", name:"قناع الإزالة", type:"spell", gameDeck:true, desc:"اختر ورقة سحرية في ملعب خصمك مكشوفة فتنحمل ضرر 500 نقطة في كل دور، وإذا دمرت تدمر هذه الورقة أيضاً." },
  { id:1060, slug:"ar7-060", name:"قناع المنع", type:"trap", gameDeck:true, desc:"كيفما كان الظروف، لا بمكن إنجاز أي تضحية." },
  { id:1061, slug:"ar7-061", name:"قناع الملعون", type:"spell", gameDeck:true, desc:"الوحش المجهز بهذه الورقة لا بمكنه الهجوم كما بلقى صاحبه ضرر 500 نقطة في كل دور." },
  { id:1062, slug:"ar7-062", name:"قناع الوحشية", type:"spell", gameDeck:true, desc:"بريد للوحش المجهر بها 1000 نقطة هجومية وتنقص 1000 نقطة دفاعه، كما يجب عليك التضحية بـ1000 نقطة أساسية في كل دور وإلا تدمر." },
  { id:1063, slug:"ar7-063", gameDeck:true, name:"عودة المنبوذ", type:"spell", desc:"ارم ورقة من يدك للمقبرة، ثم أعد أحد وحوشك التي أرسلت إلى المقبرة في نهاية هذا الدور." },
  { id:1064, slug:"ar7-064", name:"السيف الصاعق", type:"spell", gameDeck:true, desc:"هذه الورقة تجهر فقط الوحش من نوع محارب، بريد من نقاط هجومه 800 نقطة وتنقص 500 نقطة من هجوم كل الوحوش من نوع ماء." },
  { id:1065, slug:"ar7-065", name:"جدار العاصفة", type:"trap", gameDeck:true, desc:"لا تُفعل إلا عندما تكون ورقة الملعب المائي مفعل، طالما الملعب المائي مفعل أي ضرر لنقاطك الأساسية يصبح 0، إذا دمر الملعب تدمر هذه الورقة." },
  { id:1066, slug:"ar7-066", name:"عُلبة الجنّيات", type:"trap", gameDeck:true, desc:"عندما يقوم خصمك بهجوم، إرم نقدية بعد اختيار الوجه أو الظهر، إذا ربحت ينقص هجوم الوحش المهاجم، في كل دور إدفع 500 نقطة وإلا دمرت." },
  { id:1067, slug:"ar7-067", name:"ولاء السيل", type:"trap", gameDeck:true, desc:"لا تُفعل هذه الورقة إلا عندما يستدعى وحش بأي طريقه، تدمر وحوش الملعب كلها." },
  { id:1068, slug:"ar7-068", name:"صانع الفقاعات", type:"spell", gameDeck:true, desc:"استدع نقدية المزهرية في ملعبك استدعاء خاص، طالما هذه الورقة في الملعب لا بمكنك استدعاء أي وحش بأي طريقه." },
  { id:1069, slug:"ar7-069", name:"بطاقات بلا حدود", type:"spell", gameDeck:true, desc:"بعد تنشيط هذه البطاقة بمكنك إمتلاك مانشاء من الأوراق طالما هذه البطاقة في الملعب." },
  { id:1070, slug:"ar7-070", name:"مُتلقّي الصّدمات", type:"trap", gameDeck:true, desc:"عندما يهجم خصمك على أحد وحوشك مكشوف في الملعب، بمكنك جعله هدف لهجوم وحش خصمك." },
  { id:1071, slug:"ar7-071", name:"العودة الآمنة", type:"spell", desc:"عند استرجاع وحش من مقبرتك إلى ملعبك، بمكنك سحب ورقة طالما هذه البطاقة في الملعب." },
  { id:1072, slug:"ar7-072", name:"سيدة النمور", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:4, atk:1400, def:1300, desc:"إذا كان مكشوفاً صحي به كي تضع أحد وحوشك المدمرة في هذا الدور في أعلى أوراق مجموعتك." },
  { id:1073, slug:"ar7-073", name:"الأمازونية العدوانية", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:4, atk:2000, def:1000, desc:"صحي بوحش من ملعبك خلال كل مرحلة استعداد أو دمّر هذه الورقة." },
  { id:1074, slug:"ar7-074", name:"الأمازونيّة الرامية", type:"monster", race:"beast", gameDeck:true, attribute:"earth", level:4, atk:1400, def:1000, desc:"بمكنك أن تصب حصمك بضرر قدره 1200 نقطة أساسية بالتضحية بوحشين من ملعبك." },
  { id:1075, slug:"ar7-075", name:"الحارس القرمزي", type:"monster", race:"warrior", gameDeck:true, attribute:"fire", level:4, atk:1500, def:1200, desc:"إذا كانت مقلوبة صحي بها وضع أحد وحوشك المدمرة في هذا الدور مع أوراق مجموعتك تحت." },
  { id:1076, slug:"ar7-076", name:"أميرة النيران", type:"monster", race:"beast", gameDeck:true, attribute:"fire", level:4, atk:1300, def:1500, desc:"إذا كان في الدفاع مكشوف تخصم 500 نقطة أساسية لخصمك كلما زادت نقاط حياتك." },
  { id:1077, slug:"ar7-077", name:"سيدة المهاجم من اللهب", type:"monster", race:"pyro", gameDeck:true, attribute:"fire", level:4, atk:1500, def:1000, desc:"أخرج 3 أوراق من مجموعتك من اللعبة كي تنقص لخصمك 800 نقطة." },
  { id:1078, slug:"ar7-078", name:"الساحرة الناريّة", type:"monster", race:"spellcaster", gameDeck:true, attribute:"fire", level:4, atk:1000, def:1500, desc:"اسحب ورقتين عشوائياً من أوراق مجموعتك وأخرجهم من اللعبة، وبنكد حصمك ضرر قدره 800 نقطة." },
  { id:1079, slug:"ar7-079", name:"روح الجليد", type:"monster", race:"beast", gameDeck:true, attribute:"wind", level:4, atk:0, def:1800, desc:"طالما هذه الورقة في الملعب في حالة هجوم تريح 1000 نقطة في كل مرحلة من مراحل الإستعداد." },
