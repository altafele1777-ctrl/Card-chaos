// ===================== BIG SHIELD GARDNA =====================
// إذا هوجم Big Shield Gardna وهو بوضع الدفاع ونجا، يتحوّل تلقائياً لوضع الهجوم
// بعد الهجمة، ولا يمكن إرجاعه للدفاع إلا بعد مرور دور كامل لصاحبه.
function bigShieldFlip(who,idx,slot,card){
  if(!slot||!card||card.slug!=='big-shield-gardna')return;
  if(slot.pos!=='def'||slot.faceDown)return;
  slot.pos='atk';
  slot.bsgLocked=true; // ممنوع تحويله للدفاع
  slot.bsgLockTurns=2; // ينقص نهاية دور كل لاعب؛ يُفتح بعد دور كامل
  sfx('flip');
  setTimeout(()=>{
    renderField();
    bsgFlipFX(who,idx);
    showMsg("🛡 "+card.name+" تحوّل للهجوم تلقائياً!",1800);
    addLog("🛡 "+card.name+" → هجوم");
  },650);
}

function resolveAttack(atkIdx,atkSlot,atkCard,targetIdx,target){
  let defCard=cardById(target.id);
  let wasFaceDown=target.faceDown;
  if(wasFaceDown){target.faceDown=false;renderField();showMsg("انكشف "+defCard.name+"!",1300);
    // محرّك تأثيرات الوحوش عند القلب (المدافع يُكشف)
    if(typeof AR_MON_FLIP!=='undefined' && AR_MON_FLIP[defCard.slug]){
      try{ AR_MON_FLIP[defCard.slug]('e',targetIdx,defCard,G.eField); }catch(e){}
    }
  }
  let myATK=effATK(atkCard,'p',atkSlot);
  let defStat=target.pos==='def'?effDEF(defCard,'e',target):effATK(defCard,'e',target);
  // الجندي الحركيّ: +2000 هجوم/دفاع خلال المعركة ضد وحش من نوع محارب
  let kineticSlugs=['ar-074','ar9-097'];
  if(kineticSlugs.includes(atkCard.slug) && defCard.race==='warrior'){ myATK+=2000; showMsg('⚙ الجندي الحركيّ! +2000 ضد المحارب',1600); }
  if(kineticSlugs.includes(defCard.slug) && atkCard.race==='warrior'){ defStat+=2000; showMsg('⚙ الجندي الحركيّ! +2000 ضد المحارب',1600); }
  let diff=myATK-defStat;
  let doResolve=()=>{
    // علّم الوحش المهاجم فوراً (قبل الأنميشن) لمنع تكرار الهجوم
    if(atkSlot)markAttacked(atkSlot);
    // المحارب من البُعد المختلف: إذا هاجم أو هوجم، يُنفى هو ووحش الخصم من اللعبة
    let ddSlugs=['ar-090','ar8-089'];
    if(ddSlugs.includes(atkCard.slug)||ddSlugs.includes(defCard.slug)){
      flyAttack('p',atkIdx,getZoneCenter('e',targetIdx),()=>{
        sfx('banish'); camShake(true);
        G.banished=G.banished||[];
        if(G.pField.m[atkIdx]){ G.banished.push(G.pField.m[atkIdx].id); burstMonster('p',atkIdx); G.pField.m[atkIdx]=null; }
        if(G.eField.m[targetIdx]){ G.banished.push(G.eField.m[targetIdx].id); burstMonster('e',targetIdx); G.eField.m[targetIdx]=null; }
        renderAll(); showMsg('🌀 المحارب من البُعد المختلف! نُفي هو ووحش الخصم من اللعبة',2100); checkEnd();
      });
      return;
    }
    showFaceReaction('react_attack');
    flyAttack('p',atkIdx,getZoneCenter('e',targetIdx),()=>{
      recoilTarget('e',targetIdx);
      if(myATK>=2500)camShake(true); // [جديد] هزّة قوية للهجمات الكبيرة
      if(diff>0){
        // Obnoxious Celtic Guard: not destroyed by battle with ATK>=1900 attacker
        if(defCard.slug==='obnoxious-celtic-guard' && myATK>=1900){
          if(target.pos==='atk'){dealBattleDmg('e',diff);if(G.enemyLP>0&&G.enemyLP<2500)setTimeout(()=>showFaceReaction('worried'),700);}
          showMsg('🛡 Obnoxious Celtic Guard صمد أمام الهجوم القوي!',1900);
        } else {
          destroyMonster('e',targetIdx);
          if(target.pos==='atk'){dealBattleDmg('e',diff);if(G.enemyLP>0&&G.enemyLP<2500)setTimeout(()=>showFaceReaction('worried'),700);}
          showMsg(atkCard.name+" دمّر "+defCard.name+"!",1800);
          // زمبيرا الظلامي: يفقد 200 هجوم دائماً بعد تدميره وحشاً
          if((atkCard.slug==='ar6-016'||atkCard.slug==='ar14-039')&&atkSlot){atkSlot.atkBonus=(atkSlot.atkBonus||0)-200;setTimeout(()=>showMsg('🦇 زمبيرا الظلامي! −200 هجوم دائم',1700),900);}
          // صيّاد السيوف: يكتسب +200 هجوم دائم بعد تدميره وحشاً (يستحوذ على سلاحه)
          if((atkCard.slug==='ar3-083'||atkCard.slug==='ar10-006')&&atkSlot){atkSlot.atkBonus=(atkSlot.atkBonus||0)+200;setTimeout(()=>showMsg('⚔ صيّاد السيوف! استحوذ على السلاح +200 هجوم',1800),900);}
          // ساحر القمر الأحمر: الوحش المُدمّر بالمعركة يُستدعى لصالح اللاعب بعد المعركة
          if((atkCard.slug==='ar3-096'||atkCard.slug==='ar10-019')){ let victimId=target.id; setTimeout(()=>{ let gi=G.eGrave.indexOf(victimId); let fz=G.pField.m.findIndex(x=>!x); if(gi>=0&&fz>=0){ G.eGrave.splice(gi,1); G.pField.m[fz]={id:victimId,pos:'atk',faceDown:false,justSummoned:true,flashSummon:true,bigSummon:(cardById(victimId).atk||0)>=2000}; renderAll(); sfx('steal');showMsg('🌑 ساحر القمر الأحمر! استدعى '+cardById(victimId).name+' لصالحك',2000); } },1000); }
        }
      } else if(diff<0){
        if(target.pos==='def'){
          // المدافع أقوى: المهاجم لا يُدمّر، اللاعب يخسر الفرق فقط
          dealBattleDmg('p',Math.abs(diff));
          showMsg(defCard.name+" صدّ الهجوم! خسرت "+Math.abs(diff),1900);
          bigShieldFlip('e',targetIdx,target,defCard);
        } else {
          // الهدف في وضع هجوم وأقوى: المهاجم يُدمّر
          destroyMonster('p',atkIdx);
          dealBattleDmg('p',Math.abs(diff));
          showMsg(defCard.name+" هزم "+atkCard.name+"!",1800);
        }
      } else {
        // tie: Kaiser Glider not destroyed by same-ATK battle
        if(target.pos==='atk'){
          let atkGlider=atkCard.slug==='kaiser-glider';
          let defGlider=defCard.slug==='kaiser-glider';
          if(defGlider||atkGlider){
            if(!atkGlider)destroyMonster('p',atkIdx);
            if(!defGlider)destroyMonster('e',targetIdx);
            showMsg('🦅 Kaiser Glider لا يُدمّر بنفس الهجوم!',1900);
          } else {
            destroyMonster('p',atkIdx);destroyMonster('e',targetIdx);showMsg("تعادل! كلاهما دُمّر",1800);
          }
        }
        else {showMsg("صمد "+defCard.name+"!",1500);bigShieldFlip('e',targetIdx,target,defCard);}
      }
      // (تم تعليم الوحش بالهجوم في بداية doResolve)
      // قوة هجوم العفاريت: بعد الهجوم تتحول لوضع الدفاع وتُقفل حتى نهاية دورك التالي
      if(atkSlot&&G.pField.m[atkIdx]&&(atkCard.slug==='ar3-100'||atkCard.slug==='ar10-023')){ atkSlot.pos='def'; atkSlot.faceDown=false; atkSlot.bsgLocked=true; atkSlot.bsgLockTurns=2; setTimeout(()=>showMsg('👺 قوة هجوم العفاريت! تحوّلت لوضع الدفاع',1700),900); }
      G.attackMode=false;G.attacker=null;
      renderAll();checkEnd();
    });
  };
  setTimeout(doResolve,wasFaceDown?700:50);
}

