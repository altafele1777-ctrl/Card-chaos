  { id:374, slug:"ar3-074", name:"تقليد الحشرات", type:"spell", gameDeck:true, desc:"صحِّ بوحش من ملعبك، اختر من مجموعتك وحشاً ذو مستوى أعلى بدرجة واحدة من وحش التضحية واستدعه على الملعب." },
  { id:375, slug:"ar3-075", name:"الثُقب البُعدي", type:"spell", gameDeck:true, desc:"أخرج وحشاً من اللعب حتى دورك القادم." },
  { id:376, slug:"ar3-076", name:"الإنهيار", type:"spell", gameDeck:true, desc:"اختر مكانين من أمكنة وحوش خصمك بالملعب ودمرهما، لا يمكن لخصمك استعمالهما ما دامت هذه الورقة مفعلة في الملعب." },
  { id:377, slug:"ar3-077", name:"التبديل السحري", type:"trap", gameDeck:true, desc:"لا تُفعل إلا عندما يلقى خصمك ورقة سحرية، نمر على الخصم أن يرمي ورقة سحرية من يده لبطل مفعولها وإلا تدمر ورقته." },
  { id:378, slug:"ar3-078", name:"اليد المدمرة", type:"trap", gameDeck:true, desc:"كل الوحوش من المستوى الثالث أو أقل يدمرون بنهاية الدور الذي استدعوا فيه إما استدعاءً عادياً أو عن طريق القلب." },
  { id:379, slug:"ar3-079", name:"شبكة الجاذبية", type:"trap", gameDeck:true, desc:"كل وحوش المستوى الرابع أو أكثر لا يمكنها الهجوم." },
  { id:380, slug:"ar3-080", name:"المطحنة السحرية", type:"trap", gameDeck:true, desc:"لكل ورقة سحرية ترميها، يتلقى خصمك ضرراً قدره 500 نقطة أساسية." },
  { id:381, slug:"ar3-081", name:"ظلّ الأعين", type:"trap", gameDeck:true, desc:"إذا وضع خصمك وحشاً في وضعية دفاع مقلوب، اقلبه في وضعية هجوم مكشوف، إذا كان له تأثير لا يُفعل." },
  { id:382, slug:"ar3-082", name:"الصياد الأسطوري", type:"monster", race:"aqua", gameDeck:true, attribute:"water", level:4, atk:1850, def:1600, desc:"طالما ورقة الملعب المائي مفعلة لا يتأثر بأوراق السحر، جميع وحوش خصمك لا يمكنها استهدافه في هجوم." },
