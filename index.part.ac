  returnBorrowed('e');
  clearTempBonus('e'); // انتهاء الزيادات المؤقتة في نهاية دور الخصم
  if(G.banishedReturn&&G.banishedReturn.length){
    G.banishedReturn.forEach(saved=>{let fz=G.pField.m.findIndex(x=>!x);if(fz!==-1)G.pField.m[fz]=saved;});
    G.banishedReturn=[];
  }
  G.turn='player';G.turnCount++;G.normalSummoned=false;G.positionChanged=[];
  G.eField.m.forEach(s=>{if(s){s.attacked=false;s.justSummoned=false;s.atkCount=0;
    if(s.bsgLocked){s.bsgLockTurns=(s.bsgLockTurns||1)-1;if(s.bsgLockTurns<=0){s.bsgLocked=false;}}
  }});
  G.eField.s.forEach(s=>{if(s)s.justSet=false;});
  G.pField.m.forEach(s=>{if(s){s.bound=false;}});
  G.wabokuActive=false;
  // Auto draw for player
  setPhase('draw');
  setTimeout(()=>{
    if(G.skipDraw){G.skipDraw=false;showMsg("Time Seal! تخطيت السحب",1800);}
    else{let c=drawFrom('p');if(c){sfx('draw');animateDraw('p');showMsg("سحبت بطاقة 🃏",1000);}}
    renderAll();
    arAmazonUpkeep('p'); arHumanoidSlimeUpkeep('p'); arUpkeepEffects('p'); // الأمازونية + الفطر الآدمي + علاج/رقص
    setTimeout(()=>{setPhase('main1');updateButtons();updateTurnGlow();showTurnBanner('player');},1000);
  },800);
}
// الأمازونية العدوانية: في مرحلة الاستعداد، ضحِّ بوحش آخر من ملعبك أو تُدمّر هذه الورقة
function arAmazonUpkeep(who){
  let f=who==='p'?G.pField:G.eField;
  let amazons=[]; f.m.forEach((x,i)=>{ if(x&&!x.faceDown&&(cardById(x.id).slug==='ar7-073'||cardById(x.id).slug==='ar15-149')) amazons.push(i); });
  if(amazons.length===0) return;
  amazons.forEach(ai=>{
    if(!f.m[ai]) return;
    // الوحوش المتاحة للتضحية: أي وحش آخر (ليس الأمازونية نفسها)
    let others=[]; f.m.forEach((x,i)=>{ if(x&&i!==ai) others.push(i); });
    if(others.length===0){
      // لا وحش للتضحية → تُدمّر الأمازونية
      destroyMonster(who,ai);
      showMsg('⚔ الأمازونية العدوانية! لا وحش للتضحية → دُمّرت',2000);
      return;
    }
    if(who==='p' && typeof pickCard==='function'){
      let ids=others.map(i=>f.m[i].id);
      pickCard('⚔ الأمازونية العدوانية','اختر وحشاً للتضحية به (وإلا تُدمّر الأمازونية)',ids,(chosenId)=>{
        let si=-1; for(let i=0;i<5;i++){ if(i!==ai&&f.m[i]&&f.m[i].id===chosenId){ si=i; break; } }
        if(si>=0){ let nm=cardById(f.m[si].id).name; destroyMonster(who,si); showMsg('⚔ الأمازونية! ضحّيت بـ'+nm,1800); }
        renderAll();
      });
    } else {
      // الخصم: يضحّي بأضعف وحش تلقائياً
      let si=others[0],worst=Infinity; others.forEach(i=>{let a=(cardById(f.m[i].id).atk||0)+(f.m[i].atkBonus||0); if(a<worst){worst=a;si=i;}});
      let nm=cardById(f.m[si].id).name; destroyMonster(who,si);
      showMsg('⚔ '+oppName()+': الأمازونية ضحّت بـ'+nm,1800); renderAll();
    }
  });
}
// الفطر الآدمي #2: طالما مكشوف على الملعب، يتضرّر صاحبه 300 نقطة في كل مرحلة استعداد
function arHumanoidSlimeUpkeep(who){
  let f=who==='p'?G.pField:G.eField;
