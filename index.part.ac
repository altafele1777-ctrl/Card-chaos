// رسم المقبرة: آخر ورقة مدمرة تظهر فوق كومة بسُمك يعكس العدد
// ===== نظام الحقل البيئي =====
// خريطة البيئات: slug بطاقة الحقل → كلاس البيئة
const FIELD_ENV={'ar4-075':'env-toon','ar12-098':'env-toon',
  'ar4-095':'env-water','ar11-018':'env-water','ar8-056':'env-water','ar15-056':'env-water', // ماء
  'ar4-099':'env-dark','ar11-022':'env-dark','ar2-072':'env-dark','ar10-095':'env-dark', // ظلام
  'ar8-052':'env-forest','ar15-052':'env-forest', // غابة
  'ar4-096':'env-toon','ar11-019':'env-toon', // نار (برتقالي)
};
function setFieldSpell(who,card){
  G.fieldSpell=G.fieldSpell||{};
  G.fieldSpell[who]=card?card.id:null;
  let zone=document.getElementById(who==='p'?'p-field':'e-field');
  let top=document.getElementById(who==='p'?'p-field-top':'e-field-top');
  if(zone&&top){
    if(card){ zone.classList.add('has-field'); top.style.backgroundImage='url('+cardImg(card)+')'; }
    else { zone.classList.remove('has-field'); top.style.backgroundImage='none'; }
  }
  applyFieldEnv();
}
function applyFieldEnv(){
  let scr=document.getElementById('duel-screen'); if(!scr)return;
  scr.classList.remove('env-toon','env-water','env-dark','env-forest');
  let fs=G.fieldSpell||{};
  // البيئة المعروضة: أحدث بطاقة حقل مفعّلة لأي طرف
  let activeCard=fs.p?cardById(fs.p):(fs.e?cardById(fs.e):null);
  if(activeCard&&FIELD_ENV[activeCard.slug]) scr.classList.add(FIELD_ENV[activeCard.slug]);
}
function showFieldSpell(who){
  let fs=G.fieldSpell||{}; let id=fs[who];
  if(!id){ showMsg('لا توجد بطاقة بيئة مفعّلة',1400); return; }
  let c=cardById(id);
  if(c&&typeof showDetail==='function')showDetail(c);
  else showMsg('🌍 البيئة: '+(c?c.name:''),1600);
}
// تفعيل بطاقة بيئة عامة: تضعها في منطقة الحقل وتفعّل تعزيزها المستمر
function playFieldSpell(w,slug){
  let c=cardBySlug(slug); if(!c)return false;
  setFieldSpell(w,c);
  if(typeof renderField==='function')renderField();
  showMsg('🌍 '+c.name+' مُفعّلة! تعزيز مستمر للوحوش المطابقة',2200);
  return true;
}

function renderGrave(who){
  let zone=document.getElementById(who==='p'?'p-grave':'e-grave');
  if(!zone)return;
  let top=document.getElementById(who==='p'?'p-grave-top':'e-grave-top');
  let grave=who==='p'?G.pGrave:G.eGrave;
  let n=grave?grave.length:0;
  zone.classList.toggle('has-card',n>0);
  // إزالة الطبقات القديمة
  zone.querySelectorAll('.grave-layer').forEach(l=>l.remove());
  if(n>0 && top){
    let lastCard=cardById(grave[n-1]);
    top.style.backgroundImage=lastCard?'url('+cardImg(lastCard)+')':'none';
    // طبقات السُمك
    let layers=Math.min(6,Math.max(0,Math.ceil(n/5)));
    for(let i=layers;i>=1;i--){
      let l=document.createElement('div');l.className='grave-layer';
      let off=i*1.3;
      l.style.transform='translate('+off+'px,'+off+'px)';
      l.style.zIndex=String(4-i);
      zone.insertBefore(l,zone.firstChild);
    }
  } else if(top){
    top.style.backgroundImage='none';
  }
}

// رسم الديك ككومة أوراق بسُمك يعكس العدد المتبقّي
function renderDeck(who){
  let zone=document.getElementById(who==='p'?'p-deck':'e-deck');
  if(!zone)return;
  // إكسترا ديك (للطرفين)
  let exArr=who==='p'?(G.playerExtra||[]):(G.enemyExtra||[]);
  let exTop=document.getElementById(who==='p'?'p-extra-top':'e-extra-top');
  let exZone=document.getElementById(who==='p'?'p-extra':'e-extra');
  if(exTop)exTop.style.backgroundImage=exArr.length>0?'url('+CARD_BACK+')':'none';
  if(exZone)exZone.classList.toggle('has-cards',exArr.length>0);
  let top=document.getElementById(who==='p'?'p-deck-top':'e-deck-top');
  let n=(who==='p'?G.playerDeck:G.enemyDeck).length;
  // وجه الكومة = ظهر الورقة
  if(top)top.style.backgroundImage=n>0?'url('+CARD_BACK+')':'none';
  zone.classList.toggle('empty',n===0);
  // إزالة الطبقات القديمة
  zone.querySelectorAll('.deck-layer').forEach(l=>l.remove());
  // عدد الطبقات المرئية: طبقة لكل ~5 أوراق، بحد أقصى 7
  let layers=Math.min(7,Math.max(0,Math.ceil(n/6)));
  for(let i=layers;i>=1;i--){
    let l=document.createElement('div');l.className='deck-layer';
    let off=i*1.4;
    l.style.transform='translate('+off+'px,'+off+'px)';
    l.style.zIndex=String(4-i);
    zone.insertBefore(l,zone.firstChild);
  }
}

// أنيميشن سحب ورقة: شبح يطير من الديك إلى منطقة اليد
function animateDraw(who,cb){
  let deckZone=document.getElementById(who==='p'?'p-deck':'e-deck');
  if(!deckZone){if(cb)cb();return;}
  let r=deckZone.getBoundingClientRect();
  let fly=document.createElement('div');fly.className='draw-fly';
  fly.style.backgroundImage='url('+CARD_BACK+')';
  fly.style.left=r.left+'px';fly.style.top=r.top+'px';
  document.body.appendChild(fly);
  deckZone.classList.add('drawing');
  setTimeout(()=>deckZone.classList.remove('drawing'),500);
  // الوجهة: منطقة اليد (للاعب) أو شريط يد الخصم (للخصم)
  let dest=document.getElementById(who==='p'?'hand-area':'enemy-hand-bar');
  let dr=dest?dest.getBoundingClientRect():r;
  let tx=(dr.left+dr.width/2)-(r.left+r.width/2);
  let ty=(dr.top+dr.height/2)-(r.top+r.height/2);
  // حركة بإطارين: ارتفاع بسيط ثم انزلاق للوجهة مع تلاشٍ
  fly.animate([
    {transform:'translate(0,0) scale(1) rotate(0deg)',opacity:1},
    {transform:'translate('+(tx*.5)+'px,'+(ty*.5-18)+'px) scale(1.15) rotate(-6deg)',opacity:1,offset:.5},
    {transform:'translate('+tx+'px,'+ty+'px) scale(.85) rotate(0deg)',opacity:.15}
  ],{duration:520,easing:'cubic-bezier(.4,0,.2,1)'}).onfinish=()=>{
    fly.remove();if(cb)cb();
  };
}

function renderHand(){
  let el=document.getElementById('hand-area');el.innerHTML='';
  G.playerHand.forEach((cid,idx)=>{
    let card=cardById(cid);let div=document.createElement('div');div.className='hcard'+(G.selIdx===idx?' sel':'');
    div.innerHTML='<img src="'+cardImg(card)+'" alt="'+card.name+'">';
    let lastTapT=0,tapTimer;
    div.onclick=(e)=>{
      let now=Date.now();
      if(now-lastTapT<320){clearTimeout(tapTimer);lastTapT=0;showZoom(card);return;}
      lastTapT=now;
      tapTimer=setTimeout(()=>{selCard(idx);},300);
    };
    let pt;div.addEventListener('touchstart',()=>{pt=setTimeout(()=>showZoom(card),550);},{passive:true});
    div.addEventListener('touchend',()=>clearTimeout(pt));
    div.addEventListener('contextmenu',(e)=>{e.preventDefault();showZoom(card);});
    el.appendChild(div);div.style.animation='cardIn .35s ease';
  });
}

function renderField(){renderSide('p');renderSide('e');}
function renderSide(who){
  let field=who==='p'?G.pField:G.eField;
  let mc=document.getElementById(who+'-m-zones');
  mc.querySelectorAll('.zone').forEach((z,i)=>{
    let old=z.querySelector('.ciz');if(old)z.removeChild(old);
    let oldLock=z.querySelector('.lock-badge');if(oldLock)z.removeChild(oldLock);
    z.classList.remove('tribute-target','attack-target');
    let slot=field.m[i];if(!slot)return;
    let card=cardById(slot.id);let div=document.createElement('div');
    div.className='ciz'+(slot.pos==='def'?' def':'')+(slot.attacked?' attacked':'')+(slot.flashSummon?' summon-flash':'')+(slot.bigSummon?' big-summon':'')+(slot.tributeSummon?' tribute-summon':'');
    if(slot.flashSummon){slot.flashSummon=false;}
    if(slot.bigSummon){slot.bigSummon=false; (function(w,ix){setTimeout(()=>{if(typeof bigSummonFX==='function')bigSummonFX(w,ix);},40);})(who,i);}
    if(slot.faceDown){div.innerHTML='<div class="card-back" style="background-image:url('+CARD_BACK+')"></div>';}
    else{
      div.innerHTML='<img src="'+cardImg(card)+'" alt="'+card.name+'">';
      let curA=effATK(card,who,slot), curD=effDEF(card,who,slot);
      let buffed=(curA!==(card.atk||0))||(curD!==(card.def||0));
      let badge=document.createElement('div');
      badge.className='stat-badge'+(buffed?' buffed':'');
      badge.textContent=slot.pos==='def'?('🛡'+curD):('⚔'+curA);
      div.appendChild(badge);
    }
    // [جديد] شارة قفل الوضع (مثل Big Shield Gardna بعد تحوّله)
    if(slot.bsgLocked&&!slot.faceDown){
      let lock=document.createElement('div');lock.className='lock-badge';lock.textContent='🔒';
      lock.title='لا يمكن تغيير وضعه قبل مرور دور كامل';
      z.appendChild(lock);
    }
    let lastT=0;
    div.onclick=(e)=>{
      e.stopPropagation();
      let now=Date.now();
      if(now-lastT<320){lastT=0;if(!slot.faceDown||who==='p')showZoom(card);return;}
      lastT=now;
      onFieldM(who,i);
    };
    let pt;div.addEventListener('touchstart',()=>{pt=setTimeout(()=>{if(!slot.faceDown||who==='p')showZoom(card);},550);},{passive:true});
    div.addEventListener('touchend',()=>clearTimeout(pt));
    z.appendChild(div);
  });
  let sc=document.getElementById(who+'-s-zones');
  sc.querySelectorAll('.zone').forEach((z,i)=>{
    let old=z.querySelector('.ciz');if(old)z.removeChild(old);
    let slot=field.s[i];if(!slot)return;
    let card=cardById(slot.id);let div=document.createElement('div');div.className='ciz';
    if(slot.faceDown){div.innerHTML='<div class="card-back" style="background-image:url('+CARD_BACK+')"></div>';}
    else{div.innerHTML='<img src="'+cardImg(card)+'" alt="'+card.name+'">';}
    div.onclick=(e)=>{e.stopPropagation();onFieldS(who,i);};
    z.appendChild(div);
  });
  // Highlight attack targets
  if(G.attackMode&&who==='e'){
    mc.querySelectorAll('.zone').forEach((z,i)=>{if(G.eField.m[i])z.classList.add('attack-target');});
  }
}

let _dispLP={p:8000,e:8000};
function updateLP(){
  let pp=Math.max(0,G.playerLP/8000*100),ep=Math.max(0,G.enemyLP/8000*100);
  document.getElementById('plp-fill').style.width=pp+'%';
  document.getElementById('elp-fill').style.width=ep+'%';
  animateLPNum('p',Math.max(0,G.playerLP));
  animateLPNum('e',Math.max(0,G.enemyLP));
  // الموسيقى تصبح مظلمة فوراً عند انخفاض نقاط أي طرف
  if(typeof setMusicMood==='function' && typeof G!=='undefined' && G.phase && (G.playerLP<=2500||G.enemyLP<=2500)){ setMusicMood('danger'); }
}
function animateLPNum(who,target){
  let el=document.getElementById(who==='p'?'plp':'elp');if(!el)return;
  let cur=_dispLP[who];
  if(cur===target){el.textContent=target.toLocaleString();return;}
  let diff=target-cur,steps=14,step=0;
  let timer=setInterval(()=>{
    step++;let v=Math.round(cur+diff*(step/steps));
    el.textContent=Math.max(0,v).toLocaleString();
    if(step>=steps){clearInterval(timer);_dispLP[who]=target;el.textContent=target.toLocaleString();}
  },28);
}

// ===================== CARD SELECTION =====================
function selCard(idx){
  if(G.turn!=='player')return;
  if(G.phase!=='main1'&&G.phase!=='main2'){showMsg("لا يمكن لعب بطاقات الآن",1200);return;}
  G.selIdx=G.selIdx===idx?null:idx;
  G.selCard=G.selIdx!=null?cardById(G.playerHand[G.selIdx]):null;
  renderHand();
}

function onZoneClick(e,who,t,idx){
  e.stopPropagation();
  if(G.turn!=='player')return;
  if(G.tributeMode)return; // modal handles tribute now
  if(!G.selCard)return;
  if(G.phase!=='main1'&&G.phase!=='main2')return;
  if(who==='p'&&t==='m'&&G.selCard.type==='monster')trySummon(idx);
  else if(who==='p'&&t==='s'&&(G.selCard.type==='spell'||G.selCard.type==='trap'))placeS(idx);
}

// ===================== SUMMONING =====================
function trySummon(idx){
  let card=G.selCard;
  if(G.pField.m[idx]){showMsg("المنطقة ممتلئة!",1200);return;}
  if(G.normalSummoned){showMsg("استدعيت بالفعل هذا الدور!",1500);return;}
  if(card.ritual){showMsg("يحتاج استدعاء طقسي بـ "+(card.ritualSpellName||"بطاقة طقوس"),2200);return;}
  if(card.fusionMon){showMsg("⚗ وحش اندماج! يُستدعى عبر الدمج فقط ("+((card.mats||[]).map(s=>{let m=CARDS.find(c=>c.slug===s);return m?m.name:s;}).join(' + '))+")",2600);return;}
  // Count tributes needed
  let need = card.level>=7?2 : card.level>=5?1 : 0;
  // شيطان الميغاسايبر: استدعاء خاص بدون تضحية إذا كان لدى الخصم وحشان أو أكثر
  if((card.slug==='ar2-006'||card.slug==='ar10-029') && need>0){
    let oppCount=G.eField.m.filter(s=>s&&!s.faceDown).length;
    if(oppCount>=2){ need=0; showMsg('👹 شيطان الميغاسايبر! استدعاء خاص (الخصم لديه '+oppCount+' وحوش)',2000); }
  }
  // الفراشة العملاقة (دور 6) والفراشة الكبيرة (دور 4): استدعاء خاص بتضحية "فراشة صغيرة" بعد عدد أدوار
  let butterflyMap={'ar-092':6,'ar8-091':6,'ar5-026':4,'ar13-049':4,'ar6-067':2,'ar14-090':2};
  if(butterflyMap[card.slug]){
    let needTurn=butterflyMap[card.slug];
    let smallIdx=G.pField.m.findIndex(s=>s&&(cardById(s.id).slug==='ar6-082'||cardById(s.id).slug==='ar13-005'));
    if(smallIdx<0){ showMsg('🦋 '+card.name+'! تحتاج "فراشة صغيرة" على الملعب',2200); return; }
    if((G.turnCount||1)<needTurn){ showMsg('🦋 '+card.name+'! تُستدعى ابتداءً من الدور '+needTurn+' (الدور الحالي '+(G.turnCount||1)+')',2300); return; }
    sendToGrave('p',smallIdx);
    showMsg('🦋 '+card.name+'! استدعاء خاص بتضحية الفراشة الصغيرة',2200);
    need=0;
  }
  // وحوش التون: تُستدعى فقط إذا كان "عالم الرسوم المتحركة" مفعّلاً لصاحبها
  let toonSlugs=['ar4-070','ar4-071','ar4-072','ar5-099','ar12-022','ar12-093','ar12-094','ar12-095'];
  if(toonSlugs.includes(card.slug)){
    if(G.toonWorld!==who){ showMsg('🎪 '+card.name+'! يحتاج "عالم الرسوم المتحركة" مفعّلاً أولاً',2400); return; }
    showMsg('🎪 '+card.name+'! استُدعي عبر عالم الرسوم المتحركة',2000);
    need=0;
  }
  // حارس البوابة: يُستدعى فقط بتضحية كازيجن + سويجن + سانكا الرعدي الثلاثة من الملعب
  if(card.slug==='ar6-063'||card.slug==='ar14-086'){
    let f=G.pField, need3=['ar6-084','ar6-085','ar6-086'];
    let idxs=need3.map(sl=>f.m.findIndex(s=>s&&cardById(s.id).slug===sl));
    if(idxs.some(x=>x<0)){ showMsg('⚡ حارس البوابة! يحتاج كازيجن وسويجن وسانكا الرعدي على ملعبك',2500); return; }
    idxs.sort((a,b)=>b-a).forEach(ix=>sendToGrave('p',ix));
    showMsg('⚡ حارس البوابة! ضحّى بالآلهة الثلاثة واستُدعي',2300);
    need=0;
  }
  // فالكبريون: يُستدعى فقط بتضحية ألفا + بيتا + غاما المحاربين المغناطيسيين من الملعب
  if(card.slug==='ar2-011'||card.slug==='ar10-034'){
    let f=G.pField, need3=['ar8-004','ar8-005','ar8-006'];
    let idxs=need3.map(sl=>f.m.findIndex(s=>s&&cardById(s.id).slug===sl));
    if(idxs.some(x=>x<0)){ showMsg('🧲 فالكبريون! يحتاج ألفا وبيتا وغاما المحاربين المغناطيسيين على ملعبك',2500); return; }
    idxs.sort((a,b)=>b-a).forEach(ix=>sendToGrave('p',ix));
    showMsg('🧲 فالكبريون المحارب المغناطيسي! اندمج الثلاثة واستُدعي',2300);
    need=0;
  }
  // زووا/زورا المعدني: استدعاء خاص بتضحية وحش "زووا/زورا" الأساسي من الملعب
  let metalMap={'ar2-079':['ar2-078','زووا'],'ar9-002':['ar9-001','زورا']};
  if(metalMap[card.slug]){
    let baseSlug=metalMap[card.slug][0], f=G.pField;
    let bi=f.m.findIndex(s=>s&&cardById(s.id).slug===baseSlug);
    if(bi<0){ showMsg('🤖 '+card.name+'! يحتاج "'+metalMap[card.slug][1]+'" على ملعبك للتطوّر',2400); return; }
    sendToGrave('p',bi);
    showMsg('🤖 '+card.name+'! تطوّر من '+metalMap[card.slug][1],2200);
    need=0;
  }
  // ذوات المخالب: يُستدعى فقط بتضحية "المتبجح الأنيق" من الملعب
  if(card.slug==='ar6-069'||card.slug==='ar14-092'){
    let f=G.pField, bi=f.m.findIndex(s=>s&&cardById(s.id).slug==='ar6-083');
    if(bi<0){ showMsg('🦅 ذوات المخالب! يحتاج "المتبجح الأنيق" على ملعبك',2400); return; }
    sendToGrave('p',bi);
    showMsg('🦅 ذوات المخالب! استُدعي عبر المتبجح الأنيق',2200);
    need=0;
  }
  // الأرواح: استدعاء خاص بنفي وحش/وحوش بخاصية معيّنة من المقبرة
  let spiritMap={'ar6-009':['fire',1,'🔥 الروح النارية'],'ar14-032':['fire',1,'🔥 الروح النارية'],'ar6-011':['earth',1,'🪨 روح الصخر'],'ar14-034':['earth',1,'🪨 روح الصخر'],'ar14-033':['water',1,'💧 الروح المائيّة'],'ar6-010':['water',1,'💧 الروح المائيّة'],'ar6-012':['wind',1,'🌪 جارودا روح الريح'],'ar14-035':['wind',1,'🌪 جارودا روح الريح'],'ar6-008':['light',2,'✨ روح النقاء والضياء']};
  if(spiritMap[card.slug]){
    let [attr,cnt,label]=spiritMap[card.slug];
    let g=G.pGrave, banishIdxs=[];
    for(let k=g.length-1;k>=0 && banishIdxs.length<cnt;k--){ let c=cardById(g[k]); if(c&&c.type==='monster'&&c.attribute===attr) banishIdxs.push(k); }
    if(banishIdxs.length<cnt){ showMsg(label+'! تحتاج '+cnt+' وحش '+(attr==='fire'?'ناري':attr==='earth'?'أرضي':attr==='water'?'مائي':attr==='wind'?'هوائي':'ضوئي')+' في مقبرتك',2300); return; }
    G.banished=G.banished||[];
    banishIdxs.forEach(k=>{ G.banished.push(g.splice(k,1)[0]); });
    showMsg(label+'! نُفي '+cnt+' وحش من المقبرة — استدعاء خاص',2200);
    need=0;
  }
  let onField = G.pField.m.filter(s=>s).length;
  if(need>0 && onField<need){showMsg("تحتاج "+need+" مونستر للتضحية!",2000);return;}
  // Show summon choice
  showSummonChoice(idx,card,need);
}

function showSummonChoice(idx,card,need){
  let ov=document.getElementById('summon-ov');
  document.getElementById('sp-title').textContent = need>0 ? ("استدعاء بتضحية ("+need+")") : "اختر طريقة الاستدعاء";
  document.getElementById('sp-preview').innerHTML='<img src="'+cardImg(card)+'">';
  let btns=document.getElementById('sp-btns');btns.innerHTML='';
  let mkBtn=(label,fn,cls)=>{let b=document.createElement('button');b.className='sp-btn'+(cls?' '+cls:'');b.textContent=label;b.onclick=fn;btns.appendChild(b);};
  if(need>0){
    mkBtn("⚔ تضحية واستدعاء (هجوم)",()=>{closeSummonOv();beginTribute(idx,card,need,'atk');});
    mkBtn("🛡 تضحية واستدعاء (دفاع)",()=>{closeSummonOv();beginTribute(idx,card,need,'def');});
  } else {
    mkBtn("⚔ استدعاء عادي (هجوم)",()=>{closeSummonOv();doSummon(idx,card,'atk',false);});
    mkBtn("🛡 وضع مغلق (Set دفاع)",()=>{closeSummonOv();doSummon(idx,card,'def',true);});
  }
  mkBtn("إلغاء",()=>{closeSummonOv();},"cancel");
  ov.classList.add('vis');
}
function closeSummonOv(){document.getElementById('summon-ov').classList.remove('vis');}

function beginTribute(idx,card,need,pos){
  G.tributeMode={card:card,need:need,pos:pos,selected:[]};
  // Populate modal
  document.getElementById('tm-summon-img').innerHTML='<img src="'+cardImg(card)+'">';
  document.getElementById('tm-summon-name').textContent=card.name;
  document.getElementById('tm-summon-stat').textContent='ATK '+card.atk+' / مستوى '+card.level;
  document.getElementById('tm-sub').textContent='اختر '+need+' '+(need===1?'وحش':'وحوش')+' للتضحية';
  let grid=document.getElementById('tm-grid');grid.innerHTML='';
  G.pField.m.forEach((slot,i)=>{
    if(!slot)return;
    if(slot.noTribute)return; // الأكباش الفضائية وما شابه: لا يمكن التضحية بها
    let c=cardById(slot.id);
    let div=document.createElement('div');div.className='tm-card';div.dataset.idx=i;
    let imgSrc=slot.faceDown?CARD_BACK:cardImg(c);
    div.innerHTML='<img src="'+imgSrc+'"><div class="tm-cname">'+(slot.faceDown?'مقلوب':c.name)+'</div>';
    div.onclick=()=>toggleTributePick(i,div);
    grid.appendChild(div);
  });
  updateTributeCount();
  document.getElementById('tm-confirm').onclick=confirmTribute;
  document.getElementById('tm-cancel').onclick=cancelTribute;
  document.getElementById('tribute-modal').classList.add('vis');
}

function toggleTributePick(idx,div){
  let tm=G.tributeMode;if(!tm)return;
  let pos=tm.selected.indexOf(idx);
  if(pos!==-1){tm.selected.splice(pos,1);div.classList.remove('picked');}
  else{
    if(tm.selected.length>=tm.need){
      // replace oldest pick
      let oldIdx=tm.selected.shift();
      let oldDiv=document.querySelector('.tm-card[data-idx="'+oldIdx+'"]');
      if(oldDiv)oldDiv.classList.remove('picked');
    }
    tm.selected.push(idx);div.classList.add('picked');
  }
  sfx('click');
  updateTributeCount();
}

function updateTributeCount(){
  let tm=G.tributeMode;if(!tm)return;
  document.getElementById('tm-count').textContent=tm.selected.length+' / '+tm.need;
  document.getElementById('tm-confirm').disabled=tm.selected.length!==tm.need;
}

function cancelTribute(){
  G.tributeMode=null;
  document.getElementById('tribute-modal').classList.remove('vis');
}

function confirmTribute(){
  let tm=G.tributeMode;if(!tm||tm.selected.length!==tm.need)return;
  let name=tm.card.name, pos=tm.pos, cardId=tm.card.id;
  let selected=[...tm.selected];
  document.getElementById('tribute-modal').classList.remove('vis');
  // Visual tribute effect on each selected monster
  selected.forEach((i,k)=>{
    setTimeout(()=>{tributeEffect('p',i);sfx('hit');},k*180);
  });
  // After effects, perform the summon
  setTimeout(()=>{
    selected.forEach(i=>{sendToGrave('p',i);});
    let placeIdx=selected[0];
    if(G.pField.m[placeIdx])placeIdx=G.pField.m.findIndex(s=>!s);
    G.pField.m[placeIdx]={id:cardId,pos:pos,faceDown:false,attacked:false,justSummoned:true,flashSummon:true,bigSummon:true,tributeSummon:true};
    let handIdx=G.playerHand.indexOf(cardId);
    if(handIdx!==-1)G.playerHand.splice(handIdx,1);
    G.normalSummoned=true;G.tributeMode=null;G.selCard=null;G.selIdx=null;
    sfx('bigsummon');vibrate([40,50,60]);
    if(typeof epicFx==='function') epicFx(cardById(cardId).slug, name, 'summon');
    if(typeof camShake==='function')camShake(true);
    renderAll();
    showMsg("⚜ تضحية مهيبة! استُدعي "+name+" "+(pos==='def'?'🛡':'⚔'),2200);
    let nc=cardById(cardId);
    if(pos==='atk'&&nc.atk>=1000)checkEnemyTrapOnSummon(placeIdx);
  },selected.length*180+500);
}

// Visual burst + rising soul at a field monster position
function tributeEffect(who,idx){
  let center=getZoneCenter(who,idx);
  if(!center)return;
  let burst=document.createElement('div');burst.className='tribute-burst';
  burst.style.left=center.x+'px';burst.style.top=center.y+'px';
  document.body.appendChild(burst);setTimeout(()=>burst.remove(),700);
  let soul=document.createElement('div');soul.className='tribute-soul';soul.textContent='✦';
  soul.style.left=center.x+'px';soul.style.top=center.y+'px';
  document.body.appendChild(soul);setTimeout(()=>soul.remove(),1000);
  // dim the monster card immediately
  let zones=document.querySelectorAll('#'+who+'-m-zones .zone');
  let zc=zones[idx]?zones[idx].querySelector('.ciz'):null;
  if(zc){zc.style.transition='opacity .4s';zc.style.opacity='0';}
}

function showTributeBanner(txt){let b=document.getElementById('tribute-banner');b.textContent=txt;b.classList.add('vis');}
function hideTributeBanner(){document.getElementById('tribute-banner').classList.remove('vis');}

function doSummon(idx,card,pos,faceDown){
  G.pField.m[idx]={id:card.id,pos:pos,faceDown:faceDown,attacked:false,justSummoned:true,flashSummon:!faceDown,bigSummon:(!faceDown&&(card.atk||0)>=2000)};
  G.playerHand.splice(G.selIdx,1);
  G.selCard=null;G.selIdx=null;G.normalSummoned=true;
  sfx('summon');
  // أنميشن مميز للوحوش الأسطورية (إن وُجدت صورة فنية)
  if(!faceDown && typeof epicFx==='function') epicFx(card.slug, card.name, 'summon');
  if(!faceDown&&(card.atk||0)>=2000){vibrate([30,40,30]);sfx('bigsummon');}
  renderAll();
  showMsg((faceDown?"تم وضع":"تم استدعاء")+" "+card.name+" "+(faceDown?'🃏':(pos==='def'?'🛡':'⚔')),1500);
  if(!faceDown)addLog('⚔ استدعيت '+card.name);
  // King's Knight: if Queen's Knight is on field, special summon Jack's Knight from deck/hand
  if(!faceDown&&card.slug==='kings-knight'){
    let hasQueen=G.pField.m.some(s=>s&&cardById(s.id).slug==='queens-knight');
    if(hasQueen){
      let fz=G.pField.m.findIndex(x=>!x);
      if(fz>=0){
        // find Jack's Knight in deck or hand
        let di=G.playerDeck.findIndex(id=>cardById(id).slug==='jacks-knight');
        let src=null,jid=null;
        if(di>=0){jid=G.playerDeck.splice(di,1)[0];src='deck';}
        else{let hi=G.playerHand.findIndex(id=>cardById(id).slug==='jacks-knight');if(hi>=0){jid=G.playerHand.splice(hi,1)[0];src='hand';}}
        if(jid!=null){
          G.pField.m[fz]={id:jid,pos:'atk',faceDown:false,attacked:false,justSummoned:true,flashSummon:true,bigSummon:false};
          sfx('summon');showMsg("👑 King's Knight: استدعاء خاص لـ Jack's Knight!",2000);
          renderAll();
        }
      }
    }
  }
  // Trap Hole check (enemy face-down traps)
  if(!faceDown && pos==='atk' && card.atk>=1000) checkEnemyTrapOnSummon(idx);
  // رد فعل الخصم على استدعاء وحش قوي
  if(!faceDown && (card.atk||0)>=1900){ setTimeout(()=>showFaceReaction('react_summon',{force:true}),1100); }
  // generic on-summon effects (Berfomet, Invitation, etc.)
  if(!faceDown) onSummon('p',idx,card);
}

