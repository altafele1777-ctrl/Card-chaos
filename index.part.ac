function arPenguinReturn(who){
  // اجمع كل الوحوش على الملعب (الطرفين)
  let all=[];
  [['p',G.pField],['e',G.eField]].forEach(function(t){
    let s=t[0],f=t[1];
    f.m.forEach((x,i)=>{ if(x) all.push({slot:x,side:s,idx:i,id:x.id}); });
  });
  if(all.length===0){ showMsg('🐧 البطريق الجندي! لا وحوش على الملعب',1600); return; }
  if(who==='p'){
    // اللاعب يختار حتى وحشين عبر شاشة منبثقة
    let toReturn=Math.min(2,all.length);
    let pickNext=(remaining)=>{
      // أعِد بناء القائمة الحالية (لأن وحوشاً أُرجعت)
      let cur=[];
      [['p',G.pField],['e',G.eField]].forEach(function(t){let s=t[0],f=t[1];f.m.forEach((x)=>{if(x)cur.push(x.id);});});
      if(remaining<=0||cur.length===0){ if(typeof renderAll==='function')renderAll(); showMsg('🐧 البطريق الجندي! أُرجعت الوحوش إلى أصحابها',1900); return; }
      // اجمع مراجع الوحوش الحالية لمطابقة المعرّف المختار
      pickCard('🐧 البطريق الجندي', 'اختر وحشاً لإرجاعه إلى يد صاحبه ('+remaining+' متبقٍ)', cur, (chosenId)=>{
        // أرجِع أول وحش يطابق المعرّف المختار
        let done=false;
        [['p',G.pField,G.playerHand],['e',G.eField,G.enemyHand]].forEach(function(t){
          let f=t[1],h=t[2];
          for(let i=0;i<5&&!done;i++){ if(f.m[i]&&f.m[i].id===chosenId){ h.push(f.m[i].id); f.m[i]=null; done=true; } }
        });
        if(typeof renderAll==='function')renderAll();
        setTimeout(()=>pickNext(remaining-1),300);
      });
    };
    pickNext(toReturn);
  } else {
    // الخصم: يرجّع الأقوى لدى كل طرف تلقائياً
    let n=0;
    [['p',G.pField,G.playerHand],['e',G.eField,G.enemyHand]].forEach(function(t){
      let f=t[1],h=t[2],bi=-1,best=-1;
      f.m.forEach((x,i)=>{ if(x){let a=(cardById(x.id).atk||0)+(x.atkBonus||0); if(a>best){best=a;bi=i;}} });
      if(bi>=0){ h.push(f.m[bi].id); f.m[bi]=null; n++; }
    });
    if(typeof renderAll==='function')renderAll();
    showMsg('🐧 البطريق الجندي! أُرجع '+n+' وحش إلى صاحبه',2000);
  }
}

// إحياء أقوى وحش من مقبرة الطرف المحدّد إلى ملعبه (في وضع الدفاع)
function arReviveBest(who){
  let g=who==='p'?G.pGrave:G.eGrave, f=who==='p'?G.pField:G.eField;
  let si=f.m.findIndex(x=>!x); if(si<0)return false;
  let bi=-1,best=-1;
  g.forEach((id,i)=>{let c=cardById(id);if(c&&c.type==='monster'&&(c.atk||0)>best){best=c.atk||0;bi=i;}});
  if(bi<0)return false;
  let id=g.splice(bi,1)[0];
  f.m[si]={id,pos:'def',faceDown:false,justSummoned:true,flashSummon:true,bigSummon:(cardById(id).atk||0)>=2000};
  if(typeof renderAll==='function')renderAll();
  return true;
}
