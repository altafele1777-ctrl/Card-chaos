  { id:1600, slug:"ar13-001", name:"الساحر المقنّع", type:"monster", race:"spellcaster", gameDeck:true, attribute:"dark", level:4, atk:900, def:1400, desc:"إذا الحقت هذه الورقة ضرراً مباشراً بالخصم بمكنك سحب ورقة من مجموعتك." },
  { id:1601, slug:"ar13-002", name:"ثعبان المحيط", type:"monster", race:"reptile", gameDeck:true, attribute:"water", level:6, atk:2100, def:1800, desc:"\"المصباح الزاهد\" + \"هبوصيب\"." },
  { id:1602, slug:"ar13-003", name:"أوموتيك المائي", type:"monster", race:"aqua", gameDeck:true, attribute:"water", level:4, atk:1400, def:1200, desc:"تتحكم بالمياه التي في الجرة كتنين كبير قوي." },
  { id:1603, slug:"ar13-004", name:"مهاجم الأرض بيكروط", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:4, atk:1500, def:1000, desc:"روبوط مجارب أرضي كان في القديم يُستخدم في الحروب البحرية." },
  { id:1604, slug:"ar13-005", name:"فراشة صغيرة", type:"monster", race:"insect", gameDeck:true, attribute:"earth", level:1, atk:300, def:200, desc:"من الأفضل تجنب هذا المخلوق، صغير لكنه قاتل." },
  { id:1605, slug:"ar13-006", name:"المتنجح الأنيق", type:"spell", gameDeck:true, desc:"إذا كان لديك واحدة أو أكثر من دوال المخالب في الملعب بمكنك استدعاء ذات المخالب أو أخوات المخالب من بدك أو من أوراقك." },
  { id:1606, slug:"ar13-007", name:"سانكا الرعدي", type:"monster", race:"thunder", gameDeck:true, attribute:"light", level:7, atk:2600, def:2200, desc:"عند احتساب نقاط هجوم خصمك، أرجع نقاط هجوم خصمك إلى 0. هذا التأثير يفعل مرة واحدة فقط في الدور." },
  { id:1607, slug:"ar13-008", name:"كازجين", type:"monster", race:"beast", gameDeck:true, attribute:"dark", level:7, atk:2400, def:2200, desc:"عند احتساب أضرار هجمة خصمك، أرجع نقاط هجوم خصمك إلى 0. هذا التأثير يفعل مرة واحدة فقط في الدور." },
  { id:1608, slug:"ar13-009", name:"سويجن", type:"monster", race:"beast", gameDeck:true, attribute:"water", level:7, atk:2500, def:2400, desc:"عند احتساب أضرار هجمة خصمك وحشه إلى 0. هذا التأثير يفعل مرة واحدة فقط في الدور." },
  { id:1609, slug:"ar13-010", name:"المصباح الزاهد", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:2, atk:400, def:300, desc:"هذا الوحش يهاجم مهاجمة النقاط الأساسية مباشرة." },
  { id:1610, slug:"ar13-011", name:"العقرب الفولاذيّ", type:"monster", race:"insect", gameDeck:true, attribute:"earth", level:1, atk:250, def:300, desc:"اذا هوجم وهو مقلوب يُدمر وحش خصمك تلقائياً بعد 3 أدوار." },
  { id:1611, slug:"ar13-012", name:"أوكوبيم", type:"monster", race:"warrior", gameDeck:true, attribute:"light", level:4, atk:1550, def:1650, desc:"هذا المخلوق ذو الهيئة المزعجة لا يقبل أي حركة يفضل عينه وأذانه المريضة." },
  { id:1612, slug:"ar13-013", name:"لغول", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:1, atk:300, def:350, desc:"بهذا الوحش بمكنك أن تهاجم نقاط حياة خصمك مباشرة." },
  { id:1613, slug:"ar13-014", name:"اوكوشي", type:"monster", race:"warrior", gameDeck:true, attribute:"water", level:1, atk:300, def:250, desc:"بهذا الوحش بمكنك أن تهاجم نقاط حياة خصمك مباشرة." },
  { id:1614, slug:"ar13-015", name:"ليورم", type:"monster", race:"beast", gameDeck:true, attribute:"earth", level:4, atk:1750, def:1550, desc:"وحش ضخم جداً بنسبه في ملامحه ملك القطط." },
  { id:1615, slug:"ar13-016", name:"الهلواني المدمر", type:"monster", race:"beast", gameDeck:true, attribute:"fire", level:3, atk:800, def:900, desc:"يفعل تأثيره في مرحلة الاستعداد. صحي به مكسوف ودمر وحش اذا هجوم بـ1000 نقطة أو أقل." },
  { id:1616, slug:"ar13-017", name:"جينزو #7", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:2, atk:500, def:400, desc:"هذا الوحش بمكنك أن تهاجم نقاط حياة خصمك مباشرة." },
  { id:1617, slug:"ar13-018", name:"إيمان الساحرة", type:"monster", race:"spellcaster", gameDeck:true, attribute:"light", level:3, atk:300, def:400, desc:"عند قلب هذا الوحش فإنه يسمح لك بإعادة ورقة سحر من مقبرتك." },
  { id:1618, slug:"ar13-019", name:"قرش الأعماق", type:"monster", race:"fish", gameDeck:true, attribute:"water", level:4, atk:1900, def:1600, desc:"\"تونجيو\" + \"معمّر الأعماق\"." },
  { id:1619, slug:"ar13-020", gameDeck:true, name:"معمّر الأعماق", type:"monster", race:"warrior", attribute:"water", level:4, atk:1650, def:1700, desc:"الكل يهاب غضب هذا المخلوق البحري." },
  { id:1620, slug:"ar13-021", name:"غولم المدمر", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:4, atk:1500, def:1000, desc:"غولم ذو دراع ايمن هائل بدق به رؤوس أعدائه." },
  { id:1621, slug:"ar13-022", name:"هجمة كاميناري", type:"monster", race:"warrior", gameDeck:true, attribute:"fire", level:4, atk:1900, def:1400, desc:"\"كرة الرّعد العملاقة\" + \"أوكوبيم\"." },
  { id:1622, slug:"ar13-023", name:"زهور قوس قزح", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:1, atk:400, def:500, desc:"هذا الوحش بمكنك أن تهاجم نقاط حياة خصمك مباشرة." },
  { id:1623, slug:"ar13-024", name:"مورينفين", type:"monster", race:"fiend", gameDeck:true, attribute:"dark", level:4, atk:1550, def:1300, desc:"شيطان غريب بادرع طويلة و مخالب حادة." },
  { id:1624, slug:"ar13-025", name:"كرة الرّعد العملاقة", type:"monster", race:"thunder", gameDeck:true, attribute:"fire", level:2, atk:750, def:600, desc:"تندحرج على سطح الأرض و تصعق أعدائه بصرية الرعد." },
  { id:1625, slug:"ar13-026", name:"تونجيو", type:"monster", race:"warrior", gameDeck:true, attribute:"water", level:4, atk:1350, def:800, desc:"هذا الوحش بمسك بالأسماك الأخرى بلسانه الطويل ويمتص طاقتها." },
  { id:1626, slug:"ar13-027", name:"الإمبراطورة الحاكمة", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:5, atk:2100, def:1700, desc:"\"هسكيم\" + \"الملكة المزدوجة\"." },
  { id:1627, slug:"ar13-028", name:"الوحش الشاحب", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:4, atk:1500, def:1200, desc:"كل من يرى هذا الوحش الأزرق سيناله الهلع والرعب." },
  { id:1628, slug:"ar13-029", name:"السحلية الكهربائية", type:"monster", race:"reptile", gameDeck:true, attribute:"earth", level:4, atk:850, def:800, desc:"وحش أخر غير الرئيسي إذا هاجم هذا الوحش لا يمكنه الهجوم في الدور المقبل." },
  { id:1629, slug:"ar13-030", name:"العنكبوت القناص", type:"monster", race:"insect", gameDeck:true, attribute:"earth", level:4, atk:1600, def:1400, desc:"هذا الوحش يتغذى على أي شيء يمسك به بشبكته." },
  { id:1630, slug:"ar13-031", name:"السحلية المحاربة القديمة", type:"monster", race:"reptile", gameDeck:true, attribute:"earth", level:4, atk:1400, def:1100, desc:"هذه السحلية من النوع الذي كان مهيمن قبل وصول الأنسان." },
  { id:1631, slug:"ar13-032", name:"الملكة المزدوجة", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:2, atk:350, def:300, desc:"هذا الوحش بمكنه مهاجمة النقاط الأساسية مباشرة." },
  { id:1632, slug:"ar13-033", name:"تربت", type:"monster", race:"spellcaster", gameDeck:true, attribute:"earth", level:4, atk:1500, def:1800, desc:"حامي عرين الغابه يقال بأن هذه السحرة -الغارضة لوجودها- أبدية." },
  { id:1633, slug:"ar13-034", name:"القرص السحري", type:"monster", race:"spellcaster", gameDeck:true, attribute:"dark", level:4, atk:1350, def:1000, desc:"هذا الوحش يختبئ في قرص ولا يخرج إلا للهجوم." },
  { id:1634, slug:"ar13-035", name:"هيوصيب", type:"monster", race:"warrior", gameDeck:true, attribute:"water", level:4, atk:1500, def:900, desc:"هذا المخلوق له إمكانات هائلة في الهجوم لكن دفاعه ضعيف جداً." },
