// ===================== قرعة الخصم الدوّارة =====================
function startRoulette(){
  const keys=Object.keys(OPPONENTS); // الأربعة خصوم
  const ov=document.getElementById('roulette-ov');
  const track=document.getElementById('roulette-track');
  const result=document.getElementById('roulette-result');
  const flash=document.getElementById('roulette-flash');
  if(!ov||!track)return;
  // تجهيز الواجهة
  ov.classList.remove('landed');
  result.classList.remove('show');
  ov.style.removeProperty('--win-color');
  ov.style.removeProperty('--win-glow');
  // بناء شريط طويل: تكرار الخصوم عدة دورات لإيهام اللف الطويل
  const CARD_W=150+16; // عرض البطاقة + الهوامش
  const LOOPS=8;       // عدد الدورات المعروضة في الشريط
  track.innerHTML='';
  let seq=[];
  for(let l=0;l<LOOPS;l++){ for(const k of keys) seq.push(k); }
  seq.forEach(k=>{
    const o=OPPONENTS[k];
    const c=document.createElement('div');
    c.className='roulette-card';
    c.dataset.key=k;
    c.innerHTML='<img src="'+o.img+'" alt="'+o.name+'"><div class="rc-name">'+o.name+'</div>';
    track.appendChild(c);
  });
  // اختيار الخصم الفائز عشوائياً تماماً
  const winnerKey=keys[Math.floor(Math.random()*keys.length)];
  G_oppKey=winnerKey;
  // نحدد فهرس البطاقة الهدف في إحدى الدورات الأخيرة لضمان لف كافٍ
  const baseLoop=LOOPS-2; // الدورة قبل الأخيرة
  const winIdxInLoop=keys.indexOf(winnerKey);
  const targetIndex=baseLoop*keys.length+winIdxInLoop;
  // إظهار الشاشة وبدء اللف
  showScreen('menu-screen'); // التأكد أننا لسنا في شاشة أخرى عالقة
  ov.classList.add('vis','spinning');
  // حساب مسافة التوقف بحيث يستقر *مركز* البطاقة الهدف تحت مركز المؤشر
  const winW=document.querySelector('.roulette-window').clientWidth||340;
  const MARGIN=8;              // هامش يسار البطاقة
  const CARD_INNER=150;        // عرض البطاقة نفسها
  // مركز البطاقة i = i*CARD_W + MARGIN + CARD_INNER/2 (نسبة لبداية الشريط)
  // نريد هذا المركز عند winW/2 ⇒ finalX = winW/2 - (MARGIN + CARD_INNER/2) - targetIndex*CARD_W
  const finalX = winW/2 - (MARGIN + CARD_INNER/2) - targetIndex*CARD_W;
  // إزاحة البداية: نضع بطاقة عند المنتصف تقريباً قبل الانطلاق
  const startX = winW/2 - (MARGIN + CARD_INNER/2);
  // نبدأ من إزاحة بحيث يكون هناك مجال لف كبير
  track.style.transition='none';
  track.style.transform='translateX('+startX+'px)';
  // صوت التكتكة المتزامن مع مرور البطاقات
  let tickTimer=null;
  function startTicks(){
    let delay=55; // يبدأ سريعاً
    function tick(){
      sfx('flip');
      // التكتكة تتباطأ تدريجياً مع نهاية اللف
      delay*=1.06;
      if(delay<420){ tickTimer=setTimeout(tick,delay); }
    }
    tick();
  }
  // إطلاق اللف بعد إطار للسماح بإعادة الرسم
  requestAnimationFrame(()=>{ requestAnimationFrame(()=>{
    const DURATION=4200; // مدة اللف الكلية بالمللي ثانية
    track.style.transition='transform '+DURATION+'ms cubic-bezier(.12,.78,.18,1)'; // تباطؤ واقعي
    track.style.transform='translateX('+finalX+'px)';
    startTicks();
    vibrate&&vibrate([10]);
    // عند انتهاء اللف
    setTimeout(()=>{ rouletteLand(winnerKey,targetIndex); if(tickTimer)clearTimeout(tickTimer); }, DURATION+40);
  });});
}

// اقتباسات تحدّي مميزة لكل خصم تظهر عند اختياره في القرعة
const ROULETTE_QUOTES = {
  yugi:   ["القدر اختارك لتواجه ملك الألعاب!", "هل أنت مستعد لمبارزة لا تُنسى؟", "لنرَ إن كان قلبك بقوة أوراقك!"],
  joey:   ["استعد لمبارزة شرسة يا صاحبي!", "هتلعب ضد أقوى واحد... أنا!", "يلا نشوف مين الأحسن!"],
  kaiba:  ["تجرّأت على مواجهة سيد التنانين؟", "ستندم على وقوفك في طريقي!", "أرِني إن كنت تستحق وقتي!"],
  pegasus:["مرحباً بك في لعبتي الصغيرة~", "عين الألفية تنتظرك يا عزيزي!", "سيكون هذا مسلياً للغاية~"],
};
function rouletteLand(winnerKey,targetIndex){
  const ov=document.getElementById('roulette-ov');
  const track=document.getElementById('roulette-track');
  const flash=document.getElementById('roulette-flash');
  const result=document.getElementById('roulette-result');
  const o=OPPONENTS[winnerKey];
  ov.classList.remove('spinning');
  ov.classList.add('landed');
  // تلوين المؤشر والنتيجة بلون الخصم
  ov.style.setProperty('--win-color', o.color);
  ov.style.setProperty('--win-glow', hexToGlow(o.color));
  // ومضة الحسم
  if(flash){ flash.classList.remove('fire'); void flash.offsetWidth; flash.classList.add('fire'); }
  sfx('bigsummon'); vibrate&&vibrate([40,30,60]);
  // تمييز البطاقة الفائزة
  const cards=track.querySelectorAll('.roulette-card');
  if(cards[targetIndex]) cards[targetIndex].classList.add('is-winner');
  // إظهار اسم الخصم ولقبه واقتباسه المميز
  document.getElementById('rr-name').textContent=o.name;
  document.getElementById('rr-title').textContent=o.title+' • '+o.style;
  let qp=ROULETTE_QUOTES[winnerKey]||[''];
  let q=qp[Math.floor(Math.random()*qp.length)];
  let qEl=document.getElementById('rr-quote');
  if(qEl){ qEl.textContent='“'+q+'”'; qEl.style.animation='none'; void qEl.offsetWidth; qEl.style.animation=''; }
  result.classList.add('show');
  // بعد لحظة، الانتقال لشاشة الاقتباس ثم المبارزة
  setTimeout(()=>{
    ov.classList.remove('vis','landed');
    confirmOpponent();
  }, 2400);
}

// تحويل لون hex إلى توهّج rgba شفاف
function hexToGlow(hex){
  let h=hex.replace('#','');
  if(h.length===3){h=h.split('').map(c=>c+c).join('');}
  const r=parseInt(h.substr(0,2),16),g=parseInt(h.substr(2,2),16),b=parseInt(h.substr(4,2),16);
  return 'rgba('+r+','+g+','+b+',.85)';
}

function showOpponentSelect(){
  renderOpponents();
  showScreen('opp-screen');
}
function renderOpponents(){
  let grid=document.getElementById('opp-grid');grid.innerHTML='';
  Object.keys(OPPONENTS).forEach(key=>{
    let o=OPPONENTS[key];
    let card=document.createElement('div');
    card.className='opp-card'+(key===G_oppKey?' selected':'');
    card.style.setProperty('--opp-color',o.color);
    card.innerHTML='<div class="opp-portrait"><img src="'+o.img+'" alt="'+o.name+'"></div>'+
      '<div class="opp-info"><div class="opp-name">'+o.name+'</div>'+
      '<div class="opp-title">'+o.title+'</div>'+
      '<div class="opp-style">⚔ '+o.style+'</div>'+
      '<div class="opp-desc">'+o.desc+'</div></div>';
    card.onclick=()=>{G_oppKey=key;sfx('flip');renderOpponents();};
    grid.appendChild(card);
  });
}
function confirmOpponent(){
  let intro=document.getElementById('intro-ov');
  let o=OPPONENTS[G_oppKey];
  document.getElementById('intro-name-e').textContent=o.name;
  document.getElementById('intro-quote').textContent=YUGI_QUOTES[Math.floor(Math.random()*YUGI_QUOTES.length)];
  intro.classList.add('vis');
  setTimeout(()=>{intro.classList.remove('vis');playShuffle();},2600);
}
// حركة خلط الأوراق قبل المبارزة
function playShuffle(){
  let ov=document.getElementById('shuffle-ov');
  let stage=document.getElementById('shuffle-stage');
  if(!ov||!stage){beginDuel();return;}
  stage.innerHTML='';
  let cb=(typeof CARD_BACK!=='undefined')?CARD_BACK:'';
  // كومة من الأوراق المقلوبة
  for(let i=0;i<7;i++){
    let c=document.createElement('div');c.className='shuffle-card';
    c.style.setProperty('--cb','url('+cb+')');
    c.style.zIndex=String(i);
    c.style.animationDelay=(i*0.07)+'s';
    stage.appendChild(c);
    setTimeout(()=>c.classList.add('anim'), 30);
  }
  ov.classList.add('vis');
  if(SETTINGS.sfxOn){initAudio();
    let n=0,iv=setInterval(()=>{sfx('flip');if(++n>=5)clearInterval(iv);},220);
  }
  setTimeout(()=>{ ov.classList.remove('vis'); beginDuel(); }, 1500);
}
function beginDuel(){
  pickRandomArena();
  let dp=diffPreset();
  let {pd,ed,extra,pExtra}=buildDecks();
  G={phase:'main1',turn:'player',turnCount:1,firstTurn:true,toonWorld:null,fieldSpell:{p:null,e:null},exodiaTriggered:false,
     playerLP:8000,enemyLP:dp.enemyLP,
     playerHand:[],enemyHand:[],playerDeck:pd,enemyDeck:ed,
     pGrave:[],eGrave:[],
     pField:newField(),eField:newField(),
     selCard:null,selIdx:null,
     enemyExtra:(extra||[]),
     playerExtra:(pExtra||[]),
     normalSummoned:false,positionChanged:[],swords:0,skipDraw:false,
     tributeMode:null,attackMode:false,enemySummoned:false,opponent:G_oppKey};
  // (تُوزَّع اليد الافتتاحية لاحقاً عبر dealOpeningHands بأنميشن)
  _dispLP={p:8000,e:dp.enemyLP};
  clearLog();
  showScreen('duel-screen');buildField();renderAll();
  // set enemy name label in duel
  let en=document.getElementById('enemy-lp-name');if(en)en.textContent=OPPONENTS[G_oppKey].name;
  if(SETTINGS.music){initAudio();startMusic();}
  updateTurnGlow();
  // توزيع اليد الافتتاحية ورقةً ورقة بأنميشن وصوت سحب
  dealOpeningHands(()=>{
    setTimeout(()=>showFaceReaction('start',{force:true}),300);
    showMsg("المبارزة تبدأ! ⚔",1800);
    setPhase('main1');
    updateButtons();
  });
}
// توزيع اليد الافتتاحية: 6 للاعب، 5 للخصم — تُسحب بالتناوب ورقةً ورقة
function dealOpeningHands(done){
  // تسلسل السحب: نتناوب لاعب/خصم لإحساس "التوزيع"
  let seq=[];
  for(let i=0;i<6;i++){ seq.push('p'); if(i<5) seq.push('e'); }
  let i=0;
  let step=()=>{
    if(i>=seq.length){ if(done)done(); return; }
    let who=seq[i++];
    drawFrom(who);
    sfx('draw');
    if(typeof vibrate==='function' && who==='p') vibrate(12);
    animateDraw(who,()=>{ renderAll(); });
    // تأخير بين كل ورقة (أسرع قليلاً للخصم)
    setTimeout(step, who==='p'?230:150);
  };
  // مهلة بسيطة قبل البدء كي تستقر الشاشة
  setTimeout(step, 450);
}

