  { id:318, slug:"ar3-018", name:"نداء الممسوس", type:"trap", gameDeck:true, desc:"اختر وحشاً من مقبرتك وضعه في الملعب في وضعية الهجوم مكشوف، إذا دمر أحدهما يدمر الآخر." },
  { id:319, slug:"ar3-019", name:"كتاب القوانين", type:"trap", gameDeck:true, desc:"تنازل عن دورك." },
  { id:320, slug:"ar3-020", name:"الإهتزاز الأرضي", type:"trap", gameDeck:true, desc:"اختر نوعين من أوصاف الوحوش، تُدمر كل الوحوش المكشوفة بالملعب من نفس الوصف المختار." },
  { id:321, slug:"ar3-021", name:"الرّمح المسحور", type:"trap", gameDeck:true, desc:"عندما يهجم وحش من وحوش خصمك، أضف إلى نقاط حياتك الأساسية نقاطاً تساوي نقاط هجوم وحش خصمك." },
  { id:322, slug:"ar3-022", name:"جدار المرآة", type:"trap", gameDeck:true, desc:"أنقص النصف من نقاط هجوم كل وحوش خصمك المهاجمة، إدفع 2000 نقطة خلال كل دور، إذا لم تدفع تُدمر هذه الورقة." },
  { id:323, slug:"ar3-023", name:"هبّة الريح", type:"trap", gameDeck:true, desc:"بمكنك استعمال هذه الورقة عندما تدمر ورقة أو أوراق سحرية بتأثير ورقة، دمر ورقة سحر أو فخ في الملعب." },
  { id:324, slug:"ar3-024", name:"الثّلج القاهر", type:"trap", gameDeck:true, desc:"عندما تدمر ورقة أو أوراق فخ من أوراقك بالملعب بتأثير ورقة من أوراق خصمك، دمر ورقة فخ أو سحر بالملعب." },
  { id:325, slug:"ar3-025", name:"الدّرع الزّجاجي", type:"trap", gameDeck:true, desc:"فعّلها عندما يكون أحد الوحوش مجهزاً بأوراق تجهيز، تُلغى تأثيراتها كلها في دور تشغيلها." },
  { id:326, slug:"ar3-026", name:"دمار العالم", type:"trap", gameDeck:true, desc:"ألغِ تفعيل ورقة ملعب سحرية خلال الدور الذي فُعّلت فيه." },
  { id:327, slug:"ar3-027", name:"المجسّ الغامض", type:"trap", gameDeck:true, desc:"فعّلها عندما تكون في الملعب ورقة أو أوراق فخ ذو تأثير مستمر، وأبطل مفعولها خلال الدور الذي تُفعل فيه هذه الورقة." },
  { id:328, slug:"ar3-028", name:"متتبع المعادن", type:"trap", gameDeck:true, desc:"عندما تكون ورقة سحر مستمر مفعلة، أبطل مفعول أوراق الفخ المستمر خلال الدور الذي تُفعل فيه هذه الورقة." },
  { id:329, slug:"ar3-029", name:"الطبيب الملائكي", type:"trap", gameDeck:true, desc:"فعّلها عندما تنضرر نقاطك الأساسية، أضف 1000 نقطة لنقاط حياتك، بعدها أضف 500 نقطة عن كل ورقة الطبيب الملائكي في مقبرتك." },
  { id:330, slug:"ar3-030", name:"التملّك", type:"trap", gameDeck:true, desc:"فعّلها عندما يسحب خصمك ورقة في غير دور السحب، بعدها إسحب ورقتين من أوراق مجموعتك كلما سحب خصمك ورقة في غير دور السحب." },
  { id:331, slug:"ar3-031", name:"المصادرة الإجبارية", type:"trap", gameDeck:true, desc:"فعّلها عندما يستغني خصمك عن ورقة، بعدها كل مرة يستغني فيها عن ورقة، يكون خصمك مجبراً لرمي نفس عدد الأوراق التي رميت أنت من يدك." },
  { id:332, slug:"ar3-032", name:"الجراحة الوراثية", type:"trap", gameDeck:true, desc:"اختر نوعاً من الوحوش، طالما هذه الورقة بالملعب، كل الوحوش المكشوفة تصبح من النوع الذي اخترته." },
  { id:333, slug:"ar3-033", name:"قوانين القبيلة", type:"trap", gameDeck:true, desc:"اختر نوعاً من الوحوش، الوحوش من هذا النوع لا يمكنها الهجوم." },
  { id:334, slug:"ar3-034", name:"جندي الإحتياط", type:"trap", gameDeck:true, desc:"بمكنك تفعيلها إذا كان لديك 5 وحوش بالمقبرة أو أكثر، تستدعي أحد 3 وحوش من ملعبك كل دور وإلا دمرت بهجوم 1500 نقطة." },
  { id:335, slug:"ar3-035", name:"الفتنة الكبيرة", type:"trap", gameDeck:true, desc:"فعّل هذه الورقة عندما تقوم باستدعاء وحوش خصمك، أرجع كل وحوش الملعب إلى يد صاحبها." },
  { id:336, slug:"ar3-036", name:"وقف إطلاق النار", type:"trap", gameDeck:true, desc:"اقلب كل الوحوش المقلوبة، التأثيرات لا تُفعل، يُنضرر خصمك بـ500 نقطة لكل وحش ذو تأثير في الملعب." },
  { id:337, slug:"ar3-037", name:"ضياء التدخّل", type:"trap", gameDeck:true, desc:"أوراق الوحوش لا يمكن وضعها مقلوبة، الوحوش المستدعاة في وضعية الدفاع المقلوبة توضع مكشوفة." },
  { id:338, slug:"ar3-038", name:"احترام اللّعب", type:"trap", gameDeck:true, desc:"في كل دور من أدوار الخصمين بتوجب عليهما كشف أوراق أيديهما." },
  { id:339, slug:"ar3-039", name:"القبعات السحرية", type:"trap", gameDeck:true, desc:"تُفعل عند هجوم خصمك، اختر ورقتين من أوراقك ووحشاً من ملعبك، أخلط الأوراق الثلاث وضعهم في الملعب مقلوبين." },
  { id:340, slug:"ar3-040", name:"سيد الإبادة", type:"spell", gameDeck:true, desc:"دمر ورقة وحش في الملعب مقلوب وأخرجها من اللعبة، إذا كان للوحش تأثير تخرج كل أوراق مجموعات الخصمين المماثلة لهذا الوحش." },
  { id:341, slug:"ar3-041", name:"سيد الإبادة الثاني", type:"spell", gameDeck:true, desc:"دمر ورقة سحر أو فخ مقلوبة وأخرجها من اللعبة، إذا كانت ورقة فخ، كلا اللاعبين بتخلى عن كل الأوراق المماثلة لورقة الفخ التي دمرت." },
  { id:342, slug:"ar3-042", name:"القبر الفارغ", type:"spell", gameDeck:true, desc:"أنت وخصمك تستدعيان وحشاً واحداً من المقبرة إلى الملعب مقلوب في وضعية الدفاع." },
  { id:343, slug:"ar3-043", name:"الدّفن المعجّل", type:"spell", desc:"إدفع 800 نقطة، اختر وحشاً من المقبرة واستدعه في الملعب في وضعية الهجوم مكشوف، إذا دمرت هذه الورقة يدمر الوحش أيضاً." },
  { id:344, slug:"ar3-044", name:"التفتيش", type:"spell", gameDeck:true, desc:"خلال دور خصمك بمكنك رؤية ورقة واحدة من أوراق خصمك مع دفع 500 نقطة." },
