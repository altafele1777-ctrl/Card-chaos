function buildDecks(){
  let active=activeCardIds();
  // بطاقات كايبا معزولة: لا تدخل سطح اللاعب
  let monsters=active.filter(id=>{let c=cardById(id);return c.type==='monster'&&!c.ritual&&!c.kaiba&&!c.joeyDeck&&!c.gameDeck&&!c.fusionMon;});
  let spells=active.filter(id=>{let c=cardById(id);return c.type==='spell'&&!c.ritualFor&&!c.kaiba&&!c.joeyDeck&&!c.gameDeck&&!c.fusionSpell;});
  let traps=active.filter(id=>{let c=cardById(id);return c.type==='trap'&&!c.kaiba&&!c.joeyDeck&&!c.gameDeck;});
  // fallback: if a category is empty, pull from all NON-kaiba cards so deck still works
  if(!monsters.length) monsters=CARDS.filter(c=>c.type==='monster'&&!c.ritual&&!c.kaiba&&!c.joeyDeck&&!c.gameDeck&&!c.fusionMon).map(c=>c.id);
  if(!spells.length) spells=CARDS.filter(c=>c.type==='spell'&&!c.ritualFor&&!c.kaiba&&!c.joeyDeck&&!c.gameDeck).map(c=>c.id);
  if(!traps.length) traps=CARDS.filter(c=>c.type==='trap'&&!c.kaiba&&!c.joeyDeck&&!c.gameDeck).map(c=>c.id);
  function mkDeck(){
    let d=[];
    let ms=shuffle(monsters); for(let i=0;i<24;i++) d.push(ms[i%ms.length]);
    let sp=shuffle(spells);   for(let i=0;i<10;i++) d.push(sp[i%sp.length]);
    let tp=shuffle(traps);    for(let i=0;i<6;i++)  d.push(tp[i%tp.length]);
    return shuffle(d);
  }
  // الخصوم العامّون (يوغي/جوي/بيغاسوس): المكتبة العامة بدون بطاقات كايبا
  let allM=CARDS.filter(c=>c.type==='monster'&&!c.ritual&&!c.kaiba&&!c.joeyDeck&&!c.gameDeck&&!c.fusionMon).map(c=>c.id);
  let allS=CARDS.filter(c=>c.type==='spell'&&!c.ritualFor&&!c.kaiba&&!c.joeyDeck&&!c.gameDeck).map(c=>c.id);
  let allT=CARDS.filter(c=>c.type==='trap'&&!c.kaiba&&!c.joeyDeck&&!c.gameDeck).map(c=>c.id);
  function mkEnemyDeck(){
    let d=[];
    let ms=shuffle(allM); for(let i=0;i<24;i++) d.push(ms[i%ms.length]);
    let sp=shuffle(allS); for(let i=0;i<10;i++) d.push(sp[i%sp.length]);
    let tp=shuffle(allT); for(let i=0;i<6;i++)  d.push(tp[i%tp.length]);
    return shuffle(d);
  }
  // === سطح كايبا الحصري: فقط بطاقاته الـ58 (ما عدا وحوش الاندماج، تذهب للإكسترا) ===
  function mkKaibaDeck(){
    let km=CARDS.filter(c=>c.kaiba&&c.type==='monster'&&!c.fusionMon).map(c=>c.id);
    let ks=CARDS.filter(c=>c.kaiba&&c.type==='spell').map(c=>c.id);
    let kt=CARDS.filter(c=>c.kaiba&&c.type==='trap').map(c=>c.id);
    let d=[];
    let ms=shuffle(km); for(let i=0;i<26;i++) d.push(ms[i%ms.length]);
    let sp=shuffle(ks); for(let i=0;i<8;i++)  d.push(sp[i%sp.length]);
    let tp=shuffle(kt); for(let i=0;i<6;i++)  d.push(tp[i%tp.length]);
    return shuffle(d);
  }
  // الإكسترا ديك لكايبا (وحوش الاندماج)
  // === سطح جوي الحصري: فقط بطاقاته (ما عدا وحوش الاندماج، تذهب للإكسترا) ===
  function mkJoeyDeck(){
    let jm=CARDS.filter(c=>c.joeyDeck&&c.type==='monster'&&!c.fusionMon).map(c=>c.id);
    let js=CARDS.filter(c=>c.joeyDeck&&c.type==='spell').map(c=>c.id);
    let jt=CARDS.filter(c=>c.joeyDeck&&c.type==='trap').map(c=>c.id);
    let d=[];
    let ms=shuffle(jm); for(let i=0;i<26;i++) d.push(ms[i%ms.length]);
    let sp=shuffle(js); for(let i=0;i<8;i++)  d.push(sp[i%sp.length]);
    let tp=shuffle(jt); for(let i=0;i<6;i++)  d.push(tp[i%tp.length]);
    return shuffle(d);
  }
  let joeyExtra=CARDS.filter(c=>c.joeyDeck&&c.fusionMon).map(c=>c.id);
  let kaibaExtra=CARDS.filter(c=>c.kaiba&&c.fusionMon).map(c=>c.id);

  // ============================================================
  // === مجموعة اللعبة + بنّاء المجموعة العشوائية المتناغمة ===
  // ============================================================
  // "مجموعة اللعبة": كل بطاقات اللعبة (قديمة وجديدة) متاحة للنظام لبناء مجموعات الخصوم.
  // اللاعب لا يصل لهذه القائمة؛ يستخدمها النظام فقط لاختيار مجموعة الخصم.

  // === ميول الشخصيات: كل خصم يفضّل كروتاً تناسب طبعه (نصف السطح تقريباً) ===
  // favMon/favSpell/favTrap: كروت محبّبة بالاسم (slug).
  // monScore: دالة تعطي وزناً إضافياً لأي وحش يناسب الشخصية (لتنويع غير محصور بالأسماء).
  const OPP_DECK_BIAS = {
    yugi: { // متوازن: سحرة وأبطال كلاسيكيون
      favMon:['dark-magician','dark-magician-girl','summoned-skull','gaia-fierce-knight','curse-of-dragon','obnoxious-celtic-guard','kuriboh','magician-of-faith','neo-the-magic-swordsman','black-luster-soldier','buster-blader'],
      favSpell:['monster-reborn','dark-hole','pot-of-greed','change-of-heart','card-of-sanctity'],
      favTrap:['mirror-force','magic-cylinder','spellbinding-circle','magical-hats'],
      monScore:c=>(c.attribute==='dark'?1:0)+(c.atk>=2500?1:0),
    },
    joey: { // عدواني: محاربون وتنانين وحظ
      favMon:['red-eyes-black-dragon','baby-dragon','time-wizard','panther-warrior','axe-raider','gearfried-iron-knight','jinzo','insect-queen','gilford-lightning','ansatsu','beaver-warrior','rocket-warrior','hayabusa-knight'],
      favSpell:['graceful-dice','scapegoat','giant-trunade','lightning-blade','shield-and-sword'],
      favTrap:['skull-dice','kunai-with-chain','fairy-box','magical-arm-shield'],
      monScore:c=>(c.atk>=1700?1:0)+(c.attribute==='earth'?1:0),
    },
    kaiba: { // شرس: تنانين ووحوش ضخمة بهجوم عالٍ
      favMon:['blue-eyes-white-dragon','battle-ox','la-jinn','vorse-raider','judge-man','swordstalker','rude-kaiser','kaiser-glider','x-head-cannon','y-dragon-head','z-metal-tank','blade-knight','hitotsu-me-giant'],
      favSpell:['monster-reborn','enemy-controller','cost-down','soul-exchange','shrink'],
      favTrap:['ring-of-destruction','crush-card-virus','virus-cannon'],
      monScore:c=>(c.atk>=1800?2:0)+(c.level>=5?1:0)+(/dragon/i.test(c.slug)?1:0),
    },
    pegasus: { // ماكر: فخاخ وحيل وشياطين
      favMon:['ryu-kishin','witty-phantom','mystic-clown','sorcerer-of-the-doomed','claw-reacher','baron-of-the-fiend-sword','man-eating-treasure-chest','feral-imp','dragon-zombie'],
      favSpell:['dark-hole','de-spell','mystical-space-typhoon','yami','change-of-heart'],
      favTrap:['trap-hole','dragon-capture-jar','reverse-trap','spellbinding-circle','time-seal','waboku'],
      monScore:c=>(c.attribute==='dark'?1:0),
    },
  };

  function buildRandomEnemy(oppKey){
    const bias = OPP_DECK_BIAS[oppKey] || OPP_DECK_BIAS.yugi;
    // تجمّعات حسب النوع/المستوى من مجموعة اللعبة كاملة (نستبعد الطقسي لتبسيط اللعب)
    const isNormalMon = c => c.type==='monster' && !c.fusionMon && !c.ritual && !c.ritualFor;
    const monByLvl = lv => CARDS.filter(c=>isNormalMon(c) && (Array.isArray(lv)?lv.includes(c.level):c.level===lv));
    const lvl4 = monByLvl(4);
    const lvl5 = monByLvl(5);
    const lvl6 = monByLvl(6);
    const lvl3 = monByLvl(3);
    const lvl12 = monByLvl([1,2]);
    const allSpells = CARDS.filter(c=>c.type==='spell' && !c.fusionSpell && !c.ritualFor);
    const allTraps  = CARDS.filter(c=>c.type==='trap');
    // وحوش الاندماج القابلة للتنفيذ فقط: كل موادها وحوش عادية ضمن المستويات 1-6
    // (حتى يستطيع الخصم استكمال الاندماج فعلياً ضمن مجموعته العشوائية)
    const playableFusion = c => {
      if(!c.fusionMon || !Array.isArray(c.mats) || !c.mats.length) return false;
      return c.mats.every(slug=>{
        let mc = CARDS.find(x=>x.slug===slug);
        return mc && isNormalMon(mc) && mc.level>=1 && mc.level<=6;
      });
    };
    const allFusions= CARDS.filter(playableFusion);

    // يسحب n عناصر فريدة من مصفوفة (بدون تكرار قدر الإمكان)
    function pickUnique(pool, n){
      let s=shuffle(pool); let out=[];
      for(let i=0;i<n;i++){ out.push(s[i % s.length]); }
      return out;
    }

    // --- 1) اختر وحش الاندماج أولاً لضمان التناغم ---
    let fusion = shuffle(allFusions)[0];
    let deckMonsters = [];

    // --- 2) لو لوحش الاندماج مواد، احرص أن تكون مواده ضمن وحوش المجموعة ---
    let matCards = [];
    if(fusion && Array.isArray(fusion.mats)){
      fusion.mats.forEach(slug=>{
        let mc = CARDS.find(c=>c.slug===slug && isNormalMon(c));
        if(mc && !matCards.some(x=>x.id===mc.id)) matCards.push(mc);
      });
    }

    // --- 3) ابنِ الوحوش حسب القيود (24 وحش) مع حقن المواد والمفضّلات ---
    // ترتيب أولوية الوحوش في كل مستوى: مواد الاندماج، ثم مفضّلات الشخصية، ثم وحوش
    // عالية الـ monScore، ثم عشوائي — بهدف "متوازن" (نحو نصف السطح مُحابى).
    let favMonSet = new Set(bias.favMon||[]);
    function fillLevel(pool, count){
      let chosen = [];
      // 1) مواد الاندماج التابعة لهذا المستوى أولاً
      let mats = matCards.filter(mc=>pool.some(p=>p.id===mc.id));
      mats.forEach(mc=>{ if(chosen.length<count) chosen.push(mc); });
      // 2) رتّب باقي الوحوش: المفضّلة بالاسم أعلى، ثم حسب monScore، مع كسر تعادل عشوائي
      let rest = pool.filter(p=>!chosen.some(c=>c.id===p.id));
      rest = shuffle(rest).map(c=>{
        let score = (favMonSet.has(c.slug)?5:0) + (bias.monScore?bias.monScore(c):0);
        return {c, score};
      }).sort((a,b)=>b.score-a.score).map(x=>x.c);
      // 3) خذ النصف الأعلى أولوية، لكن أبقِ تنوعاً: نملأ تقريباً 60% من المرتّب ثم نخلط الباقي
      let i=0;
      while(chosen.length<count){
        if(rest.length){ chosen.push(rest[i % rest.length]); i++; }
        else { chosen.push(pool[chosen.length % pool.length]); }
      }
      return chosen.slice(0,count);
    }

    let mLvl4 = fillLevel(lvl4, 10);
    let mLvl5 = fillLevel(lvl5, 4);
    let mLvl6 = fillLevel(lvl6, 3);
    let mLvl3 = fillLevel(lvl3, 5);
    let mLvl12= fillLevel(lvl12, 2);
    deckMonsters = [...mLvl4,...mLvl5,...mLvl6,...mLvl3,...mLvl12]; // 24 وحش

    // --- 4) التعاويذ (10): مفضّلات الشخصية أولاً، ثم المفيدة العامة، ثم الباقي ---
    const usefulSpellSlugs = ['dark-hole','raigeki','pot-of-greed','monster-reborn','j-dark-hole','j-pot-of-greed','j-monster-reborn','k-monster-reborn','graceful-charity','card-of-sanctity','swords-of-revealing-light','change-of-heart','brain-control','mystical-space-typhoon','de-spell','shrink','giant-trunade','scapegoat','card-of-demise'];
    let favSpellSet = new Set(bias.favSpell||[]);
    let favSpells   = shuffle(allSpells.filter(c=>favSpellSet.has(c.slug)));
    let usefulSpells= shuffle(allSpells.filter(c=>usefulSpellSlugs.includes(c.slug)&&!favSpellSet.has(c.slug)));
    let otherSpells = shuffle(allSpells.filter(c=>!usefulSpellSlugs.includes(c.slug)&&!favSpellSet.has(c.slug)));
    // المفضّلة مكرّرة بقوة لرفع احتمالها (نحو نصف التعاويذ)، ثم المفيدة، ثم الباقي
    let spellPool = [...favSpells, ...favSpells, ...favSpells, ...favSpells, ...usefulSpells, ...otherSpells];
    let deckSpells = pickUnique(spellPool, 10);
    // إن وُجد وحش اندماج: اضمن وجود ورقة الانصهار حتى يُنفَّذ الاندماج فعلياً
    if(fusion){
      let poly = CARDS.find(c=>c.fusionSpell);
      if(poly && !deckSpells.some(c=>c.id===poly.id)){
        deckSpells[deckSpells.length-1] = poly; // استبدل آخر تعويذة بالانصهار
      }
    }

    // --- 5) الأفخاخ (6): مفضّلات الشخصية أولاً ثم عشوائي ---
    let favTrapSet = new Set(bias.favTrap||[]);
    let favTraps   = shuffle(allTraps.filter(c=>favTrapSet.has(c.slug)));
    let otherTraps = shuffle(allTraps.filter(c=>!favTrapSet.has(c.slug)));
    let trapPool   = [...favTraps, ...favTraps, ...favTraps, ...favTraps, ...otherTraps]; // مضاعفة قوية للمفضّلة
    let deckTraps  = pickUnique(trapPool, 6);

    // --- 6) جمّع المجموعة (40 كرت رئيسي) + الإكسترا ---
    let d = [...deckMonsters.map(c=>c.id), ...deckSpells.map(c=>c.id), ...deckTraps.map(c=>c.id)];
    let ex = fusion ? [fusion.id] : [];
    return { deck: shuffle(d), extra: ex };
  }

  // كل خصم يبني مجموعة عشوائية متوازنة تميل لكروته المفضّلة (نصف السطح تقريباً)
  let rnd = buildRandomEnemy(G_oppKey);
  let enemyDeck = rnd.deck;
  let extraDeck = rnd.extra;
  // إكسترا ديك اللاعب: فقط وحوش الاندماج التي أملكها أنا (موجودة في مجموعتي، غير مستبعدة).
  // وحوش الاندماج المعلّمة gameDeck تخصّ مكتبة الخصم فقط، فلا تدخل إكستراي.
  // (مستقبلاً: عند ربح وحش اندماج يُضاف لمجموعتي فيظهر هنا تلقائياً)
  let ownedSet = new Set(active);
  let playerExtra = FUSION_MON_SLUGS.filter(sl=>{
    let c = cardBySlug(sl);
    return c && ownedSet.has(c.id); // الوحش نفسه مملوك في مجموعتي
  }).map(sl=>{let c=cardBySlug(sl); return c?c.id:null;}).filter(x=>x!=null);
  // إكسترا الخصم: كل وحوش الاندماج التي موادها موجودة في الكتالوج (الخصم يلعب بكل الأوراق)
  let enemyFusionExtra = FUSION_MON_SLUGS.filter(sl=>{
    let mats=(typeof FUSION_DB!=='undefined')?FUSION_DB[sl]:null;
    return mats && mats.length && mats.every(ms=>cardBySlug(ms));
  }).map(sl=>{let c=cardBySlug(sl); return c?c.id:null;}).filter(x=>x!=null);
  let mergedEnemyExtra = Array.from(new Set([...(extraDeck||[]), ...enemyFusionExtra]));
  return {pd:mkDeck(),ed:enemyDeck,extra:mergedEnemyExtra,pExtra:playerExtra};
}

function newField(){return {m:[null,null,null,null,null],s:[null,null,null,null,null]};}
function drawFrom(who){let deck=who==='p'?G.playerDeck:G.enemyDeck;let hand=who==='p'?G.playerHand:G.enemyHand;if(!deck.length){if(who==='p')endGame('lose');else endGame('win');return null;}let c=deck.splice(0,1)[0];hand.push(c);if(typeof checkExodia==='function')checkExodia(who);return c;}

function showScreen(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');}

