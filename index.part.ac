  { id:369, slug:"ar3-069", name:"تأثير النّيزك الجنّي", type:"spell", gameDeck:true, desc:"إذا هجم وحشك وهو مجهز بهذه الورقة على وحش خصمك في وضعية الدفاع ونقاط دفاعه أقل من نقاط هجوم وحشك، يُخصم الفرق من نقاط حياته الأساسية كناتج للهجوم." },
  { id:370, slug:"ar3-070", name:"الإنتقال الأقصى", type:"spell", gameDeck:true, desc:"يضاعف هجوم كل وحش من نوع آلة موجود بالملعب، عند نهاية الدور كل الوحوش المؤثرين بهذه الورقة يدمرون." },
  { id:371, slug:"ar3-071", name:"مطر الرحمة", type:"spell", gameDeck:true, desc:"تزيد لكلا اللاعبين 1000 نقطة أساسية." },
  { id:372, slug:"ar3-072", name:"شفاء الوحش", type:"spell", gameDeck:true, desc:"أضف وحشاً بملعبك إلى أوراقك، ثم أضف أوراق يدك إلى أوراقك التي كانت بيدك." },
