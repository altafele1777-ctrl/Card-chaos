function defaultExcluded(){
  // مجموعتي تبدأ فارغة: استبعد كل أوراق المخزون (pool). تُضاف الأوراق المختارة يدوياً لاحقاً.
  return CARDS.filter(c=>!c.kaiba&&!c.joeyDeck&&!c.gameDeck).map(c=>c.id);
}
function loadExcluded(){
  // إعادة تعيين لمرة واحدة: تفريغ المجموعة بالكامل (نسخة v3)
  try{
    if(localStorage.getItem('poc_excluded_v8')===null){
      let d=defaultExcluded();
      localStorage.setItem('poc_excluded',JSON.stringify(d));
      localStorage.setItem('poc_excluded_v2','1');
      localStorage.setItem('poc_excluded_v8','1');
      return d;
    }
  }catch(e){}
  try{let s=localStorage.getItem('poc_excluded');if(s!==null){let a=JSON.parse(s);if(Array.isArray(a)&&a.length===0&&localStorage.getItem('poc_excluded_v2')===null){return defaultExcluded();}return a;}}catch(e){}return defaultExcluded();}
function saveExcluded(arr){try{localStorage.setItem('poc_excluded',JSON.stringify(arr));localStorage.setItem('poc_excluded_v2','1');}catch(e){}}
function isExcluded(id){return loadExcluded().includes(id);}
function activeCardIds(){let ex=loadExcluded();return CARDS.filter(c=>!c.kaiba&&!c.joeyDeck&&!c.gameDeck&&!ex.includes(c.id)).map(c=>c.id);}

