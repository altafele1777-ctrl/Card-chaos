function checkEnd(){if(G.playerLP<=0){G.playerLP=0;updateLP();endGame('lose');}else if(G.enemyLP<=0){G.enemyLP=0;updateLP();endGame('win');}}
function loadOwned(){ try{let s=localStorage.getItem('poc_owned');if(s)return JSON.parse(s);}catch(e){} return []; }
function saveOwned(arr){ try{localStorage.setItem('poc_owned',JSON.stringify(arr));}catch(e){} }
function ownedCount(id){ return loadOwned().filter(x=>x===id).length; }
var MAX_COPIES=3;
function awardRandomCard(){
  // اختر بطاقة عشوائية من كل أوراق اللعبة، بحد أقصى 3 نسخ لكل بطاقة
  try{
    let owned=loadOwned();
    let counts={};
    owned.forEach(id=>{counts[id]=(counts[id]||0)+1;});
    // المرشحون: بطاقات قابلة للامتلاك لم تبلغ الحد الأقصى (3 نسخ)
    let pool=CARDS.filter(c=>!c.kaiba&&!c.joeyDeck&&(counts[c.id]||0)<MAX_COPIES);
    if(pool.length===0) return null; // اللاعب يملك 3 نسخ من كل شيء
    // 1) حدّد نوع الجائزة بنسب متناسبة (تضمن ظهوراً عادلاً للسحر والفخ)
    //    وحش 55% — سحر 28% — فخ 17%
    let byType={monster:[],spell:[],trap:[]};
    pool.forEach(c=>{ if(byType[c.type]) byType[c.type].push(c); });
    let typeRoll=Math.random(), chosenType;
    if(typeRoll<0.55 && byType.monster.length) chosenType='monster';
    else if(typeRoll<0.83 && byType.spell.length) chosenType='spell';
    else if(byType.trap.length) chosenType='trap';
    else chosenType = byType.monster.length?'monster':(byType.spell.length?'spell':'trap');
    let group=byType[chosenType].length?byType[chosenType]:pool;
    // 2) ندرة حسب القوة داخل النوع المختار (الأقوى أندر) — للوحوش فقط
    let weightOf=(c)=>{
      if(c.type!=='monster') return 8; // السحر/الفخ وزن متساوٍ نسبياً
      let atk=c.atk||0, lvl=c.level||1;
      if(atk>=3000||lvl>=9) return 1;   // أساطير نادرة جداً
      if(atk>=2500||lvl>=8) return 2;   // قوية جداً
      if(atk>=2000||lvl>=7) return 4;   // قوية
      if(atk>=1500||lvl>=5) return 7;   // متوسطة
      return 12;                        // ضعيفة/شائعة
    };
    let total=0; group.forEach(c=>{ total+=weightOf(c); });
    let r=Math.random()*total, won=group[0];
    for(let c of group){ r-=weightOf(c); if(r<=0){ won=c; break; } }
    owned.push(won.id);
    saveOwned(owned);
    // اجعله متاحاً في "مجموعتي" خارج المجموعة (دون العبث بالمجموعة الحالية)
    let ex=loadExcluded();
    if(!ex.includes(won.id)){ ex.push(won.id); saveExcluded(ex); }
    return {card:won, copies:(counts[won.id]||0)+1};
  }catch(e){ return null; }
}
function showWonCard(won){
  let box=document.getElementById('won-card');
  if(!box) return;
  if(!won||!won.card){ box.style.display='none'; return; }
  let card=won.card;
  let img=document.getElementById('won-card-img');
  let nm=document.getElementById('won-card-name');
  if(img){ let src=cardImg(card); if(src) img.src=src; }
  if(nm) nm.textContent=card.name||'';
  // عرض رقم النسخة المملوكة (مثلاً: النسخة 2 من 3)
  let cnt=document.getElementById('won-card-copies');
  if(cnt){ cnt.textContent = won.copies>1 ? ('تملك الآن '+won.copies+' نسخ من هذه البطاقة') : 'بطاقة جديدة في مجموعتك!'; }
  box.style.display='flex';
}
