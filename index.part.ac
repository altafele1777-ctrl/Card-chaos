  { id:68, slug:"ar-068", name:"ماكر العيون السوداء", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:2, atk:0, def:1400, desc:"ما دامت هذه الورقة في الملعب أحد وحوش خصمك المختار لا يمكنه الهجوم." },
  { id:69, slug:"ar-069", name:"ملكة الحشرات", type:"monster", race:"insect", gameDeck:true, attribute:"earth", level:7, atk:2200, def:2400, desc:"تضحي بوحش من ملك كي تهجم، هجومة بريد 200 نقطة لكل وحش بالملعب." },
  { id:70, slug:"ar-070", name:"ستار السحر الأسود", type:"spell", gameDeck:true, desc:"عند تفعيلها لا يمكنك استدعاء أي وحش، يمكنك استدعاء ساحر الظلام استدعاء خاص لكن بعد التخلي عن نصف نقاط حياتك." },
  { id:71, slug:"ar-071", name:"الوحش الخرافي الطائر", type:"monster", race:"winged", gameDeck:true, attribute:"wind", level:6, atk:2100, def:1800, desc:"وحش دمج: بيرفوميت + غازلن ملك وحوش الأساطير." , fusionMon:true},
  { id:72, slug:"ar-072", name:"وحش جيلفر", type:"monster", race:"zombie", gameDeck:true, attribute:"dark", level:7, atk:2200, def:2500, desc:"يفعل هذا الخاصية عندما تكون هذه الورقة بالمقبرة، يريد للوحش المختار في الملعب 500 نقطة هجوم." },
  { id:73, slug:"ar-073", name:"أجنحة غريفون", type:"trap", gameDeck:true, desc:"عندما يفعل خصمك ربشة هاربي، كل أوراق سحر وفخ خصمك تدمر مكان أوراقك." },
  { id:74, slug:"ar-074", name:"الجندي الحركيّ", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:3, atk:1350, def:1800, desc:"خلال المعركة ضد الوحوش من نوع محارب تضاف لهجومه ودفاعه 2000 نقطة عند احتساب الأضرار." },
  { id:75, slug:"ar-075", name:"سكيلانج", type:"monster", race:"warrior", gameDeck:true, attribute:"light", level:2, atk:900, def:400, desc:"يمكنك سحب ورقة من مجموعتك." },
  { id:76, slug:"ar-076", name:"إنفجار المجال", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:1400, def:1400, desc:"إذا كان مقلوباً وهوجم، وعند دور استعداده تدمر الوحوش ويخصم من نقاط خصمك ما قدره هجوم الوحش المدمر." },
  { id:77, slug:"ar-077", name:"مباركة الملك", type:"spell", gameDeck:true, desc:"لا تستطيع استخدام هذه الورقة إلا عندما تهاجم نقاط حياة معارضك مباشرة، يمكنك زيادة نقاط حياتك بمبلغ يساوي الضرر الذي سببه لخصمك." },
  { id:78, slug:"ar-078", name:"آلة الزمن", type:"trap", gameDeck:true, desc:"عندما يرسل أحد وحوشك للمقبرة خلال هجوم، يمكنك استدعاءه استدعاء خاص للملعب في وضعيته السابقة." },
  { id:79, slug:"ar-079", name:"ساحرة الظلام دبنوم", type:"monster", race:"spellcaster", gameDeck:true, attribute:"light", level:4, atk:1800, def:1050, desc:"عندما لا يكون الحظ في صالحها تدخل المعركة دون تراجع." },
  { id:80, slug:"ar-080", name:"كابا الأخضر", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:3, atk:650, def:900, desc:"اختر ورقتين مقلوبتين فخ أو سحر بالملعب ودمرهما." },
  { id:81, slug:"ar-081", name:"الأردواز المحارب", type:"monster", race:"warrior", gameDeck:true, attribute:"wind", level:4, atk:1900, def:400, desc:"عبد قليه بريد هجومه ودفاعه 500 نقطة، الوحش الذي يدمر هذه الورقة بهجوم ودفاع." },
  { id:82, slug:"ar-082", gameDeck:true, name:"بيرفوميت", type:"monster", race:"zombie", attribute:"dark", level:4, atk:1400, def:1800, desc:"عندما يستدعى استدعاءً عادياً أحضر غازلن ملك وحوش الأساطير إلى يدك." },
  { id:83, slug:"ar-083", name:"غاردنا المدرّع الكبير", type:"monster", race:"machine", gameDeck:true, attribute:"earth", level:4, atk:100, def:2600, desc:"إذا كان مقلوباً واستهدف بورقة سحرية يبطل مفعولها ويعود لوضعيته، عندما تهاجم بقلب وتحول لوضعية الهجوم." },
  { id:84, slug:"ar-084", name:"ريريوكو", type:"spell", gameDeck:true, desc:"خلال دورك، يمكنك أن تقلص هجوم أحد وحوش خصمك إلى النصف وإضافة النصف لأحد وحوشك بالملعب." },
  { id:85, slug:"ar-085", name:"ساحر العبث الأسود", type:"monster", race:"spellcaster", gameDeck:true, attribute:"dark", level:8, atk:2800, def:2600, ritual:true, ritualSpellName:"طقس السحر الأسود", desc:"يستدعى بالورقة السحرية طقس السحر الأسود بوحوش مستواها 8 أو أكثر من الملعب أو من يدك." },
  { id:86, slug:"ar-086", name:"سبير-شتاين", type:"monster", race:"beast", gameDeck:true, attribute:"dark", level:2, atk:700, def:500, desc:"فعل تأثير هذا الوحش وصحي بـ5000 نقطة أساسية واستدعى وحش ادماج في وضعه الهجوم." },
  { id:87, slug:"ar-087", name:"ماكيو", type:"spell", gameDeck:true, desc:"اختر عملاق الفرس أو وحش رعدي، كل وحوش الخصم التي لديها دفاع أقل من هجوم الورقة التي اخترت تدمر، ونمر دون القيام بالهجوم." },
  { id:88, slug:"ar-088", name:"الصندوق الغامض", type:"spell", gameDeck:true, desc:"اختر وحشاً من جهتك ووحشاً من جهة خصمك، بدمر وحش خصمك وتحصل على وحشك كتعويض." },
  { id:89, slug:"ar-089", name:"ريكراس ليفر", type:"monster", race:"beast", gameDeck:true, attribute:"fire", level:3, atk:1600, def:100, desc:"كل لاعب يسحب ورقة من أوراق خصمه وبرميها، كل وحش بدمر بهذه الورقة بعد 500 نقطة من الدفاع والهجوم." },
  { id:90, slug:"ar-090", name:"المحارب من البعد المختلف", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:4, atk:1200, def:1000, desc:"إذا هاجم أو هوجم بنسحب هو ووحش الخصم من اللعبة." },
  { id:91, slug:"ar-091", name:"ملك الآلات", type:"monster", race:"machine", gameDeck:true, attribute:"earth", level:7, atk:2200, def:2000, desc:"أضف لهجوم هذا الوحش 100 نقطة لكل وحش من نوع آلة في الملعب مكشوف." },
  { id:92, slug:"ar-092", name:"الفراشة العملاقة", type:"monster", race:"insect", gameDeck:true, attribute:"earth", level:7, atk:3500, def:3000, desc:"يستدعى استدعاءً خاصاً بنصيحة الفراشة الصغيرة ابتداءً من الدور 6 بعد أن تكون الفراشة الصغيرة مجهزة بشرنقة التطور." },
  { id:93, slug:"ar-093", name:"خاتم الأقدمين", type:"spell", gameDeck:true, desc:"إدفع 1000 نقطة واقلب كل أوراق خصمك، بعد رؤيتهم أرجعهم لوضعهم السابق." },
  { id:94, slug:"ar-094", name:"طقس السحر الأسود", type:"spell", gameDeck:true, ritualFor:"ar-085", desc:"لاستدعاء وحش الطقوس ساحر العبث الأسود، عليك التضحية بوحوش ذات مستوى 8 أو أكثر من ملعبك أو من يدك." },
  { id:95, slug:"ar-095", name:"شوغن الدفاع المطلق", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:7, atk:1550, def:2500, desc:"يستدعى في وضعية دفاع، من أجل الهجوم يجب تغييرها إلى وضعية الهجوم." },
  { id:96, slug:"ar-096", name:"المُضاعف", type:"spell", gameDeck:true, desc:"صحِّ بورقة كوريبو مكشوفة في الملعب، وضع كوريبو في كل مكان وحوش فارغ بوضعية الدفاع، هؤلاء لا صحي بهم." },
  { id:97, slug:"ar-097", name:"قفص الكوابيس", type:"spell", gameDeck:true, desc:"بعد تفعيل هذه الورقة لا يمكنك لا أنت ولا خصمك الهجوم، تدمر تلقائياً بعد مرور دورين." },
