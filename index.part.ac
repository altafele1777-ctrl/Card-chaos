// Attack directly handler when enemy field empty
function tryDirectAttack(){
  if(G.phase!=='battle')return;
  let hasEnemyMon=G.eField.m.some(s=>s);
  if(hasEnemyMon){showMsg("يجب مهاجمة مونستر أولاً",1500);return;}
  let atkSlot=G.pField.m[G.attacker];if(!atkSlot)return;
  if(atkSlot.attacked){showMsg("هاجم هذا المونستر بالفعل",1300);return;}
  let atkCard=cardById(atkSlot.id);
  let aIdx=G.attacker;
  // زمبيرا الظلامي: لا يمكنه الهجوم المباشر
  if(atkCard.slug==='ar6-016'||atkCard.slug==='ar14-039'){ showMsg('🦇 زمبيرا الظلامي لا يمكنه الهجوم المباشر',1800); return; }
  // ظلام العفريت: ادفع 1000 نقطة كي يهاجم — نافذة نعم/لا
  if((atkCard.slug==='ar5-069'||atkCard.slug==='ar13-092') && !atkSlot._paidAttack){
    if(G.playerLP<=1000){ showMsg('👁 ظلام العفريت! لا تملك 1000 نقطة لتدفعها',2000); return; }
    promptYesNo('👁 ظلام العفريت','ادفع 1000 نقطة أساسية كي تهاجم بهذا الوحش؟', atkSlot.id, ()=>{
      G.playerLP-=1000; sfx('lifeloss'); updateLP(); atkSlot._paidAttack=true;
      showMsg('👁 دفعت 1000! ظلام العفريت يهاجم',1700);
      setTimeout(()=>tryDirectAttack(),400);
    }, ()=>{ G.attackMode=false;renderField(); });
    return;
  }
  // النمر المحارب: لا يهاجم إلا بالتضحية بوحش آخر من ملعبك (يختاره اللاعب). إن لم يوجد وحش آخر فلا يهاجم.
  if(atkCard.slug==='ar-064'||atkCard.slug==='ar9-087'||atkCard.slug==='dup-7'){
    let sacrIdx=[]; G.pField.m.forEach((x,i)=>{ if(x&&i!==aIdx) sacrIdx.push(i); });
    if(sacrIdx.length===0){ showMsg('🐯 النمر المحارب لا يهاجم إلا بالتضحية بوحش آخر لديك (لا يضحّي بنفسه)',2200); return; }
    if(typeof pickCard==='function'){
      let ids=sacrIdx.map(i=>G.pField.m[i].id);
      pickCard('🐯 النمر المحارب','اختر وحشاً من ملعبك للتضحية به كي يهاجم النمر مباشرة',ids,(chosenId)=>{
        let si=-1; for(let i=0;i<5;i++){ if(i!==aIdx&&G.pField.m[i]&&G.pField.m[i].id===chosenId){ si=i; break; } }
        if(si<0){ G.attackMode=false;renderField();return; }
        let sacName=cardById(G.pField.m[si].id).name;
        destroyMonster('p',si);
        showMsg('🐯 ضحّيت بـ'+sacName+'! النمر يهاجم مباشرة',1800);
        if(!G.pField.m[aIdx]){ G.attackMode=false;renderAll();return; }
        let dmg2=effATK(atkCard,'p',G.pField.m[aIdx]);
        let go=()=>{
          flyAttack('p',aIdx,getLPCenter('e'),()=>{
            sfx('directhit');dealBattleDmg('e',dmg2);if(G.enemyLP>0&&G.enemyLP<2500)setTimeout(()=>showFaceReaction('worried'),700);
            cinematicSlowmo(550);
            showMsg("هجوم مباشر! ⚔ "+dmg2,1800);addLog('🎯 هجوم مباشر! -'+dmg2);
            markAttacked(G.pField.m[aIdx]);G.attackMode=false;G.attacker=null;renderAll();checkEnd();
          });
        };
        let trap3=findEnemyActiveTrap(['magic-cylinder','waboku','negate-attack','ring-of-destruction','skull-dice','fairy-box']);
        if(trap3){promptEnemyTrap(trap3,()=>executeEnemyTrap(trap3,aIdx,atkCard),go);} else { go(); }
      });
      return;
    }
  }
  let dmg=effATK(atkCard,'p',atkSlot);
  let dealDirect=()=>{
    flyAttack('p',aIdx,getLPCenter('e'),()=>{
      sfx('directhit');dealBattleDmg('e',dmg);if(G.enemyLP>0&&G.enemyLP<2500)setTimeout(()=>showFaceReaction('worried'),700);
      let lpBar=document.getElementById('elp-fill');if(lpBar&&lpBar.parentElement)lpBar.parentElement.classList.add('shake');
      setTimeout(()=>{let b=document.getElementById('elp-fill');if(b&&b.parentElement)b.parentElement.classList.remove('shake');},400);
      // لحظة سينمائية للهجوم المباشر
      cinematicSlowmo(550);
      showMsg("هجوم مباشر! ⚔ "+dmg,1800);
      addLog('🎯 هجوم مباشر! -'+dmg);
      // الساحر المقنّع/المدمر: عند إلحاق ضرر مباشر، اسحب ورقة
      if(['ar6-078','ar13-001'].includes(atkCard.slug)){ if(arDrawCard('p'))setTimeout(()=>showMsg('🎭 '+atkCard.name+'! سحبت ورقة',1700),900); }
      // قوة هجوم العفاريت: بعد الهجوم المباشر تتحول لوضع الدفاع وتُقفل حتى دورك التالي
      if(atkSlot&&(atkCard.slug==='ar3-100'||atkCard.slug==='ar10-023')){ atkSlot.pos='def'; atkSlot.faceDown=false; atkSlot.bsgLocked=true; atkSlot.bsgLockTurns=2; setTimeout(()=>showMsg('👺 قوة هجوم العفاريت! تحوّلت لوضع الدفاع',1700),900); }
      markAttacked(atkSlot);G.attackMode=false;G.attacker=null;renderAll();checkEnd();
    });
  };
  let trap=findEnemyActiveTrap(['magic-cylinder','waboku','negate-attack','ring-of-destruction','skull-dice','fairy-box']);
  if(trap && enemyShouldTriggerTrap(trap,atkCard)){promptEnemyTrap(trap,()=>executeEnemyTrap(trap,aIdx,atkCard),dealDirect);return;}
  dealDirect();
}

// ===================== ENEMY TRAPS =====================
function findEnemyActiveTrap(slugs){
  if(jinzoActive())return null;
  for(let i=0;i<5;i++){let s=G.eField.s[i];if(s&&s.faceDown&&!s.justSet){let c=cardById(s.id);if(c.type==='trap'&&slugs.includes(c.slug))return {idx:i,card:c};}}
  return null;
}
// قرار ذكي: هل يستحق تفعيل الفخ الآن أم الانتظار لهجوم أقوى؟
function enemyShouldTriggerTrap(trap,atkCard){
  if(!trap||!trap.card) return true;
  let s=trap.card.slug;
  let atk=atkCard?(atkCard.atk||0):0;
  let tr=oppTraits();
  let bigThreat = atk>=1500;
  let lethalSoon = G.enemyLP<=Math.max(2000, atk);
  if(s==='mirror-force'){
    let pAtkCount=G.pField.m.filter(x=>x&&x.pos==='atk'&&!x.faceDown).length;
    if(pAtkCount>=2) return true;
    if(lethalSoon) return true;
    if(bigThreat) return Math.random() < (0.55+tr.aggression*0.3);
    return Math.random() < 0.25;
  }
  if(s==='magic-cylinder'||s==='ring-of-destruction'){
    if(lethalSoon) return true;
    if(bigThreat) return Math.random() < (0.6+tr.aggression*0.25);
    return Math.random() < 0.3;
  }
  if(s==='negate-attack'||s==='waboku'){
    if(lethalSoon) return true;
    if(bigThreat) return Math.random() < 0.7;
    return Math.random() < 0.35;
  }
  return true;
}
function promptEnemyTrap(trap,onYes,onNo){
  // Enemy AI decides to activate (always yes if beneficial)
  document.getElementById('tp-img').innerHTML='<img src="'+cardImg(trap.card)+'">';
  document.getElementById('tp-name').textContent=oppName()+" يفعّل: "+trap.card.name;
  document.getElementById('tp-desc').textContent=trap.card.desc;
  let prompt=document.getElementById('trap-prompt');
  document.getElementById('tp-yes').textContent="شاهد";
  document.getElementById('tp-no').style.display='none';
  document.getElementById('tp-yes').onclick=()=>{prompt.classList.remove('vis');document.getElementById('tp-no').style.display='';onYes();};
  prompt.classList.add('vis');
}
function executeEnemyTrap(trap,atkIdx,atkCard){
  graveSpell('e',trap.card);G.eField.s[trap.idx]=null;
  let s=trap.card.slug;
  if(s==='mirror-force'){
    let cnt=0;for(let i=0;i<5;i++){if(G.pField.m[i]&&G.pField.m[i].pos==='atk'&&!G.pField.m[i].faceDown){destroyMonster('p',i);cnt++;}}
    showMsg("Mirror Force! دُمّرت "+cnt+" مونستر هجوم!",2200);
  } else if(s==='magic-cylinder'){
    G.playerLP-=atkCard.atk;showDmg(atkCard.atk,true);
    showMsg("Magic Cylinder! ارتد الهجوم عليك! "+atkCard.atk,2200);
  } else if(s==='waboku'){
    G.wabokuActive=true;
    showMsg("Waboku! لا ضرر معركة هذا الدور",2000);
  } else if(s==='negate-attack'){
    showMsg("🌀 Negate Attack! أُلغي هجومك وانتهت المعركة",2100);
    G.playerBattleEnded=true;
  } else if(s==='ring-of-destruction'){
    // destroy the attacking monster; both players take its ATK as damage
    let dmg=atkCard.atk||0;
    if(G.pField.m[atkIdx])destroyMonster('p',atkIdx);
    G.playerLP-=dmg;G.enemyLP-=dmg;showDmg(dmg,true);showDmg(dmg,false);
    showMsg("💥 Ring of Destruction! ضرر "+dmg+" للطرفين",2200);
  } else if(s==='skull-dice'){
    let roll=1+Math.floor(Math.random()*6);
    let red=roll*100;let cnt=0;
    G.pField.m.forEach(x=>{if(x&&!x.faceDown){x.atkBonus=(x.atkBonus||0)-red;x.defBonus=(x.defBonus||0)-red;cnt++;}});
    showMsg("🎲 Skull Dice! النرد="+roll+" — وحوشك -"+red,2200);
  } else if(s==='magical-arm-shield'){
    // اخطف وحشاً آخر للخصم ليتلقى الهجوم؛ إن لم يوجد، أنهِ الهجوم
    let others=[];G.pField.m.forEach((x,i)=>{if(x&&i!==atkIdx&&!x.faceDown)others.push(i);});
    if(others.length){let v=others[0];let dmgM=atkCard.atk||0;destroyMonster('p',v);showMsg("🛡 Magical Arm Shield! خُطف وحشك ودُمّر",2200);}
    else{showMsg("🛡 Magical Arm Shield! أُلغي الهجوم",2000);}
    G.playerBattleEnded=true;
  } else if(s==='kunai-with-chain'){
    // حوّل المهاجم لوضع دفاع وأنهِ الهجوم
    if(G.pField.m[atkIdx]){G.pField.m[atkIdx].pos='def';G.pField.m[atkIdx].faceDown=false;}
    showMsg("⛓ Kunai with Chain! حُوّل مهاجمك للدفاع",2100);
    G.playerBattleEnded=true;
  } else if(s==='fairy-box'){
    // ارمِ عملة: إن أصبت يصبح هجوم المهاجم 0 هذا الدور وأنهِ الهجوم
    let coin=Math.random()<0.5;
    if(coin){if(G.pField.m[atkIdx]){let c=cardById(G.pField.m[atkIdx].id);G.pField.m[atkIdx].atkBonus=(G.pField.m[atkIdx].atkBonus||0)-(c.atk||0);}showMsg("🎁 Fairy Box! العملة صحّت — هجوم المهاجم = 0",2200);G.playerBattleEnded=true;}
    else{showMsg("🎁 Fairy Box! العملة خابت",1800);}
  }
  G.attackMode=false;G.attacker=null;
  renderAll();checkEnd();
}

function checkEnemyTrapOnSummon(idx){
  let trap=findEnemyActiveTrap(['trap-hole','bottomless-trap-hole','spellbinding-circle','shadow-spell','cloning','final-attack-orders']);
  if(trap){
    // شرط Trap Hole: هجوم 1000+، Bottomless: هجوم 1500+
    let summoned=G.pField.m[idx]?cardById(G.pField.m[idx].id):null;
    let atkv=summoned?(summoned.atk||0):0;
    if(trap.card.slug==='trap-hole'&&atkv<1000)return;
    if(trap.card.slug==='bottomless-trap-hole'&&atkv<1500)return;
    setTimeout(()=>{
      promptEnemyTrap(trap,()=>{
        graveSpell('e',trap.card);G.eField.s[trap.idx]=null;
        let s=trap.card.slug;
        if(s==='trap-hole'){destroyMonster('p',idx);showMsg("Trap Hole! دُمّر مونسترك!",2200);}
        else if(s==='bottomless-trap-hole'){if(G.pField.m[idx]){let rid=G.pField.m[idx].id;burstMonster('p',idx);G.pField.m[idx]=null;sfx('destroy');showMsg("🕳 Bottomless! أُبعد مونسترك نهائياً",2200);}}
        else if(s==='spellbinding-circle'){showMsg("Spellbinding Circle! تجمّد مونسترك",2000);if(G.pField.m[idx])G.pField.m[idx].bound=true;}
        else if(s==='shadow-spell'){if(G.pField.m[idx]){G.pField.m[idx].atkBonus=(G.pField.m[idx].atkBonus||0)-700;G.pField.m[idx].bound=true;}showMsg("🕸 Shadow Spell! -700 هجوم وتجميد",2100);}
        else if(s==='final-attack-orders'){showMsg("⚔ Final Attack Orders! كل الوحوش هجوم",2000);[...G.pField.m,...G.eField.m].forEach(x=>{if(x&&!x.faceDown)x.pos='atk';});G.finalAttackOrders=true;}
        else if(s==='cloning'){let fz=G.eField.m.findIndex(x=>!x);if(fz!==-1&&G.pField.m[idx]){G.eField.m[fz]={id:G.pField.m[idx].id,pos:'atk',faceDown:false,attacked:false,justSummoned:true,flashSummon:true,cloneToken:true};showMsg("👥 Cloning! "+oppName()+" نسخ مونسترك",2100);}}
        renderAll();
      },null);
    },800);
  }
}

// ===================== PHASES =====================
function setPhase(ph){
  G.phase=ph;
  const nm={draw:'مرحلة السحب',standby:'مرحلة التحضير',main1:'الرئيسية 1',battle:'مرحلة المعركة',main2:'الرئيسية 2',end:'نهاية الدور'};
  document.getElementById('phase-disp').innerHTML=(nm[ph]||ph)+' <span class="phase-dot"></span>';
  document.getElementById('turn-ind').textContent=(G.turn==='player'?'دورك':'دور '+oppName())+' — '+(nm[ph]||ph)+' (#'+G.turnCount+')';
  // مزاج الموسيقى حسب الوضع: معركة → متوتر، خطر (نقاط منخفضة) → مظلم، غير ذلك → هادئ
  if(typeof setMusicMood==='function'){
    let danger=(G.playerLP<=2500||G.enemyLP<=2500);
    setMusicMood(danger?'danger':(ph==='battle'?'battle':'calm'));
  }
}

function updateButtons(){
  let bb=document.getElementById('btn-battle'),be=document.getElementById('btn-end');
  if(G.turn!=='player'){bb.classList.add('disabled');be.classList.add('disabled');return;}
  be.classList.remove('disabled');
  if(G.phase==='main1'){bb.classList.remove('disabled','battle-active');bb.textContent='⚔ معركة';bb.disabled=G.firstTurn;if(G.firstTurn)bb.classList.add('disabled');}
  else if(G.phase==='battle'){bb.classList.remove('disabled');bb.classList.add('battle-active');bb.textContent='▶ رئيسية 2';}
  else if(G.phase==='main2'){bb.classList.add('disabled');bb.classList.remove('battle-active');}
}

function showDiceRoll(n){
  try{
    let faces=['','⚀','⚁','⚂','⚃','⚄','⚅'];
    let d=document.createElement('div');
    d.className='dice-pop';
    d.textContent=faces[n]||('🎲'+n);
    document.body.appendChild(d);
    setTimeout(()=>{ if(d.parentElement)d.parentElement.removeChild(d); },1600);
  }catch(e){}
}
function clearTempBonus(who){
  let f=who==='p'?G.pField:G.eField;
  f.m.forEach(s=>{if(s){s.tempAtk=0;s.tempDef=0;s._paidAttack=false;}});
}
function endTurn(){
  if(G.turn!=='player')return;
  // The Wicked Worm Beast: return to owner's hand at end of their turn
  returnWickedWorm('p');
  // Change of Heart / Brain Control: borrowed monster returns to its owner
  returnBorrowed('p');
  clearTempBonus('p'); // انتهاء الزيادات المؤقتة (الزهر الرشيق) في نهاية دور اللاعب
  // Reset player turn flags
  G.turn='enemy';G.normalSummoned=false;G.positionChanged=[];G.attackMode=false;G.attacker=null;
  G.pField.m.forEach(s=>{if(s){s.attacked=false;s.justSummoned=false;s.atkCount=0;
    if(s.bsgLocked){s.bsgLockTurns=(s.bsgLockTurns||1)-1;if(s.bsgLockTurns<=0){s.bsgLocked=false;}}
  }});
  G.pField.s.forEach(s=>{if(s)s.justSet=false;});
  G.firstTurn=false;
  setPhase('draw');updateButtons();updateTurnGlow();showTurnBanner('enemy');
  setTimeout(enemyTurn,1800);
}

// The Wicked Worm Beast returns to hand at end of its controller's turn
function returnWickedWorm(who){
  let f=who==='p'?G.pField:G.eField;
  let hand=who==='p'?G.playerHand:G.enemyHand;
  for(let i=0;i<5;i++){
    let s=f.m[i];
    if(s&&!s.faceDown&&cardById(s.id).slug==='the-wicked-worm-beast'){
      hand.push(s.id);f.m[i]=null;
      showMsg('🪱 The Wicked Worm Beast عاد لليد',1700);
    }
  }
}

// Change of Heart / Brain Control: return borrowed monsters to their owner at end of turn
function returnBorrowed(who){
  let myF=who==='p'?G.pField:G.eField;
  for(let i=0;i<5;i++){
    let s=myF.m[i];
    if(s&&s.borrowed){
      let owner=s.borrowedFrom||(who==='p'?'e':'p');
      let oF=owner==='p'?G.pField:G.eField;
      let fz=oF.m.findIndex(x=>!x);
      // تنظيف خصائص الاستعارة قبل الإرجاع
      let returned={...s};delete returned.borrowed;delete returned.borrowedFrom;
      returned.attacked=false;returned.atkCount=0;returned.justSummoned=false;
      if(fz!==-1){oF.m[fz]=returned;}
      else{ // ساحة المالك ممتلئة: يذهب للمقبرة
        let g=owner==='p'?G.pGrave:G.eGrave;g.push(s.id);
      }
      myF.m[i]=null;
      showMsg('💔 عاد المونستر إلى صاحبه',1600);
    }
  }
}

// ===================== ENEMY AI =====================
function enemyTurn(){
  // Draw phase (auto)
  G.enemySummoned=false;
  if(G.skipDraw){G.skipDraw=false;showMsg("Time Seal! تخطى "+oppName()+" السحب",1800);}
  else if(G.enemyDeck.length){drawFrom('e');animateDraw('e');}
  renderAll();
  arAmazonUpkeep('e'); arHumanoidSlimeUpkeep('e'); arUpkeepEffects('e'); // الأمازونية + الفطر الآدمي + علاج/رقص لدى الخصم
  setTimeout(enemyMain,1200*diffPreset().enemyDelay);
}

// === محاولة استدعاء اندماج للعدو عبر Polymerization ===
// يجمع المواد من ساحة العدو ثم يده، يضحّي بها ويستدعي وحش الاندماج من الإكسترا.
function enemyTryFusion(){
  if(!G.enemyExtra||!G.enemyExtra.length)return false;
  // لازم Polymerization في اليد
  let polyIdx=G.enemyHand.findIndex(id=>cardById(id).fusionSpell);
  if(polyIdx===-1)return false;
  // لازم خانة وحش فاضية
  if(!G.eField.m.some(s=>!s))return false;

  // مصادر المواد: ساحة العدو (وحوش غير مقلوبة وغير اندماجية) + يد العدو (وحوش)
  // نمثّل كل مصدر بكائن {slug, where:'field'|'hand', idx}
  let buildSources=()=>{
    let src=[];
    G.eField.m.forEach((s,i)=>{ if(s&&!cardById(s.id).fusionMon){ src.push({slug:cardById(s.id).slug, id:s.id, where:'field', idx:i}); } });
    G.enemyHand.forEach((id,i)=>{ let c=cardById(id); if(c.type==='monster'&&!c.fusionMon){ src.push({slug:c.slug, id:id, where:'hand', idx:i}); } });
    return src;
  };

  // نحاول إيجاد وحش اندماج تتوفر كل مواده. King of the Swamp يصلح بديلاً لأي مادة.
  let canMake=(matSlugs, sources)=>{
    let pool=sources.slice();
    let used=[];
    for(let need of matSlugs){
      // طابق مادة مطابقة أولاً
      let k=pool.findIndex(x=>x.slug===need);
      if(k===-1){ // بديل: King of the Swamp
        k=pool.findIndex(x=>x.slug==='king-of-the-swamp');
      }
      if(k===-1)return null;
      used.push(pool[k]); pool.splice(k,1);
    }
    return used;
  };

  let sources=buildSources();
  // رتّب وحوش الاندماج بالأقوى أولاً
  let extras=G.enemyExtra.map(id=>cardById(id)).filter(c=>c).sort((a,b)=>(b.atk||0)-(a.atk||0));
  for(let fc of extras){
    let used=canMake(fc.mats, sources);
    if(used){
      // نفّذ: استهلك Polymerization
      let polyCard=cardById(G.enemyHand[polyIdx]);
      G.enemyHand.splice(polyIdx,1);
      graveSpell('e',polyCard);
      // أرسل المواد للمقبرة (من الساحة عبر تأثير مرئي، ومن اليد مباشرة)
      // نعالج خانات الساحة بترتيب تنازلي حتى لا تتغير الفهارس
      let fieldUsed=used.filter(u=>u.where==='field').sort((a,b)=>b.idx-a.idx);
      let handUsed=used.filter(u=>u.where==='hand').sort((a,b)=>b.idx-a.idx);
      fieldUsed.forEach(u=>{ if(G.eField.m[u.idx]){ burstMonster('e',u.idx); G.eGrave.push(G.eField.m[u.idx].id); G.eField.m[u.idx]=null; } });
      handUsed.forEach(u=>{ G.eGrave.push(u.id); G.enemyHand.splice(u.idx,1); });
      sfx('destroy');
      // استدعِ وحش الاندماج في خانة فاضية
      let fz=G.eField.m.findIndex(s=>!s);
      G.eField.m[fz]={id:fc.id,pos:'atk',faceDown:false,attacked:false,justSummoned:true,flashSummon:true,bigSummon:(fc.atk||0)>=2500};
      // أزل وحش الاندماج من الإكسترا (يُستخدم مرة)
      let exIdx=G.enemyExtra.indexOf(fc.id);
      if(exIdx!==-1)G.enemyExtra.splice(exIdx,1);
      // الاندماج استدعاء خاص: لا يستهلك الاستدعاء العادي لهذا الدور
      sfx('summon');vibrate([40,30,60]);
      let matNames=fc.mats.map(m=>{let mc=CARDS.find(c=>c.slug===m);return mc?mc.name:m;}).join(' + ');
      showMsg("🌀 "+oppName()+" استدعى "+fc.name+" بالاندماج! ("+matNames+")",2300);
      onSummon('e',fz,fc);
      return true;
    }
  }
  return false;
}

function enemyMain(){
  // === SMART AI: evaluate board and play strategically ===
  let pMonsters=G.pField.m.map((s,i)=>({s,i})).filter(x=>x.s);
  let eMonsters=G.eField.m.map((s,i)=>({s,i})).filter(x=>x.s);
  let pStrongest=pMonsters.length?Math.max(...pMonsters.map(x=>{let c=cardById(x.s.id);return x.s.pos==='def'?c.def:(x.s.faceDown?0:c.atk);})):0;
  let pStrongestAtk=pMonsters.filter(x=>x.s.pos==='atk'&&!x.s.faceDown).length?Math.max(...pMonsters.filter(x=>x.s.pos==='atk'&&!x.s.faceDown).map(x=>cardById(x.s.id).atk)):0;

  // --- STEP 1: Play impactful spells from hand ---
  let handSpells=G.enemyHand.map((id,i)=>({c:cardById(id),i})).filter(x=>x.c.type==='spell'&&!x.c.ritualFor);
  let playSpell=(slug)=>{
    // خريطة المرادفات: تعويذات جوي تحمل بادئة j-
    let aliases={'dark-hole':['dark-hole','j-dark-hole'],'pot-of-greed':['pot-of-greed','j-pot-of-greed'],'monster-reborn':['monster-reborn','j-monster-reborn']};
    let names=aliases[slug]||[slug];
    let item=handSpells.find(x=>names.includes(x.c.slug));
    if(!item)return false;
    let sz=G.eField.s.findIndex(s=>!s);if(sz===-1)return false;
    G.enemyHand.splice(item.i,1);
    G.eField.s[sz]={id:item.c.id,faceDown:false};
    activateSpell(item.c,'e',sz);
    // حدّث القائمة المحلية بعد اللعب
    handSpells=G.enemyHand.map((id,i)=>({c:cardById(id),i})).filter(x=>x.c.type==='spell'&&!x.c.ritualFor);
    return true;
  };

  let actions=[];
  // Use Dark Hole / Raigeki if player has 2+ monsters or a strong one and enemy is weaker
  let eStrongestAtk=eMonsters.filter(x=>x.s.pos==='atk').length?Math.max(...eMonsters.filter(x=>x.s.pos==='atk').map(x=>cardById(x.s.id).atk)):0;
  let threatened = pMonsters.length>=2 || pStrongestAtk>eStrongestAtk;
  if(threatened && pMonsters.length>0){
    if(eMonsters.length<=pMonsters.length && playSpell('raigeki')){actions.push('raigeki');showFaceReaction('scheme',{force:true});}
    else if(playSpell('dark-hole')){actions.push('dark-hole'); eMonsters=[];showFaceReaction('scheme',{force:true});}
  }
  // Always draw cards
  if(playSpell('pot-of-greed'))actions.push('draw');
  if(playSpell('card-of-sanctity'))actions.push('draw');
  if(playSpell('graceful-charity'))actions.push('draw');
  // Giant Trunade لمسح أفخاخ اللاعب إذا كان لديه بطاقات مقلوبة كثيرة
  if(G.pField.s.filter(s=>s&&s.faceDown).length>=2 && playSpell('giant-trunade'))actions.push('trunade');
  // Scapegoat للدفاع إذا كان العدو مهدداً وساحته شبه فارغة
  if(threatened && eMonsters.length===0 && playSpell('scapegoat'))actions.push('goats');
  // Steal a strong monster
  if(pStrongestAtk>=1800){ if(playSpell('change-of-heart')||playSpell('brain-control')){actions.push('steal');showFaceReaction('scheme',{force:true});} }
  // Revive from grave if has good monster there
  let eGraveBest=G.eGrave.map(id=>cardById(id)).filter(c=>c.type==='monster').sort((a,b)=>b.atk-a.atk)[0];
  if(eGraveBest&&eGraveBest.atk>=2000&&G.eField.m.some(s=>!s)){if(playSpell('monster-reborn'))actions.push('reborn');}
  // الدفن المعجّل: إحياء وحش قوي من المقبرة (يدفع 800) إن توفّر
  if(eGraveBest&&eGraveBest.atk>=1900&&G.enemyLP>1500&&G.eField.m.some(s=>!s)){ if(playSpell('premature-burial'))actions.push('burial'); }
  // تدمير سحر/فخ اللاعب المقلوب إن بدا مهدِّداً (فخ محتمل)، عبر تعويذات الإزالة
  if(G.pField.s.filter(s=>s&&s.faceDown).length>=1 && pMonsters.length===0){
    if(playSpell('mystical-space-typhoon')||playSpell('de-spell'))actions.push('despell');
  }

  // محاولة الاندماج المبكّرة (لو المواد متوفرة على الساحة/اليد)
  let didFuse=false;
  if(!G.enemySummoned){ didFuse=enemyTryFusion(); if(didFuse)actions.push('fusion'); }

  renderAll();
  setTimeout(()=>enemyMainSummon(pStrongest,pStrongestAtk),(actions.length?1400:200)*diffPreset().enemyDelay);
}

function enemyMainSummon(pStrongest,pStrongestAtk){
  let freeZone=G.eField.m.findIndex(s=>!s);
  let hand=G.enemyHand.map((id,i)=>({c:cardById(id),i})).filter(x=>x.c.type==='monster'&&!x.c.ritual&&!x.c.fusionMon);
  hand.sort((a,b)=>b.c.atk-a.c.atk);
  let onField=G.eField.m.filter(s=>s).length;

  if(freeZone!==-1&&hand.length&&!G.enemySummoned){
    let highLevel=hand.filter(x=>x.c.level>=5);
    let lowLevel=hand.filter(x=>x.c.level<=4);
    // Tribute summon if it gives a meaningful upgrade and we can pay
    let bestHigh=highLevel[0];
    let tr=oppTraits();
    let canTribute = bestHigh && onField>=(bestHigh.c.level>=7?2:1);
    // Worth tributing if the high monster beats player's strongest or our board is weak (scaled by personality)
    let worthTribute = bestHigh && (bestHigh.c.atk*tr.summonHighBias>pStrongestAtk || bestHigh.c.atk>=(2400/tr.tributeBias));
    if(canTribute && worthTribute){
      let need=bestHigh.c.level>=7?2:1;
      // Tribute weakest monsters first
      let mons=G.eField.m.map((s,i)=>({s,i})).filter(x=>x.s).sort((a,b)=>cardById(a.s.id).atk-cardById(b.s.id).atk);
      for(let k=0;k<need;k++){destroyMonster('e',mons[k].i);}
      let fz=G.eField.m.findIndex(s=>!s);
      G.eField.m[fz]={id:bestHigh.c.id,pos:'atk',faceDown:false,attacked:false,justSummoned:true,flashSummon:true};
      G.lastEnemySummonIdx=fz;
      G.enemyHand.splice(bestHigh.i,1);G.enemySummoned=true;sfx('summon');
      if(typeof epicFx==='function') epicFx(bestHigh.c.slug, bestHigh.c.name, 'summon');
      showMsg(oppName()+" ضحّى واستدعى "+bestHigh.c.name+"! ⚜",1900);showFaceReaction("attack",{force:true});
      addLog('⚜ '+oppName()+' استدعى '+bestHigh.c.name);
      onSummon('e',fz,cardById(bestHigh.c.id));
    } else if(lowLevel.some(x=>(x.c.level||0)<=4)){
      // Pick best low-level; decide position smartly
      // حارس أمان: لا استدعاء عادي لأي مونستر مستوى 5+ بدون تضحية
      let best=lowLevel.find(x=>(x.c.level||0)<=4);
      // قرار الوضعية (مثل اللاعب): إن كان قوياً بما يكفي للهجوم → هجوم مكشوف، وإلا → دفاع مقلوب لحماية نفسه
      let pos,fd=false;
      if(best.c.atk>pStrongestAtk || pStrongestAtk===0){
        pos='atk'; fd=false; // قوي: هجوم مكشوف
      } else {
        // أضعف من مهاجم اللاعب → دفاع مقلوب (مستتر) لحمايته من الهجوم والكشف
        pos='def'; fd=true;
      }
      G.eField.m[freeZone]={id:best.c.id,pos:pos,faceDown:fd,attacked:false,justSummoned:true,flashSummon:!fd};
      G.lastEnemySummonIdx=freeZone;
      G.enemyHand.splice(best.i,1);G.enemySummoned=true;sfx('summon');
      if(!fd && typeof epicFx==='function') epicFx(best.c.slug, best.c.name, 'summon');
      showMsg(oppName()+" "+(fd?"وضع مونستراً مغلقاً":"استدعى "+best.c.name)+"!",1700);
      if(!fd){ addLog('⚔ '+oppName()+' استدعى '+best.c.name); onSummon('e',freeZone,cardById(best.c.id)); if((best.c.atk||0)>=1800) showFaceReaction('attack'); }
    }
  }
  // محاولة اندماج بعد الاستدعاء العادي (قد تتوفر المواد الآن على الساحة)
  enemyTryFusion();
  renderAll();
  // فحص ردود فعل اللاعب على استدعاء الخصم (الشق، إلخ)
  if(G.enemySummoned){
    checkPlayerReactions('enemySummon', ()=>{ setTimeout(enemyMainSetCards,1200*diffPreset().enemyDelay); });
  } else {
    setTimeout(enemyMainSetCards,1200*diffPreset().enemyDelay);
  }
}

function enemyMainSetCards(){
  // ذكاء دفاعي: حوّل وحوش الخصم المهدّدة (أضعف من أقوى مهاجم لديك) إلى وضع الدفاع
  (function(){
    let pAtk=G.pField.m.filter(s=>s&&s.pos==='atk'&&!s.faceDown).map(s=>effATK(cardById(s.id),'p',s));
    let pMax=pAtk.length?Math.max(...pAtk):0;
    if(pMax<=0) return; // لا مهاجم لدى اللاعب
    let tr=oppTraits();
    G.eField.m.forEach((s,i)=>{
      if(!s||s.pos!=='atk'||s.faceDown||s.justSummoned) return;
      let c=cardById(s.id);
      let myAtk=effATK(c,'e',s), myDef=effDEF(c,'e',s);
      // مهدّد: أقوى مهاجم لديك يدمّره في وضع الهجوم
      if(pMax>=myAtk){
        // يحوّل للدفاع إذا كان الدفاع يحميه أكثر (أو على الأقل يتجنّب خسارة نقاط) — مرتبط بحذر الشخصية
        let defenseBetter = myDef>myAtk || pMax>myDef;
        if((myDef>=myAtk || pMax>myAtk) && Math.random() < (0.85 - tr.aggression*0.3) && !s.bsgLocked){
          s.pos='def'; s.faceDown=false;
          showMsg(oppName()+': حوّل '+c.name+' لوضع الدفاع 🛡',1500);
        }
      }
    });
    renderAll();
  })();
  let _hadTrap=G.enemyHand.findIndex(id=>cardById(id).type==='trap')!==-1;
  // Set traps (prefer to keep them hidden)
  let ti=G.enemyHand.findIndex(id=>cardById(id).type==='trap');
  let sz=G.eField.s.findIndex(s=>!s);
  let didSet=false;
  if(ti!==-1&&sz!==-1&&Math.random()<oppTraits().trapChance){
    let cid=G.enemyHand.splice(ti,1)[0];
    G.eField.s[sz]={id:cid,faceDown:true,justSet:true};
    showMsg(oppName()+" وضع بطاقة مقلوبة 🔒",1400);renderAll();didSet=true;
  }
  // Give the player a chance to react with a set MST / Dust Tornado / De-Spell
  setTimeout(()=>{
    offerPlayerReactiveSpell(()=>{ setTimeout(enemyBattle,1000); });
  },didSet?1100:300);
}

function enemyBattle(){
  if(G.firstTurn){setTimeout(enemyEndTurn,800);return;}
  if(G.swords>0){G.swords--;showMsg("Swords يمنع هجوم "+oppName()+"!",1800);setTimeout(enemyEndTurn,1500);return;}
  G.enemyBattleEnded=false;
  let attackers=[];
  G.eField.m.forEach((s,i)=>{if(s&&s.pos==='atk'&&!s.faceDown&&!s.bound)attackers.push(i);});
  let qi=0;
  function nextAttack(){
    if(G.enemyBattleEnded){setTimeout(enemyEndTurn,800);return;}
    if(qi>=attackers.length){setTimeout(enemyEndTurn,1000);return;}
    let ai=attackers[qi++];let atk=G.eField.m[ai];if(!atk){nextAttack();return;}
    // حماية ضد الهجوم المزدوج: تخطَّ الوحش إن سبق أن هاجم أو لم يعد في وضع الهجوم
    if(atk.attacked || atk.pos!=='atk' || atk.faceDown){ nextAttack(); return; }
    let ac=cardById(atk.id);
    // ظلام العفريت (الخصم): يدفع 1000 كي يهاجم، وإلا يتخطّى
    if((ac.slug==='ar5-069'||ac.slug==='ar13-092') && !atk._paidAttack){
      if(G.enemyLP<=1000){ nextAttack(); return; }
      G.enemyLP-=1000; sfx('lifeloss'); updateLP(); atk._paidAttack=true;
      showMsg('👁 '+oppName()+': دفع 1000 ليهاجم بظلام العفريت',1800);
    }
    if(ac.slug==='ar-064'||ac.slug==='ar9-087'||ac.slug==='dup-7'){
      let others=[]; G.eField.m.forEach((x,i)=>{ if(x&&i!==ai) others.push(i); });
      if(others.length===0){ nextAttack(); return; } // لا وحش للتضحية → لا يهاجم النمر
      // اختر أضعف وحش آخر للتضحية به
      let si=others[0],worst=Infinity; others.forEach(i=>{let a=(cardById(G.eField.m[i].id).atk||0)+(G.eField.m[i].atkBonus||0); if(a<worst){worst=a;si=i;}});
      let sacName=cardById(G.eField.m[si].id).name;
      destroyMonster('e',si);
      showMsg('🐯 '+oppName()+': ضحّى بـ'+sacName+' كي يهاجم النمر المحارب',1900);
      renderAll();
      if(!G.eField.m[ai]){ setTimeout(nextAttack,800); return; }
    }
    let playerMons=G.pField.m.map((s,i)=>({s,i})).filter(x=>x.s);
    // Check player traps
    let pTrap=findPlayerActiveTrap(['mirror-force','magic-cylinder','waboku','negate-attack','ring-of-destruction','interdimensional-matter-transporter','attack-guidance-armor','magical-hats']);
    if(playerMons.length){
      // الوحوش التي يستطيع تدميرها دون أن يُدمَّر (هجومه > إحصاء الهدف)
      let killable=playerMons.filter(x=>{let c=cardById(x.s.id);let st=x.s.pos==='def'?c.def:c.atk;return ac.atk>st;});
      // الوحوش التي ستُدمّر مهاجمَنا (هدف بوضع هجوم وأقوى أو يساوي) — هجوم انتحاري
      let myAtk=effATK(ac,'e',atk);
      let atkPosPlayers=playerMons.filter(x=>x.s.pos==='atk'&&!x.s.faceDown);
      let strongestAtkPos=atkPosPlayers.reduce((mx,x)=>{let a=effATK(cardById(x.s.id),'p',x.s);return a>mx?a:mx;},0);
      let tr=oppTraits();
      // قرار دفاعي: إن لم يستطع قتل أي وحش، وكان أضعف من أقوى مهاجم لدى اللاعب → لا يهاجم (انتحار)
      if(!killable.length){
        // لو كل وحوش اللاعب في وضع الدفاع: الهجوم غير مؤذٍ لكنه غير مُجدٍ — يتخطّى غالباً
        if(strongestAtkPos>=myAtk){
          // مهاجمة وحش هجومي أقوى = خسارة مؤكدة → لا يهاجم (إلا نادراً جداً لو عدواني مفرط)
          if(strongestAtkPos>myAtk){ nextAttack(); return; }
          // تعادل: مهاجمة وحش بنفس القوة تُدمّر الاثنين — يقبلها فقط إن كان عدوانياً
          if(Math.random()>tr.aggression*0.5){ nextAttack(); return; }
        } else {
          // اللاعب لا يملك مهاجماً أقوى (كلهم دفاع أو أضعف) — هجوم غير مُجدٍ، يتخطّى حسب الحذر
          if(Math.random()>tr.aggression){ nextAttack(); return; }
        }
      }
      let tgt=killable.length?killable.sort((a,b)=>{let ca=cardById(a.s.id),cb=cardById(b.s.id);return (b.s.pos==='atk'?cb.atk:0)-(a.s.pos==='atk'?ca.atk:0);})[0]:playerMons.sort((a,b)=>cardById(a.s.id).atk-cardById(b.s.id).atk)[0];
      if(pTrap){
        promptPlayerTrap(pTrap,ai,ac,()=>{nextAttack();});
        return;
      }
      enemyResolveAttack(ai,ac,tgt.i,tgt.s);
      setTimeout(nextAttack,1900);
    } else {
      // Direct attack
      if(pTrap){promptPlayerTrap(pTrap,ai,ac,()=>{nextAttack();});return;}
      atk.attacked=true; // علّم فوراً قبل الأنميشن
      flyAttack('e',ai,getLPCenter('p'),()=>{
        let ed=effATK(ac,'e',atk);
        if(tryKuriboh()){renderAll();checkEnd();return;}
        dealBattleDmg('p',ed);showMsg(oppName()+" يهاجم مباشرة! "+ed,1800);
        addLog('🎯 '+oppName()+' هاجم مباشرة! -'+ed);
        let lb=document.getElementById('plp-fill');if(lb&&lb.parentElement){lb.parentElement.classList.add('shake');setTimeout(()=>lb.parentElement.classList.remove('shake'),400);}
        cinematicSlowmo(550);
        renderAll();checkEnd();
      });
      setTimeout(nextAttack,1800);
    }
  }
  nextAttack();
}

function enemyResolveAttack(ai,ac,ti,tSlot){
  let tc=cardById(tSlot.id);
  if(tSlot.faceDown){tSlot.faceDown=false;renderField();showMsg("انكشف "+tc.name+"!",1300);
    // محرّك تأثيرات الوحوش عند القلب (وحش اللاعب يُكشف بهجوم الخصم)
    if(typeof AR_MON_FLIP!=='undefined' && AR_MON_FLIP[tc.slug]){
      try{ AR_MON_FLIP[tc.slug]('p',ti,tc,G.pField); }catch(e){}
    }
  }
  let aSlot=G.eField.m[ai];
  let myATK=effATK(ac,'e',aSlot);
  let defStat=tSlot.pos==='def'?effDEF(tc,'p',tSlot):effATK(tc,'p',tSlot);
  // الجندي الحركيّ: +2000 خلال المعركة ضد وحش من نوع محارب
  let kineticSlugs2=['ar-074','ar9-097'];
  if(kineticSlugs2.includes(ac.slug) && tc.race==='warrior'){ myATK+=2000; showMsg('⚙ الجندي الحركيّ! +2000 ضد المحارب',1600); }
  if(kineticSlugs2.includes(tc.slug) && ac.race==='warrior'){ defStat+=2000; showMsg('⚙ الجندي الحركيّ! +2000 ضد المحارب',1600); }
  let diff=myATK-defStat;
  // علّم الوحش أنه هاجم فوراً (قبل الأنميشن) لمنع تكرار الهجوم
  if(aSlot)aSlot.attacked=true;
  flyAttack('e',ai,getZoneCenter('p',ti),()=>{
    // المحارب من البُعد المختلف: إذا هاجم أو هوجم، يُنفى هو ووحش الخصم
    let ddSlugs=['ar-090','ar8-089'];
    if(ddSlugs.includes(ac.slug)||ddSlugs.includes(tc.slug)){
      sfx('banish'); camShake(true);
      G.banished=G.banished||[];
      if(G.eField.m[ai]){ G.banished.push(G.eField.m[ai].id); burstMonster('e',ai); G.eField.m[ai]=null; }
      if(G.pField.m[ti]){ G.banished.push(G.pField.m[ti].id); burstMonster('p',ti); G.pField.m[ti]=null; }
      renderAll(); showMsg('🌀 المحارب من البُعد المختلف! نُفي هو ووحش الخصم من اللعبة',2100); checkEnd();
      return;
    }
    if(myATK>=2500)camShake(true); // [جديد] هزّة قوية للهجمات الكبيرة
    if(diff>0){
      // Obnoxious Celtic Guard على ساحتك يصمد أمام هجوم ≥1900
      if(tc.slug==='obnoxious-celtic-guard' && myATK>=1900){
        if(tSlot.pos==='atk'){if(tryKuriboh()){}else{dealBattleDmg('p',diff);}}
        showMsg('🛡 Obnoxious Celtic Guard صمد أمام '+ac.name+'!',1900);
      } else {
        destroyMonster('p',ti);if(tSlot.pos==='atk'){if(tryKuriboh()){}else{dealBattleDmg('p',diff);}}showMsg(oppName()+": "+ac.name+" دمّر "+tc.name+"!",1700);
        if((ac.slug==='ar6-016'||ac.slug==='ar14-039')&&aSlot){aSlot.atkBonus=(aSlot.atkBonus||0)-200;}
        if((ac.slug==='ar3-083'||ac.slug==='ar10-006')&&aSlot){aSlot.atkBonus=(aSlot.atkBonus||0)+200;}
        if((ac.slug==='ar3-096'||ac.slug==='ar10-019')){ let victimId=tSlot.id; setTimeout(()=>{ let gi=G.pGrave.indexOf(victimId); let fz=G.eField.m.findIndex(x=>!x); if(gi>=0&&fz>=0){ G.pGrave.splice(gi,1); G.eField.m[fz]={id:victimId,pos:'atk',faceDown:false,justSummoned:true,flashSummon:true,bigSummon:(cardById(victimId).atk||0)>=2000}; renderAll(); showMsg('🌑 '+oppName()+': ساحر القمر استدعى '+cardById(victimId).name,2000); } },1000); }
      }
    }
    else if(diff<0){
      if(tSlot.pos==='def'){
        // مدافعك أقوى: وحش الخصم لا يُدمّر، الخصم يخسر الفرق فقط
        dealBattleDmg('e',Math.abs(diff));showMsg(tc.name+" صدّ هجوم "+ac.name+"!",1800);
        bigShieldFlip('p',ti,tSlot,tc);
      } else {
        // وحشك في وضع هجوم وأقوى: وحش الخصم يُدمّر
        destroyMonster('e',ai);dealBattleDmg('e',Math.abs(diff));showMsg(tc.name+" هزم "+ac.name+"!",1700);
      }
    }
    else{
      if(tSlot.pos==='atk'){
        let atkGlider=ac.slug==='kaiser-glider', defGlider=tc.slug==='kaiser-glider';
        if(atkGlider||defGlider){
          if(!atkGlider)destroyMonster('e',ai);
          if(!defGlider)destroyMonster('p',ti);
          showMsg('🦅 Kaiser Glider لا يُدمّر بنفس الهجوم!',1900);
        } else {destroyMonster('p',ti);destroyMonster('e',ai);showMsg("تعادل!",1500);}
      }else{showMsg(tc.name+" صمد",1400);bigShieldFlip('p',ti,tSlot,tc);}
    }
    if(G.eField.m[ai])G.eField.m[ai].attacked=true;
    // قوة هجوم العفاريت (الخصم): تتحول لوضع الدفاع بعد الهجوم
    if(G.eField.m[ai]&&(ac.slug==='ar3-100'||ac.slug==='ar10-023')){ G.eField.m[ai].pos='def'; G.eField.m[ai].faceDown=false; G.eField.m[ai].bsgLocked=true; G.eField.m[ai].bsgLockTurns=2; }
    renderAll();checkEnd();
  });
}

// Player traps triggered during enemy attack
// Jinzo: إذا كان على أي ساحة، تُلغى كل الأفخاخ
function jinzoActive(){
  let isJinzo=s=>{let sl=cardById(s.id).slug;return sl==='jinzo'||sl==='ar3-006'||sl==='ar11-029';};
  return G.pField.m.some(s=>s&&!s.faceDown&&isJinzo(s)) ||
         G.eField.m.some(s=>s&&!s.faceDown&&isJinzo(s));
}
function findPlayerActiveTrap(slugs){
  if(jinzoActive())return null;
  for(let i=0;i<5;i++){let s=G.pField.s[i];if(s&&s.faceDown&&!s.justSet){let c=cardById(s.id);if(c.type==='trap'&&slugs.includes(c.slug))return {idx:i,card:c};}}
  return null;
}

// Find any face-down player spell/trap (not just-set) whose slug is in the list
function findPlayerSetCard(slugs){
  for(let i=0;i<5;i++){let s=G.pField.s[i];if(s&&s.faceDown&&!s.justSet){let c=cardById(s.id);if(slugs.includes(c.slug))return {idx:i,card:c};}}
  return null;
}

// Offer the player a chance to activate a set spell/trap that destroys enemy spells/traps.
// Called during the enemy's turn after the enemy sets a card. Calls done() when finished.
function offerPlayerReactiveSpell(done){
  // Only meaningful if the enemy actually has a spell/trap on the field
  let enemyHasST=G.eField.s.some(s=>s);
  if(!enemyHasST){done();return;}
  // Player cards that can blow up an enemy spell/trap
  let react=findPlayerSetCard(['mystical-space-typhoon','dust-tornado','de-spell']);
  if(!react){done();return;}
  let target=cardById(react.card.id);
  document.getElementById('tp-img').innerHTML='<img src="'+cardImg(target)+'">';
  document.getElementById('tp-name').textContent=target.name;
  document.getElementById('tp-desc').textContent=target.desc+' — '+oppName()+' وضع بطاقة سحر/فخ.';
  let prompt=document.getElementById('trap-prompt');
  document.getElementById('tp-yes').textContent="نعم، فعّل";
  document.getElementById('tp-no').style.display='';
  document.getElementById('tp-yes').onclick=()=>{
    prompt.classList.remove('vis');
    // Reveal & activate: destroy one enemy spell/trap (prefer a face-down one)
    react.card; // (slot will be cleared by activateSpell via sIdx)
    let slot=G.pField.s[react.idx];slot.faceDown=false;
    sfx('flip');renderField();
    setTimeout(()=>{
      activateSpell(target,'p',react.idx);
      setTimeout(done,1200);
    },350);
  };
  document.getElementById('tp-no').onclick=()=>{
    prompt.classList.remove('vis');done();
  };
  prompt.classList.add('vis');
}

// نافذة تأكيد عامة (نعم/لا) — تعيد استخدام نافذة trap-prompt
function promptYesNo(title,msg,imgCardId,onYes,onNo){
  let prompt=document.getElementById('trap-prompt');
  document.getElementById('tp-img').innerHTML = imgCardId!=null ? '<img src="'+cardImg(cardById(imgCardId))+'">' : '';
  document.getElementById('tp-name').textContent=title||'';
  document.getElementById('tp-desc').textContent=msg||'';
  let yes=document.getElementById('tp-yes'), no=document.getElementById('tp-no');
  yes.textContent='نعم'; no.textContent='لا'; no.style.display='';
  yes.onclick=()=>{ prompt.classList.remove('vis'); if(onYes)onYes(); };
  no.onclick=()=>{ prompt.classList.remove('vis'); if(onNo)onNo(); };
  prompt.classList.add('vis');
}

// ===================== نظام ردود فعل اللاعب في دور الخصم =====================
// بطاقات سحر/فخ في يد اللاعب يمكن تفعيلها كرد فعل على أحداث دور الخصم.
// كل مدخل: { canReact(ctx) → bool, react() → ينفّذ التأثير }
// trigger أنواع: 'enemySummon' (نزل الخصم وحشاً), 'enemyAttackDeclare' (أعلن هجوماً)
const PLAYER_REACT = {
  // الشق: عند نزول وحش الخصم، دمّر أضعف وحوشه
  'ar2-053': { trigger:'enemySummon', label:'🗡 الشق', canReact:()=>G.eField.m.some(s=>s),
    react:()=>{ let f=G.eField,bi=-1,best=1e9;f.m.forEach((x,i)=>{if(x){let a=(cardById(x.id).atk||0)+(x.atkBonus||0);if(a<best){best=a;bi=i;}}});if(bi>=0){let nm=cardById(f.m[bi].id).name;destroyMonster('e',bi);showMsg('🗡 الشق! دُمّر '+nm,1900);} } },
  'ar10-076': { trigger:'enemySummon', label:'🗡 الشق', canReact:()=>G.eField.m.some(s=>s),
    react:()=>{ let f=G.eField,bi=-1,best=1e9;f.m.forEach((x,i)=>{if(x){let a=(cardById(x.id).atk||0)+(x.atkBonus||0);if(a<best){best=a;bi=i;}}});if(bi>=0){let nm=cardById(f.m[bi].id).name;destroyMonster('e',bi);showMsg('🗡 الشق! دُمّر '+nm,1900);} } },
  // تكريم المنبوذين: عند نزول وحش الخصم، دمّر أقوى وحوشه (تكلفة رمي ورقة مُمثّلة بإرسال البطاقة للمقبرة)
  'ar5-015': { trigger:'enemySummon', label:'⚰ تكريم المنبوذين', canReact:()=>G.eField.m.some(s=>s)&&G.playerHand.length>=2,
    react:()=>{ let f=G.eField,bi=-1,best=-1;f.m.forEach((x,i)=>{if(x){let a=(cardById(x.id).atk||0)+(x.atkBonus||0);if(a>best){best=a;bi=i;}}});if(bi>=0){let nm=cardById(f.m[bi].id).name;destroyMonster('e',bi);showMsg('⚰ تكريم المنبوذين! دُمّر '+nm,2000);} } },
  // سيد الإبادة: عند نزول وحش الخصم مقلوب، دمّره وانفِه
  'ar3-040': { trigger:'enemySummon', label:'💀 سيد الإبادة', canReact:()=>G.eField.m.some(s=>s&&s.faceDown),
    react:()=>{ let f=G.eField,bi=f.m.findIndex(s=>s&&s.faceDown);if(bi>=0){let id=f.m[bi].id;burstMonster('e',bi);f.m[bi]=null;G.banished=G.banished||[];G.banished.push(id);showMsg('💀 سيد الإبادة! نُفي '+cardById(id).name,2000);} } },
  'ar11-063': { trigger:'enemySummon', label:'💀 سيد الإبادة', canReact:()=>G.eField.m.some(s=>s&&s.faceDown),
    react:()=>{ let f=G.eField,bi=f.m.findIndex(s=>s&&s.faceDown);if(bi>=0){let id=f.m[bi].id;burstMonster('e',bi);f.m[bi]=null;G.banished=G.banished||[];G.banished.push(id);showMsg('💀 سيد الإبادة! نُفي '+cardById(id).name,2000);} } },
  // فخ الحفرة: عند استدعاء الخصم وحشاً هجومياً (هجوم ≥1000)، دمّره
  'ar2-054': { trigger:'enemySummon', label:'🕳 فخ الحفرة', canReact:()=>lastSummonQualifies(s=>s&&!s.faceDown&&s.pos==='atk'&&(cardById(s.id).atk||0)>=1000),
    react:()=>{ destroyLastSummon('🕳 فخ الحفرة'); } },
  'ar10-077': { trigger:'enemySummon', label:'🕳 فخ الحفرة', canReact:()=>lastSummonQualifies(s=>s&&!s.faceDown&&s.pos==='atk'&&(cardById(s.id).atk||0)>=1000),
    react:()=>{ destroyLastSummon('🕳 فخ الحفرة'); } },
