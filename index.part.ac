  'ar11-066': w=>{ if((w==='p'?G.playerLP:G.enemyLP)<=800){showMsg('⚰ تحتاج أكثر من 800',1600);return false;}let g=w==='p'?G.pGrave:G.eGrave,f=w==='p'?G.pField:G.eField,si=f.m.findIndex(x=>!x);if(si<0){showMsg('⚰ الملعب ممتلئ',1500);return false;}
