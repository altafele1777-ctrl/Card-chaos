function loadSettings(){
  try{let s=localStorage.getItem('poc_settings');if(s)return Object.assign(defaultSettings(),JSON.parse(s));}catch(e){}
  return defaultSettings();
}
function defaultSettings(){return {music:true, sfxOn:true, vibrate:true, difficulty:'normal', musicVol:0.5};}
