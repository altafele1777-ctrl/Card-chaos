  { id:1104, slug:"ar8-004", name:"ألفا المحارب المغناطيسي", type:"monster", race:"thunder", gameDeck:true, attribute:"earth", level:4, atk:1400, def:1700, desc:"ألفا، بيتا، وغاما يندمجون ليعطوا وحش ذو قوة هائلة." , fusionMon:true},
  { id:1105, slug:"ar8-005", name:"بيتا المحارب المغناطيسي", type:"monster", race:"thunder", gameDeck:true, attribute:"earth", level:4, atk:1700, def:1600, desc:"ألفا، بيتا، وغاما يندمجون ليعطوا وحش ذو قوة هائلة." , fusionMon:true},
