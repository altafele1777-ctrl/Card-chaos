function impactParticles(x,y,style){
  let n=8;
  for(let i=0;i<n;i++){
    let s=document.createElement('div');s.className='fx-particle';
    let a=(Math.PI*2*i)/n+Math.random()*.5, d=28+Math.random()*30;
    s.style.left=x+'px';s.style.top=y+'px';s.style.background=style.color;
    s.style.boxShadow='0 0 6px '+style.glow;
    if(style.kind==='wave')s.style.borderRadius='50%';
    s.style.setProperty('--px',(Math.cos(a)*d).toFixed(1)+'px');
    s.style.setProperty('--py',(Math.sin(a)*d).toFixed(1)+'px');
    s.style.setProperty('--pr',(Math.random()*360-180)+'deg');
    document.body.appendChild(s);setTimeout(()=>s.remove(),560);
  }
}
function launchParticles(start,to,style,done){
  let n=style.kind==='pop'?10:7;
  let landed=0;
  for(let i=0;i<n;i++){
    let s=document.createElement('div');s.className='atk-fx';
    s.style.width=(style.kind==='pop'?14:13)+'px';s.style.height=(style.kind==='pop'?14:13)+'px';
    s.style.borderRadius=style.kind==='pop'?'50%':'3px';
    s.style.background=style.color;s.style.boxShadow='0 0 7px '+style.glow;
    s.style.left=start.x+'px';s.style.top=start.y+'px';
    document.body.appendChild(s);
    let jx=(Math.random()-.5)*40, jy=(Math.random()-.5)*40;
    let dur=300+Math.random()*160;let t0=null;
    let sx=start.x, sy=start.y, tx=to.x+jx, ty=to.y+jy;
    (function(el){
      function step(ts){
        if(!t0)t0=ts;let p=Math.min(1,(ts-t0)/dur);
        let e=1-Math.pow(1-p,2);
        el.style.left=(sx+(tx-sx)*e)+'px';el.style.top=(sy+(ty-sy)*e)+'px';
        el.style.transform='translate(-50%,-50%) scale('+(1-e*.4)+') rotate('+(e*360)+'deg)';
        if(p<1)requestAnimationFrame(step);
        else{el.remove();landed++;if(landed===n&&done)done();}
      }
      requestAnimationFrame(step);
    })(s);
  }
}

function flySword(fromWho,fromIdx,to,onHit){
  let start=getZoneCenter(fromWho,fromIdx);
  if(!start||!to){if(onHit)onHit();return;}
  // glow attacker
  let zones=document.querySelectorAll('#'+fromWho+'-m-zones .zone');
  let zc=zones[fromIdx]?zones[fromIdx].querySelector('.ciz'):null;
  if(zc)zc.classList.add('attacking');
  lungeAttacker(fromWho,fromIdx);
  sfx('attack');
  let sword=document.createElement('div');
  sword.className='attack-sword';sword.textContent='⚔';
  sword.style.left=start.x+'px';sword.style.top=start.y+'px';
  let dx=to.x-start.x, dy=to.y-start.y;
  let ang=Math.atan2(dy,dx)*180/Math.PI;
  sword.style.transform='translate(-50%,-50%) rotate('+(ang+45)+'deg) scale(.6)';
  document.body.appendChild(sword);
  // animate
  let dur=420;let t0=null;
  function step(ts){
    if(!t0)t0=ts;let p=Math.min(1,(ts-t0)/dur);
    let ease=p<.5?2*p*p:1-Math.pow(-2*p+2,2)/2;
    let cx=start.x+dx*ease, cy=start.y+dy*ease;
    let sc=.6+ease*0.7;
    sword.style.left=cx+'px';sword.style.top=cy+'px';
    sword.style.transform='translate(-50%,-50%) rotate('+(ang+45)+'deg) scale('+sc+')';
    if(p<1)requestAnimationFrame(step);
    else{
      sword.remove();
      if(zc)zc.classList.remove('attacking');
      sfx('hit');
      // impact flash
      let fl=document.createElement('div');fl.className='impact-flash';fl.style.left=to.x+'px';fl.style.top=to.y+'px';document.body.appendChild(fl);setTimeout(()=>fl.remove(),400);
      camShake(true);
      screenFlash('#ffcc44');
      if(onHit)onHit();
    }
  }
  requestAnimationFrame(step);
}

