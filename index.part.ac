// Calculate effective ATK/DEF including continuous effects
function countInGrave(who,slug){let g=who==='p'?G.pGrave:G.eGrave;return g.filter(id=>cardById(id).slug===slug).length;}
function countDragonsOnField(who){let f=who==='p'?G.pField:G.eField;return f.m.filter(s=>s&&cardById(s.id).name.toLowerCase().includes('dragon')).length;}

// وضع علامة "هاجم": Hayabusa Knight يستطيع الهجوم مرتين في الدور
function markAttacked(slot){
  if(!slot)return;
  let c=cardById(slot.id);
  if(c&&c.slug==='hayabusa-knight'){
    slot.atkCount=(slot.atkCount||0)+1;
    if(slot.atkCount>=2)slot.attacked=true; // استهلك الهجومين
    // غير ذلك يبقى attacked=false ليهاجم مجدداً
  } else {
    slot.attacked=true;
  }
}
/* ============================================================
   محرّك التأثيرات العربية — دوال مساعدة عامة
   ============================================================ */
// عدّ الوحوش على ساحة معيّنة حسب الفصيلة ('all' = الكل)، تُحسب فقط المكشوفة
function arCountFieldRace(who,race){
  let f=who==='p'?G.pField:G.eField; let n=0;
  for(let i=0;i<5;i++){let s=f.m[i]; if(!s||s.faceDown)continue; let c=cardById(s.id); if(!c)continue;
    if(race==='all'||c.race===race)n++; }
  return n;
}
// عدّ الوحوش في مقبرة معيّنة حسب الفصيلة
function arCountGraveRace(who,race){
  let g=who==='p'?G.pGrave:G.eGrave; let n=0;
  g.forEach(id=>{let c=cardById(id); if(c&&c.type==='monster'&&(race==='all'||c.race===race))n++;});
  return n;
}
