// العودة الآمنة: اسحب ورقة كلما استُرجع وحش من مقبرتك (طالما البطاقة على الملعب)
function arSafeReturnCheck(who){
  if(!G.safeReturn||!G.safeReturn[who])return;
  // تحقّق أن البطاقة ما زالت على ملعب اللاعب
  let f=who==='p'?G.pField:G.eField;
  let stillThere=f.s.some(x=>x&&cardById(x.id).slug==='ar7-071');
  if(!stillThere){ G.safeReturn[who]=false; return; }
  let d=who==='p'?G.playerDeck:G.enemyDeck, h=who==='p'?G.playerHand:G.enemyHand;
  if(d.length){ h.push(d.pop()); sfx('draw'); if(who==='p')animateDraw('p'); setTimeout(()=>showMsg('🃏 العودة الآمنة! سحبت ورقة',1600),300); }
}
// تدمير أي وحش على الملعب (الطرفين) — اللاعب يختار عبر شاشة، الخصم يدمّر أقوى وحش للاعب
function arDestroyAnyMonster(who,label){
  let all=[];
  [['p',G.pField],['e',G.eField]].forEach(t=>{ let s=t[0],f=t[1]; f.m.forEach((x,i)=>{ if(x) all.push({side:s,idx:i,id:x.id}); }); });
  if(all.length===0){ showMsg((label||'🎯')+' لا وحوش على الملعب',1600); return; }
  let doDestroy=(side,idx)=>{ let f=side==='p'?G.pField:G.eField; if(!f.m[idx])return; let nm=cardById(f.m[idx].id).name; destroyMonster(side,idx); if(typeof renderAll==='function')renderAll(); showMsg((label||'🎯')+' دُمّر '+nm,1800); };
  if(who==='p' && typeof pickCard==='function'){
    let ids=all.map(a=>a.id);
    pickCard((label||'🎯 تدمير'),'اختر وحشاً على الملعب لتدميره (أيّ طرف)',ids,(chosenId)=>{ let pick=all.find(a=>{let f=a.side==='p'?G.pField:G.eField;return f.m[a.idx]&&f.m[a.idx].id===chosenId;}); if(pick)doDestroy(pick.side,pick.idx); });
  } else {
    // الخصم: يدمّر أقوى وحش للاعب
    let pl=all.filter(a=>a.side==='p');
    let target=(pl.length?pl:all).reduce((best,a)=>{let f=a.side==='p'?G.pField:G.eField;let at=(cardById(a.id).atk||0)+((f.m[a.idx]||{}).atkBonus||0);return at>best.v?{a,v:at}:best;},{a:(pl.length?pl:all)[0],v:-1}).a;
    doDestroy(target.side,target.idx);
  }
}
function clearMonstersToGrave(who){let f=who==='p'?G.pField:G.eField;let g=who==='p'?G.pGrave:G.eGrave;for(let i=0;i<5;i++){if(f.m[i]){let id=f.m[i].id;burstMonster(who,i);g.push(id);f.m[i]=null;onSentToGrave(who,id);}}sfx('destroy');if(typeof renderGrave==='function')renderGrave(who);}
function graveSpell(who,card){let g=who==='p'?G.pGrave:G.eGrave;g.push(card.id);}

// ===================== SPELL / TRAP PLACEMENT =====================
function placeS(idx){
  let card=G.selCard;
  if(G.pField.s[idx]){showMsg("المنطقة ممتلئة!",1200);return;}
  if(card.ritualFor){
    // Ritual spell - try to ritual summon
    tryRitual(card,idx);return;
  }
  // Show choice: activate now or set face-down
  showSpellTrapChoice(idx,card);
}

// Set a spell/trap face-down (covers both traps and spells the player wants to hold)
function setSpellTrap(idx,card){
  G.pField.s[idx]={id:card.id,faceDown:true,justSet:true};
  G.playerHand.splice(G.selIdx,1);G.selCard=null;G.selIdx=null;
  sfx('flip');renderAll();
  showMsg("وُضع "+card.name+" وجهاً للأسفل 🔒",1500);
}

// Choice overlay: activate immediately vs set face-down (reuses summon-ov UI)
function showSpellTrapChoice(idx,card){
  let ov=document.getElementById('summon-ov');
  let isTrap=card.type==='trap';
  document.getElementById('sp-title').textContent = isTrap ? "تجهيز الفخ" : "تجهيز التعويذة";
  document.getElementById('sp-preview').innerHTML='<img src="'+cardImg(card)+'">';
  let btns=document.getElementById('sp-btns');btns.innerHTML='';
  let mkBtn=(label,fn,cls)=>{let b=document.createElement('button');b.className='sp-btn'+(cls?' '+cls:'');b.textContent=label;b.onclick=fn;btns.appendChild(b);};
  if(isTrap){
    // Traps can only be set face-down (they never activate the turn they're played)
    mkBtn("🔒 ضعه مقلوباً (Set)",()=>{closeSummonOv();setSpellTrap(idx,card);});
  } else {
    mkBtn("✨ فعّل الآن",()=>{
      closeSummonOv();
      G.pField.s[idx]={id:card.id,faceDown:false};
      G.playerHand.splice(G.selIdx,1);G.selCard=null;G.selIdx=null;
      activateSpell(card,'p',idx);
    });
    // زر استدعاء الاندماج: يظهر فقط لأوراق الإنصهار وعند توفّر دمج ممكن
    if(typeof FUSION_SPELL_SLUGS!=='undefined' && FUSION_SPELL_SLUGS.includes(card.slug)){
      let options=availableFusions('p');
      if(options.length){
        mkBtn("🔮 استدعاء اندماج ("+options.length+")",()=>{
          closeSummonOv();
          startFusionSummon(idx,card);
        },'fusion-btn');
      }
    }
    mkBtn("🔒 ضعها مقلوبة (Set)",()=>{closeSummonOv();setSpellTrap(idx,card);});
  }
  mkBtn("إلغاء",()=>{closeSummonOv();},"cancel");
  ov.classList.add('vis');
}

function tryRitual(spellCard,sIdx){
  // Find the ritual monster in hand
  let monsterSlug=spellCard.ritualFor;
  let mIdx=G.playerHand.findIndex(id=>cardById(id).slug===monsterSlug);
  if(mIdx===-1){showMsg("تحتاج "+monsterSlug+" في يدك!",2200);return;}
  let ritualMon=cardById(G.playerHand[mIdx]);
  // Need tributes equal to level (simplified: need monsters on field/hand summing to level)
  let onField=G.pField.m.filter(s=>s).length;
  if(onField<1){showMsg("تحتاج مونستر على الساحة للتضحية الطقسية!",2200);return;}
  let freeZone=G.pField.m.findIndex(s=>!s);
  if(freeZone===-1){showMsg("ساحة المونسترات ممتلئة!",1800);return;}
  // Tribute one monster (simplified)
  let tribIdx=G.pField.m.findIndex(s=>s);
  sendToGrave('p',tribIdx);
  // Remove spell + ritual monster from hand
  G.playerHand.splice(mIdx,1);
  let spellHandIdx=G.selIdx; if(spellHandIdx>mIdx) spellHandIdx--;
  G.playerHand.splice(spellHandIdx,1);
  let fz=G.pField.m.findIndex(s=>!s);
  G.pField.m[fz]={id:ritualMon.id,pos:'atk',faceDown:false,attacked:false,justSummoned:true};
  G.selCard=null;G.selIdx=null;
  renderAll();
  showMsg("استدعاء طقسي! "+ritualMon.name+" ⚜",2200);
}

