  { id:907, slug:"ar6-007", name:"نيكروفير الظلامي", type:"monster", race:"zombie", gameDeck:true, attribute:"dark", level:6, atk:2200, def:2800, desc:"يستدعى بخلع ثلاثة وحوش من نوع شيطان من مقبرتك، إذا دمر هذا الوحش بصحح ورقة وحوش حصمك وتحكم فيه." },
  { id:908, slug:"ar6-008", name:"روح النقاء والضياء", type:"monster", race:"zombie", gameDeck:true, attribute:"light", level:4, atk:2000, def:1800, desc:"يستدعى للملعب بإخراج وحسين من المقبرة من نوع صوئي، ما دامت بالملعب تنقص هجوم وحوش خصمك 300 نقطة عند كل هجوم." },
  { id:909, slug:"ar6-009", name:"الروح النارية", type:"monster", race:"zombie", gameDeck:true, attribute:"fire", level:4, atk:1700, def:1000, desc:"يستدعى استدعاءً خاصاً بعد أن تخلع من الملعب وحش ناري من مقبرتك، عند الهجوم بريد هجومه بـ300 نقطة." },
  { id:910, slug:"ar6-010", name:"الروح المائيّة", type:"monster", race:"aqua", gameDeck:true, attribute:"water", level:4, atk:1600, def:1200, desc:"لاستدعائه احذف وحش مائي من مقبرتك، بمكنك تغير وضعية وحش من وحوش خصمك في كل مرحلة استعداد خصمك." },
  { id:911, slug:"ar6-011", name:"روح الصخر", type:"monster", race:"zombie", gameDeck:true, attribute:"earth", level:4, atk:1700, def:1000, desc:"يستدعى استدعاءً خاصاً بعد سحب وحش أرضي من مقبرتك، بزداد هجومه بـ300 عند الهجوم." },
  { id:912, slug:"ar6-012", name:"جارودا روح الريح", type:"monster", race:"zombie", gameDeck:true, attribute:"wind", level:4, atk:1600, def:1200, desc:"استدع هذا الوحش بعد أن تخرج وحش هوائي من مقبرتك، بمكنك تغير وضعية وحش من وحوش خصمك عند نهاية دوره." },
  { id:913, slug:"ar6-013", name:"غيلاصوروس", type:"monster", race:"zombie", gameDeck:true, attribute:"earth", level:4, atk:1400, def:400, desc:"إذا استدعى استدعاءً خاصاً فيمكن لخصمك استدعاء وحش من مقبرته للملعب." },
  { id:914, slug:"ar6-014", name:"طائر العاصفة", type:"monster", race:"winged", gameDeck:true, attribute:"wind", level:4, atk:1100, def:1000, desc:"أعد ورقتين سحر أو فخ من الملعب إلى مجموعة صاحبهما." },
  { id:915, slug:"ar6-015", name:"حلم الشبح", type:"monster", race:"zombie", gameDeck:true, attribute:"light", level:2, atk:300, def:200, desc:"عندما يهاجم خصمك هذا الوحش، تمكنك أن تحول الهجوم إلى أحد أوراقك الأخرى." },
  { id:916, slug:"ar6-016", name:"زمبيرا الظلامي", type:"monster", race:"beast", attribute:"dark", level:4, atk:2100, def:500, desc:"لا بمكنه الهجوم مباشرة، عندما بدمر وحشاً بفقد 200 نقطة من هجومه." },
  { id:917, slug:"ar6-017", name:"التموين", type:"monster", race:"zombie", gameDeck:true, attribute:"earth", level:4, atk:1300, def:800, desc:"أرجع وحشاً دمج من مقبرتك إلى مجموعتك قد سبق لك وأن استعملنهم في استدعاء وحش دمج." , fusionMon:true},
  { id:918, slug:"ar6-018", gameDeck:true, name:"ماريوكوتاي", type:"monster", race:"spellcaster", attribute:"water", level:4, atk:900, def:900, desc:"إذا كان بالملعب مكشوف وفعل حصمك ورقة سحرية بدمر الورقة السحرية بعد أن تضحي به." },
  { id:919, slug:"ar6-019", name:"المحارب الأخير من الكوكب الأخر", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:7, atk:2350, def:2300, desc:"وحش دمج: ماريوكوتاي + زمبيرا الظلامي، عندما يستدعى تدمر كل وحوشك بالملعب ولا بمكنك استدعاء أو قلب وحش." , fusionMon:true, mats:["ar6-018", "ar6-016"]},
  { id:920, slug:"ar6-020", name:"الطاقة المجمعة", type:"trap", gameDeck:true, desc:"فعّل هذه الورقة واختر وحشاً من وحوشك بالملعب لبرود بقوة كل أوراق التجهيز التي بالملعب." },
  { id:921, slug:"ar6-021", name:"طيف الصّمت الأسود", type:"trap", gameDeck:true, desc:"تُفعّل عند هجوم الخصم، بمكنك إلغاء هجوم وحش وتوجيهه لأحد وحوش الخصم المقلوبة، إذا كان هذا الوحش في وضعية دفاع غيره إلى هجوم." },
  { id:922, slug:"ar6-022", name:"الأمر الملكي", type:"trap", gameDeck:true, desc:"هذه الورقة تلغي جميع تأثيرات الوحوش عن طريق القلب." },
