function effATK(card,who,slot){
  if(slot&&slot.token)return 0;
  let atk=card.atk||0;
  // equip bonuses stored on slot
  if(slot&&slot.atkBonus)atk+=slot.atkBonus;
  if(slot&&slot.tempAtk)atk+=slot.tempAtk; // زيادة مؤقتة لهذا الدور (الزهر الرشيق)
  // التأثيرات الديناميكية العربية (+X لكل وحش/فصيلة)
  if(slot&&!slot.faceDown&&AR_ATK_DYNAMIC[card.slug]){
    try{atk+=AR_ATK_DYNAMIC[card.slug](who,slot);}catch(e){}
  }
  // النجمة الخارقة: إذا كان لدى الخصم نجمة خارقة مكشوفة، تنقص وحوش الظلام لديك 400 هجوم
  if(card.attribute==='dark'){
    let opp=who==='p'?G.eField:G.pField;
    if(opp.m.some(s=>s&&!s.faceDown&&cardById(s.id).slug==='ar13-081')) atk-=400;
  }
  // محرّضات الفصيلة (تؤثر على كل الملعب حسب الخاصية): مايلس/كمير/نصل الذبابة
  {
    let allOnField=s=>[G.pField,G.eField].some(f=>f.m.some(x=>x&&!x.faceDown&&s.includes(cardById(x.id).slug)));
    // مايلس المشع: +500 للأرض، -400 للهواء
    if(allOnField(['ar5-066','ar13-089'])){ if(card.attribute==='earth')atk+=500; if(card.attribute==='wind')atk-=400; }
    // كمير الصغير: +500 للنار، -400 للماء
    if(allOnField(['ar5-073'])){ if(card.attribute==='fire')atk+=500; if(card.attribute==='water')atk-=400; }
    // نصل الذبابة: +500 للهواء، -400 للأرض
    if(allOnField(['ar5-074','ar13-097'])){ if(card.attribute==='wind')atk+=500; if(card.attribute==='earth')atk-=400; }
    // الفتى النجم: +500 هجوم لوحوش الماء
    if(allOnField(['ar5-065','ar13-088'])){ if(card.attribute==='water')atk+=500; }
    // الساحر المبتدئة: +500 هجوم لوحوش الظلام
    if(allOnField(['ar5-077','ar13-100'])){ if(card.attribute==='dark')atk+=500; }
  }
  // بطاقات البيئة المفعّلة (في منطقة الحقل): تعزيز مستمر حسب النوع
  if(G.fieldSpell){
    for(let w of ['p','e']){
      let fid=G.fieldSpell[w]; if(!fid)continue;
      let fc=cardById(fid); if(!fc||!FIELD_BOOST[fc.slug])continue;
      try{ atk+=FIELD_BOOST[fc.slug](card); }catch(e){}
    }
  }
  switch(card.slug){
    case 'dark-magician-girl':
      // +300 per Dark Magician in either graveyard
      atk+=300*(countInGrave('p','dark-magician')+countInGrave('e','dark-magician'));
      break;
    case 'buster-blader':
      // +500 per dragon the opponent controls
      atk+=500*countDragonsOnField(who==='p'?'e':'p');
      break;
    case 'blade-knight':
      // +400 ATK while its controller has 1 or fewer cards in hand
      {let hand=who==='p'?G.playerHand:G.enemyHand; if(hand&&hand.length<=1)atk+=400;}
      break;
    case 'insect-queen':
      // +200 لكل حشرة على الساحة (نحسب الملكة نفسها كحشرة)
      {let f=who==='p'?G.pField:G.eField;let bugs=f.m.filter(s=>s&&(cardById(s.id).slug==='insect-queen')).length; atk+=200*Math.max(1,bugs);}
      break;
    case 'ar4-081':
    case 'ar11-004':
      // المهاجم البرقيّ: ينقص هجومه 400 لكل ورقة يملكها الخصم على الملعب (وحوش + سحر/فخ)
      if(slot&&!slot.faceDown){
        let opp=who==='p'?G.eField:G.pField;
        let oppCards=opp.m.filter(s=>s).length + opp.s.filter(s=>s).length;
        atk-=400*oppCards;
      }
      break;
  }
  return Math.max(0,atk);
}
function effDEF(card,who,slot){
  let def=card.def||0;
  if(slot&&slot.defBonus)def+=slot.defBonus;
  if(slot&&slot.tempDef)def+=slot.tempDef; // زيادة مؤقتة لهذا الدور (الزهر الرشيق)
  // بطاقات البيئة: تعزيز الدفاع للفصيلة المطابقة (للبيئات حسب الفصيلة)
  if(G.fieldSpell){
    let raceFields=['ar8-052','ar15-052','ar8-053','ar15-053','ar8-054','ar15-054','ar8-056','ar15-056','ar2-072','ar10-095'];
    for(let w of ['p','e']){
      let fid=G.fieldSpell[w]; if(!fid)continue;
      let fc=cardById(fid); if(!fc||!FIELD_BOOST[fc.slug]||!raceFields.includes(fc.slug))continue;
      try{ let b=FIELD_BOOST[fc.slug](card); if(b>0)def+=b; }catch(e){}
    }
  }
  // محرّضات إنقاص الدفاع حسب الخاصية
  {
    let allOnField=s=>[G.pField,G.eField].some(f=>f.m.some(x=>x&&!x.faceDown&&s.includes(cardById(x.id).slug)));
    if(allOnField(['ar5-065','ar13-088'])&&card.attribute==='fire')def-=400; // الفتى النجم: -400 دفاع نار
    if(allOnField(['ar5-077','ar13-100'])&&card.attribute==='light')def-=400; // الساحر المبتدئة: -400 دفاع ضوء
  }
  return Math.max(0,def);
}
function onSentToGrave(who,cardId){
  let card=cardById(cardId);
  if(!card)return;
  // محرّك تأثيرات الوحوش عند التدمير/الذهاب للمقبرة
  if(typeof AR_MON_GRAVE!=='undefined' && AR_MON_GRAVE[card.slug]){
    try{ AR_MON_GRAVE[card.slug](who,cardId,card); }catch(e){}
  }
  if(card.slug==='archfiend-of-gilfer'){
    // reduce a random opponent monster's ATK by 500
    let opp=who==='p'?'e':'p';let f=opp==='p'?G.pField:G.eField;
    let targets=[];f.m.forEach((s,i)=>{if(s)targets.push(i);});
    if(targets.length){let i=targets[Math.floor(Math.random()*targets.length)];f.m[i].atkBonus=(f.m[i].atkBonus||0)-500;showMsg('👹 لعنة Gilfer: -500 هجوم!',1800);}
  }
  if(card.slug==='magician-of-faith'&&who==='p'){
    // retrieve a spell from your graveyard back to hand
    let idx=G.pGrave.findIndex(id=>cardById(id).type==='spell');
    if(idx>=0){let id=G.pGrave.splice(idx,1)[0];G.playerHand.push(id);showMsg('✨ Magician of Faith: استرجعت '+cardById(id).name,1900);}
  }
  // Witch of the Black Forest: when sent to grave, search deck for a monster with DEF<=1500 to hand
  if(card.slug==='witch-of-the-black-forest'){
    witchSearch(who);
  }
  // Kaiser Glider: when destroyed, return one opponent monster to hand
  if(card.slug==='kaiser-glider'){
    let opp=who==='p'?'e':'p';let f=opp==='p'?G.pField:G.eField;
    let hand=opp==='p'?G.playerHand:G.enemyHand;
    let idxs=[];f.m.forEach((s,i)=>{if(s)idxs.push(i);});
    if(idxs.length){
      let pick=idxs[Math.floor(Math.random()*idxs.length)];
      let rid=f.m[pick].id;hand.push(rid);f.m[pick]=null;
      showMsg('🦅 Kaiser Glider: أعاد '+cardById(rid).name+' لليد!',1900);
    }
  }
  // مطارد الضوء: ما دام مكشوفاً بالملعب، كل ورقة تذهب للمقبرة تُنفى من اللعب بدلاً
  let lightStalker = [G.pField,G.eField].some(f=>f.m.some(s=>s&&!s.faceDown&&(cardById(s.id).slug==='ar4-077'||cardById(s.id).slug==='ar12-100')));
  if(lightStalker && card.slug!=='ar4-077' && card.slug!=='ar12-100'){
    let g=who==='p'?G.pGrave:G.eGrave;
    let gi=g.lastIndexOf(cardId);
    if(gi>=0){ g.splice(gi,1); G.banished=G.banished||[]; G.banished.push(cardId); showMsg('🔦 مطارد الضوء! نُفي '+card.name+' من اللعب',1700); }
  }
}

// Witch search: pick a monster (DEF<=1500) from your deck → hand. Player gets a modal; enemy auto-picks.
function witchSearch(who){
  let deck=who==='p'?G.playerDeck:G.enemyDeck;
  let hand=who==='p'?G.playerHand:G.enemyHand;
  let candidates=deck.map((id,i)=>({id,i})).filter(x=>{let c=cardById(x.id);return c.type==='monster'&&(c.def||0)<=1500&&!c.fusionMon;});
  if(!candidates.length){showMsg('🔮 Witch: لا يوجد مونستر مناسب في السطح',1800);return;}
  if(who==='p'){
    // unique by id for display
    let seen={};let uniq=[];
    candidates.forEach(x=>{if(!seen[x.id]){seen[x.id]=1;uniq.push(x.id);}});
    pickCard('🔮 Witch of the Black Forest','اختر مونستراً بدفاع ≤1500 لإضافته ليدك', uniq, (chosenId)=>{
      let di=deck.findIndex(id=>id===chosenId);
      if(di>=0){deck.splice(di,1);hand.push(chosenId);shuffleDeckInPlace(deck);showMsg('🔮 أضفت '+cardById(chosenId).name+' ليدك!',1900);renderAll();}
    });
  } else {
    // enemy: pick the highest-ATK candidate
    candidates.sort((a,b)=>(cardById(b.id).atk||0)-(cardById(a.id).atk||0));
    let pick=candidates[0];
    deck.splice(pick.i,1);hand.push(pick.id);
    showMsg('🔮 '+oppName()+' بحث وأضاف مونستراً ليده',1800);renderAll();
  }
}

function shuffleDeckInPlace(d){for(let i=d.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[d[i],d[j]]=[d[j],d[i]];}}

// ===== منطق استدعاء الاندماج (مثل Power of Chaos) =====
// تجمع كل مصادر المواد المتاحة للاعب: اليد + الوحوش على الساحة
function fusionMaterialPool(who){
  let hand = who==='p'?G.playerHand:G.enemyHand;
  let field = who==='p'?G.pField:G.eField;
  let pool=[]; // {id, src:'hand'|'field', idx}
  hand.forEach((id,i)=>{ if(cardById(id) && cardById(id).type==='monster') pool.push({id:id,src:'hand',idx:i}); });
  field.m.forEach((slot,i)=>{ if(slot && !slot.token) pool.push({id:slot.id,src:'field',idx:i}); });
  return pool;
}
// هل تتوفر مواد وحش اندماج معيّن؟ تُعيد قائمة المصادر المستهلكة أو null
function canFuse(outSlug, who){
  let mats = FUSION_DB[outSlug]; if(!mats) return null;
  let pool = fusionMaterialPool(who);
  let used=[]; let usedKeys=new Set();
  for(let need of mats){
    let needCard = cardBySlug(need); if(!needCard) return null;
    // ابحث عن مصدر مطابق بالـid لم يُستهلك بعد
    let found=null;
    for(let p of pool){
      let key=p.src+':'+p.idx;
      if(usedKeys.has(key)) continue;
      if(p.id===needCard.id){ found=p; break; }
    }
    if(!found) return null;
    used.push(found); usedKeys.add(found.src+':'+found.idx);
  }
  return used;
}
// كل وحوش الاندماج القابلة للاستدعاء الآن من إكسترا اللاعب
function availableFusions(who){
  let extra = who==='p'?(G.playerExtra||[]):(G.enemyExtra||[]);
  let out=[];
  extra.forEach(id=>{
    let c=cardById(id); if(!c) return;
    if(canFuse(c.slug, who)) out.push(id);
  });
  return out;
}
// ابدأ استدعاء الاندماج: اعرض الخيارات ثم نفّذ
function startFusionSummon(spellIdx, spellCard){
  let opts = availableFusions('p');
  if(!opts.length){ showMsg('🔮 لا توجد مواد كافية لأي وحش اندماج',1900); return; }
  pickCard('🔮 اختر وحش الاندماج', 'المواد المتاحة في يدك وعلى ساحتك', opts, (chosenId)=>{
    doFusionSummon('p', chosenId, spellIdx, spellCard);
  });
}
// نفّذ الاستدعاء: استهلك ورقة الإنصهار + المواد، ثم ضع وحش الاندماج على الساحة
function doFusionSummon(who, outId, spellIdx, spellCard){
  let outCard = cardById(outId);
  let used = canFuse(outCard.slug, who);
  if(!used){ showMsg('🔮 تعذّر إتمام الاندماج',1700); return; }
  let field = who==='p'?G.pField:G.eField;
  let hand  = who==='p'?G.playerHand:G.enemyHand;
  let grave = who==='p'?G.pGrave:G.eGrave;
  let extra = who==='p'?G.playerExtra:G.enemyExtra;
  // تأكد من وجود خانة وحش فارغة
  let slotIdx = field.m.findIndex(x=>!x);
  // إذا لا توجد خانة فارغة، حرّر الخانات التي ستُستهلك من الساحة لاحقاً
  let fieldUsed = used.filter(u=>u.src==='field').map(u=>u.idx);
  if(slotIdx<0 && fieldUsed.length) slotIdx = fieldUsed[0];
  if(slotIdx<0){ showMsg('🔮 لا توجد خانة شاغرة للوحش',1800); return; }
  // أرسل المواد للمقبرة (اليد والساحة)
  // نجمع فهارس اليد لحذفها تنازلياً
  let handIdxs = used.filter(u=>u.src==='hand').map(u=>u.idx).sort((a,b)=>b-a);
  used.forEach(u=>{ grave.push(u.id); });
  handIdxs.forEach(i=>{ hand.splice(i,1); });
  fieldUsed.forEach(i=>{ field.m[i]=null; });
  // استهلك ورقة الإنصهار من اليد
  if(spellIdx!=null){
    // spellCard قد تكون في اليد عند selIdx
    let sIdxHand = (G.selIdx!=null)?G.selIdx:hand.findIndex(id=>id===spellCard.id);
    if(sIdxHand>=0){ grave.push(hand.splice(sIdxHand,1)[0]); }
  }
  G.selCard=null; G.selIdx=null;
  // أعد حساب خانة فارغة بعد التحرير
  if(field.m[slotIdx]) slotIdx = field.m.findIndex(x=>!x);
  if(slotIdx<0) slotIdx = 0;
  // أزل وحش الاندماج من الإكسترا (نسخة واحدة) وضعه على الساحة هجوماً
  let exPos = extra.indexOf(outId);
  if(exPos>=0) extra.splice(exPos,1);
  field.m[slotIdx] = {id:outId,pos:'atk',faceDown:false,justSummoned:true,fusion:true};
  sfx('bigsummon'); vibrate([40,60,120]);
  showMsg('🔮 استدعاء اندماج! '+outCard.name,2200);
  renderAll();
}

// عرض محتوى الإكسترا ديك (وحوش الاندماج) مع تمييز المتاح للاستدعاء
function showExtra(who){
  let extra = who==='p'?(G.playerExtra||[]):(G.enemyExtra||[]);
  if(!extra.length){ showMsg('📦 الإكسترا ديك فارغ',1500); return; }
  let avail = (who==='p')?availableFusions('p').slice():[];
  document.getElementById('pick-title').textContent = who==='p' ? '📦 الإكسترا ديك' : '📦 إكسترا ديك الخصم';
  document.getElementById('pick-sub').textContent = who==='p' ? 'وحوش الاندماج — الأخضر متاح للاستدعاء الآن' : 'وحوش اندماج الخصم (عرض فقط)';
  let grid=document.getElementById('pick-grid'); grid.innerHTML='';
  let ov=document.getElementById('pick-ov');
  extra.forEach(id=>{
    let card=cardById(id); if(!card) return;
    let canNow = avail.includes(id);
    let div=document.createElement('div'); div.className='grid-card';
    div.innerHTML='<img src="'+cardImg(card)+'" alt="'+card.name+'" style="'+(canNow?'box-shadow:0 0 10px 3px #4caf50;border-radius:6px':'opacity:.78')+'">';
    let mats=(FUSION_DB[card.slug]||[]).map(s=>{let m=cardBySlug(s);return m?m.name:s;}).join(' + ');
    div.title=mats;
    if(canNow && who==='p'){
      div.onclick=()=>{
        // ابحث عن ورقة إنصهار في اليد
        let fi=G.playerHand.findIndex(hid=>FUSION_SPELL_SLUGS.includes(cardById(hid).slug));
        if(fi<0){ showMsg('🔮 تحتاج ورقة إنصهار في يدك',1800); return; }
        ov.classList.remove('vis'); sfx('flip');
        let fcard=cardById(G.playerHand[fi]);
        G.selIdx=fi; G.selCard=fcard;
        doFusionSummon('p', id, fi, fcard);
      };
    } else {
      div.onclick=()=>{ showMsg('🔮 '+card.name+'  ['+mats+']',2400); };
    }
    grid.appendChild(div);
  });
  ov.classList.add('vis');
}

// Generic card picker modal. ids = array of card ids; cb(chosenId) called on tap.
function pickCard(title,sub,ids,cb){
  document.getElementById('pick-title').textContent=title;
  document.getElementById('pick-sub').textContent=sub||'';
  let grid=document.getElementById('pick-grid');grid.innerHTML='';
  let ov=document.getElementById('pick-ov');
  ids.forEach(entry=>{
    // entry قد يكون معرّفاً (رقم) أو كائناً {id, faceDown}
    let id = (typeof entry==='object') ? entry.id : entry;
    let faceDown = (typeof entry==='object') ? !!entry.faceDown : false;
    let card=cardById(id);
    let div=document.createElement('div');div.className='grid-card'+(faceDown?' facedown-pick':'');
    if(faceDown){
      // ورقة مقلوبة: تظهر بظهرها (مخفية) مع علامة استفهام
      div.innerHTML='<div class="pick-back">❔</div>';
    } else {
      div.innerHTML='<img src="'+cardImg(card)+'" alt="'+card.name+'">';
    }
    div.onclick=()=>{ov.classList.remove('vis');sfx('flip');cb(id);};
    grid.appendChild(div);
  });
  ov.classList.add('vis');
}
// اختيار وحش على ملعب اللاعب لتجهيزه؛ applyFn(slot,slotIdx) يطبّق البونص على الخانة المختارة
// filterFn(card) اختياري: يحصر الاختيار بالوحوش المطابقة (للتجهيز المشروط بفصيلة)
function pickEquipTarget(who,applyFn,label,filterFn){
  let f=who==='p'?G.pField:G.eField;
  let cands=[];
  f.m.forEach((s,i)=>{ if(s&&!s.faceDown && (!filterFn||filterFn(cardById(s.id))))cands.push(i); });
  if(!cands.length){ showMsg((label||'🗡 التجهيز')+'! لا وحش مناسب لتجهيزه',1700); return false; }
  // الخصم (الذكاء): يجهّز أقوى وحش مطابق تلقائياً
  if(who==='e'){
    let bi=cands[0],best=-1;
    cands.forEach(i=>{let a=cardById(f.m[i].id).atk||0;if(a>best){best=a;bi=i;}});
    applyFn(f.m[bi],bi); renderAll(); return true;
  }
  // اللاعب: شاشة اختيار
  if(cands.length===1){ applyFn(f.m[cands[0]],cands[0]); renderAll(); return true; }
  document.getElementById('pick-title').textContent=label||'🗡 اختر وحشاً لتجهيزه';
  let sub=document.getElementById('pick-sub'); if(sub)sub.textContent='اضغط على الوحش الذي تريد تجهيزه';
  let grid=document.getElementById('pick-grid');grid.innerHTML='';
  let ov=document.getElementById('pick-ov');
  cands.forEach(i=>{
    let c=cardById(f.m[i].id);
    let div=document.createElement('div');div.className='grid-card';
    div.innerHTML='<img src="'+cardImg(c)+'" alt="'+c.name+'">';
    div.onclick=()=>{ ov.classList.remove('vis'); sfx('equip'); applyFn(f.m[i],i); renderAll(); };
    grid.appendChild(div);
  });
  ov.classList.add('vis');
  return true;
}
