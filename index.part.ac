function cardById(id){return CARDS.find(c=>c.id===id);}
function cardBySlug(sl){return CARDS.find(c=>c.slug===sl);}
function cardImg(card){if(typeof CARD_IMAGES==='undefined')return '';let key=(card.copyOf)?card.copyOf:card.slug;return CARD_IMAGES[key]?CARD_IMAGES[key]:'';}

// ===================== SAVE / STATS =====================
function loadStats(){
  try{let s=localStorage.getItem('poc_stats');if(s)return JSON.parse(s);}catch(e){}
  return {wins:0,losses:0,streak:0,bestStreak:0};
}
function saveStats(st){try{localStorage.setItem('poc_stats',JSON.stringify(st));}catch(e){}}
function recordResult(won){
  let st=loadStats();
  if(won){st.wins++;st.streak++;if(st.streak>st.bestStreak)st.bestStreak=st.streak;}
  else{st.losses++;st.streak=0;}
  saveStats(st);
}
function renderMenuStats(){
  let el=document.getElementById('menu-stats');if(!el)return;
  let st=loadStats();
  let total=st.wins+st.losses;
  if(total===0){el.textContent='⚔ أول مبارزة لك!';return;}
  let rate=Math.round(st.wins/total*100);
  el.innerHTML='🎮 '+total+' مباراة · 🏆 '+st.wins+' فوز ('+rate+'%) · 💀 '+st.losses+' خسارة'+(st.bestStreak>1?' · 🔥 أفضل سلسلة: '+st.bestStreak:'')+(st.streak>1?' · ⚡ سلسلة حالية: '+st.streak:'');
}


