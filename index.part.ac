// اسحب ورقة من مجموعة لاعب — تُرجع true إذا نجح
function arDrawCard(who){
  let deck=who==='p'?G.playerDeck:G.enemyDeck;
  let hand=who==='p'?G.playerHand:G.enemyHand;
  if(!deck.length)return false;
  hand.push(deck.splice(0,1)[0]); if(typeof checkExodia==='function')checkExodia(who); return true;
}
// دمّر أول وحش من فصيلة معيّنة على ساحة معيّنة — تُرجع true إذا نجح
function arDestroyOneByRace(who,race){
  let f=who==='p'?G.pField:G.eField;
  for(let i=0;i<5;i++){let sl=f.m[i]; if(sl){let c=cardById(sl.id); if(c&&c.race===race){destroyMonster(who,i);return true;}}}
  return false;
}

function onSummon(who,idx,card){
  let myF=who==='p'?G.pField:G.eField;
  let myHand=who==='p'?G.playerHand:G.enemyHand;
  let myDeck=who==='p'?G.playerDeck:G.enemyDeck;
  // ===== محرّك تأثيرات الاستدعاء العربية =====
  if(AR_ON_SUMMON[card.slug]){
    try{ AR_ON_SUMMON[card.slug](who,idx,card,myF,myHand,myDeck); }catch(e){}
  }
  // Berfomet: add a Gazelle from your deck to your hand
  if(card.slug==='berfomet'){
    let di=myDeck.findIndex(id=>cardById(id).slug==='gazelle');
    if(di>=0){let gid=myDeck.splice(di,1)[0];myHand.push(gid);shuffleDeckInPlace(myDeck);showMsg('🦁 Berfomet: أضاف Gazelle لليد!',1800);renderAll();}
  }
  // Invitation to a Dark Sleep: choose an opponent monster that cannot attack
  if(card.slug==='invitation-to-a-dark-sleep'){
    let opp=who==='p'?'e':'p';let oppF=opp==='p'?G.pField:G.eField;
    let idxs=[];oppF.m.forEach((s,i)=>{if(s)idxs.push(i);});
    if(idxs.length){
      let target=idxs[Math.floor(Math.random()*idxs.length)]; // أبسط: عشوائي (أو الأقوى)
      // اختر الأقوى لمنعه
      target=idxs.sort((a,b)=>(cardById(oppF.m[b].id).atk||0)-(cardById(oppF.m[a].id).atk||0))[0];
      oppF.m[target].bound=true;
      showMsg('💤 Invitation: '+cardById(oppF.m[target].id).name+' لا يستطيع الهجوم!',2000);
      renderAll();
    }
  }
  // === تأثيرات استدعاء وحوش جوي ===
  // Copycat: ينسخ هجوم/دفاع أقوى وحش لدى الخصم
  if(card.slug==='copycat'){
    let opp=who==='p'?'e':'p';let oppF=opp==='p'?G.pField:G.eField;
    let best=null;oppF.m.forEach(s=>{if(s){let c=cardById(s.id);if(!best||(c.atk||0)>(cardById(best).atk||0))best=s.id;}});
    if(best&&myF.m[idx]){let bc=cardById(best);myF.m[idx].atkBonus=(myF.m[idx].atkBonus||0)+(bc.atk||0);myF.m[idx].defBonus=(myF.m[idx].defBonus||0)+(bc.def||0);showMsg('🐱 Copycat: نسخ قوة '+bc.name+'!',2000);renderAll();}
  }
  // Gilford the Lightning: عند استدعائه بتضحية (لا وحوش متبقية غيره عند صاحبه قبل الاستدعاء) دمّر كل وحوش الخصم
  if(card.slug==='gilford-lightning'){
    let opp=who==='p'?'e':'p';
    let cleared=0;
    let oppF=opp==='p'?G.pField:G.eField;
    for(let i=0;i<5;i++){if(oppF.m[i]){destroyMonster(opp,i);cleared++;}}
    if(cleared)showMsg('⚡ Gilford البرق: دمّر كل وحوش الخصم!',2200);
    renderAll();
  }
}

function sendToGrave(who,mIdx){let f=who==='p'?G.pField:G.eField;let g=who==='p'?G.pGrave:G.eGrave;let slot=f.m[mIdx];if(slot){let id=slot.id;g.push(id);f.m[mIdx]=null;onSentToGrave(who,id);return;}f.m[mIdx]=null;}
// Helper: send a monster/spell to grave by destroying it
function destroyMonster(who,idx){let f=who==='p'?G.pField:G.eField;let g=who==='p'?G.pGrave:G.eGrave;if(f.m[idx]){let id=f.m[idx].id;burstMonster(who,idx);g.push(id);f.m[idx]=null;sfx('destroy');vibrate([30,20,40]);if(typeof addLog==='function')addLog('💥 دُمّر '+cardById(id).name);onSentToGrave(who,id);if(typeof renderGrave==='function')renderGrave(who);}}
function destroySpell(who,idx){let f=who==='p'?G.pField:G.eField;let g=who==='p'?G.pGrave:G.eGrave;if(f.s[idx]){burstSpell(who,idx);g.push(f.s[idx].id);f.s[idx]=null;sfx('destroy');vibrate([20,15,25]);if(typeof renderGrave==='function')renderGrave(who);}}
// تدمير ورقة سحر/فخ لدى الخصم — اللاعب يختار عبر شاشة منبثقة، الخصم تلقائي
function arDestroyOppSpell(who,label){
  let opp=who==='p'?'e':'p', f=opp==='p'?G.pField:G.eField, g=opp==='p'?G.pGrave:G.eGrave;
  let idxs=[]; f.s.forEach((x,i)=>{ if(x) idxs.push(i); });
  if(idxs.length===0){ showMsg((label||'🧨')+' لا سحر/فخ لدى الخصم',1600); return; }
  let doDestroy=(i)=>{ if(!f.s[i])return; if(typeof burstSpell==='function')burstSpell(opp,i); g.push(f.s[i].id); f.s[i]=null; sfx('destroy'); if(typeof renderAll==='function')renderAll(); showMsg((label||'🧨')+' دُمّرت '+cardById(g[g.length-1]).name,1900); };
  if(who==='p' && typeof pickCard==='function'){
    let ids=idxs.map(i=>({id:f.s[i].id,faceDown:!!f.s[i].faceDown}));
    pickCard((label||'🧨 تدمير'),'عليك اختيار ورقة سحر/فخ لدى الخصم لتدميرها',ids,(chosenId)=>{ let i=idxs.find(k=>f.s[k]&&f.s[k].id===chosenId); if(i==null)i=idxs.find(k=>f.s[k]); if(i!=null)doDestroy(i); });
  } else {
    // الخصم: يدمّر أول ورقة (يفضّل المكشوفة)
    let i=idxs.find(k=>f.s[k]&&!f.s[k].faceDown); if(i==null)i=idxs[0]; doDestroy(i);
  }
}
// تدمير وحش لدى الخصم — اللاعب يختار عبر شاشة منبثقة، الخصم يدمّر الأقوى تلقائياً
// الصياد الأسطوري / وحش أغوار البحر: محميان من السحر طالما "أومي" مفعّلة لصاحبهما
function isWaterProtected(who,slot){
  if(!slot||slot.faceDown)return false;
  let sl=cardById(slot.id).slug;
  if(sl!=='ar3-082'&&sl!=='ar10-005'&&sl!=='ar3-085'&&sl!=='ar10-008')return false;
  // أومي مفعّلة لصاحب الوحش؟
  if(!G.fieldSpell)return false;
  let fid=G.fieldSpell[who]; if(!fid)return false;
  let fsl=cardById(fid).slug;
  return fsl==='ar8-056'||fsl==='ar15-056';
}
function arDestroyOppMonster(who,label){
  let opp=who==='p'?'e':'p', f=opp==='p'?G.pField:G.eField;
  let idxs=[]; f.m.forEach((x,i)=>{ if(x && !isWaterProtected(opp,x)) idxs.push(i); });
  if(idxs.length===0){ showMsg((label||'💥')+' لا وحش لدى الخصم (أو محمي)',1700); return; }
  let doDestroy=(i)=>{ if(!f.m[i])return; let nm=cardById(f.m[i].id).name; destroyMonster(opp,i); if(typeof renderAll==='function')renderAll(); showMsg((label||'💥')+' دُمّر '+nm,1800); };
  if(who==='p' && typeof pickCard==='function'){
    let ids=idxs.map(i=>f.m[i].id);
    pickCard((label||'💥 تدمير'),'عليك اختيار وحشاً من وحوش الخصم لتدميره',ids,(chosenId)=>{ let i=idxs.find(k=>f.m[k]&&f.m[k].id===chosenId); if(i==null)i=idxs.find(k=>f.m[k]); if(i!=null)doDestroy(i); });
  } else {
    // الخصم: يدمّر أقوى وحش للاعب تلقائياً
    let bi=idxs[0],best=-1; idxs.forEach(i=>{let a=(cardById(f.m[i].id).atk||0)+(f.m[i].atkBonus||0); if(a>best){best=a;bi=i;}}); doDestroy(bi);
  }
}
// إرجاع ورقة سحر/فخ لدى الخصم إلى يده — اللاعب يختار عبر شاشة منبثقة
