  { id:930, slug:"ar6-030", name:"لوحة المصير", type:"trap", gameDeck:true, desc:"عندما تمتلك هذه الورقة مع الحروف الأخرى بالمباراة لصالحك، تستدعى الحروف الأخرى عند كل دور من أدوارك، وعند اكتمالها تفوز." },
  { id:931, slug:"ar6-031", name:"رسالة الشبح \"ي\"", type:"spell", gameDeck:true, desc:"لا تلعب هذه الورقة إلا إذا كانت ورقة لوحة المصير مفعلة." },
  { id:932, slug:"ar6-032", name:"رسالة الشبح \"ا\"", type:"spell", gameDeck:true, desc:"لا تلعب هذه الورقة إلا إذا كانت ورقة لوحة المصير مفعلة." },
  { id:933, slug:"ar6-033", name:"رسالة الشبح \"هـ\"", type:"spell", gameDeck:true, desc:"لا تلعب هذه الورقة إلا إذا كانت ورقة لوحة المصير مفعلة." },
  { id:934, slug:"ar6-034", name:"رسالة الشبح \"ن\"", type:"spell", gameDeck:true, desc:"لا تلعب هذه الورقة إلا إذا كانت ورقة لوحة المصير مفعلة." },
  { id:935, slug:"ar6-035", name:"باب الظلام", type:"spell", gameDeck:true, desc:"كلا اللاعبان يهجمان بوحش واحد فقط خلال دور الهجوم." },
  { id:936, slug:"ar6-036", gameDeck:true, name:"الروحانية", type:"spell", desc:"أعد بطاقة سحر أو فخ من الملعب إلى يد خصمك، تفعل هذه الورقة لا بمكن نفيه بأي ورقة كانت." },
  { id:937, slug:"ar6-037", name:"الإعصار اللّيزري", type:"spell", gameDeck:true, desc:"جهّز بها كرادييس فيزداد هجومه بـ300 نقطة، إذا كان هجومه أكبر من دفاع الوحش الذي في وضعية دفاع بحصم الفرق من نقاط حياة الخصم." },
  { id:938, slug:"ar6-038", name:"الدمية الطُعم", type:"spell", gameDeck:true, desc:"ارغم تفعيل ورقة فخ غير مكشوفة، إذا كان موعد تفعيلها غير صحيح يبطل مفعولها وتدمر، وإذا تفعلت ترجع للأوراق وليس المقبرة." },
  { id:939, slug:"ar6-039", gameDeck:true, name:"فكّ الدمج", type:"spell", desc:"ضع وحش دمج بالملعب في مكان وحوش الدمج، إذا كان كل وحوش الدمج موجودون في المقبرة بمكنك استدعاؤهم استدعاء خاصاً في أي وقت تريد." },
  { id:940, slug:"ar6-040", gameDeck:true, name:"بوابة الدمج", type:"spell", desc:"طالما هذه الورقة في الملعب بمكنك دمج وحشين قابلين للدمج بدون ورقة الإنصهار، وحوش الدمج تخرج من اللعب ولا تذهب للمقبرة." },
  { id:941, slug:"ar6-041", name:"إكبيو دراكمور", type:"spell", gameDeck:true, desc:"الوحش المجهز بهذه الورقة لا بمكنه الهجوم، تدمر الوحش خلال الدور الثاني من أدوار صاحب الوحش ثم ترجع هذه الورقة لبد صاحبها." },
  { id:942, slug:"ar6-042", name:"معجزة الحفر", type:"spell", gameDeck:true, desc:"إذا أزيل 5 وحوش من وحوشك أو أكثر من اللعبة، بهذه الورقة بمكنك استرجاع 3 منهم." },
  { id:943, slug:"ar6-043", name:"هجوم التنين", type:"spell", gameDeck:true, desc:"هذه الورقة تجهز فقط بوحش من نوع المحارب وتزيد نقاطه الهجومية والدفاعية بـ500 نقطة." },
