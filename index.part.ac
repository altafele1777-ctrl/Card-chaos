// ===================== محرّك الأفخاخ العربية =====================
// كل دالة تأخذ (who, card) وتُرجع true إذا تحقق شرط التفعيل ونفّذت،
// أو false إذا لم يوجد هدف صالح (عندها لا تُرسل الورقة للمقبرة).
const AR_TRAPS = {
  // نداء القبر: استرجع وحشاً من مقبرتك للملعب هجوماً
  'ar-018': w=>{ let g=w==='p'?G.pGrave:G.eGrave, f=w==='p'?G.pField:G.eField;
    let gi=g.findIndex(id=>cardById(id).type==='monster'&&!cardById(id).fusionMon);
    let fz=f.m.findIndex(x=>!x);
    if(gi===-1||fz===-1){showMsg('⚰ لا يوجد وحش للإحياء',1600);return false;}
    let id=g.splice(gi,1)[0]; f.m[fz]={id,pos:'atk',faceDown:false,attacked:false,justSummoned:true,flashSummon:true};
    showMsg('⚰ نداء القبر! أُحيي '+cardById(id).name,1900); return true; },
  // الترس السحري: أنقص هجوم أقوى وحش عدو بـ500 وجمّده
  'ar-058': w=>{ let opp=w==='p'?'e':'p', oF=opp==='p'?G.pField:G.eField;
    let idxs=[]; oF.m.forEach((x,i)=>{if(x&&!x.faceDown)idxs.push(i);});
    if(!idxs.length){showMsg('🛡 لا يوجد هدف',1500);return false;}
    idxs.sort((a,b)=>(cardById(oF.m[b].id).atk||0)-(cardById(oF.m[a].id).atk||0));
    let t=idxs[0]; oF.m[t].atkBonus=(oF.m[t].atkBonus||0)-500; oF.m[t].bound=true;
    showMsg('🛡 الترس السحري! -500 وتجميد '+cardById(oF.m[t].id).name,1900); return true; },
  // الكُنّي المسلسل: حوّل وحشاً لك للدفاع و+500 هجوم لوحش آخر
  'ar-063': w=>{ let f=w==='p'?G.pField:G.eField;
    let atkIdx=f.m.findIndex(x=>x&&x.pos==='atk'&&!x.faceDown);
    if(atkIdx===-1){showMsg('🔁 لا يوجد وحش هجومي',1500);return false;}
    f.m[atkIdx].pos='def';
    let other=f.m.findIndex((x,i)=>x&&i!==atkIdx&&!x.faceDown);
    if(other!==-1)f.m[other].atkBonus=(f.m[other].atkBonus||0)+500;
    showMsg('🔁 الكُنّي المسلسل! دفاع +500 هجوم لوحش آخر',1900); return true; },
  // المُنشدة المائية: +500/+500 لكل وحوشك المكشوفة
  'ar-067': w=>{ let f=w==='p'?G.pField:G.eField, n=0;
    f.m.forEach(x=>{if(x&&!x.faceDown){x.atkBonus=(x.atkBonus||0)+500;x.defBonus=(x.defBonus||0)+500;n++;}});
