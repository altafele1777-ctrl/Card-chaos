// Per-opponent AI behaviour profiles
const OPP_TRAITS={
  yugi:    {aggression:0.6, trapChance:0.7, tributeBias:1.0, summonHighBias:1.0}, // balanced
  joey:    {aggression:0.95, trapChance:0.4, tributeBias:1.2, summonHighBias:0.9}, // reckless attacker
  kaiba:   {aggression:0.85, trapChance:0.5, tributeBias:1.6, summonHighBias:1.6}, // big monsters
  pegasus: {aggression:0.45, trapChance:0.95, tributeBias:0.8, summonHighBias:0.8}, // tricky, trap-heavy
};
function oppTraits(){
  let base=OPP_TRAITS[(typeof G!=='undefined'&&G.opponent)||G_oppKey]||OPP_TRAITS.yugi;
  let dp=diffPreset();
  // نطبّق معاملات الصعوبة على السمات
  return {
    aggression: Math.min(1, base.aggression*dp.aggMul),
    trapChance: Math.min(1, base.trapChance*dp.trapMul),
    tributeBias: base.tributeBias*dp.tributeMul,
    summonHighBias: base.summonHighBias*dp.summonMul,
  };
}

