// Map each player-deck monster to an attack style. Only applies to the player's own monsters.
// ===== أنميشن الوحوش المميزة (Epic Art) =====
// خريطة slug -> صورة فنية كبيرة تظهر بأنميشن مهيب عند الاستدعاء/الهجوم
const EPIC_ART={
  'ar-064':'data:image/jpeg;base64,',
  'ar9-087':'data:image/jpeg;base64,',
  'dup-7':'data:image/jpeg;base64,',
};
function epicFx(slug,name,mode){
  try{
    let art=EPIC_ART[slug];
    if(!art)return false;
    let ov=document.createElement('div');
    ov.className='epic-fx epic-'+(mode||'summon');
    ov.innerHTML='<div class="epic-art-wrap"><img class="epic-art" src="'+art+'"><div class="epic-shine"></div></div><div class="epic-name">'+(name||'')+'</div>';
    document.body.appendChild(ov);
    if(typeof sfx==='function')sfx(mode==='attack'?'attack':'bigsummon');
    if(typeof vibrate==='function')vibrate(mode==='attack'?[30,40,60]:[50,60,120]);
    setTimeout(()=>{ if(ov.parentElement)ov.parentElement.removeChild(ov); }, mode==='attack'?1300:1900);
    return true;
  }catch(e){return false;}
}
