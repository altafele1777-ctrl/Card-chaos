// خريطة fallback: لو الحالة مش متوفرة كصورة، استخدم البديل
const FACE_FALLBACK = {
  yugi:    {start:'challenge', lose:'angry', resolve:'attack', confident:'challenge', react_summon:'challenge', react_attack:'worried'},
  joey:    {lose:'worried', challenge:'start', resolve:'attack', confident:'win', angry:'attack', react_summon:'worried', react_attack:'attack'},
  kaiba:   {worried:'angry', lose:'angry', win:'attack', resolve:'attack', confident:'challenge', react_summon:'scheme', react_attack:'angry'},
  pegasus: {start:'challenge', worried:'resolve', win:'scheme', lose:'confident', angry:'attack', react_summon:'scheme', react_attack:'challenge'},
};
function resolveFaceKey(opp, state){
  if(OPP_FACES[opp+'_'+state]) return opp+'_'+state;
  let fb=(FACE_FALLBACK[opp]||{})[state];
  if(fb && OPP_FACES[opp+'_'+fb]) return opp+'_'+fb;
  // آخر حل: أي صورة متاحة للخصم
  let any=Object.keys(OPP_FACES).find(k=>k.startsWith(opp+'_'));
  return any||null;
}

// ============ نظام تعابير وردات فعل الخصم ============
let _faceTimer=null, _faceLast=0;
function showFaceReaction(state, opts){
  opts=opts||{};
  // الخصم الحالي
  let opp=(typeof G!=='undefined'&&G.opponent)||G_oppKey||'yugi';
  let key=resolveFaceKey(opp,state);
  if(!key)return;
  // تجنّب التكرار السريع جداً (إلا للحظات المهمة)
  let now=Date.now();
  if(!opts.force && now-_faceLast<2600) return;
  _faceLast=now;
  // اختيار كومنت عشوائي مناسب
  let pool=(OPP_COMMENTS[opp]&&OPP_COMMENTS[opp][state])|| (OPP_COMMENTS[opp]&&OPP_COMMENTS[opp].attack) ||[''];
  let txt=pool[Math.floor(Math.random()*pool.length)];
  let bar=document.getElementById('face-react');
  if(!bar)return;
  let img=document.getElementById('face-react-img');
  let bubble=document.getElementById('face-react-text');
  img.style.backgroundImage='url('+OPP_FACES[key]+')';
  bubble.textContent=txt;
  // لون حسب الحالة
  bar.className='face-react state-'+state+' show';
  // اهتزاز خفيف للحظات القوية
  if(state==='attack'||state==='angry'){ if(typeof vibrate==='function')vibrate([20]); }
  clearTimeout(_faceTimer);
  let dur=opts.duration|| (txt.length>22?3000:2300);
  _faceTimer=setTimeout(()=>{ bar.classList.remove('show'); }, dur);
}

