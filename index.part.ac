  { id:1709, slug:"ar14-010", name:"جوانا القديسة", type:"monster", race:"warrior", gameDeck:true, attribute:"light", level:4, atk:2000, def:2000, desc:"\"الملاك الأسود\" + \"السيدة الحنونة\"." },
  { id:1710, slug:"ar14-011", name:"الملاك الأسود", type:"monster", race:"fairy", gameDeck:true, attribute:"dark", level:4, atk:1700, def:1200, desc:"تأثير شرير: عندما تكون هذه الورقة في المقبرة، تزيد صاحبها 200 نقطة خلال كل مرحلة من مراحل الاستعداد." },
  { id:1711, slug:"ar14-012", name:"جرة الطمع", type:"trap", gameDeck:true, desc:"إسحب ورقة واحدة من أوراقك." },
  { id:1712, slug:"ar14-013", name:"مخطوط السحر", type:"spell", gameDeck:true, desc:"بمكنك تغيير وصف الوحش إلى الوصف الذي تريد." },
  { id:1713, slug:"ar14-014", name:"الإتحاد قوة", type:"spell", gameDeck:true, desc:"عن كل وحش تملكه بالملعب تزداد 800 نقطة لهجوم و دفاع الوحش المجهز بهذه الورقة." },
  { id:1714, slug:"ar14-015", name:"قوة السحر", type:"spell", gameDeck:true, desc:"لكل ورقة سحرية أو فخ في ملعبك ترفع قوة الوحش المجهز بهذه الورقة بـ500 نقطة." },
  { id:1715, slug:"ar14-016", name:"قربان الملعونين", type:"spell", gameDeck:true, desc:"دمر ورقة وحش مكشوف، و بالتالي تتخلى عن المرحلة القادمة لسحب الورق." },
  { id:1716, slug:"ar14-017", name:"الباب السرية", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:1200, def:1500, desc:"يقال أن هذا الباب النفيض صنع من طرف القابس النعساء." },
  { id:1717, slug:"ar14-018", gameDeck:true, name:"شيخ الأحلام الضائعة", type:"monster", race:"warrior", attribute:"dark", level:4, atk:1300, def:1800, desc:"هذا الوحش يغتات على أحلام النائمين الغافلين فيدخلهم في سبات عميق." },
  { id:1718, slug:"ar14-019", name:"السياف المقطوع الراس", type:"monster", race:"warrior", gameDeck:true, attribute:"light", level:4, atk:1450, def:1700, desc:"روح فارس نائهه، قد انهر ظلماً. نبحت عن الحقيقة و العدالة." },
  { id:1719, slug:"ar14-020", name:"الروح الملازمة للأرض", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:500, def:2000, desc:"مخلوق مبهم مشكل من أرواح المحاربين المهزومين، يدخل كل من بحرق ونهجم عليه إلى داخل أحشاء الأرض." },
  { id:1720, slug:"ar14-021", name:"كونت الموت", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:2000, def:700, desc:"إن هذا الرحل النبل حد شرير و بهابه الناس منل الشباطين." },
  { id:1721, slug:"ar14-022", name:"عظم هيمر", type:"monster", race:"zombie", gameDeck:true, attribute:"water", level:2, atk:850, def:400, desc:"هذا الوحش بحوب البحان يجذب إلى أشواكه جميع المخلوقات التي تصادف طريقها." },
  { id:1722, slug:"ar14-023", name:"الشعلة الراقصة", type:"monster", race:"pyro", gameDeck:true, attribute:"fire", level:2, atk:550, def:450, desc:"هذا الوحش يتحرك فوق حبل بحترق." },
  { id:1723, slug:"ar14-024", name:"السيدة سيفروس", type:"monster", race:"aqua", gameDeck:true, attribute:"earth", level:3, atk:400, def:1400, desc:"الكثير من اندحعوا بحمال مصاصة الدماء هاته." },
  { id:1724, slug:"ar14-025", name:"ثعبان البرق", type:"monster", race:"reptile", gameDeck:true, attribute:"light", level:4, atk:350, def:750, desc:"هذا الثعبان البحري الهائل يمتص الشحنات الكهربائية الضخمة و يحررها على شكل برق." },
  { id:1725, slug:"ar14-026", name:"جوعن الروحانية", type:"monster", race:"zombie", gameDeck:true, attribute:"light", level:4, atk:1400, def:1300, desc:"إذا رميت عشوائنا ورقة للمقبرة بمكنك أن تدمر كل الوحوش المستدعاة استدعاء خاصا و لا بمكن استدعائهم. تنفذ مرة بوجود قلة الوقها." },
  { id:1726, slug:"ar14-027", name:"كيكو الشبح المدمر", type:"monster", race:"zombie", gameDeck:true, attribute:"dark", level:4, atk:1800, def:700, desc:"إذا خلف ضررا مباشر بمكنك أن تحصد أخرع ورقتين من مقبرته في اللعب، مادامت في الملعب. لا بمكنه إخراج أوراق المقبرة من اللعب." },
  { id:1727, slug:"ar14-028", name:"مستدعي الأوهام", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:800, def:900, desc:"قلب: صحي بوحش، بمكنك استدعاء وحش دمج من مجموعتك. بدمر هذا الوحش في نهاية الدور." , fusionMon:true},
  { id:1728, slug:"ar14-029", name:"بازو - آكل الأرواح", type:"monster", race:"zombie", gameDeck:true, attribute:"earth", level:4, atk:1600, def:900, desc:"احذف ثلاث وحوش من مقبرتك و أضف 300 نقطة هجوم لهذا الوحش حتى نهاية دور خصمك." },
  { id:1729, slug:"ar14-030", name:"نيكروفير الظلامي", type:"monster", race:"fiend", gameDeck:true, attribute:"dark", level:6, atk:2200, def:2800, desc:"يستدعى بخلع ثلاثة وحوش من نوع شيطان. بزيد هذا الوحش بصبح ورقة بصير غير بها أحد وحوش حصمك و تحكم فيه." },
  { id:1730, slug:"ar14-031", name:"روح النقاء و الضياء", type:"monster", race:"zombie", gameDeck:true, attribute:"light", level:6, atk:2000, def:1800, desc:"بستدعى للملعب باخراج وحش من المقبرة من بدك ضوئي، مادامت بالملعب تنقص نقص هجوم وحوش حصمك عند كل هجوم." },
  { id:1731, slug:"ar14-032", name:"الروح النارية", type:"monster", race:"zombie", gameDeck:true, attribute:"fire", level:4, atk:1700, def:1000, desc:"بستدعى استدعاء خاص من الملعب وحش ناري بخلع وحش من وحوش مقبرتك، عند الهجوم يزيد هجومه بـ300 نقطة." },
  { id:1732, slug:"ar14-033", name:"الروح المائيّة", type:"monster", race:"aqua", gameDeck:true, attribute:"water", level:4, atk:1100, def:1200, desc:"بستدعى استدعاء خاص وحش مائي من مقبرتك، بمكنك من تغير وصفة وحش وصمة وحوش من مقبرتك في كل مرحلة استعداد حصمك." },
  { id:1733, slug:"ar14-034", name:"روح الصخر", type:"monster", race:"zombie", gameDeck:true, attribute:"earth", level:4, atk:1700, def:1000, desc:"بستدعى استدعاء خاص بعد بدء سحب وحش أرضي من مقبرتك، برداد هجومه بـ300 عند الهجوم." },
  { id:1734, slug:"ar14-035", name:"جارودا روح الريح", type:"monster", race:"zombie", gameDeck:true, attribute:"wind", level:4, atk:1500, def:1200, desc:"استدع هذا الوحش بعد ان تخرج وحش هوائي من مقبرتك و وصمة وحوش حصمك عند نهاية دوره." },
  { id:1735, slug:"ar14-036", name:"غيلاصوروس", type:"monster", race:"zombie", gameDeck:true, attribute:"earth", level:3, atk:1400, def:400, desc:"إذا استدعي استدعاء خاصا فبمكنك لحصمك استدعاء وحش من مقبرته للملعب." },
  { id:1736, slug:"ar14-037", name:"طائر العاصفة", type:"monster", race:"winged", gameDeck:true, attribute:"wind", level:3, atk:1100, def:1000, desc:"قلب: أعد ورقتين سحر أو فخ من الملعب إلى مجموعة صاحبها." },
  { id:1737, slug:"ar14-038", name:"حلم الشبح", type:"monster", race:"zombie", gameDeck:true, attribute:"light", level:2, atk:300, def:200, desc:"عندما بهاجم حصمك هذا الوحش، بمكنك أن بتحول المهجوم إلى أحد أوراقك الأخرى." },
  { id:1738, slug:"ar14-039", name:"زمبيرا الظلامي", type:"monster", race:"beast", gameDeck:true, attribute:"dark", level:4, atk:2100, def:500, desc:"لا بمكنه الهجوم مباشرة، عندما تدمر وحساً، يفقد 200 نقطة من هجومه." },
  { id:1739, slug:"ar14-040", name:"التموين", type:"monster", race:"zombie", gameDeck:true, attribute:"earth", level:4, atk:1300, def:800, desc:"قلب: ارجع وحساً ودمج من مقبرتك قد بسبق لك و أن استعملتهم في استدعاء وحش دمج." , fusionMon:true},
  { id:1740, slug:"ar14-041", name:"ماريوكوتاي", type:"monster", race:"spellcaster", gameDeck:true, attribute:"water", level:3, atk:900, def:900, desc:"إذا كان بالملعب مكشوف و فعل حصمك ورقة سحرية تدمر الورقة السحرية بعد ان تصحيها به." },
  { id:1741, slug:"ar14-042", name:"المحارب الأخير من الكوكب الآخر", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:7, atk:2350, def:2100, desc:"\"ماريوكوتاي\" + \"زميبرا الظلامي\". عندما لا بمكنك استدعاء وحش، و لا بمكنك إخراج أوراق المقبرة في صيغة هجوم بقلب وحش." },
  { id:1742, slug:"ar14-043", name:"الطاقة المجمعة", type:"trap", gameDeck:true, desc:"فعل هذه الورقة و احير وحسا من وحوشك بالملعب بقوة كل أوراق التجهيز التي بالملعب." },
  { id:1743, slug:"ar14-044", name:"طيف الصّمت الأسود", type:"trap", gameDeck:true, desc:"تفعل عند هجوم الحصم، بمكنك إلغاء هجوم وحش و توجيه لأحد وحوش الحصم المقلوبة. إذا كان هذا الوحش في وضعية دفاع، غيره إلى هجوم." },
  { id:1744, slug:"ar14-045", name:"الأمر الملكي", type:"trap", gameDeck:true, desc:"هذه الورقة تلغي جميع تأثيرات الوحوش عن طريق القلب." },
  { id:1745, slug:"ar14-046", name:"حقل ريبريوكو", type:"trap", gameDeck:true, desc:"إلغاء ورقة سحرية واحدة و تدميرها." },
  { id:1746, slug:"ar14-047", name:"مخبأ الجماجم", type:"trap", gameDeck:true, desc:"بمكنك أن تدمر وحسا واحدا بسحب عدد من وحوش مقبرتك بعادل مستوى الوحش المراد تدميره." },
  { id:1747, slug:"ar14-048", name:"انتقام الميت", type:"trap", gameDeck:true, desc:"في كل دور بحصم 100 نقطة أساسية عن كل وحش من وحوش حصمك خرج من الملعب." },
  { id:1748, slug:"ar14-049", name:"إتفاق الشبح", type:"trap", gameDeck:true, desc:"حتى نهاية دورك، هجوم أحد وحوشك برداد بـ100 نقطة لكل ورقة وحش موجودة في مقبرتك." },
  { id:1749, slug:"ar14-050", name:"الضربة المدمرة", type:"trap", gameDeck:true, desc:"إذا كانت نقاط الوحش المهاجم أقل من نقاط وحش من جهة الحصم الدفاعية بدمر هذا الوحش بعد الهجوم (تحسب الأضرار بعد الهجوم كما هي)." },
  { id:1750, slug:"ar14-051", name:"التدمير الأعمى", type:"trap", gameDeck:true, desc:"خلال دورك ارم نردا. دمر كل الوحوش التي مستواها بطابق عدد النرد المحصل عليه. إذا كان الرقم المحصل عليه هو 6، دمر كل الوحوش التي مستواها 6 أو أكثر." },
  { id:1751, slug:"ar14-052", name:"عطلة الإمبراطور", type:"trap", gameDeck:true, desc:"عطل تأثير كل أوراق التجهيز." },
  { id:1752, slug:"ar14-053", name:"لوحة المصير", type:"trap", gameDeck:true, desc:"عندما تمتلك هذه الورقة مع الحروف الخاصة بها بنتهي المباراة لصالحك بلهانيا، تستدعى الحروف الأخرى عند كل دور من أدوارك و عند اكتمالها نفوز." },
  { id:1753, slug:"ar14-054", name:"رسالة الشيخ \" ي \"", type:"spell", gameDeck:true, desc:"لا تلعب هذه الورقة إلا إذا كانت ورقة \"لوحة المصير\" مفعلة." },
  { id:1754, slug:"ar14-055", name:"رسالة الشيخ \" ا \"", type:"spell", gameDeck:true, desc:"لا تلعب هذه الورقة إلا إذا كانت ورقة \"لوحة المصير\" مفعلة." },
  { id:1755, slug:"ar14-056", name:"رسالة الشيخ \" ه \"", type:"spell", gameDeck:true, desc:"لا تلعب هذه الورقة إلا إذا كانت ورقة \"لوحة المصير\" مفعلة." },
  { id:1756, slug:"ar14-057", name:"رسالة الشيخ \" ن \"", type:"spell", gameDeck:true, desc:"لا تلعب هذه الورقة إلا إذا كانت ورقة \"لوحة المصير\" مفعلة." },
  { id:1757, slug:"ar14-058", name:"باب الظلام", type:"spell", gameDeck:true, desc:"كلا اللاعبين بهجمان بوحش واحد فقط خلال دور الهجوم." },
  { id:1758, slug:"ar14-059", name:"الروحانية", type:"spell", gameDeck:true, desc:"أعد بطاقة سحر أو فخ من الملعب إلى بد حصمك. تفعل هذه الورقة لا بمكن نفيه إلا بورقة كابت." },
  { id:1759, slug:"ar14-060", name:"الإعصار الليّزري", type:"spell", gameDeck:true, desc:"جهز بها \"كرادبس\" فيرداد هجومه بـ300 نقطة. إذا كان هجومه أكبر من دفاع الوحش الذي في وضعية دفاع، تحصص الفرق من نقاط حياة الخصم." },
  { id:1760, slug:"ar14-061", name:"الدمية الطعم", type:"spell", gameDeck:true, desc:"ارجع عشوانيا ورقة للمقبرة بمكنك أن تجبر المحارب أو تريد نقاطه المهجومة. إذا كان موعد تفعليها غير صحيح، بطل تفعيلها و تدمن و إذا تفعلت، ترجع للأوراق و ليس المقبرة." },
  { id:1761, slug:"ar14-062", gameDeck:true, name:"فكّ الدمج", type:"spell", desc:"ضع وحش دمج في الملعب. بمكنك دمج وحش الدمج في مكان وحوش الدمج. إذا كان وحش الدمج بمكنك استدعاؤهم استدعاء خاصا في الملعب في أي وقت تريد." },
  { id:1762, slug:"ar14-063", gameDeck:true, name:"بوابة الدمج", type:"spell", desc:"طالما هذه الورقة في الملعب، بمكنك دمج وحشين قابلين للدمج بدون ورقة \"الدمج\". وحوش الدمج تخرج من اللعب و لا تذهب للمقبرة." },
  { id:1763, slug:"ar14-064", name:"إكبيو دراكمور", type:"spell", gameDeck:true, desc:"الوحش المجهز بهذه الورقة لا بمكنه الهجوم. بدمر الوحش خلال الدور الثاني من أدوار صاحب الوحش ثم ترجع هذه لورقة لبد صاحبها." },
  { id:1764, slug:"ar14-065", name:"معجزة الحفر", type:"spell", gameDeck:true, desc:"إذا أزيل 5 وحوش من وحوشك أو أكثر من اللعبة، بهذه الورقة بمكنك استرجاع 3 منهم." },
  { id:1765, slug:"ar14-066", name:"هجوم التنين", type:"spell", gameDeck:true, desc:"هذه الورقة تجهز وحش من نوع المخالب و تريد نقاط الهجوم والدفاعية بـ500 نقطة. الوحش المجهز بهذه الورقة بعتبر من نوع التنين." },
  { id:1766, slug:"ar14-067", name:"الإبادة الروحية", type:"spell", gameDeck:true, desc:"عندما بخرج وحش من اللعب بعد أن كان في المقبرة. استعمل وحسا موجود بالملعب بدلا منه." },
  { id:1767, slug:"ar14-068", name:"روح المستنقع المنتقمة", type:"spell", gameDeck:true, desc:"اي وحش في الملعب لا بمكنه استدعاء فيه حتى و إن كان استدعاء عن قلب أو استدعاء خاص." },
  { id:1768, slug:"ar14-069", name:"الأسطوانات السحرية", type:"trap", gameDeck:true, desc:"عندما بهاجمك وحش من جهه حصمك بمكنك أن تعكس الهجوم إلى نقاطه الأساسية." },
  { id:1769, slug:"ar14-070", name:"فتاة سحر الظلام", type:"monster", race:"beast", gameDeck:true, attribute:"dark", level:6, atk:2000, def:1700, desc:"هجومها برداد بـ300 نقطة عن كل ورقه \"الساحر الأسود\" و \"ساحر العت السود\" في مقبرة أحد اللاعبين." },
  { id:1770, slug:"ar14-071", name:"درع الألفية", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:4, atk:0, def:3000, desc:"يقال أن هذا الشيء من الألفية بتصدى لأقوى الهجمات." },
  { id:1771, slug:"ar14-072", name:"ملكة الكون", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:8, atk:2900, def:2450, desc:"ملكة المجرات و سيدة النجوم." },
  { id:1772, slug:"ar14-073", name:"ملكة الحماقات", type:"monster", race:"warrior", gameDeck:true, attribute:"light", level:3, atk:950, def:700, desc:"خذ نقدية و العب وجه أو ظهر. إذا ربحت بضاعف هجوم الورقة خلال هذا الدور. إذا خسرت تفقد نصف هجومك." },
  { id:1773, slug:"ar14-074", name:"صفدع اللعاب", type:"monster", race:"warrior", gameDeck:true, attribute:"water", level:2, atk:700, def:500, desc:"مادة لزجة على رأس الصفدع." },
  { id:1774, slug:"ar14-075", name:"برانزو", type:"monster", race:"beast", gameDeck:true, attribute:"dark", level:4, atk:1300, def:1500, desc:"صندوق كنز بحتوي على وحش يهاجم كل قطاع الطرق المتهورين." },
  { id:1775, slug:"ar14-076", name:"تكريمينوس", type:"monster", race:"seaserpent", gameDeck:true, attribute:"water", level:4, atk:1500, def:1200, desc:"ثعبان البحر، هذا الثعبان البحري يحوب البحار كل حربه." },
  { id:1776, slug:"ar14-077", name:"الحيوان المحشو", type:"monster", race:"warrior", gameDeck:true, attribute:"earth", level:2, atk:1200, def:900, desc:"تحسبه دمية محشوة بدون خطورة، لكن فمها المفتوح آله عضه رهيبة." },
  { id:1777, slug:"ar14-078", name:"عين ميجاسونيك", type:"monster", race:"warrior", gameDeck:true, attribute:"dark", level:4, atk:1500, def:1800, desc:"مكون من معدن غريب، هذا الوحش عبارة عن آله لنهاية الزمن عند حدود الكون." },
  { id:1778, slug:"ar14-079", name:"إيمادرون", type:"monster", race:"pyro", gameDeck:true, attribute:"fire", level:4, atk:1600, def:1800, desc:"هذا الوحش بمتلك ثلاث رؤوس تطلق نارا قادرة على إنشاء بحر من اللهب إذا اتحدت نيرانها." },
  { id:1779, slug:"ar14-080", name:"رومبي السبقات الثلاثة", type:"monster", race:"zombie", gameDeck:true, attribute:"dark", level:4, atk:1100, def:800, desc:"هياكل عظمايا متعاطمان، هزيل و صحب، وبنطلقان بصعوبة كبيرة." },
