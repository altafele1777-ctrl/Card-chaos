const EXODIA_PARTS=['ar7-041','ar7-037','ar7-038','ar7-039','ar7-040'];
function checkExodia(who){
  if(G.exodiaTriggered)return false;
  let hand=who==='p'?G.playerHand:G.enemyHand;
  let have=EXODIA_PARTS.every(slug=>hand.some(id=>cardById(id).slug===slug));
  if(!have)return false;
  G.exodiaTriggered=true;
  playExodiaAnimation(who);
  return true;
}
function playExodiaAnimation(who){
  try{
    stopMusic(); sfx('win'); vibrate([60,40,60,40,100,60,200]);
