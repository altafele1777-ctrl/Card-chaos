  { id:1111, slug:"ar8-011", name:"تنين ذات المخالب", type:"monster", race:"dragon", gameDeck:true, attribute:"wind", level:6, atk:2000, def:2500, desc:"يزيد نقاط دفاعه و هجومه لـ300 نقطة لكل \"داب المخالب\" مكشوف في الملعب." },
