// تعديل لون الضربة حسب السمة (تلوين خفيف يعكس العنصر)
const ATTR_TINT={
  dark:  {color:'#b56cff', glow:'#5a1f99'},
  light: {color:'#fff0a8', glow:'#e0b030'},
  fire:  {color:'#ff7a3c', glow:'#cc2200'},
  water: {color:'#7ad6ff', glow:'#1f8aff'},
  wind:  {color:'#bff0d8', glow:'#2fd9a0'},
  earth: null, // يُبقي لون الفصيلة
};
function autoAttackStyle(card){
  if(!card)return null;
  let base=RACE_ATTACK[card.race];
  if(!base)return null;
  let st={kind:base.kind, icon:base.icon, color:base.color, glow:base.glow};
  // مزج خفيف مع لون السمة للوحوش المظلمة/النارية/المائية لإبراز عنصرها
  let tint=ATTR_TINT[card.attribute];
  if(tint && (card.attribute==='dark'||card.attribute==='fire'||card.attribute==='light')){
    st.color=tint.color; st.glow=tint.glow;
  }
  // الوحوش القوية جداً (هجوم ≥2400) تحصل على ضربة "stream" مهيبة بغضّ النظر عن الفصيلة
  if((card.atk||0)>=2400 && base.kind!=='laser' && base.kind!=='beam'){
    st.kind='stream';
  }
  return st;
}

function flyAttack(fromWho,fromIdx,to,onHit){
  let style=null;
  let f=fromWho==='p'?G.pField:G.eField;
  let slot=f.m[fromIdx];
  if(slot){let c=cardById(slot.id); if(c){ style=ATTACK_STYLES[c.slug] || autoAttackStyle(c); }}
  if(!style){return flySword(fromWho,fromIdx,to,onHit);}
  let start=getZoneCenter(fromWho,fromIdx);
  if(!start||!to){if(onHit)onHit();return;}
  let zones=document.querySelectorAll('#'+fromWho+'-m-zones .zone');
  let zc=zones[fromIdx]?zones[fromIdx].querySelector('.ciz'):null;
  if(zc)zc.classList.add('attacking');
  lungeAttacker(fromWho,fromIdx);
  sfx('attack');
  let charge=document.createElement('div');charge.className='fx-charge';
  charge.style.left=start.x+'px';charge.style.top=start.y+'px';charge.style.borderColor=style.color;
  charge.style.boxShadow='0 0 14px '+style.glow;
  document.body.appendChild(charge);setTimeout(()=>charge.remove(),360);
  let dx=to.x-start.x, dy=to.y-start.y;
  let ang=Math.atan2(dy,dx)*180/Math.PI;
  let dist=Math.hypot(dx,dy);
  let finish=()=>{
    if(zc)zc.classList.remove('attacking');
    sfx('hit');
    let imp=document.createElement('div');imp.className='fx-impact';
    imp.style.left=to.x+'px';imp.style.top=to.y+'px';
    imp.style.background='radial-gradient(circle,'+hexA(style.color,.95)+','+hexA(style.glow,.5)+' 55%,transparent 72%)';
    document.body.appendChild(imp);setTimeout(()=>imp.remove(),450);
    impactParticles(to.x,to.y,style);
    camShake(true);
    screenFlash(style.glow||style.color);
    if(onHit)onHit();
  };
  if(style.kind==='slash'){
    setTimeout(()=>{
      let sl=document.createElement('div');sl.className='fx-slash';
      sl.style.left=to.x+'px';sl.style.top=to.y+'px';
      sl.style.setProperty('--sl',(ang+20)+'deg');
      sl.style.background='linear-gradient(90deg,transparent,'+style.color+','+style.color+',transparent)';
      sl.style.boxShadow='0 0 16px '+style.glow;
      document.body.appendChild(sl);setTimeout(()=>sl.remove(),420);
      setTimeout(finish,180);
    },220);
  } else if(style.kind==='rocks'||style.kind==='pop'){
    launchParticles(start,to,style,()=>setTimeout(finish,60));
  } else if(style.kind==='stream'){
    // dragon burst: thick expanding beam from caster to target
    let st=document.createElement('div');st.className='fx-stream';
    st.style.left=start.x+'px';st.style.top=start.y+'px';st.style.width=dist+'px';
    st.style.transform='rotate('+ang+'deg) scaleX(0)';
    st.style.background='linear-gradient(90deg,'+hexA(style.glow,.95)+','+hexA(style.color,.95)+' 60%,'+hexA(style.color,.4)+')';
    st.style.boxShadow='0 0 22px '+style.glow+',0 0 40px '+hexA(style.glow,.6);
    document.body.appendChild(st);setTimeout(()=>st.remove(),520);
    setTimeout(finish,300);
  } else if(style.kind==='laser'){
    // machine laser: sharp instant beam
    let lz=document.createElement('div');lz.className='fx-laser';
    lz.style.left=start.x+'px';lz.style.top=start.y+'px';lz.style.width=dist+'px';
    lz.style.transform='rotate('+ang+'deg)';
    lz.style.background='linear-gradient(90deg,'+hexA(style.glow,.9)+','+style.color+','+hexA(style.color,.7)+')';
    lz.style.boxShadow='0 0 14px '+style.glow+',0 0 26px '+hexA(style.glow,.7);
    document.body.appendChild(lz);setTimeout(()=>lz.remove(),440);
    setTimeout(finish,230);
  } else {
    let proj=document.createElement('div');proj.className='atk-fx fx-beam';
    proj.textContent=style.icon;
    proj.style.left=start.x+'px';proj.style.top=start.y+'px';
    proj.style.filter='drop-shadow(0 0 10px '+style.glow+')';
    document.body.appendChild(proj);
    let trail=document.createElement('div');trail.className='fx-trail';
    trail.style.left=start.x+'px';trail.style.top=start.y+'px';
    trail.style.width=dist+'px';trail.style.transform='rotate('+ang+'deg)';
    trail.style.background='linear-gradient(90deg,'+hexA(style.color,.9)+',transparent)';
    trail.style.boxShadow='0 0 10px '+style.glow;
    document.body.appendChild(trail);setTimeout(()=>trail.remove(),500);
    let dur=style.kind==='vortex'?520:380;let t0=null;
    let spin=style.kind==='vortex'||style.kind==='bolt';
    function step(ts){
      if(!t0)t0=ts;let p=Math.min(1,(ts-t0)/dur);
      let e=p<.5?2*p*p:1-Math.pow(-2*p+2,2)/2;
      let cx=start.x+dx*e, cy=start.y+dy*e;
      let sc=.7+e*.6;
      proj.style.left=cx+'px';proj.style.top=cy+'px';
      proj.style.transform='translate(-50%,-50%) scale('+sc+')'+(spin?(' rotate('+(e*540)+'deg)'):'');
      if(p<1)requestAnimationFrame(step);
      else{proj.remove();finish();}
    }
    requestAnimationFrame(step);
  }
}
function hexA(hex,a){
  let h=hex.replace('#','');
  if(h.length===3)h=h.split('').map(x=>x+x).join('');
  let r=parseInt(h.substr(0,2),16),g=parseInt(h.substr(2,2),16),b=parseInt(h.substr(4,2),16);
  return 'rgba('+r+','+g+','+b+','+a+')';
}
