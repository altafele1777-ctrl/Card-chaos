// ===================== FIELD INTERACTIONS =====================
function onFieldM(who,idx){
  if(G.turn!=='player')return;
  // Tribute mode handled in onZoneClick
  if(G.tributeMode)return;
  if(who==='p'){
    let slot=G.pField.m[idx];if(!slot)return;
    if(G.phase==='main1'||G.phase==='main2'){
      // Flip summon or change position
      if(slot.faceDown){
        slot.faceDown=false;slot.pos='atk';slot.justSummoned=true;sfx('flip');
        showMsg("استدعاء بالقلب! ⚔",1300);renderField();
      } else {
        if(slot.justSummoned){showMsg("لا يمكن تغيير وضع مونستر استُدعي هذا الدور",1500);return;}
        if(slot.bsgLocked){showMsg("🛡 لا يمكن تغيير وضعيته قبل مرور دور كامل!",1900);return;}
        if(G.positionChanged.includes(idx)){showMsg("غيّرت وضعه بالفعل هذا الدور",1500);return;}
        slot.pos=slot.pos==='atk'?'def':'atk';
        G.positionChanged.push(idx);
        showMsg(slot.pos==='def'?"وضع دفاعي 🛡":"وضع هجومي ⚔",1100);renderField();
      }
    } else if(G.phase==='battle'){
      if(G.playerBattleEnded){showMsg("انتهت مرحلة معركتك (Negate Attack)",1600);return;}
      if(slot.pos!=='atk'||slot.faceDown){showMsg("فقط مونسترات الهجوم تقاتل",1300);return;}
      if(slot.attacked){showMsg("هاجم هذا المونستر بالفعل",1300);return;}
      // If enemy has no monsters -> direct attack immediately
      let enemyHasMonsters=G.eField.m.some(s=>s);
      if(!enemyHasMonsters){
        G.attacker=idx;
        tryDirectAttack();
        return;
      }
      // Otherwise select attacker, wait for target
      G.attackMode=true;G.attacker=idx;
      showMsg("اختر هدفاً للهجوم 🎯",1300);renderField();
    }
  } else {
    // Enemy monster clicked - attack target
    if(G.phase==='battle'&&G.attackMode){doAttack(idx);}
  }
}

function onFieldS(who,idx){
  if(who!=='p')return;
  let slot=G.pField.s[idx];if(!slot)return;
  if(!slot.faceDown)return;
  let card=cardById(slot.id);
  // During player's own turn: flip-activate spells; some traps can be activated proactively
  if(G.turn==='player'){
    if(card.type==='trap'){
      let s=card.slug;
      // جينزو: يبطل كل الفخاخ طالما على الملعب
      if(typeof jinzoActive==='function' && jinzoActive()){ showMsg('🤖 جينزو يبطل الفخاخ! لا يمكن تفعيل الفخ',2000); return; }
      // ===== محرّك الأفخاخ العربية: يُجرَّب أولاً =====
      if(AR_TRAPS[s]){
        let ok=false; try{ ok=AR_TRAPS[s]('p',card); }catch(e){ ok=true; }
        if(ok){ sfx('trap'); slot.faceDown=false; graveSpell('p',card); G.pField.s[idx]=null; renderAll(); }
        return;
      }
      // Player-activatable traps on their own turn
      if(s==='gift-of-the-mystical-elf'){
        let cnt=[...G.pField.m,...G.eField.m].filter(x=>x).length;
        G.playerLP+=cnt*300;slot.faceDown=false;graveSpell('p',card);G.pField.s[idx]=null;
        sfx('spell');showMsg('🧝 Gift of The Mystical Elf! +'+(cnt*300)+' حياة',2000);renderAll();return;
      }
      if(s==='final-attack-orders'){
        slot.faceDown=false;[...G.pField.m,...G.eField.m].forEach(x=>{if(x&&!x.faceDown)x.pos='atk';});G.finalAttackOrders=true;
        showMsg('⚔ Final Attack Orders! كل الوحوش هجوم',2000);renderAll();return;
      }
      if(s==='shadow-spell'||s==='spellbinding-circle'){
        let t=G.eField.m.findIndex(x=>x&&!x.faceDown);
        if(t!==-1){slot.faceDown=false;graveSpell('p',card);G.pField.s[idx]=null;
          if(s==='shadow-spell'){G.eField.m[t].atkBonus=(G.eField.m[t].atkBonus||0)-700;G.eField.m[t].bound=true;showMsg('🕸 Shadow Spell! -700 وتجميد '+cardById(G.eField.m[t].id).name,2000);}
          else{G.eField.m[t].bound=true;showMsg('⛓ Spellbinding Circle! جُمّد '+cardById(G.eField.m[t].id).name,2000);}
          sfx('spell');renderAll();}
        else showMsg('لا يوجد مونستر عدو',1500);
        return;
      }
      if(s==='crush-card-virus'){
        // tribute a DARK monster (ATK<=1000) you control, then destroy enemy monsters with ATK>=1500
        let darkIdx=G.pField.m.findIndex(x=>x&&!x.faceDown&&cardById(x.id).attribute==='dark'&&(cardById(x.id).atk||0)<=1000);
        if(darkIdx===-1){showMsg('🦠 يحتاج وحش ظلام بهجوم ≤1000 للتضحية',2200);return;}
        slot.faceDown=false;destroyMonster('p',darkIdx);graveSpell('p',card);G.pField.s[idx]=null;
        let cnt=0;for(let i=0;i<5;i++){if(G.eField.m[i]&&!G.eField.m[i].faceDown&&(cardById(G.eField.m[i].id).atk||0)>=1500){destroyMonster('e',i);cnt++;}}
        sfx('spell');showMsg('🦠 Crush Card Virus! دُمّر '+cnt+' وحش عدو',2200);renderAll();return;
      }
      if(s==='lightforce-sword'){
        if(G.enemyHand.length){slot.faceDown=false;graveSpell('p',card);G.pField.s[idx]=null;
          let r=Math.floor(Math.random()*G.enemyHand.length);let rid=G.enemyHand.splice(r,1)[0];G.banished=G.banished||[];G.banished.push(rid);
          sfx('spell');showMsg('🗡 Lightforce Sword! أُبعدت ورقة من يد '+oppName(),2000);renderAll();}
        else showMsg('يد العدو فارغة',1500);
        return;
      }
      if(s==='virus-cannon'){
        // tribute monsters; enemy sends equal number of spells from field/hand to grave
        let myMon=G.pField.m.map((x,i)=>({x,i})).filter(o=>o.x);
        if(!myMon.length){showMsg('🕷 يحتاج وحشاً للتضحية',2000);return;}
        slot.faceDown=false;destroyMonster('p',myMon[0].i);graveSpell('p',card);G.pField.s[idx]=null;
        // discard up to 1 enemy spell from field + 1 from hand
        let removed=0;
        for(let i=0;i<5;i++){if(G.eField.s[i]){destroySpell('e',i);removed++;break;}}
        let hi=G.enemyHand.findIndex(id=>cardById(id).type==='spell');
        if(hi!==-1){let rid=G.enemyHand.splice(hi,1)[0];G.eGrave.push(rid);removed++;}
        sfx('spell');showMsg('🕷 Virus Cannon! العدو فقد '+removed+' تعويذة',2100);renderAll();return;
      }
      if(s==='magical-trick-mirror'){
        // use a copy of a spell in opponent's graveyard
        let gi=G.eGrave.findIndex(id=>cardById(id).type==='spell');
        if(gi===-1){showMsg('🪞 لا توجد تعويذة في مقبرة العدو',2000);return;}
        slot.faceDown=false;let spellCard=cardById(G.eGrave[gi]);graveSpell('p',card);G.pField.s[idx]=null;
        sfx('spell');showMsg('🪞 Magical Trick Mirror! نسخ '+spellCard.name,1800);
        activateSpell(spellCard,'p',null);renderAll();return;
      }
      if(s==='final-geas'){
        // return all monsters to hands, then revive your strongest spellcaster/dragon from grave
        [...Array(5)].forEach((_,i)=>{if(G.pField.m[i]){G.playerHand.push(G.pField.m[i].id);G.pField.m[i]=null;}if(G.eField.m[i]){G.enemyHand.push(G.eField.m[i].id);G.eField.m[i]=null;}});
        slot.faceDown=false;graveSpell('p',card);G.pField.s[idx]=null;
        let gi=G.pGrave.map((id,i)=>({id,i})).filter(o=>cardById(o.id).type==='monster'&&!cardById(o.id).fusionMon).sort((a,b)=>(cardById(b.id).atk||0)-(cardById(a.id).atk||0))[0];
        if(gi){let rid=G.pGrave.splice(gi.i,1)[0];G.pField.m[0]={id:rid,pos:'atk',faceDown:false,attacked:false,justSummoned:true,flashSummon:true};showMsg('🌟 Final Geas! أعاد الكل وأحيا '+cardById(rid).name,2200);}
        else showMsg('🌟 Final Geas! أُعيدت كل الوحوش لليد',2000);
        sfx('spell');renderAll();return;
      }
      if(s==='magical-hats'){
        showMsg('🎩 Magical Hats يتفعّل عند هجوم العدو',2000);return;
      }
      if(s==='time-seal'){
        slot.faceDown=false;graveSpell('p',card);G.pField.s[idx]=null;G.skipDraw=true;
        sfx('spell');showMsg('⏳ Time Seal! '+oppName()+' سيتخطى سحبه القادم',2100);renderAll();return;
      }
      showMsg("الفخ يتفعّل عند تحقق شرطه في دور الخصم",1800);return;
    }
    // Quick reveal-activate a set spell
    slot.faceDown=false;
    activateSpell(card,'p',idx);renderField();
  }
}

// ===================== BATTLE =====================
function goBattlePhase(){
  if(G.turn!=='player')return;
  if(G.phase==='main1'){
    if(G.firstTurn){showMsg("لا يمكن الهجوم في الدور الأول!",2000);return;}
    G.phase='battle';G.selCard=null;G.selIdx=null;G.playerBattleEnded=false;
    setPhase('battle');showMsg("⚔ مرحلة المعركة!",1500);
    updateButtons();renderAll();
  } else if(G.phase==='battle'){
    // Move to main2
    G.phase='main2';G.attackMode=false;G.attacker=null;
    setPhase('main2');showMsg("المرحلة الرئيسية 2",1300);
    updateButtons();renderAll();
  }
}

function doAttack(targetIdx){
  let atkIdx=G.attacker;
  let atkSlot=G.pField.m[atkIdx];
  if(!atkSlot||atkSlot.attacked||atkSlot.pos!=='atk'){G.attackMode=false;renderField();return;}
  let atkCard=cardById(atkSlot.id);
  let target=G.eField.m[targetIdx];
  if(!target){G.attackMode=false;renderField();return;}
  // ظلام العفريت: ادفع 1000 نقطة كي يهاجم — نافذة نعم/لا
  if((atkCard.slug==='ar5-069'||atkCard.slug==='ar13-092') && !atkSlot._paidAttack){
    if(G.playerLP<=1000){ showMsg('👁 ظلام العفريت! لا تملك 1000 نقطة لتدفعها',2000); G.attackMode=false;renderField();return; }
    promptYesNo('👁 ظلام العفريت','ادفع 1000 نقطة أساسية كي تهاجم بهذا الوحش؟', atkSlot.id, ()=>{
      G.playerLP-=1000; sfx('lifeloss'); updateLP(); atkSlot._paidAttack=true;
      showMsg('👁 دفعت 1000! ظلام العفريت يهاجم',1700);
      setTimeout(()=>doAttack(targetIdx),400);
    }, ()=>{ G.attackMode=false;renderField(); });
    return;
  }
  // النمر المحارب: لا يهاجم إلا بالتضحية بوحش آخر من ملعبك (يختاره اللاعب عبر شاشة)
  if(atkCard.slug==='ar-064'||atkCard.slug==='ar9-087'||atkCard.slug==='dup-7'){
    // الوحوش المتاحة للتضحية: أي وحش آخر على ملعبك (ليس النمر نفسه)
    let sacrIdx=[]; G.pField.m.forEach((x,i)=>{ if(x&&i!==atkIdx) sacrIdx.push(i); });
    if(sacrIdx.length===0){ showMsg('🐯 النمر المحارب لا يهاجم إلا بالتضحية بوحش آخر لديك (لا يضحّي بنفسه)',2200); G.attackMode=false;renderField();return; }
    if(typeof pickCard==='function'){
      let ids=sacrIdx.map(i=>G.pField.m[i].id);
      pickCard('🐯 النمر المحارب','اختر وحشاً من ملعبك للتضحية به كي يهاجم النمر',ids,(chosenId)=>{
        // ضحِّ بأول وحش يطابق المعرّف المختار (وليس النمر)
        let si=-1; for(let i=0;i<5;i++){ if(i!==atkIdx&&G.pField.m[i]&&G.pField.m[i].id===chosenId){ si=i; break; } }
        if(si<0){ G.attackMode=false;renderField();return; }
        let sacName=cardById(G.pField.m[si].id).name;
        destroyMonster('p',si);
        showMsg('🐯 ضحّيت بـ'+sacName+'! النمر يهاجم',1800);
        // أعِد التحقق من سلامة المهاجم والهدف ثم نفّذ الهجوم (مع فحص الفخاخ)
        let aSlot=G.pField.m[atkIdx], tgt=G.eField.m[targetIdx];
        if(!aSlot||!tgt){ G.attackMode=false;renderAll();return; }
        let trap2=findEnemyActiveTrap(['mirror-force','magic-cylinder','waboku','negate-attack','ring-of-destruction','skull-dice','magical-arm-shield','kunai-with-chain','fairy-box']);
        if(trap2){ promptEnemyTrap(trap2,()=>{ executeEnemyTrap(trap2,atkIdx,atkCard); }, ()=>{ resolveAttack(atkIdx,aSlot,atkCard,targetIdx,tgt); }); }
        else { resolveAttack(atkIdx,aSlot,atkCard,targetIdx,tgt); }
      });
      return; // ننتظر اختيار اللاعب
    }
  }

  // Check enemy trap before damage
  let trap=findEnemyActiveTrap(['mirror-force','magic-cylinder','waboku','negate-attack','ring-of-destruction','skull-dice','magical-arm-shield','kunai-with-chain','fairy-box']);
  if(trap && enemyShouldTriggerTrap(trap,atkCard)){
    promptEnemyTrap(trap,()=>{ executeEnemyTrap(trap,atkIdx,atkCard); }, ()=>{ resolveAttack(atkIdx,atkSlot,atkCard,targetIdx,target); });
    return;
  }
  resolveAttack(atkIdx,atkSlot,atkCard,targetIdx,target);
}

// ===================== SWORD ATTACK ANIMATION =====================
function getZoneCenter(who,idx){
  let zones=document.querySelectorAll('#'+who+'-m-zones .zone');
  let z=zones[idx];
  if(!z)return null;
  let r=z.getBoundingClientRect();
  return {x:r.left+r.width/2,y:r.top+r.height/2};
}
// Center of a spell/trap zone
function getSpellZoneCenter(who,idx){
  let zones=document.querySelectorAll('#'+who+'-s-zones .zone');
  let z=zones[idx];
  if(!z)return null;
  let r=z.getBoundingClientRect();
  return {x:r.left+r.width/2,y:r.top+r.height/2};
}
// ===================== DESTRUCTION BURST =====================
// kind: 'monster' (fiery shards) | 'spell' (blue glass shatter)
function burstAt(x,y,kind){
  if(x==null||y==null)return;
  kind=kind||'monster';
  let palette = kind==='spell'
    ? {ring:'#5fbcff',core:'radial-gradient(circle,rgba(180,230,255,.95),rgba(40,120,255,.5) 55%,transparent 72%)',shards:['#bfe6ff','#5fbcff','#2a7bff','#e8f6ff']}
    : {ring:'#ffb347',core:'radial-gradient(circle,rgba(255,230,140,.97),rgba(255,90,0,.55) 50%,transparent 72%)',shards:['#ffe08a','#ff9a3c','#ff5a1f','#ffd24a']};
  // shockwave ring
  let ring=document.createElement('div');ring.className='destroy-ring';
  ring.style.left=x+'px';ring.style.top=y+'px';ring.style.borderColor=palette.ring;
  ring.style.boxShadow='0 0 14px '+palette.ring;
  document.body.appendChild(ring);setTimeout(()=>ring.remove(),600);
  // موجة صدمة ثانية أكبر (متأخرة قليلاً)
  let ring2=document.createElement('div');ring2.className='destroy-ring';
  ring2.style.left=x+'px';ring2.style.top=y+'px';ring2.style.borderColor=palette.ring;
  ring2.style.boxShadow='0 0 20px '+palette.ring;
  ring2.style.animationDelay='.08s';ring2.style.animationDuration='.7s';
  document.body.appendChild(ring2);setTimeout(()=>ring2.remove(),800);
  // central flash
  let core=document.createElement('div');core.className='destroy-core';
  core.style.left=x+'px';core.style.top=y+'px';core.style.background=palette.core;
  document.body.appendChild(core);setTimeout(()=>core.remove(),550);
  // flying shards (مضاعفة العدد والمدى)
  let n=kind==='spell'?14:18;
  for(let i=0;i<n;i++){
    let s=document.createElement('div');
    s.className='destroy-shard'+(kind==='spell'?' glass':'');
    let ang=(Math.PI*2*i)/n + Math.random()*0.5;
    let dist=48+Math.random()*60;
    s.style.left=x+'px';s.style.top=y+'px';
    s.style.background=palette.shards[i%palette.shards.length];
    s.style.boxShadow='0 0 6px '+palette.ring;
    s.style.setProperty('--sx',(Math.cos(ang)*dist).toFixed(1)+'px');
    s.style.setProperty('--sy',(Math.sin(ang)*dist).toFixed(1)+'px');
    s.style.setProperty('--sr',(Math.random()*540-270).toFixed(0)+'deg');
    document.body.appendChild(s);setTimeout(()=>s.remove(),700);
  }
}
// Burst helpers that read live coordinates from the field
function burstMonster(who,idx){let p=getZoneCenter(who,idx);if(p)burstAt(p.x,p.y,'monster');}
function burstSpell(who,idx){let p=getSpellZoneCenter(who,idx);if(p)burstAt(p.x,p.y,'spell');}

function getLPCenter(who){
  let bar=document.getElementById(who==='p'?'plp-fill':'elp-fill');
  if(bar){let r=bar.getBoundingClientRect();return {x:r.left+r.width/2,y:r.top+r.height/2};}
  return {x:window.innerWidth/2,y:who==='p'?window.innerHeight*0.7:window.innerHeight*0.15};
}
