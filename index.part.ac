// ===================== HAPTICS (vibration) =====================
function vibrate(pattern){try{if(navigator.vibrate&&SETTINGS.vibrate)navigator.vibrate(pattern);}catch(e){}}

// ===================== BACKGROUND MUSIC (ambient loop) =====================
let musicNodes=null, musicOn=false;
var musicMood='calm';
function musicBaseVol(){ return 0.10 * (SETTINGS.musicVol!=null?SETTINGS.musicVol:0.5); }
function startMusic(){
  if(musicOn||!audioCtx||!SETTINGS.music)return;
  try{
    musicOn=true;
    let master=audioCtx.createGain();
    master.gain.value=musicBaseVol();
    master.connect(audioCtx.destination);
    // درون باس عميق (طبقة أساسية دائمة) — نبرة مميزة لكل خصم
    let oppKey=(typeof G!=='undefined'&&G.opponent)||G_oppKey||'yugi';
    let oppTone={yugi:55, joey:49, kaiba:62, pegasus:46}[oppKey]||55; // كايبا أحدّ، بيغاسوس أعمق وأغرب
    let drone=audioCtx.createOscillator();
    drone.type='sine';drone.frequency.value=oppTone;
    let droneG=audioCtx.createGain();droneG.gain.value=0.6;
    drone.connect(droneG);droneG.connect(master);drone.start();
    let drone2=audioCtx.createOscillator();
    drone2.type='triangle';drone2.frequency.value=82.41;
    let drone2G=audioCtx.createGain();drone2G.gain.value=0.25;
    drone2.connect(drone2G);drone2G.connect(master);drone2.start();
    // سلالم نغمية حسب المزاج (شرقية صغرى)
    const scales={
      calm:  [261.63,293.66,311.13,349.23,392.0,415.3,466.16],   // هادئة
      battle:[261.63,311.13,349.23,392.0,466.16,523.25,622.25],  // أعلى وأكثر توتراً
      danger:[233.08,277.18,311.13,369.99,415.3,466.16,554.37],  // مظلمة/خطر
    };
    let tickFor=()=>musicMood==='battle'?1500:(musicMood==='danger'?1900:2600);
    let scheduleNext;
    let playNote=()=>{
      if(!musicOn||!audioCtx){return;}
      let scale=scales[musicMood]||scales.calm;
      let f=scale[Math.floor(Math.random()*scale.length)];
      // في المعركة: نغمات أعلى وأقوى قليلاً
      let peak=musicMood==='battle'?0.16:(musicMood==='danger'?0.14:0.12);
      let dur=musicMood==='battle'?1.8:2.2;
      let o=audioCtx.createOscillator();o.type=musicMood==='danger'?'triangle':'sine';o.frequency.value=f;
      let g=audioCtx.createGain();
      g.gain.setValueAtTime(0,audioCtx.currentTime);
      g.gain.linearRampToValueAtTime(peak,audioCtx.currentTime+0.35);
      g.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+dur);
      o.connect(g);g.connect(master);
      o.start();o.stop(audioCtx.currentTime+dur+0.1);
      // طبقة هارموني خفيفة في المعركة (خامسة)
      if(musicMood==='battle'){
        let o2=audioCtx.createOscillator();o2.type='sine';o2.frequency.value=f*1.5;
        let g2=audioCtx.createGain();g2.gain.setValueAtTime(0,audioCtx.currentTime);
        g2.gain.linearRampToValueAtTime(peak*0.5,audioCtx.currentTime+0.35);
        g2.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+dur);
        o2.connect(g2);g2.connect(master);o2.start();o2.stop(audioCtx.currentTime+dur+0.1);
      }
      scheduleNext();
    };
    scheduleNext=()=>{ if(!musicOn)return; musicNodes.melTimer=setTimeout(playNote, tickFor()); };
    musicNodes={master,drone,drone2,droneG,drone2G,melTimer:null};
    scheduleNext();
  }catch(e){musicOn=false;}
}
// تغيير المزاج الموسيقي حسب وضع اللعب: calm | battle | danger
function setMusicMood(mood){
  if(mood===musicMood)return;
  musicMood=mood;
  if(!musicOn||!musicNodes||!audioCtx)return;
  try{
    // درون أعمق وأقوى قليلاً وقت الخطر، أخف وقت الهدوء
    let target=musicBaseVol()*(mood==='danger'?1.25:(mood==='battle'?1.1:1.0));
    musicNodes.master.gain.linearRampToValueAtTime(target,audioCtx.currentTime+1.2);
    // نبرة الدرون الثاني: ترتفع قليلاً في المعركة لإحساس الإثارة
    let f2=mood==='battle'?98.0:(mood==='danger'?77.78:82.41);
    musicNodes.drone2.frequency.linearRampToValueAtTime(f2,audioCtx.currentTime+1.2);
  }catch(e){}
}
function setMusicVolume(){
  if(musicOn&&musicNodes&&audioCtx){ try{ musicNodes.master.gain.linearRampToValueAtTime(musicBaseVol(),audioCtx.currentTime+0.3); }catch(e){} }
}
function stopMusic(){
  if(!musicOn||!musicNodes)return;
  try{
    clearTimeout(musicNodes.melTimer);
    musicNodes.master.gain.exponentialRampToValueAtTime(0.0001,audioCtx.currentTime+0.5);
    setTimeout(()=>{try{musicNodes.drone.stop();musicNodes.drone2.stop();}catch(e){}musicNodes=null;},600);
  }catch(e){}
  musicOn=false;
}
// ===================== شاشة الإعدادات =====================
function showSettings(){
  renderSettings();
  document.getElementById('settings-ov').classList.add('vis');
}
function closeSettings(){
  document.getElementById('settings-ov').classList.remove('vis');
}
function renderSettings(){
  // تحديث حالة التبديلات
  setToggle('set-music', SETTINGS.music);
  setToggle('set-sfx', SETTINGS.sfxOn);
  setToggle('set-vibrate', SETTINGS.vibrate);
  // شريط مستوى الموسيقى
  let vs=document.getElementById('set-music-vol');
  if(vs){ vs.value=Math.round((SETTINGS.musicVol!=null?SETTINGS.musicVol:0.5)*100); }
  let vr=document.getElementById('music-vol-row');
  if(vr){ vr.style.opacity=SETTINGS.music?'1':'0.45'; }
  // أزرار الصعوبة
  document.querySelectorAll('.diff-btn').forEach(b=>{
    b.classList.toggle('active', b.dataset.diff===SETTINGS.difficulty);
  });
}
function setMusicVolFromSlider(val){
  SETTINGS.musicVol=Math.max(0,Math.min(1,(+val)/100));
  saveSettings(SETTINGS);
  if(typeof setMusicVolume==='function') setMusicVolume();
}
function setToggle(id,on){
  let el=document.getElementById(id);
  if(el)el.classList.toggle('on',!!on);
}
function toggleSetting(key){
  SETTINGS[key]=!SETTINGS[key];
  saveSettings(SETTINGS);
  renderSettings();
  // تطبيق فوري على الموسيقى
  if(key==='music'){
    if(SETTINGS.music){initAudio();startMusic();}
    else{stopMusic();}
  }
  if(key==='sfx'||key==='sfxOn'){}
  // صوت تأكيد خفيف
  if(SETTINGS.sfxOn){initAudio();sfx('flip');}
}
function setDifficulty(d){
  SETTINGS.difficulty=d;
  saveSettings(SETTINGS);
  renderSettings();
  if(SETTINGS.sfxOn){initAudio();sfx('flip');}
}

let G={};

function shuffle(a){let b=[...a];for(let i=b.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]];}return b;}

