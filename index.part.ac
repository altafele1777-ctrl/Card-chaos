// آخر وحش استدعاه الخصم (يُسجّل في enemyMainSummon): {idx}
function lastSummonQualifies(test){
  if(G.lastEnemySummonIdx==null)return false;
  let s=G.eField.m[G.lastEnemySummonIdx];
  return !!(s && test(s));
}
function destroyLastSummon(label){
  if(G.lastEnemySummonIdx==null)return;
  let s=G.eField.m[G.lastEnemySummonIdx]; if(!s)return;
  let nm=cardById(s.id).name; destroyMonster('e',G.lastEnemySummonIdx);
  showMsg(label+'! دُمّر '+nm,2000);
}
// يفحص يد اللاعب عن بطاقات يمكن تفعيلها رد فعل للحدث المعطى، ويعرض شاشة سؤال متسلسلة
function checkPlayerReactions(trigger, after){
  let candidates=[];
  G.playerHand.forEach((id,hi)=>{
    let c=cardById(id); if(!c)return;
    let r=PLAYER_REACT[c.slug];
    if(r && r.trigger===trigger){ try{ if(r.canReact()){ candidates.push({hi,id,c,r}); } }catch(e){} }
  });
  if(!candidates.length){ if(after)after(); return; }
  // اعرضها واحدة واحدة عبر شاشة السؤال
  let qi=0;
  function askNext(){
    if(qi>=candidates.length){ if(after)after(); return; }
    let cand=candidates[qi]; qi++;
    promptYesNo('تفعيل '+(cand.r.label||cand.c.name)+'؟', cand.c.desc||'', cand.id,
      ()=>{ // نعم
        let hidx=G.playerHand.indexOf(cand.id);
        if(hidx>=0){ G.playerHand.splice(hidx,1); G.pGrave.push(cand.id); }
        try{ cand.r.react(); }catch(e){}
        renderAll(); checkEnd();
        setTimeout(askNext,1300);
      },
      ()=>{ askNext(); } // لا
    );
  }
  askNext();
}

function promptPlayerTrap(trap,enemyAtkIdx,enemyAtkCard,onResolve){
  document.getElementById('tp-img').innerHTML='<img src="'+cardImg(trap.card)+'">';
  document.getElementById('tp-name').textContent=trap.card.name;
  document.getElementById('tp-desc').textContent=trap.card.desc;
  let prompt=document.getElementById('trap-prompt');
  document.getElementById('tp-yes').textContent="نعم، فعّل";
  document.getElementById('tp-no').style.display='';
  document.getElementById('tp-yes').onclick=()=>{
    prompt.classList.remove('vis');
    graveSpell('p',trap.card);G.pField.s[trap.idx]=null;
    let s=trap.card.slug;
    if(s==='mirror-force'){let cnt=0;for(let i=0;i<5;i++){if(G.eField.m[i]&&G.eField.m[i].pos==='atk'&&!G.eField.m[i].faceDown){destroyMonster('e',i);cnt++;}}showMsg("Mirror Force! دُمّرت "+cnt+" مونستر عدو!",2200);}
    else if(s==='magic-cylinder'){G.enemyLP-=enemyAtkCard.atk;showDmg(enemyAtkCard.atk,false);showMsg("Magic Cylinder! ارتد الهجوم! "+enemyAtkCard.atk,2200);}
    else if(s==='waboku'){showMsg("Waboku! لا ضرر هذا الدور",2000);G.wabokuActive=true;}
    else if(s==='negate-attack'){showMsg("🌀 Negate Attack! أُلغي الهجوم وانتهت المعركة",2100);G.enemyBattleEnded=true;}
    else if(s==='ring-of-destruction'){let dmg=enemyAtkCard.atk||0;if(G.eField.m[enemyAtkIdx])destroyMonster('e',enemyAtkIdx);G.playerLP-=dmg;G.enemyLP-=dmg;showDmg(dmg,true);showDmg(dmg,false);showMsg("💥 Ring of Destruction! ضرر "+dmg+" للطرفين",2200);}
    else if(s==='interdimensional-matter-transporter'){
      // banish one of your monsters until end phase (dodge the attack)
      let mine=G.pField.m.findIndex(x=>x);
      if(mine!==-1){let saved=G.pField.m[mine];G.pField.m[mine]=null;G.banishedReturn=G.banishedReturn||[];G.banishedReturn.push(saved);showMsg("🌌 Transporter! أُبعد وحشك مؤقتاً ونجا من الهجوم",2200);}
    }
    else if(s==='attack-guidance-armor'){
      // redirect the attack to another of your monsters
      let others=G.pField.m.map((x,i)=>({x,i})).filter(o=>o.x);
      if(others.length>1){let redirect=others[Math.floor(Math.random()*others.length)];showMsg("🛡 Attack Guidance Armor! حُوّل الهجوم",2000);renderAll();setTimeout(()=>{enemyResolveAttack(enemyAtkIdx,enemyAtkCard,redirect.i,redirect.x);setTimeout(onResolve,1400);},800);return;}
      else showMsg("🛡 Attack Guidance Armor!",1500);
    }
    else if(s==='magical-hats'){
      showMsg("🎩 Magical Hats! اختفى وحشك خلف القبعات",2000);
      // treat as dodge: attack misses
    }
    renderAll();checkEnd();
    setTimeout(onResolve,1400);
  };
  document.getElementById('tp-no').onclick=()=>{
    prompt.classList.remove('vis');
    // Resolve the attack normally
    let pm=G.pField.m.map((s,i)=>({s,i})).filter(x=>x.s);
    if(pm.length){let tgt=pm.sort((a,b)=>cardById(a.s.id).atk-cardById(b.s.id).atk)[0];enemyResolveAttack(enemyAtkIdx,enemyAtkCard,tgt.i,tgt.s);}
    else{G.playerLP-=enemyAtkCard.atk;showDmg(enemyAtkCard.atk,true);if(G.eField.m[enemyAtkIdx])G.eField.m[enemyAtkIdx].attacked=true;renderAll();checkEnd();}
    setTimeout(onResolve,1400);
  };
  prompt.classList.add('vis');
}

function enemyEndTurn(){
  returnWickedWorm('e');
