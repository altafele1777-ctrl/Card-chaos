  scr.classList.remove('arena-zombie','arena-cosmic','arena-volcano','arena-ocean','arena-storm','arena-ice');
  scr.classList.remove('env-toon','env-water','env-dark','env-forest');
  let a=ARENAS[Math.floor(Math.random()*ARENAS.length)];
  if(a.cls)scr.classList.add(a.cls);
