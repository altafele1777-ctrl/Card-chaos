  { id:945, slug:"ar6-045", name:"روح المستنقع المنتقمة", type:"spell", gameDeck:true, desc:"أي وحش في الملعب لا بمكنه الهجوم في الدور الذي استدعي به حتى وإن كان استدعاء عن قلب أو استدعاء خاص." },
