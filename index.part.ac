function endGame(r){stopMusic();vibrate(r==='win'?[80,50,80,50,120]:[200]);sfx(r==='win'?'win':'lose');endGameFx(r);recordResult(r==='win');let t=document.getElementById('result-t');t.textContent=r==='win'?'\u{1F3C6} انتصرت!':'\u{1F480} خسرت!';t.className='result-t '+(r==='win'?'win':'lose');let oppState=r==='win'?'lose':'win';showResultFace(oppState);
